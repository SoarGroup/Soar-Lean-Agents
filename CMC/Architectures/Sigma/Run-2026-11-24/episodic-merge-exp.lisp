(in-package :sigma)
(defun mk (c) `(perceive '((concept (value ,c)) (color (value silver)) (alive (value true)) (mobile (value true)) (legs (value 4)) (weight (value 10)))))
(defun run-exp (subtractive)
  (episodic)
  (setq gdl-subtractive-normalization subtractive)
  (setq trace-perception nil pre-d nil post-d nil)
  (setq ep-per (list (mk 'walker) (mk 'walker) (mk 'walker) (mk 'walker) (mk 'dog) (mk 'dog) (mk 'walker) (mk 'walker) nil nil))
  (setq perceive-list '((eval (pop ep-per))))
  (let ((trace-stream (make-broadcast-stream))) (d 9))
  (let* ((n (car (remove-if-not (lambda (n) (and (function-nodep n) (eq (node-function-name n) 'time-concept*episodic-learn))) (graph-nodes cg))))
         (p (node-function n))
         (tv 0))
    (format t "~&=== subtractive=~a  variables=~a~%" subtractive (map 'list #'svariable-name (plm-variables p)))
    (format t "slices along time: ~a~%" (mapcar #'slice-location (aref (plm-slices p) tv)))
    (format t "regions total: ~a~%" (array-total-size (plm-array p)))
    (pa 'time-concept*episodic-learn)))
(run-exp nil)
(run-exp t)
