(load "/home/claude/sig/prelude.lisp")
(in-package :sigma)
(setf sb-ext:*evaluator-mode* :compile)
(defvar *skipped* 0)
(with-open-file (in "/mnt/user-data/uploads/Soar-Lean-Agents/CMC/Architectures/Sigma/From-Rosenbloom-2026-11-16/sigma38-tutorial.lisp")
  (let ((*package* (find-package :sigma)))
    (loop for form = (handler-case (read in nil :eof)
                       (error (e) (format t "~&READ-ERR ~a~%" e) :skip))
          until (eq form :eof)
          do (unless (eq form :skip)
               (handler-bind ((warning #'muffle-warning))
                 (handler-case (eval form)
                   (error (e) (incf *skipped*)
                     (format t "~&SKIP ~s: ~a~%" (if (consp form) (list (car form) (if (consp (cdr form)) (cadr form))) form)
                             (subseq (princ-to-string e) 0 (min 120 (length (princ-to-string e))))))))))))
(format t "~&skipped ~a~%" *skipped*)
(load "/home/claude/sig/patch.lisp")
