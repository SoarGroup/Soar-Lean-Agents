sp {blocks-world*elaborate*problem-space
   (state <s> ^name blocks-world)
-->
   (<s> ^problem-space <p>)
   (<p> ^name move-blocks
        ^default-state-copy true
        ^dont-copy top-state clear 
                   inplace-object
        ^two-level-attributes desireds
                              on
        ^one-level-attributes object 
                              last-moved-block)}
