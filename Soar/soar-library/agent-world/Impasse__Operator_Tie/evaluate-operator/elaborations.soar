## elaborations.soar -- agent-world: 20 elaborations, 1 application.

## ---- elaborations ----

## Elaborate evaluate-operator evaluate-operator external-top-state -> sets external-top-state.
sp {agent-world*elaborate*evaluate-operator*evaluate-operator*external-top-state
   :default
   (state <s> ^name evaluate-operator
              ^superstate.superstate.external-top-state <external-top-state>)
-->
   (<s> ^external-top-state <external-top-state>)
}

## Elaborate evaluate-operator state look-ahead-operator copy -> sets look-ahead-operator, copied-from.
sp {agent-world*elaborate*evaluate-operator*state*look-ahead-operator*copy
   :default
   (state <s> ^problem-space.name <problem-space-name>
              ^superstate.operator <super-operator>)
   (<super-operator> ^name evaluate-operator
                     ^super-operator <super-super-operator>
                     ^super-problem-space.name <problem-space-name>)
-->
   (<s> ^look-ahead-operator <copy>)
   (<copy> ^copied-from <super-super-operator>)
}

## Elaborate evaluate-operator look-ahead-operator copy attributes.
sp {agent-world*elaborate*evaluate-operator*look-ahead-operator*copy*attributes
   :default
   (state <s> ^look-ahead-operator <copy>)
   (<copy> ^copied-from <real>)
   (<real> ^{ <> copied-from <> evaluation <> super-operator <attribute> } <value>)
-->
   (<copy> ^<attribute> <value>)
}

## Elaborate evaluate-operator copy-desired -> sets desired, duplicate-o.
sp {agent-world*elaborate*evaluate-operator*copy-desired
   :default
   (state <s> ^name evaluate-operator
              ^superstate.operator <super-operator>
              ^desireds <desireds>)
   (<super-operator> ^name evaluate-operator
                     ^evaluation.desireds <duplicate-desireds>)
   (<desireds> ^duplicate-of <duplicate-desireds>)
   (<duplicate-desireds> ^desired <desired>)
-->
   (<desireds> ^desired <new-desired>)
   (<new-desired> ^duplicate-of <desired>)}

## Elaborate evaluate-operator copy-desired-selection-value -> sets selection-val.
sp {agent-world*elaborate*evaluate-operator*copy-desired-selection-value
   :default
   (state <s> ^name evaluate-operator
              ^desireds <desireds>)
   (<desireds> ^duplicate-of <duplicate-desireds>
               ^desired <desired>)
   (<desired> ^duplicate-of <duplicate-desired>)
   (<duplicate-desired> ^selection-value <value>)
-->
   (<desired> ^selection-value <value>)
}

## Elaborate evaluate-operator copy-desired-object -> sets object, object-handle.
sp {agent-world*elaborate*evaluate-operator*copy-desired-object
   :default
   (state <s> ^name evaluate-operator
              ^desireds <desireds>)
   (<desireds> ^duplicate-of <duplicate-desireds>
               ^desired <desired>)
   (<desired> ^duplicate-of <duplicate-desired>)
   (<duplicate-desired> ^object <object>)
   (<object> ^object-handle <object-handle>)
-->
   (<desired> ^object <new-object>)
   (<new-object> ^object-handle <object-handle>)}

## Elaborate evaluate-operator copy-desired-object attribute.
sp {agent-world*elaborate*evaluate-operator*copy-desired-object*attribute
   :default
   (state <s> ^name evaluate-operator
              ^desireds <desireds>)
   (<desireds> ^duplicate-of <duplicate-desireds>
               ^desired <desired>)
   (<desired> ^duplicate-of <duplicate-desired>
              ^object <new-object>)
   (<duplicate-desired> ^object <object>)
   (<object> ^{ <attribute> <> duplicate-of <> object-handle } <value>)
-->
   (<new-object> ^<attribute> <value>)}

## Elaborate evaluate-operator copy-desired-holding-object -> sets holding-object, object-handle.
sp {agent-world*elaborate*evaluate-operator*copy-desired-holding-object
   :default
   (state <s> ^name evaluate-operator
              ^desireds <desireds>)
   (<desireds> ^duplicate-of <duplicate-desireds>
               ^desired <desired>)
   (<desired> ^duplicate-of <duplicate-desired>)
   (<duplicate-desired> ^holding-object <object>)
   (<object> ^object-handle <object-handle>)
-->
   (<desired> ^holding-object <new-object>)
   (<new-object> ^object-handle <object-handle>)}

## Elaborate evaluate-operator copy-desired-holding-object attribute.
sp {agent-world*elaborate*evaluate-operator*copy-desired-holding-object*attribute
   :default
   (state <s> ^name evaluate-operator
              ^desireds <desireds>)
   (<desireds> ^duplicate-of <duplicate-desireds>
               ^desired <desired>)
   (<desired> ^duplicate-of <duplicate-desired>
              ^holding-object <new-object>)
   (<duplicate-desired> ^holding-object <object>)
   (<object> ^{ <attribute> <> duplicate-of <> object-handle } <value>)
-->
   (<new-object> ^<attribute> <value>)}

## Elaborate evaluate-operator copy-desired-relation -> sets argument1, argument2.
## Relation - on in controlled-by above
sp {agent-world*elaborate*evaluate-operator*copy-desired-relation
   :default
   (state <s> ^name evaluate-operator
              ^desireds <desireds>)
   (<desireds> ^duplicate-of <duplicate-desireds>
               ^desired <desired>)
   (<desired> ^duplicate-of <duplicate-desired>)
   (<duplicate-desired> ^<relation> <value>)
   (<value> ^argument1.object-handle <argument1-handle>
            ^argument2.object-handle <argument2-handle>)
-->
   (<desired> ^<relation> <value1>)
   (<value1> ^argument1.object-handle <argument1-handle>
             ^argument2.object-handle <argument2-handle>)}

## Elaborate evaluate-operator copy-desired-learn task -> sets learn.
sp {agent-world*elaborate*evaluate-operator*copy-desired-learn*task
   :default
   (state <s> ^name evaluate-operator
              ^desireds <desireds>)
   (<desireds> ^duplicate-of <duplicate-desireds>
               ^desired <desired>)
   (<desired> ^duplicate-of <duplicate-desired>)
   (<duplicate-desired> ^learn task-goal
                        ^task <task>)
-->
   (<desired> ^learn task-goal
              ^task <task>)}

## Elaborate evaluate-operator copy-desired-executed-action -> sets executed-acti.
sp {agent-world*elaborate*evaluate-operator*copy-desired-executed-action
   :default
   (state <s> ^name evaluate-operator
              ^desireds <desireds>)
   (<desireds> ^duplicate-of <duplicate-desireds>
               ^desired <desired>)
   (<desired> ^duplicate-of <duplicate-desired>)
   (<duplicate-desired> ^executed-action <action>)
-->
