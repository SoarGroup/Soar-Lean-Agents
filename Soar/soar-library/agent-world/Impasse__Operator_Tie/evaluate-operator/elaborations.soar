## Elaborate evaluate-operator copy-desired-disjunction -> sets disjunction.
## Disjunction: link the copies of the two disjunct desired
sp {agent-world*elaborate*evaluate-operator*copy-desired-disjunction
   :default
   (state <s> ^name evaluate-operator ^desireds <desireds>)
   (<desireds> ^duplicate-of <duplicate-desireds>
               ^desired <desired> { <> <desired> <desired2> })
   (<desired> ^duplicate-of <duplicate-desired>)
   (<desired2> ^duplicate-of <duplicate-desired2>)
   (<duplicate-desired> ^disjunction <duplicate-desired2>)
-->
   (<desired> ^disjunction <desired2>)}

## Elaborate evaluate-operator copy-desireds-preferences.
## Preferred and avoid desired: point to the copies
sp {agent-world*elaborate*evaluate-operator*copy-desireds-preferences
   :default
   (state <s> ^name evaluate-operator ^desireds <desireds>)
   (<desireds> ^duplicate-of <duplicate-desireds> ^desired <desired>)
   (<desired> ^duplicate-of <duplicate-desired>)
   (<duplicate-desireds> ^{ << preferred-desired avoid-desired >> <attribute> } <duplicate-desired>)
-->
   (<desireds> ^<attribute> <desired>)}

## Elaborate evaluate-operator copy-desired-self.
## Self, world-context and next-desireds: share the (read-only) structure
sp {agent-world*elaborate*evaluate-operator*copy-desired-self
   :default
   (state <s> ^name evaluate-operator ^desireds <desireds>)
   (<desireds> ^duplicate-of <duplicate-desireds> ^desired <desired>)
   (<desired> ^duplicate-of <duplicate-desired>)
   (<duplicate-desired> ^self <self>)
-->
   (<desired> ^self <self>)}

## Elaborate evaluate-operator copy-desireds-world-context-next.
sp {agent-world*elaborate*evaluate-operator*copy-desireds-world-context-next
   :default
   (state <s> ^name evaluate-operator ^desireds <desireds>)
   (<desireds> ^duplicate-of <duplicate-desireds>)
   (<duplicate-desireds> ^{ << world-context next-desireds >> <attribute> } <value>)
-->
   (<desireds> ^<attribute> <value>)}

## Elaborate evaluate-operator time copy lock-in.
sp {agent-world*elaborate*evaluate-operator*time*copy*lock-in
   :default
   (state <s> ^name evaluate-operator
              ^superstate.top-selection true
              ^world <new-world>)
   (<new-world> ^anchored-world true)
-->
   (<new-world> ^time 0)}

## Elaborate evaluate-operator time copy-not-from-super-state.
## If not in a look-ahead, but doing a deep copy, uses current time
## Copy time for superstate world
sp {agent-world*elaborate*evaluate-operator*time*copy-not-from-super-state
   :default
   (state <s> -^name evaluate-operator
               ^deep-copy-world true
               ^superstate.superstate.world.time <time>
               ^world <new-world>)
   (<new-world> ^anchored-world true)
-->
   (<new-world> ^time <time>)}

## Elaborate evaluate-operator time copy.
sp {agent-world*elaborate*evaluate-operator*time*copy
   :default
   (state <s> ^name evaluate-operator
             -^superstate.top-selection true
              ^superstate.superstate.world.time <time>
              ^world <new-world>)
   (<new-world> ^anchored-world true)
-->
   (<new-world> ^time <time>)}

## ---- operator application ----

## Apply evaluate-operator -> sets numeric-value, symbolic-value (the path cost: unit or time, see cost.soar).
sp {agent-world*apply*evaluate-operator*numeric-evaluation-return*path-cost
   :default
   (state <s> ^superstate <superstate>
              ^success.duplicate-of <desireds>
              ^world.path-cost $ <time>
             -^state-value
             -^flags.iterative-step cost
             -^cost-exceeded true
              ^flags.cost-metric << unit time >>)
   (<superstate> ^operator <super-operator>
                 ^evaluation <evaluation>)
   (<super-operator> ^name evaluate-operator
                     ^evaluation <evaluation>)
   (<evaluation> ^desireds <desireds>)
   (<evaluation> ^lower-bound $ <lower-bound>)   # v2.30: the chunk tests this bound literally (none: no cut-off below)
-->
   (log 1 (crlf) <evaluation> | Pass back numeric-value path-cost: | <time>)
   (<evaluation> ^numeric-value <time>
                 ^symbolic-value success)
}
## Apply evaluate-operator -> sets numeric-value, symbolic-value under cost-cap iteration (waits for the current cost-within-cap marker).
sp {agent-world*apply*evaluate-operator*numeric-evaluation-return*path-cost*cost-cap
   :default
   (state <s> ^superstate <superstate>
              ^success.duplicate-of <desireds>
              ^world.path-cost $ <time>
             -^state-value
              ^flags.iterative-step cost
              ^cost-within-cap true
             -^cost-exceeded true
              ^flags.cost-metric << unit time >>)
   (<superstate> ^operator <super-operator>
                 ^evaluation <evaluation>)
   (<super-operator> ^name evaluate-operator
                     ^evaluation <evaluation>)
   (<evaluation> ^desireds <desireds>)
   (<evaluation> ^lower-bound $ <lower-bound>)   # v2.30: the chunk tests this bound literally (none: no cut-off below)
-->
   (log 1 (crlf) <evaluation> | Pass back numeric-value path-cost: | <time>)
   (<evaluation> ^numeric-value <time>
                 ^symbolic-value success)
}

## Apply evaluate-operator -> sets numeric-value = net value, symbolic-value (a task that supplies ^state-value on the evaluate-operator state).
## net value = ^state-value - ^flags.cost-weight * ^world.path-cost. The task states ^better higher on ^desireds.
sp {agent-world*apply*evaluate-operator*numeric-evaluation-return*net-value
   :default
   (state <s> ^superstate <superstate>
              ^success.duplicate-of <desireds>
              ^world.path-cost <cost>
              ^state-value <value>
              ^flags.cost-metric << unit time >>
              ^flags.cost-weight <weight>)
   (<superstate> ^operator <super-operator>
                 ^evaluation <evaluation>)
   (<super-operator> ^name evaluate-operator
                     ^evaluation <evaluation>)
   (<evaluation> ^desireds <desireds>)
   (<evaluation> ^lower-bound $ <lower-bound>)   # v2.30: the chunk tests this bound literally (none: no cut-off below)
-->
   (log 1 (crlf) <evaluation> | Pass back numeric-value net value: | (- <value> (* <weight> <cost>)))
   (<evaluation> ^numeric-value (- <value> (* <weight> <cost>))
                 ^symbolic-value success)
}
