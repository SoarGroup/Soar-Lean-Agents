## ---- operator application ----

## Apply operator acheived-desired handle anchored-only -> sets achieved, unachieved.
sp {agent-world*apply*operator*acheived-desired*handle*anchored-only
   :default
   (state <s> ^operator.desireds <desireds>
              ^world.objects.object <object>)
   (<object> ^anchored true
             ^object-handle <handle>)
   (<desireds> ^desired <desired>)
   (<desired> ^object <desired-object>)
   (<desired-object> ^object-handle <handle>
                     ^anchored true
                    -^{ <> object-handle <> anchored })
-->
   (<desireds> ^achieved <desired>
               ^unachieved <desired> -)
}

## Apply operator acheived-desired handle -> sets achieved, unachieved.
sp {agent-world*apply*operator*acheived-desired*handle
   :default
   (state <s> ^operator.desireds <desireds>
              ^world.objects.object <object>)
   (<object> ^{ <> object-handle <> anchored  <> duplicate-of <desired-attribute>} <desired-value>
             ^anchored true
             ^object-handle <handle>)
   (<desireds> ^desired <desired>)
   (<desired> ^object <desired-object>)
   (<desired-object> ^{ <> object-handle  <> duplicate-of <desired-attribute>} <desired-value>
                     ^object-handle <handle>)
-->
   (<desireds> ^achieved <desired>
               ^unachieved <desired> -)
}

## Apply operator acheived-desired info -> sets achieved, unachieved, anchored-object.
sp {agent-world*apply*operator*acheived-desired*info
   :default
   (state <s> ^operator.desireds <desireds>
              ^world.info <info>)
   (<info> ^unanchored-object.object-handle <object-handle>
           ^anchored-object <anchored-object>)
   (<desireds> ^desired <desired>)
   (<desired> ^info <info2>)
   (<info2> ^unanchored-object.object-handle <object-handle>)
-->
   (<desireds> ^achieved <desired>
               ^unachieved <desired> -)
   (<info2> ^anchored-object <anchored-object>)
}

## Apply operator desired-count too-many.
## More than 6 desireds is an error
sp {agent-world*apply*operator*desired-count*too-many
   :default
   (state <s> ^operator <operator> +)
   (<operator> ^desireds <desireds>)
   (<desireds> ^desired-count { > 6 <n> })
-->
   (write (crlf) |ERROR: operator desireds | <desireds> | has desired-count | <n> |; agent-world counts at most 6 desireds.|)
   (interrupt)
}
