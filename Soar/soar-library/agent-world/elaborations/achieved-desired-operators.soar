## achieved-desired-operators.soar -- agent-world: 30 elaborations, 4 applications.

## ---- elaborations ----

## Elaborate operator acheived-all-next-desireds -> sets desireds.
## Operators next-desired
sp {agent-world*elaborate*operator*acheived-all-next-desireds
   :default
   :o-support
   (state <s> ^operator <operator> +)
   (<operator> ^desireds <desireds>)
   (<desireds> ^desired-count $ <count>
               ^achieved-desireds-count <count>
               ^unachieved-desireds-count 0
               ^next-desireds <next>)
-->
   (<operator> ^desireds <desireds> -
                         <next>)
}

## Elaborate operator pre-conditions-satisfied -> sets pre-conditions-satisfied.
## Operators pre-conditions
sp {agent-world*elaborate*operator*pre-conditions-satisfied
   :default
   :i-support
   (state <s> ^operator <operator> +)
   (<operator> ^desireds <desireds>)
   (<desireds> ^desired-count <count>
               ^achieved-desireds-count <count>
               ^unachieved-desireds-count 0
              -^next-desireds)
-->
   (<operator> ^pre-conditions-satisfied true)
}

## Elaborate operator desired-count0 achieved-0 -> sets achieved-desireds-count, unachieved-desireds-count.
## Need to handle the case where there are 0 desireds on an operator
## (Could be that there are only effect-desireds)
sp {agent-world*elaborate*operator*desired-count0*achieved-0
   :i-support
    :default
   (state <s> ^operator <operator> +)
   (<operator> ^desireds <desireds>)
   (<desireds> ^desired-count 0)
-->
   (<desireds> ^achieved-desireds-count 0
               ^unachieved-desireds-count 0)
}

## Elaborate operator desired-count1 achieved-1 -> sets achieved-desireds-count, unachieved-desireds-count.
## Operators
sp {agent-world*elaborate*operator*desired-count1*achieved-1
   :default
   :i-support
   (state <s> ^operator <operator> +)
   (<operator> ^desireds <desireds>)
   (<desireds> ^desired-count 1
               ^achieved <desired>)
-->
   (log 1 (crlf) |Success (1) : | <desireds>)
   (<desireds> ^achieved-desireds-count 1
               ^unachieved-desireds-count 0)
}

## Elaborate operator desired-count1 unachieved-1 -> sets unachieved-desireds-count, achieved-desireds-count.
sp {agent-world*elaborate*operator*desired-count1*unachieved-1
   :default
   :i-support
   (state <s> ^operator <operator> +)
   (<operator> ^desireds <desireds>)
   (<desireds> ^desired-count 1
               ^unachieved <desired>)
-->
   (<desireds> ^unachieved-desireds-count 1
               ^achieved-desireds-count 0)
}

