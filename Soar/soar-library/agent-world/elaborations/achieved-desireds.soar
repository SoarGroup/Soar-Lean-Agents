   (<desireds> ^achieved-desireds-count 2
               ^unachieved-desireds-count 8)
}

## Elaborate desired-count10 achieved-1 -> sets achieved-desireds-count, unachieved-desireds-count.
sp {agent-world*elaborate*desired-count10*achieved-1
   :default
   (state <s> ^<< desireds termination-desireds >> <desireds>)
   (<desireds> ^desired-count 10
               ^achieved <desired1>
               ^unachieved <desired2> { < <desired2> <desired3> } { < <desired3> <desired4> } { < <desired4> <desired5> } { < <desired5> <desired6> } { < <desired6> <desired7> } { < <desired7> <desired8> } { < <desired8> <desired9> } { < <desired9> <desired10> })
-->
   (<desireds> ^achieved-desireds-count 1
               ^unachieved-desireds-count 9)
}

## Elaborate desired-count10 achieved-0 -> sets achieved-desireds-count, unachieved-desireds-count.
sp {agent-world*elaborate*desired-count10*achieved-0
   :default
   (state <s> ^<< desireds termination-desireds >> <desireds>)
   (<desireds> ^desired-count 10
               ^unachieved <desired1> { < <desired1> <desired2> } { < <desired2> <desired3> } { < <desired3> <desired4> } { < <desired4> <desired5> } { < <desired5> <desired6> } { < <desired6> <desired7> } { < <desired7> <desired8> } { < <desired8> <desired9> } { < <desired9> <desired10> })
-->
   (<desireds> ^achieved-desireds-count 0
               ^unachieved-desireds-count 10)
}

## Elaborate unachieved-desireds-true -> sets unachieved-desireds.
sp {agent-world*elaborate*unachieved-desireds-true
   :default
   (state <s> ^<< desireds termination-desireds >> <desireds>)
   (<desireds> ^unachieved)
-->
   (<desireds> ^unachieved-desireds true)
}

## ---- operator application ----

## Apply desired-count too-many.
## More than 10 desireds is an error (v2.47: the limit was 6)
sp {agent-world*apply*desired-count*too-many
   :default
   (state <s> ^<< desireds termination-desireds >> <desireds>)
   (<desireds> ^desired-count { > 10 <n> })
-->
   (write (crlf) |ERROR: desireds | <desireds> | has desired-count | <n> |; agent-world counts at most 10 desireds.|)
   (interrupt)
}
