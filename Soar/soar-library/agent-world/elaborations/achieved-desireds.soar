## achieved-desireds.soar -- agent-world: 38 elaborations, 1 application.

## ---- elaborations ----

## Elaborate state achieved-desired disjunction -> sets achieved.
sp {agent-world*elaborate*state*achieved-desired*disjunction
   :default
   (state <s> ^desireds <desireds>)
   (<desireds> ^desired <desired1> {<> <desired1> <desired2> }
               ^achieved <desired1>)
   (<desired1> ^disjunction <desired2>)
-->
   (<desireds> ^achieved <desired2>)
}

## Elaborate state achieved-desired abstract-property -> sets achieved.
sp {agent-world*elaborate*state*achieved-desired*abstract-property
   :default
   (state <s> ^desireds <desireds>
              ^world.abstract-property <abstract-property>)
   (<desireds> ^desired <desired>)
   (<desired> ^object <object>)
   (<object> ^<abstract-property> <desired-value>)
-->
   (<desireds> ^achieved <desired>)
}

## Elaborate state unachieved-desired-origin -> sets unachieved.
sp {agent-world*elaborate*state*unachieved-desired-origin
   :default
   (state <s> ^desireds <desireds>
             -^world.abstract-property)
   (<desireds> ^desired <desired>)
   (<desired> ^object <desired-object>)
   (<desired-object> ^{ <> object-handle <> duplicate-of <> anchored <> origin-object-handle <desired-attribute>} <desired-value>
                     ^origin-object-handle <handle>)
  -{(<s> ^world.objects.object <object>)
    (<object> ^<desired-attribute> <desired-value>
              ^<< object-handle origin-object-handle >> <handle>
              ^anchored true)}
  -(<desireds> ^achieved <desired>)
-->
   (<desireds> ^unachieved <desired>)
}

## Elaborate state unachieved-desired abstract-property -> sets unachieved.
sp {agent-world*elaborate*state*unachieved-desired*abstract-property
   :default
   (state <s> ^desireds <desireds>
              ^world.abstract-property <abstract-property>)
   (<desireds> ^desired <desired>)
   (<desired> ^object <desired-object>)
   (<desired-object> ^{ <> object-handle <> duplicate-of <> anchored <> origin-object-handle <> <abstract-property> <desired-attribute>} <desired-value>
                     ^object-handle <handle>)
  -{(<s> ^world.objects.object <object>)
    (<object> ^<desired-attribute> <desired-value>
              ^<< object-handle origin-object-handle >>  <handle>
              ^anchored true)}
                       -{(<desireds> ^achieved <desired>)}
-->
   (<desireds> ^unachieved <desired>)
}

## Elaborate state achieved-desired info -> sets achieved.
sp {agent-world*elaborate*state*achieved-desired*info
   :default
   (state <s> ^desireds <desireds>
              ^world.info <info>)
   (<info> ^unanchored-object.object-handle <object-handle>
           ^anchored-object)
   (<desireds> ^desired <desired>)
   (<desired> ^info <info2>)
   (<info2> ^unanchored-object.object-handle <object-handle>)
-->
   (<desireds> ^achieved <desired>)
}

## Elaborate state unachieved-desired info -> sets unachieved.
sp {agent-world*elaborate*state*unachieved-desired*info
   :default
   (state <s> ^desireds <desireds>)
  -{(<s> ^world.info <info>)
    (<info> ^unanchored-object.object-handle <object-handle>
            ^anchored-object <anchored-object>)}
   (<desireds> ^desired <desired>)
   (<desired> ^info <info>)
   (<info> ^unanchored-object.object-handle <object-handle>)
  -{(<desireds> ^achieved <desired>)}
-->
   (<desireds> ^unachieved <desired>)
}

## Elaborate state unachieved-desired learn task-goal achieved -> sets achieved.
## Achieved when there is a learning-event matching the type and task
sp {agent-world*elaborate*state*unachieved-desired*learn*task-goal*achieved
   :default
   (state <s> ^desireds <desireds>
              ^events <events>)
   (<desireds> ^desired <desired>)
   (<desired> ^learn task-goal
              ^task <task>)
   (<events> ^learning-event <event>)
   (<event> ^type task-goal
            ^task <task>)
-->
   (<desireds> ^achieved <desired>)
}

## Elaborate state unachieved-desired learn task-goal unachieved -> sets unachieved.
sp {agent-world*elaborate*state*unachieved-desired*learn*task-goal*unachieved
   :default
   (state <s> ^desireds <desireds>
              ^events <events>)
   (<desireds> ^desired <desired>)
   (<desired> ^learn task-goal
              ^task <task>)
  -{(<events> ^learning-event <event>)
    (<event> ^type task-goal
             ^task <task>)}
-->
   (<desireds> ^unachieved <desired>)
}

## Elaborate state unachieved-desired executed-action achieved -> sets achieved.
## Desired: executed-action
## Achieved when the output link command is successful
sp {agent-world*elaborate*state*unachieved-desired*executed-action*achieved
   :default
   (state <s> ^desireds <desireds>
              ^events <events>)
   (<desireds> ^desired <desired>)
   (<desired> ^executed-action <action>)
   (<action> ^action-handle <action-handle>)
   (<events> ^executed-action <event>)
   (<event> ^action-handle <action-handle>)
-->
   (<desireds> ^achieved <desired>)
}

## Elaborate state unachieved-desired executed-action unachieved -> sets unachieved.
sp {agent-world*elaborate*state*unachieved-desired*executed-action*unachieved
   :default
   (state <s> ^desireds <desireds>
              ^events <events>)
   (<desireds> ^desired <desired>)
   (<desired> ^executed-action <action>)
   (<action> ^action-handle <action-handle>)
  -{(<events> ^executed-action <event>)
    (<event> ^action-handle <action-handle>)}
  -{(<desireds> ^achieved <desired>)}
-->
   (<desireds> ^unachieved <desired>)
}

## Elaborate desired-count1 achieved-1 -> sets success, achieved-desireds-count, unachieved-desireds-count.
## States
sp {agent-world*elaborate*desired-count1*achieved-1
   :default
   (state <s> ^desireds <desireds>)
   (<desireds> ^desired-count 1
               ^achieved <desired>)
-->
   (log 1 (crlf) |Success (1) : | <desireds>)
   (<s> ^success <desireds>)
   (<desireds> ^achieved-desireds-count 1
               ^unachieved-desireds-count 0)
}

