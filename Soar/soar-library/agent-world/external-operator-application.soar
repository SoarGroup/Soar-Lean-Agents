## Apply operator external, 0 arguments, command named by the form, action handle under its name attribute.
sp {agent-world*apply*operator*external*argument0*named
   :default
   (state <s> ^operator <operator>
              ^quiescence t
              ^internal-actions false
              ^io.output-link <output>)
   (<operator> ^name <operator-name>
               ^action-handle <action-handle>
               ^pre-conditions-satisfied true
               ^argument-count 0
               ^output-form <form>)
   (<form> ^command <command>
        ^name-attribute <name-attribute>)
-->
   (log 1 (crlf) |Apply | <operator-name> |, action: | <action-handle> |: external.|)
   (<output> ^<command> <c>)
   (<c> ^<name-attribute> <action-handle>)
}

## Apply operator external, 1 argument, command named by the form, action handle under its name attribute.
sp {agent-world*apply*operator*external*argument1*named
   :default
   (state <s> ^operator <operator>
              ^quiescence t
              ^internal-actions false
              ^io.output-link <output>)
   (<operator> ^name <operator-name>
               ^action-handle <action-handle>
               ^pre-conditions-satisfied true
               ^argument-count 1
               ^output-form <form>
               ^output-argument1 <v1>)
   (<form> ^command <command>
        ^name-attribute <name-attribute>
        ^argument1 <a1>)
-->
   (log 1 (crlf) |Apply | <operator-name> |: | <v1> |, action: | <action-handle> | external.|)
   (<output> ^<command> <c>)
   (<c> ^<name-attribute> <action-handle> ^<a1> <v1>)
}

