## Apply operator external report action-event success -> sets executed-action, action-handle.
## If the selected operator's output command reports the map's success status, report an executed-action event.
sp {agent-world*apply*operator*external*report*action-event*success
   :default
   (state <s> ^operator <operator>
              ^internal-actions false
              ^interaction-stack.top-segment <> nil
              ^io.output-link <output>
              ^external-top-state.output-map <m>
              ^events <events>)
   (<operator> ^name <operator-name>
               ^action-handle <action-handle>)
   (<m> ^command <command>
        ^name-attribute <name-attribute>
        ^success-status <status>)
   (<output> ^<command> <perform>)
   (<perform> ^<name-attribute> <action-handle>
              ^status <status>)
-->
   (<events> ^executed-action <action>)
   (<action> ^action-handle <action-handle>)
}

## Apply operator external report action-event success, command named by the action handle.
sp {agent-world*apply*operator*external*report*action-event*success*action-handle
   :default
   (state <s> ^operator <operator>
              ^internal-actions false
              ^interaction-stack.top-segment <> nil
              ^io.output-link <output>
              ^external-top-state.output-map <m>
              ^events <events>)
   (<operator> ^name <operator-name>
               ^action-handle <action-handle>
               ^output-form.command-is-action-handle true)
   (<m> ^success-status <status>)
   (<output> ^<action-handle> <perform>)
   (<perform> ^status <status>)
-->
   (<events> ^executed-action <action>)
   (<action> ^action-handle <action-handle>)
}

## Apply operator external report failed-action event -> sets failed-action, action-handle.
## If an output command reports one of the map's error statuses, report a failed-action event and interrupt.
sp {agent-world*apply*operator*external*report*failed-action*event
   :default
   (state <s> ^operator <operator>
              ^internal-actions false
             -^interaction-stack.top-segment nil
              ^io.output-link <output>
              ^external-top-state.output-map <m>
              ^events <events>)
   (<operator> ^name <operator-name>
               ^action-handle <action-handle>)
   (<m> ^error-status <status>)
   (<output> ^<command> <perform>)
   (<perform> ^status <status>)
-->
   (interrupt)
   (<events> ^failed-action <failure>)
   (<failure> ^action-handle <action-handle>)
}
