## external-operator-application.soar -- agent-world: 8 elaborations, 11 applications.
## v2.47: environment-neutral output (World-Conventions L10-002). A selected task operator with ^action-handle, applied
## externally, is written to the output-link in the form the top state's ^output-map gives (see
## elaborations/output.soar): either (<output-link> ^<command> <c>) (<c> ^<name-attribute> <action-handle> ^<attr1> <h1>
## ...), or, with ^command-is-action-handle true, (<output-link> ^<action-handle> <c>) (<c> ^<attr1> <h1> ...). An
## argument is written as its object handle, or as itself when it is not an object. A map with ^rules environment leaves
## application to the environment's own rules (Thor-Soar: thor-soar/external-operator-application.soar).

## Elaborate operator output-form: the form for this action, from the output map (World-Conventions L10-002).
## The map's own fields are the form unless it has an entry (^action) for this action handle.
sp {agent-world*elaborate*operator*output-form*map
   :default
   (state <s> ^operator <operator>
              ^internal-actions false
              ^io
              ^external-top-state.output-map <m>)
   (<operator> ^action-handle <action-handle>)
   (<m> -^rules environment
        -^action.action-handle <action-handle>)
-->
   (<operator> ^output-form <m>)
}

## Elaborate operator output-form: the map's entry for this action handle.
sp {agent-world*elaborate*operator*output-form*action
   :default
   (state <s> ^operator <operator>
              ^internal-actions false
              ^io
              ^external-top-state.output-map <m>)
   (<operator> ^action-handle <action-handle>)
   (<m> -^rules environment
         ^action <a>)
   (<a> ^action-handle <action-handle>)
-->
   (<operator> ^output-form <a>)
}

## Elaborate operator output-argument1: the object handle of argument1, or argument1 itself when it is not an object.
sp {agent-world*elaborate*operator*output-argument1*handle
   :default
   (state <s> ^operator <operator>)
   (<operator> ^output-form <form>
               ^argument1.object-handle <h>)
-->
   (<operator> ^output-argument1 <h>)
}

sp {agent-world*elaborate*operator*output-argument1*value
   :default
   (state <s> ^operator <operator>)
   (<operator> ^output-form <form>
               ^argument1 <v>)
   (<v> -^object-handle)
-->
   (<operator> ^output-argument1 <v>)
}

