   (<output> ^<command> <c>)
   (<c> ^<name-attribute> <action-handle> ^<a1> <v1> ^<a2> <v2>)
}

## Apply operator external, 3 arguments, command named by the form, action handle under its name attribute.
sp {agent-world*apply*operator*external*argument3*named
   :default
   (state <s> ^operator <operator>
              ^quiescence t
              ^internal-actions false
              ^io.output-link <output>)
   (<operator> ^name <operator-name>
               ^action-handle <action-handle>
               ^pre-conditions-satisfied true
               ^argument-count 3
               ^output-form <form>
               ^output-argument1 <v1>
               ^output-argument2 <v2>
               ^output-argument3 <v3>)
   (<form> ^command <command>
        ^name-attribute <name-attribute>
        ^argument1 <a1>
        ^argument2 <a2>
        ^argument3 <a3>)
-->
   (log 1 (crlf) |Apply | <operator-name> |: | <v1> |, | <v2> |, | <v3> |, action: | <action-handle> | external.|)
   (<output> ^<command> <c>)
   (<c> ^<name-attribute> <action-handle> ^<a1> <v1> ^<a2> <v2> ^<a3> <v3>)
}

## Apply operator external, 0 arguments, command named by the action handle.
sp {agent-world*apply*operator*external*argument0*action-handle
   :default
   (state <s> ^operator <operator>
              ^quiescence t
              ^internal-actions false
              ^io.output-link <output>)
   (<operator> ^name <operator-name>
               ^action-handle <action-handle>
               ^pre-conditions-satisfied true
               ^argument-count 0
               ^output-form <form>)
   (<form> ^command-is-action-handle true)
-->
   (log 1 (crlf) |Apply | <operator-name> |, action: | <action-handle> |: external.|)
   (<output> ^<action-handle> <c>)
}

