## elaborations.soar -- agent-world: 12 elaborations.

## Elaborate substate super-operator attributes.
sp {agent-world*elaborate*substate*super-operator*attributes
   "Elaborate substates with super-operator attributes."
   :default
   (state <s> ^impasse no-change
              ^attribute operator
              ^superstate.operator.{ <> desireds <> superstate <> current-evaluation-depth <> termination-desireds <> repeat-count <attribute> } <value>)
-->
   (<s> ^<attribute> <value>)
}

## Elaborate substate scene -> sets sce.
sp {agent-world*elaborate*substate*scene
   "Elaborate substates with scene."
   :default
   (state <s> ^impasse no-change
              ^attribute operator
              ^superstate.scene <scene>)
-->
   (<s> ^scene <scene>)
}

## Elaborate operator-implementation-substate super-operator-problem-space -> sets problem-space.
## Not an MEA substate - an operator implementation substate
sp {agent-world*elaborate*operator-implementation-substate*super-operator-problem-space
   :default
   (state <s> ^name <name>
              ^superstate.operator <so>)
   (<so> ^name <name>
         ^pre-conditions-satisfied true)  # This indicates it is an operator implementation substate
-->
   (<s> ^problem-space.name <name>)
}

## Elaborate operator-implementation-substate super-operator-desireds -> sets desireds, copied-from, better.
sp {agent-world*elaborate*operator-implementation-substate*super-operator-desireds
   :default
   (state <s> ^superstate <ss>
              ^impasse no-change
              ^attribute operator)
   (<ss> ^operator <sso>)
   (<sso> ^pre-conditions-satisfied true
          ^effect-desireds <effect-desireds>)
  -{(<ss> ^operator-progress <progress>)
    (<progress> ^operator <sso>)}
-->
   (<s> ^desireds <desireds>)
   (<desireds> ^copied-from <effect-desireds>)
}

## Elaborate operator-implementation-substate desireds from operator-progress -> sets desireds, copied-from,
## phase-copy, pass.
## After the first phase change the current phase is recorded on the superstate (next-desireds.soar); the
## substate's desireds are a copy of that phase, new for each phase and each pass (L8-026, L8-027).
sp {agent-world*elaborate*operator-implementation-substate*operator-progress*desireds
   :default
   (state <s> ^superstate <ss>
              ^impasse no-change
              ^attribute operator)
   (<ss> ^operator <sso>
         ^operator-progress <progress>)
   (<sso> ^pre-conditions-satisfied true)
   (<progress> ^operator <sso>
               ^phase <template>
               ^pass <pass>)
-->
   (<s> ^desireds <desireds>)
   (<desireds> ^copied-from <template>
               ^phase-copy true
               ^pass <pass>)
}

## Elaborate operator-implementation-substate repeat-count -> from the super-operator until the first
## phase change (L8-029).
sp {agent-world*elaborate*operator-implementation-substate*repeat-count
   :default
   (state <s> ^superstate <ss>
              ^impasse no-change
              ^attribute operator)
   (<ss> ^operator <sso>)
   (<sso> ^pre-conditions-satisfied true
          ^repeat-count <count>)
  -{(<ss> ^operator-progress <progress>)
    (<progress> ^operator <sso>)}
-->
   (<s> ^repeat-count <count>)
}

## Elaborate operator-implementation-substate repeat-count -> from operator-progress after it.
sp {agent-world*elaborate*operator-implementation-substate*operator-progress*repeat-count
   :default
   (state <s> ^superstate <ss>
              ^impasse no-change
              ^attribute operator)
   (<ss> ^operator <sso>
         ^operator-progress <progress>)
   (<progress> ^operator <sso>
               ^repeat-count <count>)
-->
   (<s> ^repeat-count <count>)
}

## Elaborate operator-implementation-substate desireds better -> the orientation of numeric values (^better) of the superstate's desireds (v2.45;
## before, ^better lower was set unconditionally).
sp {agent-world*elaborate*operator-implementation-substate*super-operator-desireds*better
   :default
   (state <s> ^superstate <ss>
              ^impasse no-change
              ^attribute operator
              ^desireds <desireds>)
   (<desireds> ^copied-from <effect-desireds>)
   (<ss> ^desireds.better <better>)
-->
   (<desireds> ^better <better>)
}

## Elaborate operator-implementation-substate desireds better lower -> ^better lower when the superstate's desireds state no orientation
## (a cost metric is minimized by default).
sp {agent-world*elaborate*operator-implementation-substate*super-operator-desireds*better*default
   :default
   (state <s> ^superstate <ss>
              ^impasse no-change
              ^attribute operator
              ^desireds <desireds>)
   (<desireds> ^copied-from <effect-desireds>)
   (<ss> ^desireds <ss-desireds>)
  -(<ss-desireds> ^better)
-->
   (<desireds> ^better lower)
}

## Elaborate operator-implementation-substate super-operator-desireds copy.
sp {agent-world*elaborate*operator-implementation-substate*super-operator-desireds*copy
   :default
   (state <s> ^desireds <desireds>
              ^superstate.operator.effect-desireds <effect-desireds>)
   (<desireds> ^copied-from <effect-desireds>)
   (<effect-desireds> ^{ <> achieved <> unachieved <> achieved-desireds-count
                         <> unachieved-desireds-count <> unachieved-desireds
                         <> better <attribute> } <value>)
-->
   (<desireds> ^<attribute> <value>)
}

## Elaborate operator-implementation-substate termination-desireds -> sets termination-desireds, copied-from.
## The substate holds its own copy of the super-operator's termination desireds, so that their achievement
## is marked locally and does not become a result (L8-028).
sp {agent-world*elaborate*operator-implementation-substate*termination-desireds
   :default
   (state <s> ^superstate.operator <sso>
              ^impasse no-change
              ^attribute operator)
   (<sso> ^pre-conditions-satisfied true
          ^termination-desireds <super-termination>)
-->
   (<s> ^termination-desireds <termination>)
   (<termination> ^copied-from <super-termination>)
}

## Elaborate operator-implementation-substate termination-desireds copy.
sp {agent-world*elaborate*operator-implementation-substate*termination-desireds*copy
   :default
   (state <s> ^termination-desireds <termination>
              ^superstate.operator.termination-desireds <super-termination>)
   (<termination> ^copied-from <super-termination>)
   (<super-termination> ^{ <> achieved <> unachieved <> achieved-desireds-count
                           <> unachieved-desireds-count <> unachieved-desireds <attribute> } <value>)
-->
   (<termination> ^<attribute> <value>)
}
