## find-object.soar -- object-world: 2 elaborations, 6 proposals, 9 compares, 5 applications.

## ---- elaborations ----

## Elaborate find-object object mea -> sets argument1.
sp {object-world*elaborate*find-object*object*mea
   :default
   (state <s>
              ^desireds <desireds>
              ^operator <operator> +)
   (<operator> ^name find-object
               ^argument1 <argument1>
               ^argument2 <unanchored-object>)
   (<desireds> ^desired.object { <desired-unanchored-object> <> <argument1> })  ## In the desired
   (<desired-unanchored-object> ^object-handle <unachored-object-handle>)
   (<unanchored-object> ^<< origin-object-handle object-handle >> <unachored-object-handle>)  ## is not anchored
-->
   (<operator> ^argument1 <desired-unanchored-object>)
}

## Elaborate find-object object effect-desired -> sets argument1.
## Operator Effect-desireds - probably should have copied down to be similar to desireds
sp {object-world*elaborate*find-object*object*effect-desired
   :default
   (state <s>
              ^superstate.operator.effect-desireds <desireds>
              ^operator <operator> +)
   (<operator> ^name find-object
               ^argument1 <argument1>
               ^argument2 <unanchored-object>)
   (<desireds> ^desired.object { <desired-unanchored-object> <> <argument1> })  ## In the desired
   (<desired-unanchored-object> ^object-handle <unachored-object-handle>)
   (<unanchored-object> ^<< origin-object-handle object-handle >> <unachored-object-handle>)  ## is not anchored
-->
   (<operator> ^argument1 <desired-unanchored-object>)
}

## ---- operator proposal ----

## Propose find-object.
sp {object-world*propose*find-object*object-handle*unknown*mea
   :default
   (state <s>
              ^desireds <desireds>)
  -{(<s> ^world.objects.object <object>)
    (<object> ^object-handle <anchored-object-handle>
             -^origin-object-handle <anchored-object-handle>)}
  -(<s> ^world.objects.object.origin-object-handle <anchored-object-handle>)
  -(<s> ^world.future-event.argument1.<< origin-object-handle object-handle >> <anchored-object-handle>)
   (<desireds> ^desired <desired>
               ^unachieved <desired>)
   (<desired> ^object <desired-anchored-object>)  ## In the desired
   (<desired-anchored-object> ^object-handle <anchored-object-handle>
                             -^failed-grounding true)
-->
   (<s> ^operator <operator> +)
   (<operator> ^name find-object
               ^super-desired <desired>
               ^argument1 <desired-anchored-object> # world object
               ^argument-count 1
               ^desireds <desireds2>
               ^mode a)
   (<desireds2> ^desired.info.unanchored-object <desired-anchored-object>     # object that isn't anchored in world-context
                ^desired-count 1)
}

## Propose find-object.
sp {object-world*propose*find-object*object-handle*unknown*mea*origin*anchored
   :default
   (state <s>
              ^desireds <desireds>
              ^world <world>)
   (<world> ^anchored-world true
            ^objects.object <object>
           -^future-event.argument1.<< origin-object-handle object-handle >> <anchored-object-handle>)
   (<object> -^object-handle <anchored-object-handle>
              ^origin-object-handle <anchored-object-handle>)
   (<desireds> ^desired <desired>
               ^unachieved <desired>)
   (<desired> ^object <desired-anchored-object>)  ## In the desired
   (<desired-anchored-object> ^object-handle <anchored-object-handle>
                             -^failed-grounding true)
-->
   (<s> ^operator <operator> +)
   (<operator> ^name find-object
               ^super-desired <desired>
               ^argument1 <desired-anchored-object> # world object
               ^argument-count 1
               ^desireds <desireds2>)
   (<desireds2> ^desired.info <info>
                ^desired-count 1)
   (<info> ^unanchored-object <desired-anchored-object>
           ^anchored-object <object>)# object that isn't anchored in world-context
}

## Propose find-object.
sp {object-world*propose*find-object*object-handle*unknown*mea*origin
   :default
   (state <s>
              ^desireds <desireds>
              ^world <world>)
   (<world> -^anchored-world true
             ^objects.object <object>)
   (<object> -^object-handle <anchored-object-handle>
              ^origin-object-handle <anchored-object-handle>)
   (<desireds> ^desired <desired>
               ^unachieved <desired>)
   (<desired> ^object <desired-anchored-object>)  ## In the desired
   (<desired-anchored-object> ^object-handle <anchored-object-handle>
                             -^failed-grounding true)
  -{(<s> ^world <world2>)
    (<world2> ^anchored-world true
              ^objects.object.origin-object-handle <anchored-object-handle>)} # should not be used if the one above can be.
-->
   (<s> ^operator <operator> +)
   (<operator> ^name find-object
               ^super-desired <desired>
               ^argument1 <desired-anchored-object> # world object
               ^argument-count 1
               ^desireds <desireds2>
               ^mode b)
   (<desireds2> ^desired.info.unanchored-object <desired-anchored-object>     # object that isn't anchored in world-context
                ^desired-count 1)
}

## Propose find-object.
sp {object-world*propose*find-object*object-handle*unknown*holding-object*mea
   :default
   (state <s>
           #  -^external-top-state.scene.objects.object.object-handle <anchored-object-handle>
              ^desireds <desireds>)
  -{(<s> ^world <world1>)
    (<world1> ^objects.object.object-handle <anchored-object-handle>)}
   (<desireds> ^desired <desired>
               ^unachieved <desired>)
   (<desired> ^holding-object <desired-anchored-object>)  ## In the desired
   (<desired-anchored-object> ^object-handle { <> none <anchored-object-handle> }
                             -^failed-grounding true)
-->
   (<s> ^operator <operator> +)
   (<operator> ^name find-object
               ^super-desired <desired>
               ^argument1 <desired-anchored-object> # world object
               ^argument-count 1
               ^desireds <desireds2>)
   (<desireds2> ^desired.info.unanchored-object <desired-anchored-object>     # object that isn't anchored in world-context
                ^desired-count 1)
}

## Propose find-object.
## unanchored
sp {object-world*propose*find-object*object*mea
   :default
   (state <s>
              ^world <world>
              ^desireds <desireds>)
   (<world> ^objects.object <unanchored-object>
                            )#^anchored-world true)     ## Bug? does it have to be anchored?
   (<desireds> ^desired <desired>
               ^unachieved <desired>)
   (<desired> ^object <desired-unanchored-object>)  ## In the desired
   (<desired-unanchored-object> ^object-handle <unanchored-object-handle>
                               -^failed-grounding true)
   (<unanchored-object> ^<< origin-object-handle object-handle >> <unanchored-object-handle>  ## is not anchored
                        ^anchored false)
-->
   (<s> ^operator <operator> +)
   (<operator> ^name find-object
               ^super-desired <desired>
               ^argument1 <desired-unanchored-object>           # desired unanchored object
               ^argument2 <unanchored-object> # world unanchored object
               ^argument-count 2
               ^desireds <desireds2>)
   (<desireds2> ^desired.info.unanchored-object <unanchored-object>     # object that isn't anchored in world-context
                ^desired-count 1)
}

## Propose find-object.
sp {object-world*propose*find-object*holding*mea
   :default
   (state <s>
              ^world <world>
              ^desireds <desireds>)
   (<world> ^objects.object <unanchored-object>)
   (<desireds> ^desired <desired>
               ^unachieved <desired>)
   (<desired> ^holding-object <desired-unanchored-object>)  ## In the desired
   (<desired-unanchored-object> ^object-handle <unachored-object-handle>
                               -^failed-grounding true)
   (<unanchored-object> ^<< origin-object-handle object-handle discarded >> <unachored-object-handle>  ## is not anchored
                        ^anchored false)
-->
   (<s> ^operator <operator> +)
   (<operator> ^name find-object
               ^super-desired <desired>
               ^argument1 <desired-unanchored-object>           # desired unanchored object
               ^argument2 <unanchored-object>            # world unanchored object
               ^argument-count 2
               ^desireds <desireds2>)
   (<desireds2> ^desired.info.unanchored-object <unanchored-object>    # object that isn't anchored in world-context
                ^desired-count 1)
}

## ---- evaluate / compare ----

## Preference for find-object.
sp {object-world*compare*find-object
    :default
   (state <s> ^operator <op1> +
                        { <> <op1> <op2> }  +)
   (<op1> ^name find-object
          ^mode a)
   (<op2> ^name find-object
          ^mode b)
-->
   (<s> ^operator <op1> > <op2>)
}

## Preference for find-object2.
sp {object-world*compare*find-object2
   :default
   (state <s> ^operator <op1> +
                        { < <op1> <op2> }  +)
   (<op1> ^name find-object)
   (<op2> ^name find-object)
-->
   (<s> ^operator <op1> = <op2>)
}

## Preference for find-object worse.
sp {object-world*compare*find-object*worse
   :default
   (state <s> ^operator <op1> +
                        { <> <op1> <op2> }  +)
   (<op1> ^name { <> find-object <> find-object-direct }
          ^argument2.anchored false)
   (<op2> ^name find-object)
-->
   (<s> ^operator <op1> < <op2>)
}

## Preference for find-object worse1.
sp {object-world*compare*find-object*worse1
   :default
   (state <s> ^operator <op1> +
                        { <> <op1> <op2> }  +)
   (<op1> ^name find-object
         -^argument2.anchored true)
   (<op2> ^name find-object
          ^argument2.anchored true)
-->
   (<s> ^operator <op1> < <op2>)
}

## Preference for find-object reject-other.
## New - made so doesn't apply in top state
sp {object-world*compare*find-object*reject-other
   :default
   (state <s> ^operator <op1> +
                        { <> <op1> <op2> }  +
              ^world.info.unanchored-object.object-handle <un-object-handle>
             -^desireds.failed-grounding-desired.object.object-handle <un-object-handle>)
   (<op1> ^name { <> find-object <> find-object-direct })
   (<op2> ^name find-object
          ^argument1.object-handle <un-object-handle>
          ^argument2.object-handle <un-object-handle>)
-->
   (<s> ^operator <op1> -)
}

## Preference for find-object worse operator-grounded argument12-grounded.
sp {object-world*compare*find-object*worse*operator-grounded*argument12-grounded
   :default
   (state <s> ^operator <op1> +
                        { <> <op1> <op2> }  +)
   (<op1> ^argument1.anchored true
          ^argument2.anchored true
          ^name <> find-object)
   (<op2> ^name find-object)
-->
   (<s> ^operator <op1> > <op2>)
}

## Preference for find-object worse operator-grounded argument1-grounded.
sp {object-world*compare*find-object*worse*operator-grounded*argument1-grounded
   :default
   (state <s> ^operator <op1> +
                        { <> <op1> <op2> }  +)
   (<op1> ^argument1.anchored true
         -^argument2
          ^name <> find-object)
   (<op2> ^name find-object)
-->
   (<s> ^operator <op1> > <op2>)
}

## Preference for find-object worse operator-doesnt-need.
## If have operator proposed that is using a grounded version of the object find-object is trying to ground, let that go ahead
sp {object-world*compare*find-object*worse*operator-doesnt-need
   :default
   (state <s> ^operator <op1> +
                        { <> <op1> <op2> }  +)
   (<op1> ^<< argument1 argument2 >> <argument1>
          ^name <> find-object)
   (<argument1> ^object-handle <object-handle>
                ^anchored true)
   (<op2> ^name find-object
          ^argument1 <argument1x>)
   (<argument1x> ^<< object-handle origin-object-handle >> <object-handle>)
-->
   (<s> ^operator <op1> > <op2>)
}

## Preference for reject find-object future-event.
sp {object-world*compare*reject*find-object*future-event
   :default
   (state <s> ^operator <op1> +
              ^world.future-event.argument1.<< origin-object-handle object-handle >> <object-handle>)
   (<op1> ^name find-object
          ^argument1.object-handle <object-handle>)
-->
   (<s> ^operator <op1> -)
}

## ---- operator application ----

## Apply find-object -> sets processed, info, object-handle ....
sp {object-world*apply*find-object*object-found
   :default
   (state <s> ^operator <operator>
              ^world <world>)
   (<world> ^info <info>
            ^objects <objects>)
   (<objects> ^object <unanchored-object>)
   (<info> ^unanchored-object <unanchored-object2>
           ^anchored-object <anchored-object>)
   (<anchored-object> ^object-handle $ <new-object-handle>  ## new
                     -^fake true
                      ^anchored true)
   (<operator> ^name find-object
               ^pre-conditions-satisfied true
               ^argument1 <desired-unanchored-object>
               ^argument2 { <> <desired-unanchored-object> <unanchored-object> })
   (<desired-unanchored-object> ^object-handle { <> <new-object-handle> <unanchored-object-handle> })
   (<unanchored-object> ^object-handle <unanchored-object-handle>)
   (<unanchored-object2> ^object-handle <unanchored-object-handle>)
-->
   (log 1 (crlf) |Apply find-object object: | <new-object-handle> | anchors and replaces | <unanchored-object-handle>)
   (<world> ^processed true
            ^info <info> -)
   (<desired-unanchored-object> ^object-handle <unanchored-object-handle> -
                                               <new-object-handle>
                                ^anchored false -
                                          true)
}

## Apply find-object -> sets processed, info, object-handle ....
sp {object-world*apply*find-object*object-found-arg1
   :default
   (state <s> ^operator <operator>
              ^world <world>)
   (<world> ^info <info>
            ^objects <objects>)
   (<objects> ^object <anchored-object>)
   (<info> ^unanchored-object <unanchored-object>
           ^anchored-object <anchored-object>)
   (<anchored-object> ^object-handle $ <new-object-handle> ## new
                     -^fake true
                      ^anchored true)
   (<operator> ^name find-object
               ^pre-conditions-satisfied true
               ^argument1 <desired-unanchored-object>
              -^argument2)
   (<desired-unanchored-object> ^object-handle { <> <new-object-handle> <unanchored-object-handle> })
   (<unanchored-object> ^object-handle <unanchored-object-handle>)
-->
   (log 1 (crlf) |Apply find-object object: | <new-object-handle> | anchors and replaces | <unanchored-object-handle>)
   (<world> ^processed true
            ^info <info> -)
   (<desired-unanchored-object> ^object-handle <unanchored-object-handle> -
                                               <new-object-handle>
                                ^anchored false -
                                          true)
}

## Apply find-object -> sets processed, info, object-handle.
sp {object-world*apply*find-object*object-found*imaginary
   :default
   (state <s> ^operator <operator>
              ^world <world>)
   (<world> ^info <info>)
   (<info> ^unanchored-object <unanchored-object>
           ^anchored-object <anchored-object>)
   (<anchored-object> ^object-handle <new-object-handle>
                      ^anchored true
                      ^fake true)
   (<operator> ^name find-object
               ^pre-conditions-satisfied true
               ^argument1 <desired-unanchored-object>
               ^argument2 <unanchored-object2>)
   (<desired-unanchored-object> ^object-handle { <> <new-object-handle> <unanchored-object-handle> })
   (<unanchored-object> ^object-handle <unanchored-object-handle>)
   (<unanchored-object2> ^object-handle <unanchored-object-handle>)
-->
   (log 1 (crlf) |Apply find-object object: | <new-object-handle> | anchors and replaces | <unanchored-object-handle>)
   (<world> ^processed true
            ^info <info> -)
   (<desired-unanchored-object> ^object-handle <unanchored-object-handle> -
                                               <new-object-handle>)
}

## Apply find-object -> sets info, object-handle, anchored.
sp {object-world*apply*find-object*object-found*super-desireds*object
   :default
   (state <s> ^operator <operator>
              ^super-desireds.desired.object <desired-object>
             -^super-desireds.desired.holding-object.object-handle <unanchored-object-handle>
              ^world <world>)
   (<desired-object> ^object-handle { <> <new-object-handle> <unanchored-object-handle> })
   (<world> ^info <info>
            ^objects <objects>)
   (<objects> ^object <unanchored-object>)
   (<info> ^unanchored-object <unanchored-object>
           ^anchored-object <anchored-object>)
   (<anchored-object> ^object-handle $ <new-object-handle>
                      ^anchored true)
   (<operator> ^name find-object
               ^pre-conditions-satisfied true
               ^argument2 <unanchored-object>)
   (<unanchored-object> ^object-handle $ <unanchored-object-handle>)
-->
   (<world> ^info <info> -)
   (log 1 (crlf) |Apply find-object super object: | <new-object-handle> | anchors and replaces | <unanchored-object-handle>)
   (<desired-object> ^object-handle <unanchored-object-handle> -
                                    <new-object-handle>
                     ^anchored false -
                               true)
}

## Apply find-object -> sets info, object-handle, anchored.
sp {object-world*apply*find-object*object-found*super-desireds*object*argument1
   :default
   (state <s> ^operator <operator>
              ^superstate.operator.argument1 <argument1>
              ^world <world>)
   (<argument1> ^object-handle { <> <new-object-handle> <unanchored-object-handle> })
   (<world> ^info <info>
            ^objects <objects>)
   (<objects> ^object <unanchored-object>)
   (<info> ^unanchored-object <unanchored-object>
           ^anchored-object <anchored-object>)
   (<anchored-object> ^object-handle <new-object-handle>
                      ^anchored true)
   (<operator> ^name find-object
               ^pre-conditions-satisfied true
               ^argument2 <unanchored-object>)
   (<unanchored-object> ^object-handle <unanchored-object-handle>)
-->
   (<world> ^info <info> -)
   (log 1 (crlf) |Apply find-object super object: | <new-object-handle> | anchors and replaces | <unanchored-object-handle>)
   (<argument1> ^object-handle <unanchored-object-handle> -
                                    <new-object-handle>
                ^anchored false -
                          true)
}
