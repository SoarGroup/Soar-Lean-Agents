## Elaborate evaluate-operator default-state-copy-relation holding none -> sets holding-object.
sp {selection-world*elaborate*evaluate-operator*default-state-copy-relation*holding*none
   :default
   (state <s> ^deep-copy-world true
              ^world <new-world>)
   (<new-world> ^duplicate-of <old-world>)
   (<old-world> ^holding-object.object-handle none)
-->
   (<new-world> ^holding-object.object-handle none)
}

## Elaborate evaluate-operator default-state-copy-self -> sets m.
## Need to copy because it is internally created.
sp {selection-world*elaborate*evaluate-operator*default-state-copy-self
   :default
   (state <s> ^deep-copy-world true
              ^world <new-world>)
   (<new-world> ^duplicate-of.self.mobile <mobile>
                ^self <new-self>)
-->
   (<new-self> ^mobile <mobile>)
}

## Elaborate evaluate-operator default-state-copy-relation future-event -> sets future-event, duplicate-of, type.
## v2.45: copies every future event, whatever its arguments (before: only events with ^argument1 and ^argument2 both in the
## copied world and a ^property-change-count; others, such as Thor's broken-egg event, were left out of the look-ahead).
## The arguments, counts and completion time are copied by the rules below.
sp {selection-world*elaborate*evaluate-operator*default-state-copy-relation*future-event
   :default
   (state <s> ^deep-copy-world true
              ^world <new-world>)
   (<new-world> ^duplicate-of <old-world>)
   (<old-world> ^future-event <relation-object>)
   (<relation-object> ^type <type>)
-->
   (<new-world> ^future-event <new-relation-object>)
   (<new-relation-object> ^duplicate-of <relation-object>
                          ^type <type>)
}

## Elaborate evaluate-operator default-state-copy future-event argument -> sets argument1, argument2 or argument3.
## Re-links each argument to the copied object with the same handle.
sp {selection-world*elaborate*evaluate-operator*default-state-copy*future-event*argument
   :default
   (state <s> ^deep-copy-world true
              ^world <new-world>)
   (<new-world> ^future-event <new-relation-object>
                ^objects.object <object-new>)
   (<new-relation-object> ^duplicate-of <relation-object>)
   (<relation-object> ^{ << argument1 argument2 argument3 >> <arg> } <object-value>)
   (<object-value> ^object-handle <object-handle>)
   (<object-new> ^object-handle <object-handle>)
-->
   (<new-relation-object> ^<arg> <object-new>)
}

## Elaborate evaluate-operator default-state-copy future-event count -> sets argument-count, property-change-count.
sp {selection-world*elaborate*evaluate-operator*default-state-copy*future-event*count
   :default
   (state <s> ^deep-copy-world true
              ^world <new-world>)
   (<new-world> ^future-event <new-relation-object>)
   (<new-relation-object> ^duplicate-of <relation-object>)
   (<relation-object> ^{ << argument-count property-change-count >> <attr> } <n>)
-->
   (<new-relation-object> ^<attr> <n>)
}

## Elaborate evaluate-operator default-state-copy future-event completion-time -> sets completion-time.
## Where the copied clock keeps its time (nested evaluations, L15-012), the completion time is copied unchanged.
sp {selection-world*elaborate*evaluate-operator*default-state-copy*future-event*completion-time
   :default
   (state <s> ^deep-copy-world true
              ^world <new-world>)
   (<new-world> ^future-event <new-relation-object>)
   (<new-relation-object> ^duplicate-of.completion-time <ctime>)
  -{(<s> ^name evaluate-operator
         ^superstate.top-selection true)
    (<new-world> ^anchored-world true)}
-->
   (<new-relation-object> ^completion-time <ctime>)
}

## Elaborate evaluate-operator default-state-copy future-event completion-time rebaseline -> sets completion-time.
## v2.45: an evaluation directly under the top selection starts its clock at 0 (agent-world*elaborate*evaluate-operator*time*copy*lock-in),
## so a pending event's completion time is re-based to the time remaining: completion-time minus the copied world's ^time.
sp {selection-world*elaborate*evaluate-operator*default-state-copy*future-event*completion-time*rebaseline
   :default
   (state <s> ^name evaluate-operator
              ^superstate.top-selection true
              ^deep-copy-world true
              ^world <new-world>)
   (<new-world> ^anchored-world true
                ^duplicate-of.time <old-time>
                ^future-event <new-relation-object>)
   (<new-relation-object> ^duplicate-of.completion-time { > <old-time> <ctime> })
-->
   (<new-relation-object> ^completion-time (- <ctime> <old-time>))
}

## Elaborate evaluate-operator default-state-copy future-event completion-time rebaseline due -> sets completion-time 0.
## An event already due (completion time not later than the copied world's ^time) is due at once in the look-ahead.
sp {selection-world*elaborate*evaluate-operator*default-state-copy*future-event*completion-time*rebaseline*due
   :default
   (state <s> ^name evaluate-operator
              ^superstate.top-selection true
              ^deep-copy-world true
              ^world <new-world>)
   (<new-world> ^anchored-world true
                ^duplicate-of.time <old-time>
                ^future-event <new-relation-object>)
   (<new-relation-object> ^duplicate-of.completion-time <= <old-time>)
-->
   (<new-relation-object> ^completion-time 0)
}

## Elaborate evaluate-operator default-state-copy future-event completion-time no clock -> sets completion-time.
## A top-level evaluation whose source world has no ^time keeps the completion time.
sp {selection-world*elaborate*evaluate-operator*default-state-copy*future-event*completion-time*no-clock
   :default
   (state <s> ^name evaluate-operator
              ^superstate.top-selection true
              ^deep-copy-world true
              ^world <new-world>)
   (<new-world> ^anchored-world true
                ^duplicate-of <old-world>
                ^future-event <new-relation-object>)
   (<old-world> -^time)
   (<new-relation-object> ^duplicate-of.completion-time <ctime>)
-->
   (<new-relation-object> ^completion-time <ctime>)
}

## Elaborate evaluate-operator default-state-copy-property-change -> sets property-change, object, property-handle ....
## copies property-change to copied future-event
## must use the local version of <object> via <object-handle>
sp {selection-world*elaborate*evaluate-operator*default-state-copy-property-change
   :default
   (state <s> ^deep-copy-world true
              ^world <new-world>)
   (<new-world> ^duplicate-of <old-world>
                ^future-event <new-relation-object>
                ^objects.object <copied-object>)
   (<copied-object> ^object-handle <object-handle>)
   (<new-relation-object> ^duplicate-of <relation-object>)
   (<old-world> ^future-event <relation-object>)
   (<relation-object> ^property-change <property-change>)
   (<property-change> ^object.object-handle <object-handle>
                      ^property-handle <property-handle>
                      ^original-property-value <original-property-value>
                      ^new-property-value <new-property-value>)
-->
   (<new-relation-object> ^property-change <new-property-change>)
   (<new-property-change> ^object <copied-object>
                          ^property-handle <property-handle>
                          ^original-property-value <original-property-value>
                          ^new-property-value <new-property-value>)
}

## Elaborate evaluate-operator default-state-copy-primary-property-change -> sets primary-property-change.
## v2.45: matches the copied property change by object handle and property (before, it required the copy to point to the
## original object, which the copy never does, so ^primary-property-change was never copied).
sp {selection-world*elaborate*evaluate-operator*default-state-copy-primary-property-change
   :default
   (state <s> ^deep-copy-world true
              ^world <new-world>)
   (<new-world> ^future-event <new-relation-object>)
   (<new-relation-object> ^duplicate-of <relation-object>
                          ^property-change <new-property-change>)
   (<relation-object> ^primary-property-change <primary>)
   (<primary> ^object.object-handle <object-handle>
              ^property-handle <property-handle>)
   (<new-property-change> ^object.object-handle <object-handle>
                          ^property-handle <property-handle>)
-->
   (<new-relation-object> ^primary-property-change <new-property-change>)
}

## Elaborate evaluate-operator default-state-copy-new-desired -> sets new-desired, object.
## copies new-desired
## must use the local version of <object> via <object-handle>
sp {selection-world*elaborate*evaluate-operator*default-state-copy-new-desired
   :default
   (state <s> ^deep-copy-world true
              ^world <new-world>)
   (<new-world> ^duplicate-of <old-world>
                ^future-event <new-relation-object>)
   (<new-relation-object> ^duplicate-of <relation-object>)
   (<old-world> ^future-event <relation-object>)
   (<relation-object> ^new-desired <new-desired>)
   (<new-desired> ^object <new-desired-object>)
-->
   (<new-relation-object> ^new-desired <new-desired2>)
   (<new-desired2> ^object <new-desired-object>)
}

## ---- operator proposal ----

## Propose evaluate-operator look-ahead acceptable.
sp {selection-world*propose*evaluate-operator*look-ahead*acceptable
   :default
   (state <s> ^look-ahead-operator <operator>
              ^untried-tied-operator <operator>)
-->
   (<s> ^operator <operator> +)}

## ---- operator application ----

## Apply evaluate-operator -> sets duplica.
sp {selection-world*apply*evaluate-operator*state*duplicate-of
   :default
   (state <s> ^superstate <superstate>
              ^default-state-copy yes)
   (<superstate> ^operator <super-operator>)
   (<super-operator> ^name evaluate-operator
                     ^superstate <sss>)
-->
   (<s> ^duplicate-of <sss>)}

## Apply look-ahead tried-tied-operator -> sets tried-tied-oper.
sp {selection-world*apply*look-ahead*tried-tied-operator
   :default
   (state <s> ^operator <operator>
              ^look-ahead-operator <operator>)
-->
   (<s> ^tried-tied-operator <operator>)}

## Apply evaluate-operator -> sets symbolic-val.
## Return Results
## v2.47: a failure (partial-failure, exhaustion-failure, failure, prohibit-failure) is not passed back from a look-ahead state
## that continued at random (^random-continuation true, soar-base/simple.soar): it shows only that one random path failed, not
## that the evaluated operator fails; it is passed back as depth-exceeded (rule below). Successes are passed back as before.
## (Soar - To-do row 6: water-jug-look-ahead-rl learned 'pour 3->5 from (3,0) is partial-failure' after a random pour back.)
sp {selection-world*apply*evaluate-operator*symbolic-evaluation*from-subgoal
   :default
   (state <s> ^superstate <superstate>
              ^ { << required-success partial-success indifferent >> <svalue> } <desireds2>)
   (<desireds2> ^duplicate-of <desireds>)
   (<superstate> ^operator <super-operator>
                 ^evaluation <evaluation>)
   (<super-operator> ^name evaluate-operator
                     ^evaluation <evaluation>)
   (<evaluation> ^desireds <desireds>)
   (<evaluation> ^lower-bound $ <lower-bound>)   # v2.30: the chunk tests this bound literally (none: no cut-off below)
-->
   (<evaluation> ^symbolic-value <svalue>)}

sp {selection-world*apply*evaluate-operator*symbolic-evaluation*from-subgoal*failure
   :default
   (state <s> ^superstate <superstate>
             -^random-continuation true
              ^ { << partial-failure exhaustion-failure failure prohibit-failure >> <svalue> } <desireds2>)
   (<desireds2> ^duplicate-of <desireds>)
   (<superstate> ^operator <super-operator>
                 ^evaluation <evaluation>)
   (<super-operator> ^name evaluate-operator
                     ^evaluation <evaluation>)
   (<evaluation> ^desireds <desireds>)
   (<evaluation> ^lower-bound $ <lower-bound>)   # v2.30: the chunk tests this bound literally (none: no cut-off below)
-->
   (<evaluation> ^symbolic-value <svalue>)}


## A failure after a random continuation is passed back as depth-exceeded (it does not show that the evaluated operator fails).
## v2.49: the evaluation is also marked ^random-failure true (no rule uses the mark; a preference against marked evaluations was
## tried on 28 Nov 2026 and dropped: Rosie suko seed 3 and sujiko seed 2 lost again, as before the v2.49 marker repair).
sp {selection-world*apply*evaluate-operator*symbolic-evaluation*from-subgoal*failure*random-continuation
   :default
   (state <s> ^quiescence t   # no chunk (as for the other depth-exceeded results)
              ^superstate <superstate>
              ^random-continuation true
              ^ { << partial-failure exhaustion-failure failure prohibit-failure constraint-failure >> <svalue> } <desireds2>)
   (<desireds2> ^duplicate-of <desireds>)
   (<superstate> ^operator <super-operator>
                 ^evaluation <evaluation>)
   (<super-operator> ^name evaluate-operator
                     ^evaluation <evaluation>)
   (<evaluation> ^desireds <desireds>)
-->
   (<evaluation> ^symbolic-value depth-exceeded
                 ^random-failure true)}

## Apply evaluate-operator -> sets symbolic-va.
sp {selection-world*apply*evaluate-operator*symbolic-evaluation*from-subgoal*success
   :default
   (state <s> ^superstate <superstate>
              ^success <desireds2>
              ^flags.cost-metric none
             -^flags.iterative-step cost
             -^cost-exceeded true)
   (<desireds2> ^duplicate-of <desireds>)
   (<superstate> ^operator <super-operator>
                 ^evaluation <evaluation>)
   (<super-operator> ^name evaluate-operator
                     ^evaluation <evaluation>)
   (<evaluation> ^desireds <desireds>)
   (<evaluation> ^lower-bound $ <lower-bound>)   # v2.30: the chunk tests this bound literally (none: no cut-off below)
-->
   (<evaluation> ^symbolic-value success)}

## Apply evaluate-operator -> sets symbolic-value success with a cost metric and a task state value (the path cost is not returned).
## With a cost metric and no state value agent-world*apply*evaluate-operator*numeric-evaluation-return*path-cost returns the success
## together with its path cost, so the chunk built from the result holds both and a success is never learned without its cost.
sp {selection-world*apply*evaluate-operator*symbolic-evaluation*from-subgoal*success*state-value
   :default
   (state <s> ^superstate <superstate>
              ^success <desireds2>
              ^flags.cost-metric << unit time >>
              ^state-value <state-value>
             -^flags.iterative-step cost
             -^cost-exceeded true)
   (<desireds2> ^duplicate-of <desireds>)
   (<superstate> ^operator <super-operator>
                 ^evaluation <evaluation>)
   (<super-operator> ^name evaluate-operator
                     ^evaluation <evaluation>)
   (<evaluation> ^desireds <desireds>)
   (<evaluation> ^lower-bound $ <lower-bound>)   # v2.30: the chunk tests this bound literally (none: no cut-off below)
-->
   (<evaluation> ^symbolic-value success)}

## Apply evaluate-operator -> sets symbolic-value success under cost-cap iteration (waits for the current cost-within-cap marker).
sp {selection-world*apply*evaluate-operator*symbolic-evaluation*from-subgoal*success*cost-cap
   :default
   (state <s> ^superstate <superstate>
              ^success <desireds2>
              ^flags.iterative-step cost
              ^cost-within-cap true
             -^cost-exceeded true)
   (<desireds2> ^duplicate-of <desireds>)
   (<superstate> ^operator <super-operator>
                 ^evaluation <evaluation>)
   (<super-operator> ^name evaluate-operator
                     ^evaluation <evaluation>)
   (<evaluation> ^desireds <desireds>)
   (<evaluation> ^lower-bound $ <lower-bound>)   # v2.30: the chunk tests this bound literally (none: no cut-off below)
-->
   (<evaluation> ^symbolic-value success)}

## Apply evaluate-operator -> sets numeri.
sp {selection-world*apply*evaluate-operator*numeric-evaluation*from-subgoal
   :default
   (state <superstate> ^superstate <s>
                       ^desireds <desireds2>
                       ^numeric-value <v>)
   (<desireds2> ^duplicate-of <desireds>)
   (<s> ^operator <super-operator>
        ^evaluation <evaluation>)
   (<super-operator> ^name evaluate-operator
                     ^evaluation <evaluation>)
   (<evaluation> ^desireds <desireds>)
   (<evaluation> ^lower-bound $ <lower-bound>)   # v2.30: the chunk tests this bound literally (none: no cut-off below)
-->
   (<evaluation> ^numeric-value <v>)}

## Apply evaluate-operator -> sets expecte.
sp {selection-world*apply*evaluate-operator*expected-evaluation*from-subgoal
   :default
   (state <superstate> ^superstate <s>
                       ^desireds <desireds2>
                       ^expected-value <v>)
   (<desireds2> ^duplicate-of <desireds>)
   (<s> ^operator <super-operator>
        ^evaluation <evaluation>)
   (<super-operator> ^name evaluate-operator
                     ^evaluation <evaluation>)
   (<evaluation> ^desireds <desireds>)
-->
   (<evaluation> ^expected-value <v>)}

## Apply evaluate-operator state world-copy -> sets world, objects, self ....
## Creates world pointer and initiailized objects and self from super.superstate for deep copy
sp {selection-world*apply*evaluate-operator*state*world-copy
   :default
   (state <s> ^impasse no-change
              ^deep-copy-world true
              ^attribute operator
              ^superstate <ss>)
   (<ss> ^superstate.world <old-world>
         ^operator <super-operator>)
-->
   (<s> ^world <new-world>)
   (<new-world> ^objects <objects>
                ^self <self>
                ^duplicate-of <old-world>)}

## Apply evaluate-operator -> sets symbolic-value, failure-string.
sp {selection-world*apply*evaluate-operator*symbolic-evaluation*from-subgoal*constraint-failure
   :default
   (state <s> ^superstate <superstate>
             -^random-continuation true
              ^constraint-failure <desireds2>
              ^failure-string <failure-string>)
   (<desireds2> ^duplicate-of <desireds>)
   (<superstate> ^operator <super-operator>
                 ^evaluation <evaluation>)
   (<super-operator> ^name evaluate-operator
                     ^evaluation <evaluation>)
   (<evaluation> ^desireds <desireds>)
   (<evaluation> ^lower-bound $ <lower-bound>)   # v2.30: the chunk tests this bound literally (none: no cut-off below)
-->
   (<evaluation> ^symbolic-value constraint-failure
                 ^failure-string <failure-string>)}

## Elaborate evaluate-operator state desireds better -> copies ^better (v2.40) and ^best (v2.45) to the look-ahead desireds, so nested selections
## compare numeric values the way the top selection does.
sp {selection-world*elaborate*evaluate-operator*state*desireds*better
   :default
   (state <s> ^impasse no-change
              ^attribute operator
              ^desireds <desireds2>)
   (<desireds2> ^duplicate-of <desireds>)
   (<desireds> ^{ << better best >> <attr> } <value>)
-->
   (<desireds2> ^<attr> <value>)}
