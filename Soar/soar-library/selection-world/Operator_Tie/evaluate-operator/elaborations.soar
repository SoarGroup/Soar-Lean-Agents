## elaborations.soar -- selection-world: 27 elaborations, 1 proposal, 11 applications.

## ---- elaborations ----

## Elaborate selection selection-substate -> sets selection-sup.
sp {selection-world*elaborate*selection*selection-substate
   :default
   (state <s> ^superstate <ss>)
   (<ss> ^name selection)
-->
   (<s> ^selection-superstate <ss>)
}

## Elaborate evaluate-operator evaluate-operator internal-actions -> sets internal-actions, real, top-state ....
sp {selection-world*elaborate*evaluate-operator*evaluate-operator*internal-actions
   :default
   (state <s> ^name evaluate-operator)
-->
   (force-learn <s>)
   (<s> ^internal-actions true
        ^real false
        ^top-state <s>
        ^deep-copy-world true)
}

## Elaborate selection selection-substate copy -> sets selection-supe.
sp {selection-world*elaborate*selection*selection-substate*copy
   :default
   (state <s> ^superstate <ss>)
   (<ss> -^name selection
          ^selection-superstate <sss>)
-->
   (<s> ^selection-superstate <sss>)
}

## Elaborate evaluate-operator state desireds -> sets desireds, duplicate-of, desired-count.
## Create new desireds to which desired will be copied
sp {selection-world*elaborate*evaluate-operator*state*desireds
   :default
   (state <s> ^impasse no-change
              ^attribute operator
              ^superstate.operator <super-operator>)
   (<super-operator>  -^default-desired-copy yes
                       ^name evaluate-operator
                       ^evaluation.desireds <desireds>)
   (<desireds> ^desired-count <desired-count>)
-->
   (<s> ^desireds <desireds2>)
   (<desireds2> ^duplicate-of <desireds>
                ^desired-count <desired-count>)}

## Elaborate evaluate-operator state name.
## Copies down name of supersuper state to be name of substate
sp {selection-world*elaborate*evaluate-operator*state*name
   :default
   (state <s> ^impasse no-change
              ^attribute operator
              ^superstate.operator <super-operator>)
   (<super-operator> ^name evaluate-operator
                     ^superstate.name {<> evaluate-operator <name> })
-->
   (<s> ^name <name>)}

## Elaborate evaluate-operator untried-tied-operator -> sets untried-tied-oper.
## Propose look-ahead-operator
sp {selection-world*elaborate*evaluate-operator*untried-tied-operator
   :default
   (state <s> ^look-ahead-operator <operator>
             -^tried-tied-operator <operator>)
-->
   (<s> ^untried-tied-operator <operator>)}

## Elaborate evaluate-operator world real false -> sets real.
## v2.45: every copied (look-ahead) world is marked ^real false, so rules recognize a hypothetical world by a positive test
## (^world.real false) instead of -^world.real true (World-Conventions L16-005).
sp {selection-world*elaborate*evaluate-operator*world*real*false
   :default
   (state <s> ^deep-copy-world true
              ^world <new-world>)
   (<new-world> ^duplicate-of <old-world>)
-->
   (<new-world> ^real false)}

## Elaborate evaluate-operator time anchored-world -> sets anchor.
sp {selection-world*elaborate*evaluate-operator*time*anchored-world
   :default
   (state <s> ^deep-copy-world true
              ^world <new-world>)
   (<new-world> ^duplicate-of.anchored-world <true>)
-->
   (<new-world> ^anchored-world <true>)}

## Elaborate evaluate-operator time anchored-world false -> sets ancho.
sp {selection-world*elaborate*evaluate-operator*time*anchored-world*false
   :default
   (state <s> ^deep-copy-world true
              ^world <new-world>)
  -(<new-world> ^duplicate-of.anchored-world <true>)
-->
   (<new-world> ^anchored-world false)}

## Elaborate evaluate-operator time initialize-room false -> sets ancho.
sp {selection-world*elaborate*evaluate-operator*time*initialize-room*false
   :default
   (state <s> ^deep-copy-world true
              ^world <new-world>)
   (<new-world> ^duplicate-of <world>)
   (<world> -^room-name <room>
            -^anchored-world true)
-->
   (<new-world> ^anchored-world false)}

## Elaborate evaluate-operator default-state-copy-stamp -> sets parent-stamp (v2.28).
## The look-ahead world starts with the version stamp of the world it was copied from (see ground-state.soar).
sp {selection-world*elaborate*evaluate-operator*default-state-copy-stamp
   :default
   (state <s> ^deep-copy-world true
              ^world <new-world>)
   (<new-world> ^duplicate-of.stamp <p>)
-->
   (<new-world> ^parent-stamp <p>)}

## Elaborate evaluate-operator default-state-copy-steps -> sets parent-steps (v2.47).
## The look-ahead world starts with the look-ahead step count of the world it was copied from (0 below the real world), so
## ^look-ahead-steps (ground-state.soar) counts the operators applied on the whole look-ahead path.
sp {selection-world*elaborate*evaluate-operator*default-state-copy-steps
   :default
   (state <s> ^deep-copy-world true
              ^world <new-world>)
   (<new-world> ^duplicate-of.look-ahead-steps <n>)
-->
   (<new-world> ^parent-steps <n>)}

sp {selection-world*elaborate*evaluate-operator*default-state-copy-steps*zero
   :default
   (state <s> ^deep-copy-world true
              ^world <new-world>)
   (<new-world> ^duplicate-of <old>)
   (<old> -^look-ahead-steps)
-->
   (<new-world> ^parent-steps 0)}

## Object sets (v2.49 candidate, World-Conventions L7-029): ^objects.object holds every object of a world, and a typed object is
## also in the set of its type, ^objects.T, with ^type T. Programs write the type sets; this rule adds each typed object to
## ^object, so every library rule reaches objects through the constant attribute ^object (indexed by Soar) as in v2.48, and a
## rule learned in a look-ahead tests (<objs> ^object <x>), never the unindexed (<objs> ^<T> <x>). Agents in the legacy layout
## (every object under ^objects.object, no type sets) are unchanged. The rule matches only in the state that holds the world, not
## in substates that share their superstate's world (arithmetic-solve-problem: 14,832 firings in 273 decisions otherwise).
sp {selection-world*elaborate*world*objects*object
   :default
   (state <s> ^world <w>
             -^superstate.world <w>)
   (<w> ^objects <objs>)
   (<objs> ^<obj-type> <o>)
   (<o> ^type <obj-type>)
-->
   (<objs> ^object <o>)}

## Elaborate evaluate-operator default-state-copy-object -> sets object, object-handle, duplicate-of.
## The copy writes its own copy-map entry (v2.49 candidate; v2.45-v2.48: copy-map*copied).
sp {selection-world*elaborate*evaluate-operator*default-state-copy-object
   :default
   (state <s> ^deep-copy-world true
              ^world <new-world>)
   (<new-world> ^objects <new-objects>
                ^copy-map <map>
                ^duplicate-of.objects.object <old-object>)
   (<old-object> ^object-handle <handle>
                -^static true)
-->
   (<new-objects> ^object <new-object>)
   (<new-object> ^object-handle <handle>
                 ^duplicate-of <old-object>)
   (<map> ^<old-object> <new-object>)}

## A typed copy joins the set of its type in the same elaboration as its attributes are copied (v2.49 candidate, L7-029), so a
## rule that reaches objects through a type set (^objects.T) never sees a copy without its attributes. In v2.48 such rules
## tested ^type, which arrived with the other attributes. The type is read from the object's own ^type, not from the old
## world's type set: the copy then tests the old object only through ^objects.object, as default-state-copy-object does, so a
## learned rule has one set condition per object, (<objs> ^object <x>), and (<x> ^type T) (Sujiko with learning, 600
## decisions: 16 s; 33 s with a second test of the type set). In a look-ahead copy of a world in the legacy layout, an object
## with ^type T is also put in a T set, which legacy rules do not test.
sp {selection-world*elaborate*evaluate-operator*default-state-copy-object*type-set
   :default
   (state <s> ^deep-copy-world true
              ^world <new-world>)
   (<new-world> ^objects <new-objects>
                ^copy-map <map>
                ^duplicate-of.objects.object <old-object>)
   (<old-object> ^type <obj-type>)
   (<map> ^<old-object> <new-object>)
   (<new-object> ^duplicate-of <old-object>)
-->
   (<new-objects> ^<obj-type> <new-object>)}

## Static objects (v2.48 candidate, World-Conventions L7-028): an object marked ^static true is one no operator changes, so the
## look-ahead world shares it instead of copying it: the new world's ^objects holds the same identifier (in ^object and, if
## typed, in the set of its type), and copy-map*static maps it to itself, so relations to it are copied with the object itself
## as their argument (v2.49 candidate: relation-copy variants that took a static argument directly were tried and dropped: learned
## rules then lost the identity of that argument, English towers-of-hanoi with learning made one move and stopped).
sp {selection-world*elaborate*evaluate-operator*default-state-share-static-object
   :default
   (state <s> ^deep-copy-world true
              ^world <new-world>)
   (<new-world> ^objects <new-objects>
                ^duplicate-of.objects.object <old-object>)
   (<old-object> ^static true)
-->
   (<new-objects> ^object <old-object>)}

sp {selection-world*elaborate*evaluate-operator*default-state-share-static-object*type-set
   :default
   (state <s> ^deep-copy-world true
              ^world <new-world>)
   (<new-world> ^objects <new-objects>
                ^duplicate-of.objects.object <old-object>)
   (<old-object> ^static true
                 ^type <obj-type>)
-->
   (<new-objects> ^<obj-type> <old-object>)}



## Copy map (v2.45): ^copy-map on the new world has one WME per object, whose attribute is the old object and whose value is
## the object's copy in the new world (L7-026). Relation copies look up their arguments here: the
## lookup is joined on the map's identifier, where matching the arguments' handles against every new object built about
## relations x objects partial matches in each copy (KenKen 6-2: about 300,000; Soar - To-do row 5).
sp {selection-world*elaborate*evaluate-operator*copy-map
   :default
   (state <s> ^deep-copy-world true
              ^world <new-world>)
   (<new-world> ^duplicate-of <old-world>)
-->
   (<new-world> ^copy-map <map>)}

## copy-map*copied (v2.45-v2.48) is folded into default-state-copy-object (v2.49 candidate): the copy writes its own map entry.

## Elaborate evaluate-operator default-state-copy-object-attributes.
## Careful on copying ones that are elaborations. So issues here
sp {selection-world*elaborate*evaluate-operator*default-state-copy-object-attributes
   :default
   (state <s> ^deep-copy-world true
              ^world.objects.object <new-object>
              ^superstate.operator.super-problem-space <ps>)
   (<new-object> ^duplicate-of <old-object>)
   (<old-object> ^{ <> object-handle <> duplicate-of <> anchored <attribute> } <value>)
  -(<ps> ^dont-copy-object-attribute <attribute>)
-->
   (<new-object> ^<attribute> <value>)}

## Elaborate evaluate-operator default-state-copy-object-attributes anchored -> sets a.
sp {selection-world*elaborate*evaluate-operator*default-state-copy-object-attributes*anchored
   :default
   (state <s> ^deep-copy-world true
              ^world.objects.object <new-object>)
   (<new-object> ^duplicate-of <old-object>)
   (<old-object> ^anchored <value>) # don't copy accessible because it is an elaboration
  -(<new-object> ^anchored <> <value>)  ## MEans can only have one value... Will get overflow if two values
-->
   (<new-object> ^anchored <value>)}

## Static objects map to themselves (v2.48, L7-026, L7-028).
sp {selection-world*elaborate*evaluate-operator*copy-map*static
   :default
   (state <s> ^deep-copy-world true
              ^world <new-world>)
   (<new-world> ^copy-map <map>
                ^duplicate-of.objects.object <old-object>)
   (<old-object> ^static true)
-->
   (<map> ^<old-object> <old-object>)}

## Relation copies (v2.45). A relation is copied with its arguments looked up in the copy map (L7-026).
## above
sp {selection-world*elaborate*evaluate-operator*default-state-copy-relation*in-container*above-location
   :default
   (state <s> ^deep-copy-world true
              ^world <new-world>)
   (<new-world> ^duplicate-of <old-world>
                ^copy-map <map>)
   (<old-world> ^above <relation-object>)
   (<relation-object> ^argument1 <old-argument1>
                      ^argument2 <old-argument2>)
   (<map> ^<old-argument1> <new-argument1>
          ^<old-argument2> <new-argument2>)
-->
   (<new-world> ^above <new-relation-object>)
   (<new-relation-object> ^duplicate-of <relation-object>
                          ^argument1 <new-argument1>
                          ^argument2 <new-argument2>)
}

## on
sp {selection-world*elaborate*evaluate-operator*default-state-copy-relation*in-container*on-location
   :default
   (state <s> ^deep-copy-world true
              ^world <new-world>)
   (<new-world> ^duplicate-of <old-world>
                ^copy-map <map>)
   (<old-world> ^on <relation-object>)
   (<relation-object> ^argument1 <old-argument1>
                      ^argument2 <old-argument2>)
   (<map> ^<old-argument1> <new-argument1>
          ^<old-argument2> <new-argument2>)
-->
   (<new-world> ^on <new-relation-object>)
   (<new-relation-object> ^duplicate-of <relation-object>
                          ^argument1 <new-argument1>
                          ^argument2 <new-argument2>)
}

## in
sp {selection-world*elaborate*evaluate-operator*default-state-copy-relation*in-container*in-location
   :default
   (state <s> ^deep-copy-world true
              ^world <new-world>)
   (<new-world> ^duplicate-of <old-world>
                ^copy-map <map>)
   (<old-world> ^in <relation-object>)
   (<relation-object> ^argument1 <old-argument1>
                      ^argument2 <old-argument2>)
   (<map> ^<old-argument1> <new-argument1>
          ^<old-argument2> <new-argument2>)
-->
   (<new-world> ^in <new-relation-object>)
   (<new-relation-object> ^duplicate-of <relation-object>
                          ^argument1 <new-argument1>
                          ^argument2 <new-argument2>)
}

## Copy any relation the task declares: (<problem-space> ^copy-relation <name>) on the task's problem space.
## (P-004) Relations are copied by name; on, above, in are always copied by the rules above. Do not declare derived relations
sp {selection-world*elaborate*evaluate-operator*default-state-copy-relation*declared
   :default
   (state <s> ^deep-copy-world true
              ^world <new-world>
              ^superstate.operator.super-problem-space.copy-relation <relation>)
   (<new-world> ^duplicate-of <old-world>
                ^copy-map <map>)
   (<old-world> ^<relation> <relation-object>)
   (<relation-object> ^argument1 <old-argument1>
                      ^argument2 <old-argument2>)
   (<map> ^<old-argument1> <new-argument1>
          ^<old-argument2> <new-argument2>)
-->
   (<new-world> ^<relation> <new-relation-object>)
   (<new-relation-object> ^duplicate-of <relation-object>
                          ^argument1 <new-argument1>
                          ^argument2 <new-argument2>)
}


## Shared relation (v2.48 candidate, L7-028): a relation the task declares with (<problem-space> ^share-relation <name>) is
## one no operator changes, between static objects; the look-ahead world gets the same relation identifier, not a copy.
sp {selection-world*elaborate*evaluate-operator*default-state-share-relation*declared
   :default
   (state <s> ^deep-copy-world true
              ^world <new-world>
              ^superstate.operator.super-problem-space.share-relation <relation>)
   (<new-world> ^duplicate-of <old-world>)
   (<old-world> ^<relation> <relation-object>)
-->
   (<new-world> ^<relation> <relation-object>)
}

## Declared relation with one argument (v2.29), for example a maintained ^clear.
sp {selection-world*elaborate*evaluate-operator*default-state-copy-relation*declared*one-argument
   :default
   (state <s> ^deep-copy-world true
              ^world <new-world>
              ^superstate.operator.super-problem-space.copy-relation <relation>)
   (<new-world> ^duplicate-of <old-world>
                ^copy-map <map>)
   (<old-world> ^<relation> <relation-object>)
   (<relation-object> ^argument1 <old-argument1>
                     -^argument2)
   (<map> ^<old-argument1> <new-argument1>)
-->
   (<new-world> ^<relation> <new-relation-object>)
   (<new-relation-object> ^duplicate-of <relation-object>
                          ^argument1 <new-argument1>)
}


## Elaborate evaluate-operator default-state-copy-relation controlled-by -> sets controlled-by.
## No need to copy as will never be destroyed or modified. Can use original
sp {selection-world*elaborate*evaluate-operator*default-state-copy-relation*controlled-by
   :default
   (state <s> ^deep-copy-world true
              ^world <new-world>)
   (<new-world> ^duplicate-of.controlled-by <controlled-by>)
-->
   (<new-world> ^controlled-by <controlled-by>)
}

