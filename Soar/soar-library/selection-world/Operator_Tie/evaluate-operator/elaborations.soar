sp {selection-world*elaborate*evaluate-operator*default-state-copy-relation*holding
   :default
   (state <s> ^deep-copy-world true
              ^world <new-world>)
   (<new-world> ^duplicate-of <old-world>
                ^objects.object <new-world-object>)
   (<new-world-object> ^object-handle <object-handle>)
   (<old-world> ^holding-object.object-handle <object-handle>)
