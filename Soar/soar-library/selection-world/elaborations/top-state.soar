## top-state.soar -- selection-world: 5 applications.

## Apply top-goal halt success.
sp {selection-world*apply*top-goal*halt*success
   :default
   (state <s> ^name <name>
              ^desireds <desireds>
              ^superstate nil
              ^<< required-success success >> <desireds>
             -^<< prohibit-failure failure exhaustion-failure >> <desireds>)   # v2.38: a lost state does not halt with success
  -(<desireds> ^next-desireds)
-->
   (write (crlf)   <name>  | achieved - success|)
 #   (success)
   (interrupt)}

## Apply top-goal halt success desireds-count.
sp {selection-world*apply*top-goal*halt*success*desireds-count
    :default
   (state <s> ^name <name>
              ^superstate nil
              ^desireds <desireds>
             -^<< prohibit-failure failure exhaustion-failure >> <desireds>)   # v2.38: a lost state does not halt with success
   (<desireds> ^unachieved-desireds-count 0
               ^achieved-desireds-count <count>
               ^desired-count <count>
              -^next-desireds <n>)
-->
   (write (crlf)  <name>  | achieved all desireds|)
   (interrupt)}

## Apply top-goal halt success termination.
## The top state's loop ends when its termination desireds are achieved (L8-028).
sp {selection-world*apply*top-goal*halt*success*termination
   :default
   (state <s> ^name <name>
              ^superstate nil
              ^termination-desireds <termination>
              ^<< required-success success >> <termination>
              ^desireds <desireds>
             -^<< prohibit-failure failure exhaustion-failure >> <desireds>)
-->
   (write (crlf)   <name>  | achieved termination desireds - success|)
   (interrupt)}

## Apply top-goal halt success repeat-count.
## The top state's loop ends when its repeat count reaches 0 (L8-029).
sp {selection-world*apply*top-goal*halt*success*repeat-count
   :default
   (state <s> ^name <name>
              ^superstate nil
              ^repeat-count 0
              ^desireds <desireds>
             -^<< prohibit-failure failure exhaustion-failure >> <desireds>)
-->
   (write (crlf)   <name>  | completed its repeat count - success|)
   (interrupt)}

## Apply top-goal halt failure.
sp {selection-world*apply*top-goal*halt*failure
   :default
   (state <s> ^superstate nil
              ^desireds <desireds>
              ^name <name>
              ^ << prohibit-failure failure exhaustion-failure >> <desireds>)
-->
   (write (crlf)  <name>  | failed|)
 #   (failure)
   (interrupt)}
