sp {selection-world*propose*selection*all-evaluations-failed6
   :default
   (state <s> ^name selection
              ^item-count 6
              ^evaluation <evaluation1> { < <evaluation1> <evaluation2> }
                          { < <evaluation1> < <evaluation2> <e3> }
                          { < <evaluation1> < <evaluation2> < <e3> <e4> }
                          { < <evaluation1> < <evaluation2> < <e3> < <e4> <e5> }
                          { < <evaluation1> < <evaluation2> < <e3> < <e4> < <e5> <e6> }
             -^top-selection true
              ^remaining-operators 0)
   (<evaluation1> ^symbolic-value failure)
   (<evaluation2> ^symbolic-value failure)
   (<e3> ^symbolic-value failure)
   (<e4> ^symbolic-value failure)
   (<e5> ^symbolic-value failure)
