## ---- operator application ----

## Apply evaluate-operator -> sets symbolic.
sp {selection-world*apply*all-evaluations-failed
   :default
   (state <s> ^operator <operator>
              ^selection-superstate.operator <super-operator>)
   (<super-operator> ^name evaluate-operator
                     ^evaluation <evaluation>)
   (<operator> ^name all-evaluations-failed)
   (<evaluation> ^lower-bound $ <lower-bound>)   # v2.30: the chunk tests this bound literally (none: no cut-off below)
-->
   (write (crlf) |Failed | <evaluation>)
   (<evaluation> ^symbolic-value failure)
}
