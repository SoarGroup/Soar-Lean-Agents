## exceed-depth.soar -- selection-world: 2 proposals, 2 compares, 1 application.

## ---- operator proposal ----

## Propose evaluate-operator.
sp {selection-world*propose*evaluate-operator*exceed-depth
   :default
   (state <s> ^name evaluate-operator
              ^flags.iterative-step operator  # why needed
              ^current-evaluation-depth.value <= 0)
-->
   (<s> ^operator <operator> + =, >)
   (<operator> ^name exceed-depth)
}

## Propose exceed-depth when the look-ahead path has applied ^flags.max-look-ahead-steps operators (v2.47): a backstop for
## runaway subgoaling or search inside one evaluation. Not with iterative-step operator, where the depth limit already
## counts every operator applied, so the defined limit is the bound.
sp {selection-world*propose*evaluate-operator*exceed-depth*look-ahead-steps
   :default
   (state <s> ^name evaluate-operator
              ^world <w>
             -^flags.iterative-step operator
              ^flags.max-look-ahead-steps <max>)
   (<w> ^look-ahead-steps >= <max>)
-->
   (<s> ^operator <operator> + =, >)
   (<operator> ^name exceed-depth)
   (log 1 (crlf) |Look-ahead steps reached the limit | <max> |: depth exceeded.|)
}

## ---- evaluate / compare ----

## Preference for evaluate-operator exceed-depth.
sp {selection-world*compare*evaluate-operator*exceed-depth
   :default
   (state <s> ^operator <operator1> +
                        { <> <operator1> <operator2> } +)
   (<operator1> ^name exceed-depth)
-->
   (<s> ^operator <operator1> > <operator2>)
}

## Preference for evaluate-operator exceed-depth duplicate.
sp {selection-world*compare*evaluate-operator*exceed-depth*duplicate
   :default
   (state <s> ^operator <operator1> +
                        { <> <operator1> <operator2> } +
              ^duplicate-look-ahead-operator <operator2>)
   (<operator1> ^name exceed-depth)
-->
   (<s> ^operator <operator1> > <operator2>)
}

## ---- operator application ----

## Apply exceed-depth -> sets depth-excee.
sp {selection-world*apply*exceed-depth
   :default
   (state <s> ^operator.name exceed-depth
              ^desireds <desireds>)
-->
   (<s> ^depth-exceeded <desireds>)
}
