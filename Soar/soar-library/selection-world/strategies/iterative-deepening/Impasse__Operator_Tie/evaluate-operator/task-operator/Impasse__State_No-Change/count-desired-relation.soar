## count-desired-relation.soar -- selection-world: 1 proposal, 1 application.

## ---- operator proposal ----

## Propose count-desired-relation.
sp {selection-world*propose*failure-evaluation*count-desired-relation
   :default
   (state <s> ^name failure-evaluation
              ^superstate.desireds.desired.<< on in above under >> <relation>
              ^counted-object-handle <object-handle1> <object-handle2>
             -^counted-desired-relation <relation>)
   (<relation> ^argument1.object-handle <object-handle1>
               ^argument2.object-handle <object-handle2>)
-->
   (<s> ^operator <op> + =)
   (<op> ^name count-desired-relation
         ^relation <relation>)
}

## ---- operator application ----

## Apply count-desired-relation -> sets feature-count, counted-desired-relat.
sp {selection-world*apply*count-desired-relation
   :default
   (state <s> ^operator <op>
              ^feature-count <feature-count>)
   (<op> ^name count-desired-relation
         ^relation <relation>)
   (<relation> ^argument1.object-handle <object-handle1>
               ^argument2.object-handle <object-handle2>)
-->
   (<s> ^feature-count (+ 1 <feature-count>)
                       <feature-count> -
        ^counted-desired-relation <relation>)
}
