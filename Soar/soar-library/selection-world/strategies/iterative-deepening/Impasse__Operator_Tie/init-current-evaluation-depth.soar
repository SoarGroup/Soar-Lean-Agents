## init-current-evaluation-depth.soar -- selection-world: 3 proposals, 2 applications.

## ---- operator proposal ----

## Propose init-current-evaluation-depth.
## For top-level selection space
sp {selection-world*propose*selection*init-current-evaluation-depth*top-selection*one
   :default
   (state <s> ^name selection
              ^flags.init-evaluation-depth one
              ^superstate.desireds.unachieved-desireds-count $ <count>
              ^top-selection true
             -^current-evaluation-depth)
-->
   (<s> ^operator <operator> + =, >)
   (<operator> ^name init-current-evaluation-depth
               ^value 1)
}

## Propose init-current-evaluation-depth.
sp {selection-world*propose*selection*init-current-evaluation-depth*top-selection
   :default
   (state <s> ^name selection
              ^top-selection true
              ^flags.init-evaluation-depth unachieved-desireds
              ^superstate.desireds.unachieved-desireds-count { $ <count> > 2 }  #1
             -^current-evaluation-depth)
-->
   (<s> ^operator <operator> + =, >)
   (<operator> ^name init-current-evaluation-depth
               ^value <count>) # v2.38: start at the count; assumes each operator achieves at most one desired
                               # (count - 1, the original, gave the same plans with up to 6x the decisions on blocks world and eight-puzzle)
}

## Propose init-current-evaluation-depth.
sp {selection-world*propose*selection*init-current-evaluation-depth*top-selection*1
   :default
   (state <s> ^name selection
              ^top-selection true
              ^flags.init-evaluation-depth unachieved-desireds
              ^superstate.desireds.unachieved-desireds-count { $ <count> <= 2 }
             -^current-evaluation-depth)
-->
   (<s> ^operator <operator> + =, >)
   (<operator> ^name init-current-evaluation-depth
               ^value 2) # 1 shallow
}

## ---- operator application ----

## Apply init-current-evaluation-depth -> sets current-evaluation-depth.
sp {selection-world*apply*init-current-evaluation-depth
   :default
   (state <s> ^operator <operator>)
   (<operator> ^name init-current-evaluation-depth
               ^value <value>)
-->
   (<s> ^current-evaluation-depth.value <value>)
}

## Apply init-current-evaluation-depth -> sets max-eval.
sp {selection-world*apply*init-current-evaluation-depth*max
   :default
   (state <s> ^top-selection true
             -^flags.iterative-step cost
              ^flags.max-evaluation-depth <max>
              ^operator <operator>)
   (<operator> ^name init-current-evaluation-depth)
-->
   (<s> ^max-evaluation-depth <max>)
}

