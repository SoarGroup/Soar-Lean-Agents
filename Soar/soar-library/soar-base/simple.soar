## simple.soar -- soar-base: 5 elaborations, 1 proposal, 2 compares, 1 application.

## ---- elaborations ----

## Elaborate default state io.
sp {soar-base*elaborate*default*state*io
   "Elaborate each substate with io pointer."
   :default
   (state <s> ^impasse no-change
              ^superstate.io <io>)
   -->
   (<s> ^io <io>)}

## Elaborate top-state top-state -> sets top-s.
## Elaborate top-state with pointer to self.
sp {soar-base*elaborate*top-state*top-state
   :default
   (state <s> ^superstate nil)
-->
   (<s> ^top-state <s>)
}

## Elaborate state top-state -> sets top-st.
sp {soar-base*elaborate*state*top-state
   :default
   (state <s> ^superstate <ss>)
   (<ss> ^top-state <ts>
        -^operator.name evaluate-operator)
-->
   (<s> ^top-state <ts>)
}

## Elaborate state name -> sets na.
sp {soar-base*elaborate*state*name
   "Elaborate substates with name of operator."
   :default
   (state <s> ^superstate.operator.name <name>)
-->
   (<s> ^name <name>)}

## ---- operator proposal ----

## Propose wait.
sp {soar-base*propose*top-ps*wait
   "Propose wait if there is a state no-change."
   :default
   (state <s> ^attribute state
              ^choices none
             -^superstate.name evaluate-operator
             -^operator.name wait)
-->
   (<s> ^operator <o> + <)
   (<o> ^name wait)}

## ---- evaluate / compare ----

## Preference for default select indifferent-and-worst tied.
## Break a tie by creating indifferent preferences if get a state no-change in an impasse.
## Real states only (v2.45): in look-ahead (^real false) selection-world resolves a selection that has no operator left
## (initialize-failure-evaluation, the indifference rules); breaking the tie here let the look-ahead continue with a random
## operator below the depth limit (Soar - To-do row 29).
sp {soar-base*compare*default*select*indifferent-and-worst*tied
   "Indifferent an operator if it leads to a tie that can not be resolved."
   :default
   (state <s1> ^operator <o> +
               ^real true)
   (state <s2> ^impasse tie
               ^superstate <s1>
               ^item <o>
               ^quiescence t)
   (state <s3> ^attribute state
           ^choices none
           ^superstate <s2>
           ^quiescence t)
   -->
   (<s1> ^operator <o> =, < )}


## Random continuation in look-ahead (JL, 21 Nov 2026): without a cost metric and without optimizing, an unresolvable tie in a
## look-ahead state is broken at random as in a real state, so the look-ahead goes on past the depth limit. Any plan is acceptable
## there, and this finds one much faster (artists-2: 82-283 instead of 4,028-4,408 decisions). With a cost metric or optimize true the
## search stays sound (row 29 repair): the tie rule above applies only in real states.
## v2.49: the rule also tests (<s1> ^random-continuation true), so the o-supported marker below is set first. Without that test
## the tie was broken in the propose phase, before the apply phase in which the marker can fire, and the marker never fired:
## failures on random paths came back as real failures (Soar - To-do row 3: Rosie suko seed 1 lost its four correct first moves).
sp {soar-base*compare*default*select*indifferent-and-worst*tied*look-ahead*no-cost
   "Indifferent an operator in a look-ahead state if it leads to a tie that can not be resolved (no cost metric, optimize false)."
   :default
   (state <s1> ^operator <o> +
               ^real false
               ^random-continuation true
               ^flags <f>)
   (<f> ^cost-metric none
        ^optimize false)
   (state <s2> ^impasse tie
               ^superstate <s1>
               ^item <o>
               ^quiescence t)
   (state <s3> ^attribute state
           ^choices none
           ^superstate <s2>
           ^quiescence t)
   -->
   (<s1> ^operator <o> =, < )}

## Mark random continuation (v2.47): the look-ahead state whose tie the rule above breaks at random records it, so that a
## failure found in that state from then on is not passed back as the evaluation of the operator being evaluated (it shows
## only that one random path failed; selection-world*apply*evaluate-operator*symbolic-evaluation*from-subgoal*random-continuation).
sp {soar-base*elaborate*look-ahead*random-continuation
   :default
   :o-support
   (state <s1> ^operator <o> +
               ^real false
               ^flags <f>)
   (<f> ^cost-metric none
        ^optimize false)
   (state <s2> ^impasse tie
               ^superstate <s1>
               ^item <o>
               ^quiescence t)
   (state <s3> ^attribute state
           ^choices none
           ^superstate <s2>
           ^quiescence t)
   -->
   (<s1> ^random-continuation true)}

## ---- operator application ----

## Apply default top-goal halt operator failure.
## HALT under bad conditions
sp {soar-base*apply*default*top-goal*halt*operator*failure
   "Halt if no operator can be selected for the top goal."
   :default
   (state <s> ^superstate nil)
   (state <ss> ^impasse constraint-failure ^superstate <s>)
   -->
   (write (crlf) |No operator can be selected for top goal.| )
   (write (crlf) |Soar must halt.| )
   (halt)}
