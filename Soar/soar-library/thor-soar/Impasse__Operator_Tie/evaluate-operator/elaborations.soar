## Elaborate evaluate-operator state look-ahead-operator duplicate two-arguments find-object -> sets duplicate-look-ahead-operator.
sp {evaluate-operator*elaborate*state*look-ahead-operator*duplicate*two-arguments*find-object
   :default
   (state <s> ^name evaluate-operator
             -^applied-lookahead true
              ^operator <operator> +
              ^look-ahead-operator <look-ahead-operator>)
   (<operator> ^name find-object
               ^argument2.object-handle <container-object-handle>
               ^argument1 <object1>)
   (<object1> ^object-handle <unbound-object-handle2>)
   (<look-ahead-operator> ^name find-object
                          ^argument2.object-handle <container-object-handle>
                          ^argument1 <object1x>)
   (<object1x> ^object-handle <unbound-object-handle2>)
  -{(<s> ^operator { < <operator> <operator2> } +)
   (<operator2> ^name find-object
               ^argument2.object-handle <container-object-handle>
               ^argument1 <object2>)
   (<object2> ^object-handle <unbound-object-handle2>)}
-->
   (<s> ^duplicate-look-ahead-operator <operator>)}

## Elaborate evaluate-operator state look-ahead-operator duplicate two-arguments argument1-ungrounded -> sets duplicate-look-ahead-operator.
sp {evaluate-operator*elaborate*state*look-ahead-operator*duplicate*two-arguments*argument1-ungrounded
   :default
   (state <s> ^name evaluate-operator
             -^applied-lookahead true
              ^operator <operator> +
              ^look-ahead-operator <look-ahead-operator>)
   (<operator> ^name { << discard put-on put-in store cook cook-stove cook-microwave make-coffee >> <name> }
               ^desireds.world-context.objects.object <unbound-object>
               ^argument1.object-handle <unbound-object-handle1>
               ^argument2.object-handle <container-object-handle>)
   (<unbound-object> ^class <class> ##
                     ^object-handle <unbound-object-handle1>)
   (<look-ahead-operator> ^name <name>
                          ^desireds.world-context.objects.object <unbound-object2>
                          ^argument1.object-handle <object-handle2>
                          ^argument2.object-handle <container-object-handle>)
   (<unbound-object2> ^class <class>
                      ^object-handle <unbound-object-handle2>)
-->
   (<s> ^duplicate-look-ahead-operator <operator>)}

