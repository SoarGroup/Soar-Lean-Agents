#########################################
## _epmem-flags
## Created 2024/01/13
#########################################

epmem --set append on
epmem -e
epmem --set database file
epmem -s learning on
epmem --set trigger dc
epmem --set timers three
epmem --stats time
epmem --set phase output
epmem --set graph-match on
epmem --set path c:\temp

