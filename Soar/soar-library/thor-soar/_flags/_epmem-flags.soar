# State features we want to be in episodes should not be included in this list
epmem --set exclusions constants
epmem --set exclusions flags
epmem --set exclusions io
epmem --set exclusions reward-link
epmem --set exclusions smem
epmem --set exclusions top-state 
epmem --set exclusions svs
epmem --set exclusions external-top-state 
epmem --set exclusions attends 
epmem --set exclusions type
epmem --set exclusions superstate
#epmem --set exclusions operator

epmem --set exclusions smem-query
epmem --set exclusions smem
epmem --set exclusions smem-storage-structure
epmem --set exclusions thor-soar-classes
epmem --set exclusions super-desireds
epmem --set exclusions scene
#epmem --set exclusions desireds

epmem --init
