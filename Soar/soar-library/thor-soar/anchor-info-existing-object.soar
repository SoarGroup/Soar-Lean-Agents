## anchor-info-existing-object.soar -- thor-soar: 1 elaboration, 16 proposals, 14 compares, 3 applications.

## Propose anchor-info-existing-object.
sp {thor-soar*propose*anchor-info-existing-object
    :default
   (state <s> ^problem-space.name thor-world
              ^real true
              ^desireds.desired.info <dinfo>
              ^external-top-state.scene.objects.object <anchored-object>)  # real-object
   (<anchored-object> ^anchored true
                      ^class <class>)
   (<dinfo> ^unanchored-object <unanchored-object>)
   (<unanchored-object> ^class <class>
                       -^<< cook-state dirty open broken temperature activated liquid-contents reachable sliced >> )  # Only class
  -(<s> ^world.<< in on controlled-by >>.<< argument1 argument2 >> <unanchored-object>)
  -(<s> ^world.info.unanchored-object <unanchored-object>)
-->
   (<s> ^operator <op> + =)   # Bug - should allow ties
   (<op> ^name anchor-info-existing-object
         ^anchored-from scene
         ^task-operator false
         ^argument1 <anchored-object>  # world object that meets constraint
         ^argument2 <unanchored-object>)        # used to create maches
}

## Propose anchor-info-existing-object.
## Does not support it being part of a in or on relation
sp {thor-soar*propose*anchor-info-existing-object*one-more-feature
    :default
   (state <s> ^problem-space.name thor-world
              ^real true
              # ^quiescence t
              ^desireds.desired.info <dinfo>
             -^external-top-state.world.info.unanchored-object <unanchored-object>
              ^external-top-state.scene.objects.object <anchored-object>)  # real-object
   (<anchored-object> ^anchored true
                      ^class <class>
                      ^{ <> class <attribute> } <value>)
   (<dinfo> ^unanchored-object <unanchored-object>)
   (<unanchored-object> ^class <class>
                        ^{ <attribute> << cook-state dirty open broken temperature activated liquid-contents reachable sliced >>} <value>
                       -^{ <> <attribute>  << cook-state dirty open broken temperature activated liquid-contents reachable sliced >>})  # object that is unanchored to be replaced
  -(<s> ^world.<< in on controlled-by >>.<< argument1 argument2 >> <unanchored-object>)
-->
   (<s> ^operator <op> + =)
   (<op> ^name anchor-info-existing-object
         ^anchored-from scene
         ^task-operator false
         ^argument1 <anchored-object>  # world object that meets constraint
         ^argument2 <unanchored-object>)        # used to create maches
}

