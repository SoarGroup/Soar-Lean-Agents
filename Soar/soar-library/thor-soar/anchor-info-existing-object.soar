## Preference for prefer anchor-info-controlled-by-to-desired controls-object-handle.
sp {thor-soar*prefer*anchor-info-controlled-by-to-desired*controls-object-handle
    :default
   (state <s> ^problem-space.name thor-world
              ^world <world>
              ^super-desireds.desired.in.argument2.object-handle <burner-object-handle>
              ^operator <op1> +)
   (<world> ^objects.object <stoveknob-object>
            ^controlled-by <controlled-by>)
   (<controlled-by> ^argument1.object-handle <burner-object-handle>
                    ^argument2 <stoveknob-object>)
   (<stoveknob-object> ^object-handle <stoveknob-object-handle>)
   (<op1> ^name anchor-info-existing-object
          ^argument1.object-handle <stoveknob-object-handle>)
-->
   (<s> ^operator <op1> >)
}

## Preference for avoid anchor-info-existing-object not reachable.
## avoid onces that are not close
sp {thor-soar*avoid*anchor-info-existing-object*not*reachable
    :default
   (state <s> ^operator <op1> +
                        <op2> +)
   (<op1> ^name anchor-info-existing-object
          ^argument1.reachable false
          ^anchored-from <world>)
   (<op2> ^name anchor-info-existing-object
          ^argument1.reachable true
          ^anchored-from <world>)
-->
   (<s> ^operator <op2> > <op1>)
}

## Preference for avoid anchor-info-existing-object not reachable visible.
sp {thor-soar*avoid*anchor-info-existing-object*not*reachable*visible
    :default
   (state <s> ^operator <op1> +
                        <op2> +)
   (<op1> ^name anchor-info-existing-object
          ^argument1 <argument1>
          ^anchored-from <world>)
   (<argument1> ^reachable <reachable>
                ^visible false)
   (<op2> ^name anchor-info-existing-object
          ^argument1 <argument11>
          ^anchored-from <world>)
   (<argument1> ^reachable <reachable>
                ^visible true)
-->
   (<s> ^operator <op2> > <op1>)
}

## Preference for avoid anchor-info-existing-object higher handle.
## avoid higher name - breaks ties consistently - important in look-ahead
## BUG - should get a tie and search for best
sp {thor-soar*avoid*anchor-info-existing-object*higher*handle
    :default
   (state <s> ^operator <op1> +
                        { <> <op1> <op2> } +)
   (<op1> ^name anchor-info-existing-object
          ^argument1.object-handle < <object-handle>)
   (<op2> ^name anchor-info-existing-object
          ^argument1.object-handle <object-handle>)
-->
   (<s> ^operator <op2> = 1.)
}

## Preference for anchor-info-smem.
sp {thor-soar*compare*anchor-info-smem
    :default
   (state <s> ^operator <op1> +
                        {<> <op1> <op2> } +)
   (<op1> ^name anchor-info-existing-object)
   (<op2> ^name << finish-brewing finish-cooking search-smem >>)
-->
   (<s> ^operator <op1> > <op2>)
}

## Preference for anchor-world-better-scene.
sp {thor-soar*compare*anchor-world-better-scene
    :default
   (state <s> ^operator <op1> +
                        {<> <op1> <op2> } +)
   (<op1> ^name anchor-info-existing-object
          ^anchored-from world)
   (<op2> ^name anchor-info-existing-object
          ^anchored-from scene)
-->
   (<s> ^operator <op1> > <op2>)
}

## Apply anchor-info-existing-object -> sets info, unanchored-object, anchored-object.
sp {apply*anchor-info-existing-object
    :default
   (state <s> ^operator <op>
              ^world <world>)
   (<world> ^objects.object <unanchored-object>
           -^anchored-world true)
   #    (<world> ^anchored-world true
   #        ^objects.object <unanchored-object>)
   (<op> ^name anchor-info-existing-object
         ^argument1 <anchored-object>
         ^argument2 <unanchored-object>)
  -{(<world> ^info <info2>)
    (<info2> ^unanchored-object <unanchored-object>
             ^anchored-object <anchored-object>)}
   (<unanchored-object> ^object-handle <unanchored-object-handle>)
   (<anchored-object> ^object-handle <anchored-object-handle>)
-->
   (<world> ^info <info>)
   (<info> ^unanchored-object <unanchored-object>
           ^anchored-object <anchored-object>)
}

## Apply anchor-info-existing-object -> sets info, unanchored-object, anchored-object.
sp {apply*anchor-info-existing-object2
    :default
   (state <s> ^operator <op>
              ^world <world>)
   (<world> ^anchored-world true
           -^objects.object <unanchored-object>)
  -{(<s> ^world <world2>)
    (<world2> ^objects.object <unanchored-object>
             -^anchored-world true)}
   (<op> ^name anchor-info-existing-object
         ^argument1 <anchored-object>
         ^argument2 { <> <anchored-object> <unanchored-object>})
  -{(<s> ^world.info <info2>)
    (<info2> ^unanchored-object <unanchored-object>
             ^anchored-object <anchored-object>)}
   (<unanchored-object> ^object-handle <unanchored-object-handle>)
   (<anchored-object> ^object-handle <anchored-object-handle>)
-->
   (<world> ^info <info>)
   (<info> ^unanchored-object <unanchored-object>
           ^anchored-object <anchored-object>)
}
