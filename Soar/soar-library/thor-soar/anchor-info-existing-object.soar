## Apply find-object -> sets success.
## OK?
sp {thor-soar*propose*anchor-info-existing-object*internal-class-only
    :default
   (state <s> ^problem-space.name thor-world
              ^superstate <superstate>
              ^real false
              ^operator.name << anchor-object-class anchor-relation-class anchor-info-existing-object >>)  # real-object
   (<superstate> ^desireds <desireds>
                 ^duplicate-look-ahead-operator <look-ahead>
                 ^operator <look-ahead>)
   (<look-ahead> ^name find-object)
-->
   (<superstate> ^success <desireds>)
}

