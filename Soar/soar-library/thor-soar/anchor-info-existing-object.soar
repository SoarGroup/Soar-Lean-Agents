## Elaborate anchor-info-existing-object distance-surface -> sets expected-distance.
## Prefer closer surfaces
sp {thor-soar*compare*anchor-info-existing-object*distance-surface
    :default
   (state <s> ^problem-space.name thor-world
              ^scene.objects.object <object>
              ^external-top-state.io.input-link.self.pose <pos>
              ^operator <op1> +)
   (<pos> ^x <x> ^y <y>)
   (<object> ^x <x1>
             ^y <y1>
             ^class surface
             ^object-handle <object-handle>)
   (<op1> ^name anchor-info-existing-object
          ^argument1 <arg1>)
   (<arg1> ^object-handle <object-handle>)
-->
   (<op1> ^expected-distance (+ (compute-range (* 100.0 <x>) (* 100.0 <y>) (* 100.0 <x1>) (* 100.0 <y1>)) 0))
}

## Preference for anchor-info-existing-object distance.
sp {thor-soar*compare*anchor-info-existing-object*distance
    :default
   (state <s> ^operator <op1> +
                        { <> <op1> <op2> }  +)
   (<op1> ^name anchor-info-existing-object
          ^argument1.visible <visable>
          ^argument1.reachable <reach>
          ^expected-distance <ed>)
   (<op2> ^name anchor-info-existing-object
          ^argument1.visible <visable>
          ^argument1.reachable <reach>
          ^expected-distance > <ed>)
-->
   (<s> ^operator <op1> > <op2>)
}

## Preference for anchor-info-existing-object super on scene.
## Pick the one that is desired
## Better for chunking to have separate
sp {thor-soar*compare*anchor-info-existing-object*super*on*scene
    :default
   (state <s> ^problem-space.name thor-world
              ^external-top-state.scene.on <world-relation>
              ^superstate.desireds.desired.on <drelation>
              ^operator <op1> +)
   (<world-relation> ^argument1.object-handle <object-handle>
                     ^argument2 <anchored-object>)
   (<drelation> ^argument1.object-handle <object-handle>
                ^argument2.object-handle <unanchored-object-handle>)
   (<op1> ^name anchor-info-existing-object
          ^argument1 <anchored-object>
          ^argument2.object-handle <unanchored-object-handle>)
-->
   (<s> ^operator <op1> >)
}

