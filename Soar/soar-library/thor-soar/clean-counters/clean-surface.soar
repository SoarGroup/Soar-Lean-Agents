   (<object> ^graspable true
             ^class << book creditcard kettle mug pot bowl >> #  pan
            -^broken true
            -^sliced true
             ^object-handle <object-handle>)
  -{(<world> ^in <in>)
    (<in> ^argument1.object-handle <object-handle>)}
  -{(<world> ^on <on>)
