## Apply operator unachieved-desired container stored -> sets unachieved.
sp {thor-soar*elaborate*operator*unachieved-desired*container*stored
    :default
   (state <s> ^operator.desireds <desireds>)
   (<desireds> ^desired <desired>)
   (<desired> ^stored <in-container-object>)
   (<in-container-object> ^argument1.object-handle <object-handle>
                          ^argument2.object-handle <container-handle>)
  -{(<s> ^world.in <in-container-object2>
         ^world.objects.object <container-object2>)
    (<container-object2> ^open false
                         ^object-handle <container-handle>)
    (<in-container-object2> ^argument1 <argument1>
                            ^argument2 <argument2>)
    (<argument1> ^<< origin-object-handle object-handle >> <object-handle>
                 ^anchored true)
    (<argument2> ^object-handle <container-handle>
                 ^anchored true)}
   -{(<desireds> ^achieved <desired>)}
   -{(<desireds> ^desired <desired>
                 ^achieved <desired2>)
     (<desired> ^disjunction <desired2>)}
-->
   (<desireds> ^unachieved <desired>)
}

