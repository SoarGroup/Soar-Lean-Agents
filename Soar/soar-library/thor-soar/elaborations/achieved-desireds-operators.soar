    :default
   (state <s> ^operator.desireds <desireds>
              ^world.in <in-container-object>
              ^world.objects.object <object>)
   (<object> ^open false
             ^object-handle <container-handle>)
   (<desireds> ^desired <desired>)
   (<desired> ^stored <d-in-container-object>)
   (<in-container-object> ^argument1 <argument1>
                          ^argument2 <argument2>)
   (<d-in-container-object> ^argument1.object-handle <object-handle>
                            ^argument2.object-handle <container-handle>)
   (<argument1> ^object-handle <object-handle>
                ^anchored true)
   (<argument2> ^object-handle <container-handle>
                ^anchored true)
-->
   (<desireds> ^achieved <desired>
               ^unachieved <desired> -)
}

