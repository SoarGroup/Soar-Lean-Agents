## achieved-desireds-operators.soar -- thor-soar: 22 applications.

## Apply operator acheived-desired handle2 -> sets achieved, unachieved.
sp {thor-soar*elaborate*operator*acheived-desired*handle2
    :default
   (state <s> ^operator.desireds <desireds>
              ^world.objects.object <object>)
   (<object> ^{ <> object-handle <> anchored <> origin-object-handle <> duplicate-of <desired-attribute>} <desired-value>
             ^<< origin-object-handle object-handle >> <handle>
             ^anchored true)
   (<desireds> ^desired <desired>)
   (<desired> ^object <desired-object>)
   (<desired-object> ^{ <> object-handle <> origin-object-handle <> duplicate-of <desired-attribute>} <desired-value>
                     ^<< origin-object-handle object-handle >>  <handle>)
-->
   (<desireds> ^achieved <desired>
               ^unachieved <desired> -)
}

## Apply operator achieved-desired disjunction -> sets achieved.
sp {thor-soar*elaborate*operator*achieved-desired*disjunction
    :default
   (state <s> ^operator.desireds <desireds>)
   (<desireds> ^desired <desired1> {<> <desired1> <desired2> }
               ^achieved <desired1>)
   (<desired1> ^disjunction <desired2>)
-->
   (<desireds> ^achieved <desired2>)
}

## Apply operator acheived-desired abstract-property -> sets achieved.
## Abstract Property
sp {thor-soar*elaborate*operator*acheived-desired*abstract-property
    :default
   (state <s> ^operator.desireds <desireds>
              ^world.abstract-property <abstract-property>)
   (<desireds> ^desired <desired>)
   (<desired> ^object <object>)
   (<object> ^<abstract-property> <desired-value>)
-->
   (<desireds> ^achieved <desired>)
}

## Apply operator unacheived-desired -> sets unachieved, achieved.
sp {thor-soar*elaborate*operator*unacheived-desired
    :default
   (state <s> ^operator.desireds <desireds>
             -^world.abstract-property)
   (<desireds> ^desired <desired>)
   (<desired> ^object <desired-object>)
   (<desired-object> ^{ <> object-handle <> duplicate-of <> anchored <> origin-object-handle <desired-attribute>} <desired-value>
                     ^object-handle <handle>)
  -{(<s> ^world.objects.object <object>)
    (<object> ^<desired-attribute> <desired-value>
              ^<< object-handle origin-object-handle >> <handle>
              ^anchored true)}
  -{(<desireds> ^desired <desired>
                ^achieved <desired2>)
    (<desired> ^disjunction <desired2>)}
-->
   (<desireds> ^unachieved <desired>
               ^achieved <desired> -)
}

