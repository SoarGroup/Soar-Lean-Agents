              ^world.holding-object <holding-object>)
   (<holding-object> ^object-handle { <> <object-handle> }
                     ^origin-object-handle { <> <object-handle> })
   (<desireds> ^desired <desired>)
   (<desired> ^holding-object.object-handle <object-handle>)
-->
   (<desireds> ^unachieved <desired>
               ^achieved <desired> -)
}

