## Elaborate state unachieved-desired holding unachieved1 -> sets unachieved, achieved.
sp {thor-soar*elaborate*state*unachieved-desired*holding*unachieved1
    :default
   (state <s> ^desireds <desireds>)
  -{(<s> ^world.holding-object <holding-object>)
    (<holding-object> ^object-handle <object-handle>  # don't use <> because can be holding something that is on something else and both are held
                      )}
  -{(<s> ^world.holding-object <holding-object>)
    (<holding-object> ^origin-object-handle <object-handle>  # don't use <> because can be holding something that is on something else and both are held
                      )}
   (<desireds> ^desired <desired>)
   (<desired> ^holding-object.object-handle <object-handle>)
-->
   (<desireds> ^unachieved <desired>
               ^achieved <desired> -)
}

