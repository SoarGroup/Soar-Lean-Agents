## achieved-desireds.soar -- thor-soar: 81 elaborations.

## Elaborate state achieved-desired anchored -> sets achieved.
sp {thor-soar*elaborate*state*achieved-desired*anchored
    :default
   (state <s> ^desireds <desireds>)
   (<desireds> ^desired <desired>)
   (<desired> ^object <desired-object>)
   (<desired-object> ^anchored true
                     ^object-handle <handle>
                    -^ { <> anchored <> object-handle })
   (<s> ^world.objects.object <object>)
   (<object> ^anchored true
              ^<< object-handle origin-object-handle >>  <handle>)
-->
   (<desireds> ^achieved <desired>)
}

## Elaborate state achieved-desired handle origin accessible -> sets achieved.
sp {thor-soar*elaborate*state*achieved-desired*handle*origin*accessible
    :default
   (state <s> ^desireds <desireds>
              ^world.objects.object <object>)
   (<object> ^accessible <desired-value>
             ^anchored true
             ^origin-object-handle <handle>)
   (<desireds> ^desired <desired>)
   (<desired> ^object <desired-object>)
   (<desired-object> ^accessible <desired-value>
                     ^object-handle <handle>)
-->
   (<desireds> ^achieved <desired>)
}

