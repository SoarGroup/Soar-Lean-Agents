   (state <s> ^desireds <desireds>)
  -{(<s> ^world.objects.object <sliced-object>)
    (<sliced-object> ^origin-object-handle <object-handle>
                     ^anchored true
                     ^sliced true)}
   (<desireds> ^desired <desired>)
   (<desired> ^object <sliced-d-object>)
   (<sliced-d-object> ^origin-object-handle <object-handle>
                      ^sliced true)
-->
   (<desireds> ^unachieved <desired>)
}

## Elaborate state desireds achieved desired completed-task -> sets achieved.
## Desired: completed-task
## Achieved when there is a completed-task event on the world
sp {thor-soar*elaborate*state*desireds*achieved*desired*completed-task
    :default
   (state <s> ^desireds <desireds>
              ^world <world>)
   (<desireds> ^desired <desired>)
   (<desired> ^completed-task <task>)
   (<world> ^completed-task <task>)
-->
   (<desireds> ^achieved <desired>)
}

## Elaborate state desireds unachieved desired completed-task -> sets unachieved.
## Unachieved if there is not a completed-task event on the world
sp {thor-soar*elaborate*state*desireds*unachieved*desired*completed-task
    :default
   (state <s> ^desireds <desireds>)
   (<desireds> ^desired <desired>)
   (<desired> ^completed-task <task>)
  -{(<s> ^world.completed-task <task>)}
  -{(<desireds> ^achieved <desired>)}
-->
   (<desireds> ^unachieved <desired>)
}

## Elaborate achieved desired from interaction -> sets achieved.
## Top-state: elaborate task achieved from interaction
## (When the instructor told us the goal was achieved)
sp {thor-soar*elaborate*achieved*desired*from*interaction
   :i-support
    :default
   (state <s> ^superstate nil
              ^interaction-stack.top-segment <top-segment>
              ^desireds <desireds>)
   (<top-segment> ^parameters <parameters>)
   (<parameters> ^achieved <desired>)
   (<desireds> ^desired <desired>)
-->
   (<desireds> ^achieved <desired>)
}

## Elaborate world-context object onto task operator -> sets object.
## If we are proposing a task operator, then copy objects
## from the local world-context onto the operator as well
sp {thor-soar*elaborate*world-context*object*onto*task*operator
    :default
   (state <s> ^desireds <desireds>
              ^operator <operator> +)
   (<operator> ^instance-of composite-operator
               ^task-handle <task-handle>
               ^desireds <op-desireds>)
   (<desireds> ^world-context.objects.object <object>)
   (<op-desireds> ^world-context.objects <objects>)
-->
   (<objects> ^object <object>)
}
