## Elaborate attend desired object -> sets attend.
## AM: Attend to objects in a completed-task desired
sp {thor-soar*elaborate*attend*desired*object
    :default
   (state <s> ^desireds.desired.completed-task <task>
              ^quiescence t
              ^external-top-state.attends <attends>)
   (<task> ^{ << argument1 argument2 argument3 >> } <argument>)
   (<argument> ^object <object>)
   (<object> ^object-handle <handle>
            -^anchored false)
  -(<s> ^external-top-state.world.objects.object.object-handle <handle>)
  -(<s> ^world.objects.object.object-handle <handle>)
-->
   (<attends> ^attend <handle>)
}
