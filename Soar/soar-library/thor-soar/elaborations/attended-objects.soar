## attended-objects.soar -- thor-soar: 27 elaborations.

## Elaborate attend desired origin-object -> sets attend.
sp {thor-soar*elaborate*attend*desired*origin-object
    :default
   (state <s> ^desireds.desired.object.object-handle <handle>
              ^quiescence t
              ^scene.objects.object <object>
              ^external-top-state.attends <attends>)
   (<object> ^origin-object-handle <handle>
            -^class << breadsliced applesliced bananasliced carrotsliced potatosliced >>
             ^object-handle <new-handle>)
  -(<s> ^external-top-state.world.objects.object.object-handle <new-handle>)
  -(<s> ^world.objects.object.object-handle <handle>)
-->
   (<attends> ^attend <new-handle>)
}

## Elaborate attend desireds -> sets attend.
sp {thor-soar*elaborate*attend*desireds
    :default
   (state <s> ^desireds.desired.object <object>
              ^quiescence t
              ^external-top-state.attends <attends>)
   (<object> ^object-handle <handle>
            -^class << breadsliced applesliced bananasliced carrotsliced potatosliced >>
            -^anchored false)
   -(<s> ^external-top-state.world.objects.object.object-handle <handle>)
   -(<s> ^world.objects.object.object-handle <handle>)
-->
   (<attends> ^attend <handle>)
}

