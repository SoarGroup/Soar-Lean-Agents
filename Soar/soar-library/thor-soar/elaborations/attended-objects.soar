## Elaborate attend desireds relation world1 -> sets attend.
sp {thor-soar*elaborate*attend*desireds*relation*world1
    :default
   (state <s> ^world <world>
              ^quiescence t
              ^external-top-state <external-top-state>)
   (<external-top-state> ^attends <attends>
                         ^scene.objects.object <object-scene>)
   (<world> ^objects.object <object>
            ^anchored-world false)
   (<object> ^class { <> floor <class> })
   (<object-scene> ^object-handle <handle>
                   ^class <class>)
  -(<s> ^external-top-state.world.objects.object.object-handle <handle>)
  -(<s> ^world.objects.object.object-handle <handle>)
-->
   (<attends> ^attend <handle>)
}

## Elaborate attend desireds relation world2 -> sets attend.
sp {thor-soar*elaborate*attend*desireds*relation*world2
    :default
   (state <s> ^world <world>
              ^quiescence t
              ^external-top-state <external-top-state>)
   (<external-top-state> ^attends <attends>
                         ^scene.objects.object <object-scene>)
   (<world> ^<< on in >>.<< argument1 argument2 >> <object>
            ^anchored-world true)
   (<object> ^object-handle <handle>
            -^class << breadsliced applesliced bananasliced carrotsliced potatosliced floor >>
            -^anchored false)
   (<object-scene> ^object-handle <handle>
                  -^class << potatoSliced carrotsliced applesliced floor >>)
  -(<world> ^objects.object.object-handle <handle>)
  -(<s> ^external-top-state.world.objects.object.object-handle <handle>)
-->
   (<attends> ^attend <handle>)
}

## Elaborate attend desireds object world2 -> sets attend.
sp {thor-soar*elaborate*attend*desireds*object*world2
    :default
   (state <s> ^world <world>
              ^quiescence t
              ^external-top-state <external-top-state>)
   (<external-top-state> ^attends <attends>)
   (<world> ^objects.object <object>
           -^anchored-world true)
   (<external-top-state> ^scene.objects.object <object-scene>)
   (<object> ^object-handle <handle>
            -^class << breadsliced applesliced bananasliced carrotsliced potatosliced floor >>
            -^anchored false)
   (<object-scene> ^object-handle <handle>)
  -(<world> ^objects.object.object-handle <handle>)
  -(<s> ^external-top-state.world.objects.object.object-handle <handle>)
-->
   (<attends> ^attend <handle>)
}

## Elaborate attend desireds desired-on-in -> sets attend.
sp {thor-soar*elaborate*attend*desireds*desired-on-in
    :default
   (state <s> ^desireds.desired.<< on in stored >>.<< argument1 argument2 >> <object>
              ^quiescence t
              ^external-top-state <external-top-state>)
   (<external-top-state> ^attends <attends>
                         ^scene.objects.object <object2>)
   (<object2> ^object-handle <handle>
             -^class << breadsliced applesliced bananasliced carrotsliced potatosliced floor >>)
   (<object> ^object-handle <handle>
            -^class << breadsliced applesliced bananasliced carrotsliced potatosliced floor >>
            -^anchored false)
  -(<external-top-state> ^world.objects.object.object-handle <handle>)
  -(<s> ^world.objects.object.object-handle <handle>)
-->
   (<attends> ^attend <handle>)
}

## Elaborate attend desired holding-object -> sets attend.
sp {thor-soar*elaborate*attend*desired*holding-object
    :default
   (state <s> ^desireds.desired.holding-object <holding-object>
              ^world.objects.object <objectx>
              ^quiescence t
              ^external-top-state.attends <attends>)
   (<objectx> ^object-handle <handle>
             -^anchored false)
   (<holding-object> ^object-handle { <> none <handle> }
                    -^anchored false)
  -(<s> ^external-top-state.world.objects.object.object-handle <handle>)
  -(<s> ^world.objects.object.object-handle <handle>)
-->
   (<attends> ^attend <handle>)
}

