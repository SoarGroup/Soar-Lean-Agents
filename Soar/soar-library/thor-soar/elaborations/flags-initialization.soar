## flags-initialization.soar -- thor-soar: 5 elaborations.

## Elaborate init-thor-soar flags -> sets flag-override ....
## additional flags in agent-world/elaborations/flag-initialization.soar
sp {elaborate*init-thor-soar*flags
    :default
   (state <s> ^type state
              ^superstate nil)
-->
   (<s> ^flag-override <flags>)
   (<flags> ^task-search-control true    # false:
            ^rl false                         # If true reinforement learning is used. Not recently tested.
            ^iterative-step tie-impasse       # tie-impasse/operator - if impasse, an iterative step is when there is a tie-impasse. if operator, it is when a task operator is applied.
            ^init-evaluation-depth unachieved-desireds #one - uses unacheived-desireds - 1 as initial evaluation depth
            ^smem-store false                 # stores class structures in smem
            ^initialize-scene-with-smem false #### If true, will initialize the scene from smem. Requires previously generating the smem structure (usually with hide-in-container-false) and saving it.
            ^smem-retrieve true ###########  # retrieves objects from smem for grounding
            ^epmem-retrieve false             # retrieve class structures in epmem
            ^clean-up-on-success false        # If true, will clean up after a top-state successful desireds (close doors, turn off the faucet). Haven't tested recently.
            ^above-computed false             # If true, will compute above relationships automatically
            ^mea-operator-selection true      # If true use means-ends analysis to propose operators instead of pure forward search (preconditions satisfied). Not kept up to date. Always true.
            ^cost-metric time                 # none/unit/time. time recommended: the cost of a look-ahead path is the elapsed time (action times), which makes iterative-step tie-impasse meaningful.
            ^explore false                    # Will explore room looking for objects - only needed if view-frustum true
            ^explore-receptacles false        # Will open all closed receptacles and look to see what is inside
            ^hide-in-container-objects true  # If true, then cannot see into a container to see a contained object. If false, will see inside a container.
            ^scan-room true                 # Scans room when wakes up. Need for view-frustum true
            ^view-frustum true)
}

## Elaborate top-state flags agent-mode from input-link -> sets agent-mode.
## Copy the 'agent-mode' wme from the input-link
## (Currently, this has the value 'testing' when running in the experiment runner)
sp {top-state*elaborate*flags*agent-mode*from*input-link
    :default
   (state <s> ^superstate nil
              ^io.input-link.agent-mode <agent-mode>
              ^flags <flags>)
-->
   (<flags> ^agent-mode <agent-mode>)
}

## Elaborate init-thor-soar flags desireds-source profile JEL -> sets desireds-source.
## Each profile should have there own rule that sets the profile flag in there personal load file, such as thor-soar-JEL.soar, which is shown below:
## pushd thor-soar
sp {elaborate*init-thor-soar*flags*desireds-source*profile*JEL
    :default
   (state <s> ^superstate nil
              ^top-state <s>
              ^flags <flags>)
   (<flags> ^profile JEL)
-->
   (<flags> ^desireds-source elaboration)
}

## Elaborate init-thor-soar flags desired from-run-file -> sets desired-selection.
## Specified in run-file
sp {elaborate*init-thor-soar*flags*desired*from-run-file
    :default
   (state <s> ^superstate nil
              ^io.input-link.task-name <task>
              ^external-top-state <s>
              ^flags <flags>)
   (<flags> ^desireds-source elaboration
           -^explore true
           -^explore-receptacles true)
-->
   (<flags> ^desired-selection <task>)
}

