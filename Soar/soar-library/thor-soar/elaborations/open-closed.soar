## open-closed.soar -- thor-soar: 1 elaboration.

## Elaborate state receptacle -> sets open.
sp {elaborations*elaborate*state*receptacle
    :default
   (state <s> ^superstate nil
              ^scene.objects.object <object-int>)
   (<object-int> -^class floor
                  ^receptacle true
                 -^openable true
                 -^derived-from-input.open)
-->
   (<object-int> ^open true)     # so always open
}
