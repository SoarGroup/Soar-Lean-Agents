## reachable.soar -- thor-soar: 4 elaborations.

## Elaborate extract reachable-objects -> sets extract, type, a ....
## reachable
## Created 2024/05/31
sp {thor-soar*extract*reachable-objects
    :default
   (state <s> ^name thor-soar
              ^superstate nil
              ^svs.command <svs-command>)
-->
   (<svs-command> ^extract <filter>)
   (<filter> ^type distance_select
             ^name reachable-objects
             ^a <robot-pos>
             ^b <objects>
             ^distance-type hull
             ^min 0.0
             ^max 2.19) #2.28 cabinet8
            # ^max 2.0) # within 1.2 meters - wasn't enough for the microwave 1.5 was too much for potato
   (<robot-pos> ^type node ^id robot)
   # Select all perception objects (will ignore robot)
   (<objects> ^type tag_select
              ^a.type all_nodes
              ^tag_name object-source
              ^tag_value perception)
}

## Elaborate state world reachable -> sets reachable.
sp {elaborations*elaborate*state*world*reachable
    :default
   (state <s> ^superstate nil
              ^scene.objects.object <object>
              ^io.input-link.objects.object <io-object>
              ^svs.command.extract <filter>)
   (<object> ^object-handle <object-handle>
             -^memory-retrieved true)
   (<io-object> ^object-handle <object-handle>
                ^in-view true)
   (<filter> ^name reachable-objects
             ^result.record.value <object-handle>)
-->
   (<object> ^reachable true)
#   (log 2 |Reachable: | <object-handle> (crlf))
}

## Elaborate state world reachable false -> sets reachable.
sp {elaborations*elaborate*state*world*reachable*false
    :default
   (state <s> ^superstate nil
              ^scene.objects.object <object>)
   (<object> ^object-handle <object-handle>
             -^memory-retrieved true)
 -{(<s> ^io.input-link.objects.object <io-object>
         ^svs.command.extract <filter>)
    (<io-object> ^object-handle <object-handle>
                 ^in-view true)
   # (<object> ^visible true)
    (<filter> ^name reachable-objects
              ^result.record.value <object-handle>)}
-->
   (<object> ^reachable false)
}

## Elaborate state world reachable unknown -> sets reachable.
sp {elaborations*elaborate*state*world*reachable*unknown
    :default
   (state <s> ^superstate nil
              ^scene.objects.object <object>)
   (<object> ^object-handle <object-handle>
              ^memory-retrieved true)
-->
   (<object> ^reachable false)
#   (log 2 |Reachable false smem retrieved: | <object-handle> (crlf))
}
