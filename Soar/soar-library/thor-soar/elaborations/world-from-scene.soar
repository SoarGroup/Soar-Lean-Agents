## Elaborate state world-from-scene holding-object -> sets holding-object.
## Always include holding-object
sp {thor-soar*elaborate*state*world-from-scene*holding-object
    :default
   (state <s> ^name thor-soar
              ^top-state <s>
              ^scene.holding-object <holding-object>
              ^world <world>)
   (<holding-object> ^object-handle <object-handle>)
   (<world> ^anchored-world true)
  -(<world> ^duplicate-of.holding-object <holding-object>)
-->
   (<world> ^holding-object <holding-object>)
}

