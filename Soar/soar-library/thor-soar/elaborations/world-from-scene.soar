## world-from-scene.soar -- thor-soar: 6 elaborations.

## Elaborate state world-from-scene copy-in arg1 -> sets in.
sp {thor-soar*elaborate*state*world-from-scene*copy-in*arg1
    :default
   (state <s> ^name thor-soar
              ^top-state <s>
              ^scene.in <in>
              ^world <world>)
   (<in> ^argument1.object-handle <object-handle>
        -^argument2.class floor)
   (<world> ^objects.object.object-handle <object-handle>
            ^anchored-world true)
  -(<world> ^duplicate-of.in <in>)
-->
   (<world> ^in <in>)
}

## Elaborate state world-from-scene copy-in arg2 -> sets in.
sp {thor-soar*elaborate*state*world-from-scene*copy-in*arg2
    :default
   (state <s> ^name thor-soar
              ^top-state <s>
              ^scene.in <in>
              ^world <world>)
   (<in> ^argument2 <object>
        -^argument1.object-handle <object-handle>)
   (<object> ^object-handle <object-handle>
            -^class floor)
   (<world> ^objects.object.object-handle <object-handle>
            ^anchored-world true)
  -(<world> ^duplicate-of.in <in>)
-->
   (<world> ^in <in>)
}

