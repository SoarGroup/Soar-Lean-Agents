## external-operator-application.soar -- thor-soar: 2 elaborations, 15 applications.

## Apply turn-on -> sets perform-action, argument1.
sp {apply*operator*external*turn-on*stove
    :default
   (state <s> ^operator <operator>
              ^internal-actions false
            #  ^quiescence t
              ^io.output-link <output>)
   (<operator> ^name <operator-name>
               ^action-handle turn-on
               ^pre-conditions-satisfied true
               ^argument-count 2
               ^argument1 <argument1>)
   (<argument1> ^class stoveknob
                ^object-handle <argument1-handle>)
-->
   (log 1 (crlf) |Apply | <operator-name> |: | <argument1-handle> |, action: turn-on external.|)
   (<output> ^perform-action <perform>)
   (<perform> ^name turn-on
              ^argument1 <argument1-handle>)
}

## Apply look-at-point -> sets perform-action, object, x ....
sp {apply*operator*external*argument1*look-at
    :default
   (state <s> ^operator <operator>
              ^internal-actions false
              ^quiescence t
              ^io.output-link <output>)
   (<operator> ^name <operator-name>
               ^action-handle look-at
               ^pre-conditions-satisfied true
               ^argument-count 1
               ^argument1 <argument1>)
   (<argument1> ^x <x>
                ^y <y>
                ^z <z>
                ^object-handle <argument1-handle>)
-->
   (log 1 (crlf) |Apply | <operator-name> |: | <argument1-handle> |, action: look-at external.|)
   (<output> ^perform-action <perform>)
   (<perform> ^name look-at-point
              ^object <argument1-handle>
              ^x <x>
              ^y <y>
              ^z <z>)
}

## Elaborate operator external argument1 look-at2 -> sets looked-at.
sp {apply*operator*external*argument1*look-at2
   :o-support
    :default
   (state <s> ^superstate nil
              ^scene.objects.object <object>
              ^io.output-link <output>)
   (<object> ^object-handle <argument1-handle>)
   (<output> ^perform-action <perform>)
   (<perform> ^name look-at-point
              ^object <argument1-handle>
              ^status success)
-->
   (<object> ^looked-at true)
}

## Apply operator task create completed-task world -> sets completed-task.
## If a task composite-operator is finished,
## (satisfied preconditions, no effect-desireds)
sp {apply*operator*task*create*completed-task*world
    :default
   (state <s> ^operator <operator>
              ^world <world>)
   (<world> ^anchored-world true)
   (<operator> ^name <operator-name>
               ^task-handle <task-handle>
               ^pre-conditions-satisfied true
               ^effect-desireds.desired-count 0
               ^super-desired.completed-task <task>)
-->
   (<world> ^completed-task <task>)
}

## Apply operator task create completed-task world action -> sets completed-task.
sp {apply*operator*task*create*completed-task*world*action
    :default
   (state <s> ^operator <operator>
              ^io.output-link <output>
              ^world <world>)
   (<world> ^anchored-world true)
   (<operator> ^name <operator-name>
               ^task-operator true
               ^action-handle <action-handle>
               ^pre-conditions-satisfied true
               ^super-desired.completed-task <task>)
   (<output> ^perform-action <perform>)
   (<perform> ^name <action-handle>
              ^status success)
-->
   (<world> ^completed-task <task>)
}

## Apply operator external argument2 no-handle1 no-handle2 -> sets perform-action, argument1, argument2.
## Overlays rule from agent-world that does not swap the order. Not sure if this is a thor-soar thing or a mistake in the rule
sp {apply*operator*external*argument2*no-handle1*no-handle2
   :default
   (state <s> ^operator <operator>
              ^quiescence t
              ^internal-actions false
              ^io.output-link <output>)
   (<operator> ^name <operator-name>
               ^action-handle { <> turn-on <action-handle> }
               ^pre-conditions-satisfied true
               ^argument-count 2
               ^argument1 <argument1>
               ^argument2 <argument2>)
   (<argument1> -^object-handle)
   (<argument2> -^object-handle)
-->
   (log 1 (crlf) |Apply | <operator-name> |: | <argument1> |, | <argument2> |, action: | <action-handle> | external.|)
   (<output> ^perform-action <perform>)
   (<perform> ^name <action-handle>
              ^argument1 <argument2>
              ^argument2 <argument1>)
}

## ---- Output form (v2.47, World-Conventions L10-002, L20-042) ----
## Thor-Soar's environment takes (<output-link> ^perform-action <p>) (<p> ^name <action-handle> ^argument1 <h1>
## [^argument2 <h2>]) and reports ^status success, complete, interrupted, error or failure on it. Thor keeps its own
## application rules (below, moved from agent-world in v2.47, unchanged apart from their names), so its output map
## says ^rules environment: agent-world's generic map rules then leave Thor's operators alone; agent-world still uses
## the map's statuses to remove finished commands and report action events.
sp {thor-soar*elaborate*top-state*environment-output-map
   :default
   (state <s> ^superstate nil)
-->
   (<s> ^environment-output-map <m>)
   (<m> ^rules environment
        ^command perform-action
        ^name-attribute name
        ^argument1 argument1
        ^argument2 argument2
        ^argument3 argument3
        ^done-status interrupted complete success
        ^success-status success
        ^error-status error failure)
}

## ---- Application rules for perform-action (moved from agent-world/external-operator-application.soar, v2.47) ----
## They write Thor's command form directly and keep Thor's special cases (turn-on, turn-off, look-at, the microwave
## argument3 case).

## Apply operator external argument0 -> sets perform-action.
## Will not work for operators not in the constant-map
## Those have custom applications in their operator definition files
sp {thor-soar*apply*operator*external*perform-action*argument0
   :default
   (state <s> ^operator <operator>
              ^quiescence t
              ^internal-actions false
              ^io.output-link <output>)
   (<operator> ^name <operator-name>
               ^action-handle { <> turn-on <action-handle> }
               ^pre-conditions-satisfied true
               ^argument-count 0)
-->
   (log 1 (crlf) |Apply | <operator-name> |, action: | <action-handle> |: external.|)
   (<output> ^perform-action.name <action-handle>)
}

## Apply operator external argument1 -> sets perform-action, argument1.
sp {thor-soar*apply*operator*external*perform-action*argument1
   :default
   (state <s> ^operator <operator>
              ^quiescence t
              ^internal-actions false
              ^io.output-link <output>)
   (<operator> ^name <operator-name>
               ^action-handle { <> turn-off <> turn-on <> look-at <action-handle> }
               ^pre-conditions-satisfied true
               ^argument-count 1
               ^argument1.object-handle <argument1-handle>)
-->
   (log 1 (crlf) |Apply | <operator-name> |: | <argument1-handle> |, action: | <action-handle> | external.|)
   (<output> ^perform-action <perform>)
   (<perform> ^name <action-handle>
              ^argument1 <argument1-handle>)
}

