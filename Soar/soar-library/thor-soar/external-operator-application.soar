## Apply operator external argument2 no-handle2 -> sets perform-action, argument1, argument2.
sp {thor-soar*apply*operator*external*perform-action*argument2*no-handle2
   :default
   (state <s> ^operator <operator>
              ^quiescence t
              ^internal-actions false
              ^io.output-link <output>)
   (<operator> ^name <operator-name>
               ^action-handle { <action-handle> <> turn-on }
               ^pre-conditions-satisfied true
               ^argument-count 2
               ^argument1.object-handle <argument1-handle>
               ^argument2 <argument2>)
   (<argument2> -^object-handle)
-->
   (log 1 (crlf) |Apply | <operator-name> |: | <argument1-handle> |, | <argument2> |, action: | <action-handle> | external.|)
   (<output> ^perform-action <perform>)
   (<perform> ^name <action-handle>
              ^argument1 <argument1-handle>
              ^argument2 <argument2>)
}

## Apply operator external argument3 no-handle2 -> sets perform-action, argument1, argument2.
## For turn on microwave - needs to be more general for handling extra argument3
sp {thor-soar*apply*operator*external*perform-action*argument3*no-handle2
   :default
   (state <s> ^operator <operator>
             # ^quiescence t
              ^internal-actions false
              ^io.output-link <output>)
   (<operator> ^name { <> cook-microwave <> make-coffee <> toast <operator-name> } ## BUG
               ^action-handle <action-handle>
               ^pre-conditions-satisfied true
               ^argument-count 3
               ^argument2 <argument2>
               ^argument3.object-handle <argument3-handle>
               ^argument1.object-handle <argument1-handle>)
   (<argument2> -^object-handle)
-->
   (log 1 (crlf) |Apply | <operator-name> |: | <argument2> |, | <argument1-handle> |, action: | <action-handle> | external.|)
   (<output> ^perform-action <perform>)
   (<perform> ^name <action-handle>
              ^argument1 <argument1-handle>
              ^argument2 <argument2>)
}
