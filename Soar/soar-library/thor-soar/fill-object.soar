## Propose fill-object.
sp {thor-soar*propose*fill-object*water
    :default
   (state <s> ^problem-space.name thor-world
              ^flags.mea-operator-selection false
              ^world.objects.object <not-filled-object>)
   (<not-filled-object> ^fillable true
                        ^liquid-contents none
                        ^reachable true)
-->
   (<s> ^operator <operator> +)
   (<operator> ^name fill-object
               ^task-operator true
               ^action-handle fill
               ^argument1 <not-filled-object>
               ^argument2 water
               ^argument-count 2
               ^pre-conditions-satisfied true)
}
