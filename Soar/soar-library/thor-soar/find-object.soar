## find-object.soar -- thor-soar: 1 elaboration, 10 proposals, 6 compares, 4 applications.

## Propose find-object.
## More generally defined in agent-world
sp {thor-soar*propose*find-object*object-handle*unknown*in*mea-not-anchored
    :default
   (state <s> ^problem-space.name thor-world
            # -^external-top-state.scene.objects.object.object-handle <anchored-object-handle>
             -^world.objects.object.object-handle <anchored-object-handle>
              ^desireds <desireds>)
   (<desireds> ^desired <desired>
               ^unachieved <desired>)
   (<desired> ^<< on in stored discarded controlled-by >>.argument1 <desired-anchored-object>
             -^failed-grounding true)  ## In the desired
   (<desired-anchored-object> ^object-handle <anchored-object-handle>
                             -^anchored true)
  -{(<desireds> ^desired <desiredx>
                ^unachieved <desiredx>)
    (<desiredx> ^object <desired-anchored-objectx>)
    (<desired-anchored-objectx> ^object-handle <anchored-object-handle>)}
-->
   (<s> ^operator <operator> +)
   (<operator> ^name find-object
               ^super-desired <desired>
               ^argument1 <desired-anchored-object> # world object
               ^argument-count 1
               ^desireds <desireds2>)
   (<desireds2> ^desired.info.unanchored-object <desired-anchored-object>     # object that isn't anchored in world-context  - was info.anchored  why???
                ^desired-count 1)
}

## Propose find-object.
sp {thor-soar*propose*find-object*object-handle*unknown*in*mea-anchored
    :default
   (state <s> ^problem-space.name thor-world
            # -^external-top-state.scene.objects.object.object-handle <anchored-object-handle>
             -^world.objects.object.object-handle <anchored-object-handle>
              ^desireds <desireds>)
   (<desireds> ^desired <desired>
               ^unachieved <desired>)
   (<desired> ^<< on in stored discarded controlled-by >>.argument1 <desired-anchored-object>
             -^failed-grounding true)  ## In the desired
   (<desired-anchored-object> ^object-handle <anchored-object-handle>
                              ^anchored true)
-->
   (<s> ^operator <operator> +)
   (<operator> ^name find-object
               ^super-desired <desired>
               ^argument1 <desired-anchored-object> # world object
               ^argument-count 1
               ^desireds <desireds2>)
   (<desireds2> ^desired.info.unanchored-object <desired-anchored-object>     # object that isn't anchored in world-context  - was info.anchored  why???
                ^desired-count 1)
}

## Propose find-object.
sp {thor-soar*propose*find-object*object-handle*unknown*in2*mea
    :default
   (state <s> ^problem-space.name thor-world
            # -^external-top-state.scene.objects.object.object-handle <anchored-object-handle>
             -^world.objects.object.object-handle <anchored-object-handle>
              ^desireds <desireds>)
   (<desireds> ^desired <desired>
               ^unachieved <desired>)
   (<desired> ^<< on in stored controlled-by >>.argument2 <desired-anchored-object>)  ## In the desired
   (<desired-anchored-object> ^object-handle <anchored-object-handle>)
-->
   (<s> ^operator <operator> +, <)
   (<operator> ^name find-object
               ^super-desired <desired>
               ^argument1 <desired-anchored-object> # world object
               ^argument-count 1
               ^desireds <desireds2>)
   (<desireds2> ^desired.info.anchored-object <desired-anchored-object>     # object that isn't anchored in world-context
                ^desired-count 1)
}

## Propose find-object.
sp {thor-soar*propose*find-object-handle*in*argument1*mea
    :default
   (state <s> ^problem-space.name thor-world
              ^world.objects.object <unanchored-object>
              ^desireds <desireds>)
   (<desireds> ^desired <desired>
               ^unachieved <desired>)
   (<desired> ^<< in on controlled-by stored discarded >>.argument1 <desired-unanchored-object>)  ## In the desired
   (<desired-unanchored-object> ^object-handle <unachored-object-handle>
                               -^failed-grounding true)
   (<unanchored-object> ^<< origin-object-handle object-handle >> <unachored-object-handle>  ## is not anchored
                        ^anchored false)
-->
   (<s> ^operator <operator> +)
   (<operator> ^name find-object
               ^super-desired <desired>
               ^argument1 <desired-unanchored-object>           # desired unanchored object
               ^argument2 <unanchored-object>            # world unanchored object
               ^argument-count 2
               ^desireds <desireds2>)
   (<desireds2> ^desired.info.unanchored-object <unanchored-object>    # object that isn't anchored in world-context
                ^desired-count 1)
}

## Propose find-object.
sp {thor-soar*propose*find-object-handle*in*argument2*mea
    :default
   (state <s> ^problem-space.name thor-world
              ^world.objects.object <unanchored-object>
              ^desireds <desireds>)
   (<desireds> ^desired <desired>
               ^unachieved <desired>)
   (<desired> ^<< in on stored controlled-by discarded >>.argument2 <desired-unanchored-object>
             -^failed-grounding true)  ## In the desired
  -{(<desireds> ^desired.<< in on stored discarded >>.argument1 <desired-unanchored-object>)} # Avoid duplicate proposals
   (<desired-unanchored-object> ^object-handle <unachored-object-handle>)
   (<unanchored-object> ^<< origin-object-handle object-handle >> <unachored-object-handle>  ## is not anchored
                        ^anchored false)
-->
   (<s> ^operator <operator> +)
   (<operator> ^name find-object
               ^super-desired <desired>
               ^argument1 <desired-unanchored-object>           # desired unanchored object
               ^argument2 <unanchored-object>            # world unanchored object
               ^argument-count 2
               ^desireds <desireds2>)
   (<desireds2> ^desired.info.unanchored-object <unanchored-object>    # object that isn't anchored in world-context
                ^desired-count 1)
}

