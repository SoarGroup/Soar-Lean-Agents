## find-object-direct.soar -- thor-soar: 1 elaboration, 4 proposals, 3 compares.

## Propose find-object-direct.
## Find-object where it is straightforward to find and existing object in the world
## Does not require a subgoal and is immediately applied
sp {agent-world*propose*find-object-direct*object-handle*class-only-one
   :default
   (state <s>
              ^desireds <desireds>
              ^world.objects.object <anchored-object>)
   (<anchored-object> ^class <class>
                      ^anchored true
                      ^object-handle <anchored-object-handle>)
   (<desireds> ^desired <desired>
               ^unachieved <desired>
               ^world-context.objects.object <world-object>)
   (<world-object> ^class { <> stoveknob <> stoveburner <class> }
                   ^object-handle <unanchored-object-handle>
                   ^anchored false
                  -^{ <> anchored <> class <> object-handle <> accessible <> duplicate-of }) # no other attributes to constrain grounding
   (<desired> ^object <desired-unanchored-object>)
   (<desired-unanchored-object> ^object-handle <unanchored-object-handle>)
-->
   (<s> ^operator <operator> +, >, =)  ## pick randomly if multiple available
   (<operator> ^name find-object-direct
               ^pre-conditions-satisfied true
               ^argument1 <desired-unanchored-object>
               ^argument2 <anchored-object>
               ^argument-count 2)
}

## Propose find-object-direct.
sp {agent-world*propose*find-object-direct*object-handle*in*argument1
   :default
   (state <s>
              ^desireds <desireds>
              ^world.objects.object <anchored-object-argument1>)
   (<anchored-object-argument1> ^class <argument1-class>
                                ^anchored true
                                ^object-handle <anchored-object-argument1-handle>)
  -{(<s> ^world.objects.object { <> <anchored-object-argument1> <other-object> })
    (<other-object> ^class <argument1-class>
                    ^anchored true)}
   (<desireds> ^desired <desired>
               ^unachieved <desired>
               ^world-context.objects.object <world-object>)
   (<world-object> ^class { <> stoveknob <> stoveburner <argument1-class> }
                   ^object-handle <unanchored-object-handle>
                   ^anchored false
                  -^{ <> anchored <> class <> object-handle <> accessible <> duplicate-of }) # no other attributes to constrain grounding
   (<desired> ^{ << in on >> <in-on> } <in-on-relation-desired>)
   (<in-on-relation-desired> ^argument1 <desired-unanchored-object1>)
   (<desired-unanchored-object1> ^object-handle <unanchored-object-handle>)
-->
   (write (crlf) |+++++++++ find-object-direct | <anchored-object-argument1-handle> |: | <argument1-class> | | <in-on>
                                             | | <anchored-object-argument1-handle> |: | <argument1-class>)
   (<s> ^operator <operator> +, >, =)  ## pick randomly if multiple available
   (<operator> ^name find-object-direct
                ^pre-conditions-satisfied true
                ^argument1 <desired-unanchored-object1>
                ^argument2 <anchored-object-argument1>
                ^argument-count 2)
}

