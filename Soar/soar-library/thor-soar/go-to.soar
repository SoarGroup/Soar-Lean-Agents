sp {apply*go-to*internal*object-on-container*goto-container
    :default
   (state <s> ^internal-actions true
              ^operator <operator>
              ^world.on <on>)
   (<on> ^argument2 <container-object>
         ^argument1 <object>)
   (<operator> ^name go-to
               ^argument1 <container-object>
               ^pre-conditions-satisfied true)
   (<object> ^reachable $ <reachable>)
   (<container-object> ^reachable $ <reachable2>)
-->
   (<object> ^reachable false -
                        true)
   (<container-object> ^reachable false -
                                  true)
}

