## Apply go-to -> sets reachable.
## Object inside an object on an object being approached is reachable
sp {apply*go-to*internal*object-on-location-in-object
    :default
   (state <s> ^internal-actions true
              ^operator <operator>
              ^world.on <on>
              ^world.in <in>)
   (<in> ^argument1 <object2>
         ^argument2 <object3>)
   (<on> ^argument1 <object3>
         ^argument2 <object1>)
   (<operator> ^name go-to
               ^argument1 <object1>
               ^pre-conditions-satisfied true)
   (<object1> ^reachable $ <reachable1>)
   (<object2> ^reachable $ <reachable2>)
   (<object3> ^reachable $ <reachable3>)
-->
   (<object1> ^reachable false -
                         true)
   (<object2> ^reachable false -
                         true)
   (<object3> ^reachable false -
                         true)
}

