## Apply go-to -> sets reachable.
sp {apply*go-to*internal*remove-other-reachable-object # includes containers and locations - depends on first wave so don't get second wave on new reachable  BUG?
    :default
   (state <s> ^internal-actions true
              ^operator <operator>
              ^world.objects.object <object2>)
   (<operator> ^name go-to
               ^argument1 <argument1>
               ^pre-conditions-satisfied true)
   (<argument1> ^object-handle <object-handle>)
   (<object2> ^reachable true
              ^object-handle {<object-handle2> <> <object-handle> })
  -{(<s> ^world <world>)
    (<world> ^<< on in above >> <on>)
    (<on> ^argument1.object-handle <object-handle>
          ^argument2 <object2>)}
  -{(<s> ^world <world>)
    (<world> ^<< on in above >> <on1>)
    (<on1> ^argument2.object-handle <object-handle>
          ^argument1 <object2>)}
  -{(<s> ^world <world>)
    (<world> ^<< on in above >> <on2>)
    (<on2> ^argument2.object-handle <object-handle>
           ^argument1 <object3>)
    (<world> ^<< on in above >> <on3>)
    (<on3> ^argument2 <object2>
          ^argument1 <object3>)}
   -{(<s> ^world <world>)
    (<world> ^<< on in above >> <on4>)
    (<on4> ^argument1.object-handle <object-handle>
           ^argument2 <object3>)
    (<world> ^<< on in above >> <on5>)
    (<on5> ^argument2 <object2>
          ^argument1 <object3>)}
  -(<object2> ^controls-object-handle <object-handle>)
  -(<argument1> ^controls-object-handle <object-handle2>)
-->
   (<object2> ^reachable true -
                         false)
}

## Apply go-to -> sets distance.
## Flush distances on first move
sp {apply*go-to*internal*distance
    :default
   (state <s> ^internal-actions true
              ^operator <operator>)
   (<operator> ^name go-to
               ^argument1 <object>
               ^pre-conditions-satisfied true)
   (<object> ^object-handle <object-handle>
             ^distance <distance>)
-->
   (<object> ^distance <distance> -)
}

## Apply go-to -> sets looked-at.
## Flush looked-at
sp {apply*go-to*internal*looked-at
    :default
   (state <s> ^internal-actions true
              ^operator <operator>)
   (<operator> ^name go-to
               ^argument1 <object>
               ^pre-conditions-satisfied true)
   (<object> ^looked-at true)
-->
   (<object> ^looked-at true -)
}

## Apply go-to -> sets looked-at.
## Flush looked-at
sp {apply*go-to*flush*looked-at
    :default
   (state <s> ^operator <operator>
              ^world.objects.object <object>)
   (<operator> ^name go-to
               ^argument1 <> <object>
               ^pre-conditions-satisfied true)
   (<object> ^looked-at true)
-->
   (<object> ^looked-at true -)
}

## Propose go-to.
## Non MEA Selection
sp {propose*go-reachable-object
    :default
   (state <s> ^problem-space.name << move thor-world >>
              ^flags.mea-operator-selection false
              ^world.objects.object <object>
             -^world.holding-object.object-handle <object-handle>)
   (<object> ^object-handle <object-handle>
             ^reachable false)
-->
   (<s> ^operator <operator> +)
   (<operator> ^name go-to
               ^task-operator true
               ^argument1 <object>
               ^argument-count 1
               ^pre-conditions-satisfied true)
}
