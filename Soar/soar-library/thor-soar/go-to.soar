## Apply go-to -> sets reachable.
## Container of an object being approached becomes reachable
sp {apply*go-to*internal*object-on-container2*goto-object
    :default
   (state <s> ^internal-actions true
              ^operator <operator>
              ^world.on <on>)
   (<on> ^argument1 <object>
         ^argument2 <container-object>)
   (<operator> ^name go-to
               ^argument1 <object>
               ^pre-conditions-satisfied true)
   (<object> ^reachable $ <reachable>)
   (<container-object> ^reachable $ <reachable2>)
  -{(<object> ^reachable true)
    (<container-object> ^reachable true)}
-->
   (<object> ^reachable false -
                        true)
   (<container-object> ^reachable false -
                                  true)
}

