## search-closed-receptacles.soar -- thor-soar: 4 proposals, 3 compares, 5 applications.

## Propose search-closed-receptacles.
sp {thor-soar*propose*search-closed-receptacles*info
    :default
   (state <s> ^desireds.desired <desired>
              ^quiescence t
              ^world.real true
              ^flags.hide-in-container-objects true
             -^flags.smem-retrieve true # shouldn't need it if retrieved from smem
              ^external-top-state.scene.objects.object <object>)
   (<desired> ^info.unanchored-object <unanchored-object>)
   (<unanchored-object> ^class <value>
                       -^storage-location)
   (<object> ^receptacle true
             ^openable true
            -^graspable true
            -^explored true
            -^searched true
             ^object-handle <receptacle-handle>)
  -{(<s> ^scene.objects.object <world-object>)    # existing object don't need to search for - should use anchor-info-...
    (<world-object> ^anchored true
                    ^class <value>)}
  -(<s> ^superstate.superstate.operator.name go-to)    #
-->
   (<s> ^operator <operator> +, =)
   (<operator> ^name search-closed-receptacles
               ^task-operator true
               ^super-desired <desired>
               ^argument1 <object>
               ^argument-count 1
               ^desireds <desireds1>)
   (<desireds1> ^desired-count 1
                ^desired.object <desired-object1>
                ^next-desireds <desireds3>)
   (<desired-object1> ^open true
                      ^object-handle <receptacle-handle>)
   (<desireds3> ^desired-count 1                         # clean up!
                ^desired.object <desired-object3>
                ^next-desireds <desireds4>)
   (<desired-object3> ^looked-at true
                      ^object-handle <receptacle-handle>)
   (<desireds4> ^desired-count 1                         # clean up!
                ^desired.object <desired-object4>)
   (<desired-object4> ^open false
                      ^object-handle <receptacle-handle>)
}

