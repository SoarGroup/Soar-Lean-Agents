## Preference for search-closed-receptacles.
sp {thor-soar*compare*search-closed-receptacles
    :default
   (state <s> ^operator <op1> +
                       )# { <> <op1> <op2> }  +)
#   (<op1> ^name search-closed-receptacles
#          ^argument1.reachable true)
   (<op1> ^name search-closed-receptacles
          ^argument1.reachable false)
-->
   (<s> ^operator  <op1> <)
}

## Preference for search-closed-receptacles2.
sp {thor-soar*compare*search-closed-receptacles2
    :default
   (state <s> ^operator <op1> +
                        { <> <op1> <op2> }  +)
   (<op1> ^name search-closed-receptacles
          ^argument1.reachable true)
   (<op2> ^name close-container)
-->
   (<s> ^operator <op1> > <op2>)
}

## Preference for search-closed-receptacles prefer-fridge cheat.
sp {thor-soar*compare*search-closed-receptacles*prefer-fridge*cheat
    :default
   (state <s> ^operator <op1> +
                        { <> <op1> <op2> }  +)
   (<op1> ^name search-closed-receptacles
          ^argument1.class fridge)
   (<op2> ^name << failed-grounding search-closed-receptacles >>
         -^argument1.class fridge)
-->
   (<s> ^operator <op2> -)
}

## Apply search-closed-receptacles -> sets searched.
sp {apply*search-closed-receptacles
    :default
   (state <s> ^operator <operator>)
   (<operator> ^name << close-container search-closed-receptacles >>
               ^pre-conditions-satisfied true
               ^argument1 <object>)
   (<object> ^object-handle <receptable-handle>)
-->
#   (log 1 (crlf) |Apply search-closed-receptacles | <receptable-handle> | .|)
   (<object> ^searched false -
                       true)
}

