## smem-copy-retrieved-in.soar -- thor-soar: 1 proposal, 1 compare, 6 applications.

## Propose smem-copy-retrieved-in.
sp {thor-soar*propose*smem-copy-retrieved-in
    :default
   (state <s> ^quiescence t
              ^problem-space.name thor-world
              ^superstate.operator.name find-object
              ^flags.smem-retrieve true
              ^retrieved-in <in>)
-->
   (<s> ^operator <op> + =, >)
   (<op> ^name smem-copy-retrieved-in
         ^argument1 <in>
         ^argument2 <new-in>
         ^argument3 <new-arg1>
         ^argument4 <new-arg2>)
}

## Preference for smem-copy-retrieved-in.
## If can anchor to existing object directly, don't look in epmem.
sp {thor-soar*compare*smem-copy-retrieved-in
    :default
   (state <s>^operator <op1> +
                       { <> <op1> <op2> }  +)
   (<op1> ^name smem-copy-retrieved-in)
   (<op2> ^name << search-smem search-closed-receptacles scan-room >>)
-->
   (<s> ^operator <op1> > <op2>)
}

## Apply smem-copy-retrieved-in -> sets in, argument1, argument2 ....
sp {apply*smem-copy-retrieved-in*create-in
    :default
   (state <s> ^operator <op>
              ^external-top-state.scene <scene>
              ^retrieved-in <in>)
   (<scene> ^objects <scene-objects>)
   (<in> ^argument2.object-handle <smem-container-handle>
         ^argument1.class <class>
         ^argument1-class <class>)
   (<op> ^name smem-copy-retrieved-in
         ^argument1 <in>
         ^argument2 <new-in>
         ^argument3 <new-arg1>
         ^argument4 <new-arg2>)
  -{(<scene-objects> ^object <scene-object>)
    (<scene-object> ^object-handle <smem-container-handle>
                    ^derived-from-input)}
-->
   (<scene> ^in <new-in>)
   (<new-in> ^argument1 <new-arg1>
             ^argument2 <new-arg2>)
   (<scene-objects> ^object <new-arg1>
                            <new-arg2>)
   (<new-arg1> ^memory-retrieved true
               ^anchored true
               ^class <class>)
   (<new-arg2> ^memory-retrieved true
               ^anchored true)
}

