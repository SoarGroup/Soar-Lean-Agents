## desireds-disjunctive.soar -- thor-tasks: 3 elaborations.

## Elaborate desired put-apple-in-fridge-or-on-microwave -> sets desireds, desired, desired-count ....
## Disjunction
## put the apple in the fridge or on the countertop
sp {elaborate*thor-soar*desired*put-apple-in-fridge-or-on-microwave
    :default
   (state <s> ^name thor-soar
              ^superstate nil
              ^flags.desired-selection put-apple-in-fridge-or-on-microwave)
-->
   (<s> ^desireds <desireds>)
   (<desireds> ^desired <desired1> <desired2>
               ^desired-count 2
               ^world-context.objects.object <object-apple> <object-microwave> <object-fridge>)
   (<object-apple> ^object-handle |unanchored-apple-handle|
                    ^anchored false
                    ^class apple)
   (<object-microwave> ^object-handle |unanchored-microwave-handle|
                       ^anchored false
                       ^class microwave)
   (<object-fridge> ^object-handle |unanchored-fridge-handle|
                       ^anchored false
                       ^class fridge)
   (<desired1> ^in <in>
               ^disjunction <desired2>)
   (<in> ^argument1.object-handle |unanchored-apple-handle|
         ^argument2.object-handle |unanchored-fridge-handle|)
   (<desired2> ^in <in2>
               ^disjunction <desired1>)
   (<in2> ^argument1.object-handle |unanchored-apple-handle|
         ^argument2.object-handle |unanchored-microwave-handle|)
}

## Elaborate desired fill-mug-or-put-apple-in-sink -> sets desireds, desired, desired-count ....
sp {elaborate*thor-soar*desired*fill-mug-or-put-apple-in-sink
    :default
   (state <s> ^name thor-soar
              ^superstate nil
              ^flags.desired-selection fill-mug-or-put-apple-in-sink)
-->
   (<s> ^desireds <desireds>)
   (<desireds> ^desired <desired1> <desired2>
               ^desired-count 2
               ^world-context.objects.object <object-mug> <object-apple> <object-sinkbasin>)
   (<desired1> ^object <object1>
               ^disjunction <desired2>)
   (<object1> ^liquid-contents water
              ^object-handle |unanchored-mug-handle1|)
   (<object-apple> ^class apple
                   ^object-handle |unanchored-apple-handle1|
                   ^anchored false)
   (<object-mug> ^class mug
                 ^object-handle |unanchored-mug-handle1|
                 ^anchored false)
   (<object-sinkbasin> ^object-handle |unanchored-sinkbasin-handle1|
                       ^anchored false
                       ^class sinkbasin)
   (<desired2> ^in <in>
               ^disjunction <desired1>)
   (<in> ^argument1 <argument1>
         ^argument2 <argument2>)
   (<argument1> ^object-handle |unanchored-apple-handle1|)
   (<argument2> ^object-handle |unanchored-sinkbasin-handle1|)
}

## Elaborate desired cook-potato-or-light-off -> sets desireds, desired, desired-count ....
sp {elaborate*thor-soar*desired*cook-potato-or-light-off
    :default
   (state <s> ^name thor-soar
              ^superstate nil
              ^flags.desired-selection cook-potato-or-light-off)
-->
   (<s> ^desireds <desireds>)
   (<desireds> ^desired <desired1> <desired2>
               ^desired-count 2
               ^world-context.objects.object <object-potato> <object-lightswitch>)
   (<desired1> ^object <object1>
               ^disjunction <desired2>)
   (<desired2> ^object <object2>
               ^disjunction <desired1>)
   (<object2> ^cook-state cooked
              ^anchored false
              ^object-handle |unanchored-potato-handle1|)
   (<object-potato> ^class potato
                    ^object-handle |unanchored-potato-handle1|
                    ^anchored false)
   (<object1> ^object-handle |unanchored-lightswitch-handle1|
              ^activated false)
   (<object-lightswitch> ^class lightswitch
                         ^object-handle |unanchored-lightswitch-handle1|
                         ^anchored false)
}
