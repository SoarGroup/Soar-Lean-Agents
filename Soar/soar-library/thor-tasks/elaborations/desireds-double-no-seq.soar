               ^desired-count 2
               ^world-context.objects.object <object-mug> <object-lightswitch>)
   (<object1> ^broken true
              ^object-handle |unanchored-mug-handle1|)
   (<object2> ^activated false
              ^object-handle |unanchored-lightswitch-handle1|)
