## Elaborate desired slice-apple potato-in-microwave -> sets desireds, desired, world-context ....
## Slice a apple
sp {elaborate*thor-soar*desired*slice-apple*potato-in-microwave
    :default
   (state <s> ^name thor-soar
              ^superstate nil
              ^flags.desired-selection slice-apple-potato-in-microwave)
-->
   (<s> ^desireds <desireds>)
   (<desireds> ^desired <desired1> <desired2>
               ^world-context.objects.object <object-apple> <object-potato> <object-microwave>
               ^desired-count 2)
   (<desired1> ^object <object1>)
   (<object1> ^sliced true
              ^class applesliced
              ^object-handle |unanchored-apple-handle|)
   (<object-apple> ^class applesliced
                    ^object-handle |unanchored-apple-handle|
                    ^anchored false)
   (<object-potato> ^object-handle |unanchored-potato-handle|
                    ^anchored false
                    ^class potato)
   (<object-microwave> ^object-handle |unanchored-microwave-handle|
                     ^anchored false
                     ^class microwave)
   (<desired2> ^in <in>)
   (<in> ^argument1 <argument1>
         ^argument2 <argument2>)
   (<argument1> ^object-handle |unanchored-potato-handle|)
   (<argument2> ^object-handle |unanchored-microwave-handle|)
}

