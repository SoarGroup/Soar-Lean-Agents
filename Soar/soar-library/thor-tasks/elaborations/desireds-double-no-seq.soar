## desireds-double-no-seq.soar -- thor-tasks: 10 elaborations.

## Elaborate desired break-mug-put-apple-in-sink -> sets desireds, desired, desired-count ....
sp {elaborate*thor-soar*desired*break-mug-put-apple-in-sink
    :default
   (state <s> ^name thor-soar
              ^superstate nil
              ^flags.desired-selection break-mug-put-apple-in-sink)
-->
   (<s> ^desireds <desireds>)
   (<desireds> ^desired.object <object1>
               ^desired <desired>
               ^desired-count 2
               ^world-context.objects.object <object-mug> <object-apple> <object-sinkbasin>)
   (<object1> ^broken true
              ^object-handle |unanchored-mug-handle1|)
   (<object-apple> ^class apple
                   ^object-handle |unanchored-apple-handle1|
                   ^anchored false)
   (<object-mug> ^class mug
                 ^object-handle |unanchored-mug-handle1|
                 ^anchored false)
   (<object-sinkbasin> ^object-handle |unanchored-sinkbasin-handle1|
                       ^anchored false
                       ^class sinkbasin)
   (<desired> ^in <in>)
   (<in> ^argument1 <argument1>
         ^argument2 <argument2>)
   (<argument1> ^object-handle |unanchored-apple-handle1|)
   (<argument2> ^object-handle |unanchored-sinkbasin-handle1|)
}

## Elaborate desired break-mug-lightswitch-off -> sets desireds, desired, desired-count ....
