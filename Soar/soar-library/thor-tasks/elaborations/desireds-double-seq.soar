   (<s> ^desireds <desireds>)
   (<desireds> ^desired.on <on1>
               ^desired.on <on2>
               ^desired.object <object1>
               ^desired-count 3
               ^world-context.objects.object <object-bread> <object-plate> <object-counter>)
   (<object-bread> ^class breadsliced
                   ^object-handle |unanchored-bread-handle|
                   ^anchored false)
   (<object-plate> ^class plate
                   ^object-handle |unanchored-plate-handle|
                   ^anchored false)
   (<object-counter> ^object-handle |unanchored-counter-handle|
                     ^anchored false
                     ^class countertop)
   (<object1> ^cook-state cooked
              ^class breadsliced
              ^object-handle |unanchored-bread-handle|)
   (<on1> ^argument1 <argument1>
          ^argument2 <argument2>)
   (<argument1> ^object-handle |unanchored-bread-handle|)
   (<argument2> ^object-handle |unanchored-plate-handle|)
   (<on2> ^argument1 <argument1x>
          ^argument2 <argument2x>)
   (<argument1x> ^object-handle |unanchored-plate-handle|)
   (<argument2x> ^object-handle |unanchored-counter-handle|)
