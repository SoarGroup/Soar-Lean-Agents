## desireds-double-seq.soar -- thor-tasks: 6 elaborations.

## Elaborate desired hold-mug-lightswitch-off -> sets desireds, desired, desired-count ....
sp {elaborate*thor-soar*desired*hold-mug-lightswitch-off
    :default
   (state <s> ^name thor-soar
              ^superstate nil
              ^flags.desired-selection hold-mug-lightswitch-off)
-->
   (<s> ^desireds <desireds>)
   (<desireds> ^desired.object <object2>
               ^desired.holding-object <object1>
               ^desired-count 2
               ^world-context.objects.object <object-mug> <object-lightswitch>)
   (<object1> ^object-handle |unanchored-mug-handle1|)
   (<object2> ^activated false
              ^object-handle |unanchored-lightswitch-handle1|)
   (<object-lightswitch> ^class lightswitch
                         ^object-handle |unanchored-lightswitch-handle1|
                         ^anchored false)
   (<object-mug> ^class mug
                 ^object-handle |unanchored-mug-handle1|
                 ^anchored false)
}

