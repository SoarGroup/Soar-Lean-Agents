## desireds-double-temporal.soar -- thor-tasks: 9 elaborations.

## Elaborate desired cook-potato light-off -> sets desireds, desired, desired-count ....
sp {elaborate*thor-soar*desired*cook-potato*light-off
    :default
   (state <s> ^name thor-soar
              ^superstate nil
              ^flags.desired-selection cook-potato-light-off)
-->
   (<s> ^desireds <desireds>)
   (<desireds> ^desired.object <object2>
               ^desired.object <object1>
               ^desired-count 2
               ^world-context.objects.object <object-potato> <object-lightswitch>)
   (<object2> ^cook-state cooked
              ^anchored false
              ^object-handle |unanchored-potato-handle1|)
   (<object-potato> ^class potato
                    ^object-handle |unanchored-potato-handle1|
                    ^anchored false)
   (<object1> ^object-handle |unanchored-lightswitch-handle1|
              ^activated false)
   (<object-lightswitch> ^class lightswitch
                         ^object-handle |unanchored-lightswitch-handle1|
                         ^anchored false)
}

## Elaborate desired cook-potato-apple-in-sink -> sets desireds, desired, desired-count ....
sp {elaborate*thor-soar*desired*cook-potato-apple-in-sink
    :default
   (state <s> ^name thor-soar
              ^superstate nil
              ^flags.desired-selection cook-potato-apple-in-sink)
-->
   (<s> ^desireds <desireds>)
   (<desireds> ^desired.object <object2>
               ^desired.in <in>
               ^desired-count 2
               ^world-context.objects.object <object-apple> <object-potato> <object-sinkbasin>)
   (<object2> ^cook-state cooked
              ^anchored false
              ^object-handle |unanchored-potato-handle1|)
   (<object-potato> ^class potato
                    ^object-handle |unanchored-potato-handle1|
                    ^anchored false)
   (<object-sinkbasin> ^object-handle |unanchored-sinkbasin-handle|
                       ^anchored false
                       ^class sinkbasin)
   (<object-apple> ^object-handle |unanchored-apple-handle|
                   ^anchored false
                   ^class apple)
   (<in> ^argument1 <argument1>
         ^argument2 <argument2>)
   (<argument1> ^object-handle |unanchored-apple-handle|)
   (<argument2> ^object-handle |unanchored-sinkbasin-handle|)
}

## Elaborate desired cook-potato-slice-apple-class -> sets desireds, desired, desired-count ....
sp {elaborate*thor-soar*desired*cook-potato-slice-apple-class
    :default
   (state <s> ^name thor-soar
              ^superstate nil
              ^flags.desired-selection cook-potato-slice-apple-class)
-->
   (<s> ^desireds <desireds>)
   (<desireds> ^desired.object <object1>
               ^desired.object <object2>
               ^desired-count 2
               ^world-context.objects.object <object-apple> <object-potato>)
   (<object2> ^cook-state cooked
              ^anchored false
              ^object-handle |unanchored-potato-handle1|)
   (<object-potato> ^class potato
                    ^object-handle |unanchored-potato-handle1|
                    ^anchored false)
   (<object-apple> ^object-handle |unanchored-apple-handle|
                   ^anchored false
                   ^class applesliced)
   (<object1> ^sliced true
              ^class applesliced
              ^object-handle |unanchored-apple-handle|)
}

