## desireds-single.soar -- thor-tasks: 38 elaborations.

## Elaborate desired break-mug-class -> sets desireds, desired, desired-count ....
## BREAK the mug
sp {elaborate*thor-soar*desired*break-mug-class
    :default
   (state <s> ^name thor-soar
              ^superstate nil
              ^flags.desired-selection break-mug-class)
-->
   (<s> ^desireds <desireds>)
   (<desireds> ^desired.object <object>
               ^desired-count 1
               ^world-context.objects.object <object-mug>)
   (<object> ^broken true
             ^object-handle |unanchored-object-handle|)
   (<object-mug> ^class mug
                 ^object-handle |unanchored-object-handle|
                 ^anchored false)
}

## Elaborate desired dirty-clean-mug-class -> sets desireds, desired, desired-count ....
## CLEAN
## Make the mug dirty and then clean it
sp {elaborate*thor-soar*desired*dirty-clean-mug-class
    :default
   (state <s> ^name thor-soar
              ^superstate nil
              ^flags.desired-selection dirty-clean-mug-class)
-->
   (<s> ^desireds <desireds>)
   (<desireds> ^desired <desired1>
               ^desired-count 1
               ^next-desireds <desireds2>
               ^world-context.objects.object <object-mug>)
   (<desired1> ^object <object>)
   (<object> ^dirty true
             ^object-handle |unanchored-object-handle|)
   (<desireds2> ^desired <desired3>
                ^desired-count 1
                ^world-context.objects.object <object-mug>)
   (<desired3> ^object <objects3>)
   (<objects3> ^dirty false
               ^object-handle |unanchored-object-handle|)
   (<object-mug> ^class mug
                 ^object-handle |unanchored-object-handle|
                 ^anchored false)
}

## Elaborate desired open-close-fridge-class -> sets desireds, desired, desired-count ....
## CLOSE (after open)
sp {elaborate*thor-soar*desired*open-close-fridge-class
    :default
   (state <s> ^name thor-soar
              ^superstate nil
              ^flags.desired-selection open-close-fridge-class)
-->
   (<s> ^desireds <desireds>)
   (<desireds> ^desired <desired1>
               ^desired-count 1
               ^next-desireds <desireds2>
               ^world-context.objects.object <object-fridge>)
   (<desired1> ^object <object>)
   (<object> ^object-handle |unanchored-object-handle|
             ^open true)
   (<desireds2> ^desired.object <desired2>
                ^desired-count 1
                ^world-context.objects.object <object-fridge>)
   (<desired2> ^object-handle |unanchored-object-handle|
               ^open false)
   (<object-fridge> ^class fridge
                    ^object-handle |unanchored-object-handle|
                    ^anchored false)
}

