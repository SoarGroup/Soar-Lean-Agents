               ^desired-count 1
               ^world-context.objects.object <object-potato> <object-sinkbasin>)
   (<object-potato> ^object-handle |unanchored-potato-handle|
                    ^anchored false
                    ^class potato)
   (<object-sinkbasin> ^object-handle |unanchored-sinkbasin-handle|
                       ^anchored false
                       ^class sinkbasin)
   (<desired> ^in <in>)
   (<in> ^argument1 <argument1>
         ^argument2 <argument2>)
   (<argument1> ^object-handle |unanchored-potato-handle|)
   (<argument2> ^object-handle |unanchored-sinkbasin-handle|)
}

