   (<desireds> ^desired <desired1>
               ^desired-count 1
               ^world-context.objects.object <object-potato> <object-counter>)
   (<object-potato> ^object-handle |unanchored-potato-handle|
                    ^anchored false
                    ^class potato)
   (<object-counter> ^object-handle |unanchored-counter-handle|
                     ^anchored false
                     ^class countertop)
   (<desired1> ^on <on>)
   (<on> ^argument1 <argument1>
         ^argument2 <argument2>)
   (<argument1> ^object-handle |unanchored-potato-handle|)
   (<argument2> ^object-handle |unanchored-counter-handle|)
}

