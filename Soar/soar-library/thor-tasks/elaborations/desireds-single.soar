## Elaborate desired slice-apple-know-fridge-class -> sets desireds, desired, desired-count ....
## Slice a apple that is in the fridge
sp {elaborate*thor-soar*desired*slice-apple-know-fridge-class
    :default
   (state <s> ^name thor-soar
              ^superstate nil
              ^flags.desired-selection slice-apple-know-fridge-class)
-->
   (<s> ^desireds <desireds>)
   (<desireds> ^desired <desired1>
               ^desired-count 1
               ^world-context <world>)
   (<world> ^objects.object <object-apple>
                            <object-fridge>
            ^in <in>)
   (<desired1> ^object <object1>)
   (<object1> ^sliced true
              ^class applesliced
              ^object-handle |unanchored-apple-handle|)
   (<in> ^argument1 <object-apple>
         ^argument2 <object-fridge>)
   (<object-fridge> ^class fridge
                    ^object-handle |unanchored-object-fridge|
                    ^anchored false)
   (<object-apple> ^class applesliced
                   ^object-handle |unanchored-apple-handle|
                   ^anchored false)
}

## Elaborate desired toast -> sets desireds, desired, desired-count ....
## Toast a slice of bread
sp {elaborate*thor-soar*desired*toast
    :default
   (state <s> ^name thor-soar
              ^superstate nil
              ^flags.desired-selection toast)
-->
   (<s> ^desireds <desireds>)
   (<desireds> ^desired <desired>
               ^desired-count 1
               ^world-context.objects.object <object-bread>)
   (<desired> ^object <object>)
   (<object> ^cook-state cooked
             ^class breadsliced
             ^object-handle |unanchored-bread-handle|)
   (<object-bread> ^class breadsliced
                   ^object-handle |unanchored-bread-handle|
                   ^anchored false)
}
