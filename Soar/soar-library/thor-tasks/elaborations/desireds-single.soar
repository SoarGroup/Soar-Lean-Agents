}

## Elaborate desired cook-potato-microwave -> sets desireds, desired, desired-count ....
## Cook the potato in the microwave
## Explicity states must be cooked by microwave
sp {elaborate*thor-soar*desired*cook-potato-microwave
    :default
   (state <s> ^name thor-soar
              ^superstate nil
              ^flags.desired-selection cook-potato-microwave)
-->
   (<s> ^desireds <desireds>)
   (<desireds> ^desired <desired1> <desired2>
               ^desired-count 2
               ^world-context.objects.object <object-potato>)
   (<desired1> ^object <object1>)
   (<object1> ^cook-state cooked
              ^object-handle |unanchored-object-handle|)
   (<desired2> ^object <object2>)
   (<object2> ^cooked-by microwave
              ^event-time 15000
              ^object-handle |unanchored-object-handle|)
   (<object-potato> ^class potato
                    ^object-handle |unanchored-object-handle|
                    ^anchored false)
}

