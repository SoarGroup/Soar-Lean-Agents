## desireds.soar -- thor-tasks: 93 elaborations.

## Elaborate desireds better-lower -> sets better, best.
sp {elaborate*thor-soar*desireds*better-lower
    :default
   (state <s> ^desireds <desireds>)
-->
   (<desireds> ^better lower
               ^best 0)
}

## Elaborate desired reachable-potato55 -> sets desireds, desired, desired-count ....
sp {elaborate*thor-soar*desired*reachable-potato55
    :default
   (state <s> ^name thor-soar
              ^superstate nil
              ^flags.desired-selection reachable-potato55)
-->
   (<s> ^desireds <desireds>)
   (<desireds> ^desired <desired>
               ^desired-count 1)
   (<desired> ^object <object>)
   (<object> ^object-handle Potato55
             ^reachable true)
}

## Elaborate desired reachable-potato-class -> sets desireds, desired, desired-count ....
## Go to the potato
## Uses world-context to define potato as class instead of potato handle
sp {elaborate*thor-soar*desired*reachable-potato-class
    :default
   (state <s> ^name thor-soar
              ^superstate nil
              ^flags.desired-selection reachable-potato-class)
-->
   (<s> ^desireds <desireds>)
   (<desireds> ^desired <desired>
               ^desired-count 1
               ^world-context.objects.object <object-potato>)
   (<desired> ^object <object>)
   (<object> ^object-handle |unanchored-object-handle|
             ^reachable true)
   (<object-potato> ^class potato
                    ^object-handle |unanchored-object-handle|
                    ^anchored false)
}

