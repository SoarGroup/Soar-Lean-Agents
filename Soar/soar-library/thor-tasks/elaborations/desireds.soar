   (state <s> ^name thor-soar
              ^superstate nil
              ^flags.desired-selection holding-fork39-restricted)
-->
   (<s> ^desireds <desireds>)
   (<desireds> ^desired.holding-object <holding-object>
               ^desired-count 1)
   (<holding-object> ^object-handle Fork39
                     ^class fork
                     ^storage-location.class drawer)
}

