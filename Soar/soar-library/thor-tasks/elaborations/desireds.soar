## Elaborate desired slice-carrot know-in-fridge -> sets desireds, desired, world-context ....
## Slice a carrot that is in the fridge
sp {elaborate*thor-soar*desired*slice-carrot*know-in-fridge
    :default
   (state <s> ^name thor-soar
              ^superstate nil
              ^flags.desired-selection slice-carrot-know-in-fridge)
-->
   (<s> ^desireds <desireds>)
   (<desireds> ^desired <desired1>
               ^world-context <world>)
   (<world> ^objects.object <object-carrot>
                            <object-fridge>
            ^in <in>)
   (<desired1> ^object <object1>)
   (<object1> ^sliced true
              ^class carrotsliced
              ^object-handle |unanchored-carrot-handle|)
   (<in> ^argument1 <object-carrot>
         ^argument2 <object-fridge>)
   (<object-fridge> ^class fridge
                    ^object-handle |unanchored-object-fridge|
                    ^anchored false)
   (<object-carrot> ^class carrotsliced
                    ^object-handle |unanchored-carrot-handle|
                    ^anchored false)
}

