## Elaborate desired dirty-then-dishwash -> sets desireds, desired, desired-count ....
## Dirty dishes then clean
sp {elaborate*thor-soar*desired*dirty-then-dishwash
    :default
   (state <s> ^name thor-soar
              ^superstate nil
              ^flags.desired-selection dirty-then-dishwash)
-->
   # First dirty the objects
   (<s> ^desireds <desireds1>)
   (<desireds1> ^desired <desired1> <desired2> <desired3> <desired4> <desired5>
                ^desired-count 5
                ^next-desireds <desireds2>)
   (<desired1> ^object <object1>)
   (<object1> ^dirty true
              ^object-handle Mug48)
   (<desired2> ^object <object2>)
   (<object2> ^dirty true
              ^object-handle Plate52)
   (<desired3> ^object <object3>)
   (<object3> ^dirty true
              ^object-handle Pan49)
   (<desired4> ^object <object4>)
   (<object4> ^dirty true
              ^object-handle Pot53)
   (<desired5> ^object <object5>)
   (<object5> ^dirty true
              ^object-handle Cup24)
# this puts the dirty objects in the dishwasher and cleans them
   (<desireds2> ^desired <desired>
                ^desired-count 1)
   (<desired> ^dishes-clean true)
}

