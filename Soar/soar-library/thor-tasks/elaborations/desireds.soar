   (<desireds> ^desired <desired1> <desired2>
               ^desired-count 2)
   (<desired1> ^object <object1>)
   (<object1> ^cook-state cooked
              ^object-handle Potato55)
   (<desired2> ^object <object2>)
   (<object2> ^cooked-by microwave
              ^event-time 15000
              ^object-handle Potato55)
}

