               ^world-context <world-context>
               ^desired-count 1)
   (<desired1> ^in <in>)
   (<world-context> ^objects <objects>)
   (<objects> ^object <object1> <object2>)
   (<object1> ^anchored false
              ^class potato
              ^object-handle object-1)
   (<object2> ^anchored false
              ^class microwave
              ^object-handle object-2)
   (<in> ^argument1 <object3>
         ^argument2 <object4>)
   (<object3> ^object-handle object-1)
   (<object4> ^object-handle object-2)
}

