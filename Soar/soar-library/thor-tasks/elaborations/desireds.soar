## Elaborate desired make-toast cook-egg make-coffee1 -> sets desireds, desired, desired-count ....
## Stopping here on NL.
sp {elaborate*thor-soar*desired*make-toast*cook-egg*make-coffee1
    :default
   (state <s> ^name thor-soar
              ^superstate nil
              ^flags.desired-selection make-toast-cook-egg-make-coffee1)
-->
   #Put plate on countertop
   (<s> ^desireds <desireds1>)
   (<desireds1> ^desired <desired1>
                ^desired-count 1
                ^next-desireds <desireds2>
                ^desireds-list <desireds4> <desireds3> <desireds2> <desireds1>)
   (<desired1> ^on <on1>)
   (<on1> ^argument1.object-handle Plate52
          ^argument2.object-handle CounterTop22)
   #Put Eggs on Plate and Plate in Microwave
   (<desireds2> ^desired <desired2> <desired21>
                ^desired-count 2
                ^avoid-desired <desired3>
                ^next-desireds <desireds3>)
   (<desired2> ^on <on2>)
   (<on2> ^argument1.object-handle Egg36
          ^argument2.object-handle Plate52)
   (<desired21> ^in <in21>)
   (<in21> ^argument1.object-handle Plate52
           ^argument2.object-handle Microwave47)
   #Cook Eggs and close Fridge
   (<desireds3> ^desired <desired3> <desired32>
                ^desired-count 2
                ^preferred-desired <desired32>
                ^next-desireds <desireds4>)
   (<desired3> ^object <object1>)
   (<object1> ^cook-state cooked
              ^object-handle Egg36)
   (<desired32> ^object <object32>)
   (<object32> ^object-handle Fridge40
               ^open false)
   #Put Plate on Countertop
   (<desireds4> ^desired <desired4>
                ^desired-count 1
                ^next-desireds <desireds5>)
   (<desired4> ^on <in4>)
   (<in4> ^argument1.object-handle Plate52
          ^argument2.object-handle CounterTop21)
   #Put slice bread
   (<desireds5> ^desired <desired5>
                ^desired-count 1
                ^next-desireds <desireds6>)
   (<desired5> ^object <object5>)
   (<object5> ^sliced true
              ^class breadsliced
              ^object-handle Bread5)
   #cook bread
   (<desireds6> ^desired <desired6>
                ^desired-count 1
                ^next-desireds <desireds7>)
   (<desired6> ^object <object6>)
   (<object6> ^cook-state cooked
              ^object-handle Bread5)
   #Put Plate on countertop - repeat from above!
   (<desireds7> ^desired <desired7>
                ^desired-count 1
                ^next-desireds <desireds8>)
   (<desired7> ^on <on7>)
   (<on7> ^argument1.object-handle Plate52
          ^argument2.object-handle CounterTop21) ##
   #Put sliced bread on plate
   (<desireds8> ^desired <desired8>
                ^desired-count 1
                ^world-context <wc>
                ^next-desireds <desireds9>)
   (<wc> ^objects.object <object-bread>)
   (<object-bread> ^class breadsliced
                   ^object-handle |unanchored-object-bread-handle|
                   ^cook-state cooked
                   ^anchored false)
   (<desired8> ^on <on8>)
   (<on8> ^argument1.object-handle |unanchored-object-bread-handle|
          ^argument2.object-handle Plate52)
   #Make coffee in mug and close microwave
   (<desireds9> ^desired <desired9> <desired91> <desired93>
                ^preferred-desired <desired9>
                ^desired-count 3
                ^next-desireds <desireds10>)
   (<desired9> ^object <object9>)
   (<object9> ^liquid-contents coffee
              ^object-handle Mug48)
   (<desired91> ^object <object91>)
   (<object91> ^fill-amount full
               ^object-handle Mug48)
   (<desired93> ^object <object93>)
   (<object93> ^open false
               ^object-handle Microwave47)
   #Put Fork and mug on countertop
   (<desireds10> ^desired <desired10> <desired101>
                 ^desired-count 2)
   (<desired10> ^on <on10>)
   (<on10> ^argument1.object-handle Fork39
           ^argument2.object-handle CounterTop21)
   (<desired101> ^on <on92>)
   (<on92> ^argument1.object-handle Mug48
           ^argument2.object-handle CounterTop21)
}

