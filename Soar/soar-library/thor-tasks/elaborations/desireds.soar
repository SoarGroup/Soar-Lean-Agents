## Elaborate desired really-long -> sets desireds, desired, desired-count ....
sp {elaborate*thor-soar*desired*really-long
    :default
   (state <s> ^name thor-soar
              ^superstate nil
              ^flags.desired-selection really-long)
-->
   # Egg on plate and plate in microwave and close fridge
   (<s> ^desireds <desireds1>)
   (<desireds1> ^desired <desired11> <desired12> <desired13>
                ^desired-count 3
                ^preferred-desired <desired11>
                ^avoid-desired <desired13>
                ^next-desireds <desireds2>
                               )#      ^desireds-list <desireds1> <desireds2> <desireds3> <desireds4>)
   (<desired11> ^on <on1>)
   (<on1> ^argument1.object-handle Egg36
          ^argument2.object-handle Plate52)
   (<desired12> ^in <in2>)
   (<in2> ^argument1.object-handle Plate52
          ^argument2.object-handle Microwave47)
   (<desired13> ^object <object13>)
   (<object13> ^object-handle Fridge40
               ^open false)
   # Cook egg put plate on countertop close microwave close fridge
   (<desireds2> ^desired <desired21> <desired22> <desired23>
                ^desired-count 3
                ^preferred-desired <desired21>
                ^next-desireds <desireds3>)
   (<desired21> ^object <object21>)
   (<object21> ^cook-state cooked
               ^object-handle Egg36)
   (<desired22> ^on <in21>)
   (<in21> ^argument1.object-handle Plate52
           ^argument2.object-handle CounterTop21)
   (<desired23> ^object <object22>)
   (<object22> ^object-handle Microwave47
               ^open false)
   # Make coffee - put mug on countertop
   (<desireds3> ^desired <desired31> <desired32> <desired33>
                ^desired-count 3
                ^avoid-desired <desired33>
                ^next-desireds <desireds4>)
   (<desired31> ^object <object31>)
   (<object31> ^liquid-contents coffee
               ^object-handle Mug48)
   (<desired32> ^object <object32>)
   (<object32> ^fill-amount full
               ^object-handle Mug48)
   (<desired33> ^on <on33>)
   (<on33> ^argument1.object-handle Mug48
           ^argument2.object-handle CounterTop21)
   # Cook Bread - must slice bread
   (<desireds4> ^desired <desired4>
                ^desired-count 1
                ^next-desireds <desireds5>)
   (<desired4> ^object <object4>)
   (<object4> ^cook-state cooked
              ^object-handle Bread5)
   ## put cooked bread
   (<desireds5> ^desired <desired5>
                ^desired-count 1
                ^world-context <wc>
                ^next-desireds <desireds6>)
   (<wc> ^objects.object <object-bread5>)
   (<object-bread5> ^class breadsliced
                    ^object-handle |unanchored-object-bread-handle|
                    ^cook-state cooked
                    ^anchored false)
   (<desired5> ^on <on5>)
   (<on5> ^argument1.object-handle |unanchored-object-bread-handle|
          ^argument2.object-handle Plate52)
   # Cook Another slice of Bread
   ## How make it a different slice than above?
   (<desireds6> ^desired <desired6>
                ^desired-count 1
                ^next-desireds <desireds7>)
   (<desired6> ^object <object6>)
   (<object6> ^cook-state cooked
              ^object-handle Bread5)
   #Slice and the cook potato
   (<desireds7> ^desired <desired71> <desired72>
               ^desired-count 2)
   (<desired71> ^object <object71>)
   (<object71> ^sliced true
              ^object-handle Potato55)
   (<desired72> ^object <object72>)
   (<object72> ^cook-state cooked
              ^object-handle Potato55)
}
