## Elaborate desired slice-potato55-then-cook-slice -> sets desireds, desired, desired-count ....
## Slice a potato and then cook a slice
## Cook a slice of potato - harder to generate the next-desired without a then
sp {elaborate*thor-soar*desired*slice-potato55-then-cook-slice
    :default
   (state <s> ^name thor-soar
              ^superstate nil
              ^flags.desired-selection slice-potato55-then-cook-slice)
-->
   (<s> ^desireds <desireds1>)
   (<desireds1> ^desired <desired1>
                ^desired-count 1
                ^next-desireds <desireds2>
                ^desireds-list <desireds2> <desireds1>)
   (<desired1> ^object <object1>)
   (<object1> ^sliced true
              ^class potatosliced
              ^object-handle Potato55)
   (<desireds2> ^desired <desired2>
                ^desired-count 1)
   (<desired2> ^object <object2>)
   (<object2> ^cook-state cooked
              ^object-handle Potato55)
}

