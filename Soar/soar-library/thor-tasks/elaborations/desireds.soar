    :default
   (state <s> ^name thor-soar
              ^superstate nil
              ^flags.desired-selection get-egg-in-fridge-class-door-closed)
-->
   (<s> ^desireds <desireds>)
   (<desireds> ^desired.holding-object.object-handle |unanchored-object-egg-handle|
               ^desired <desired2>
               ^avoid-desired <desired2>
               ^desired-count 2
               ^world-context <world>)
   (<world> ^objects.object <object-egg> <object-fridge>
            ^in <in>)
   (<object-egg> ^class egg
                 ^object-handle |unanchored-object-egg-handle|
                 ^anchored false)
   (<in> ^argument1 <object-egg>
         ^argument2 <object-fridge>)
   (<object-fridge> ^class fridge
                    ^object-handle |unanchored-object-fridge|
                    ^anchored false)
   (<desired2> ^object <object4>)
   (<object4> ^object-handle |unanchored-object-fridge|
              ^open false)
}

