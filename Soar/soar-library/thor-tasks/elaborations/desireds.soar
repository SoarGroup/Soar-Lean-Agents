## Elaborate desired am-turn-on-coffeemachine -> sets desireds, desired, desired-count ....
## put mug in coffee machine and then Turn on coffee machine
sp {elaborate*thor-soar*desired*am-turn-on-coffeemachine
    :default
   (state <s> ^name thor-soar
              ^superstate nil
              ^flags.desired-selection am-turn-on-coffeemachine
              ^scene.objects.object <coffeemachine>)
   (<coffeemachine> ^object-handle <coffeemachine-handle>
                    ^class coffeemachine)
-->
   (<s> ^desireds <desireds1>)
   (<desireds1> ^desired <desired1>
                ^desired-count 1
                ^world-context <w11>
                ^next-desireds <desireds2>)
   (<w11> ^objects <objects>)
   (<desired1> ^in <N117>)
   (<N117> ^argument1 <A24>
           ^argument2 <A25>)
   (<A24> ^object-handle Mug48)
   (<A25> ^object-handle CoffeeMachine19)
   (<desireds2> ^desired <desired3>
                ^desired-count 1)
   (<desired3> ^object <object1>)
   (<object1> ^object-handle <coffeemachine-handle>
              ^activated true
              ^event-time 2000)
}

