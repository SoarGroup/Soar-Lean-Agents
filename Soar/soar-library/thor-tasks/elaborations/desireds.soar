## Elaborate desired make-toast -> sets desireds, desired, desired-count ....
## Toast a slice of bread and put it on a plate on the counter
sp {elaborate*thor-soar*desired*make-toast
    :default
   (state <s> ^name thor-soar
              ^superstate nil
              ^flags.desired-selection make-toast)
-->
   (<s> ^desireds <desireds6>)
   (<desireds6> ^desired <desired6>
                ^desired-count 1
                ^next-desireds <desireds8>)
   (<desired6> ^object <object6>)
   (<object6> ^cook-state cooked
              ^object-handle Bread5)
   (<desireds8> ^desired <desired8> <desired41>
                ^world-context.objects.object <object-bread>
                ^desired-count 2)
   (<object-bread> ^class breadsliced
                   ^object-handle |unanchored-object-bread-handle|
                   ^cook-state cooked
                   ^anchored false)
   (<desired8> ^on <on8>)
   (<on8> ^argument1 <argument1>
          ^argument2.object-handle Plate52)
   (<argument1> ^object-handle |unanchored-object-bread-handle|
                ^anchored false)
   (<desired41> ^on <in41>)
   (<in41> ^argument1.object-handle Plate52
           ^argument2.object-handle CounterTop21)
}

## Elaborate desired make-toast times3 -> sets desireds, desired, desired-count ....
sp {elaborate*thor-soar*desired*make-toast*times3
    :default
   (state <s> ^name thor-soar
              ^superstate nil
              ^flags.desired-selection make-toast2)
-->
   (<s> ^desireds <desireds1>)
   (<desireds1> ^desired <desired1>
                ^desired-count 1
                ^next-desireds <desireds2>)
   (<desired1> ^object <object1>)
   (<object1> ^cook-state cooked
              ^object-handle Bread5)
   ## put on counter
   (<desireds2> ^desired <desired2>
                ^world-context.objects.object <object-bread>
                ^desired-count 1
                ^next-desireds <desireds3>)
   (<object-bread> ^class breadsliced
                   ^object-handle |unanchored-object-bread-handle|
                   ^cook-state cooked
                   ^anchored false)
   (<desired2> ^on <on2>)
   (<on2> ^argument1 <argument2>
          ^argument2.object-handle CounterTop21)
   (<argument2> ^object-handle |unanchored-object-bread-handle|)
   # cook a second slice that is raw
   (<desireds3> ^desired <desired3>
                ^desired-count 1
                ^world-context.objects.object <object-bread3>
                ^next-desireds <desireds4>)
   (<desired3> ^object <object3>)
   (<object3> ^cook-state cooked
              ^class breadsliced
              ^object-handle |unanchored-object-bread-handle2|)
   (<object-bread3> ^class breadsliced
                    ^object-handle |unanchored-object-bread-handle2|
                    ^cook-state raw
                    ^anchored false)
   # put it on countertop
   (<desireds4> ^desired <desired4>
                ^desired-count 1
                ^next-desireds <desireds5>)
   (<desired4> ^on <on4>)
   (<on4> ^argument1 <object3>
          ^argument2.object-handle CounterTop21)
   # cook a third slice that is raw
   (<desireds5> ^desired <desired5>
                ^desired-count 1
                ^world-context.objects.object <object-bread5>
                ^next-desireds <desireds6>)
   (<desired5> ^object <object5>)
   (<object5> ^cook-state cooked
              ^class breadsliced
              ^object-handle |unanchored-object-bread-handle3|)
   (<object-bread5> ^class breadsliced
                    ^object-handle |unanchored-object-bread-handle3|
                    ^cook-state raw
                    ^anchored false)
   # put it on countertop
   (<desireds6> ^desired <desired6>
                ^desired-count 1)
   (<desired6> ^on <on6>)
   (<on6> ^argument1 <object5>
          ^argument2.object-handle CounterTop22)
}

