sp {arithmetic*apply*generate-digit1
   (state <s> ^name arithmetic)
   (<s> ^operator <o>)
   (<o> ^name generate-digit1)
   (<o> ^p <p>)
   (<o> ^c <c>)
   (<o> ^d <d>)
   (<c> ^digit1 <c-digit1>)
   (<d> ^val <d-val>)
   (<c> ^gen1 <c-gen1>)
   (<p> ^pid <p-pid>)
   (<p> ^digits <p-digits>)
-->
   (<c> ^digit1 <d-val>)
   (<c> ^digit1 <c-digit1> -)
   (<c> ^gen1 <p-pid>)
   (<c> ^gen1 <c-gen1> -)
   (<p> ^digits (+ <p-digits> 1))
   (<p> ^digits <p-digits> -)
}
