
sp {arithmetic*propose*generate-digit1*1
   (state <s> ^name arithmetic)
   (<s> ^problem <p>)
   (<s> ^column <c>)
   (<s> ^digit <d>)
   (<p> ^operation { <> 0 1 })
   (<c> ^gen1 { <c-gen1> <> <p-pid> })
   (<p> ^pid <p-pid>)
-->
   (<s> ^operator <o> +)
   (<s> ^operator <o> =)
   (<o> ^name generate-digit1)
   (<o> ^p <p>)
   (<o> ^c <c>)
   (<o> ^d <d>)
}

