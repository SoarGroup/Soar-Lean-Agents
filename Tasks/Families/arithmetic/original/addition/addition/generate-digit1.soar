sp {arithmetic*propose*generate-digit1*3
   (state <s> ^name arithmetic)
   (<s> ^problem <p>)
   (<s> ^column <c>)
   (<s> ^digit <d>)
   (<p> ^operation { <> 0 2 })
   (<c> ^gen1 { <c-gen1> <> <p-pid> })
   (<p> ^pid <p-pid>)
   (<c> ^last 1)
   (<d> ^val { <d-val> > 0 })
-->
   (<s> ^operator <o> +)
   (<s> ^operator <o> =)
   (<o> ^name generate-digit1)
   (<o> ^p <p>)
   (<o> ^c <c>)
