   (<c> ^digit2 <c-digit2> -)
   (<c> ^gen2 <p-pid>)
   (<c> ^gen2 <c-gen2> -)
   (<p> ^digits (+ <p-digits> 1))
   (<p> ^digits <p-digits> -)
}
