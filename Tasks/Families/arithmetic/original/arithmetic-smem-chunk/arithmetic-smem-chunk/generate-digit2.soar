sp {arithmetic*apply*generate-digit2
   (state <s> ^name arithmetic)
   (<s> ^operator <o>)
   (<o> ^name generate-digit2)
   (<o> ^p <p>)
   (<o> ^c <c>)
   (<o> ^d <d>)
   (<c> ^digit2 <c-digit2>)
   (<d> ^val <d-val>)
   (<c> ^gen2 <c-gen2>)
   (<p> ^pid <p-pid>)
   (<p> ^digits <p-digits>)
-->
