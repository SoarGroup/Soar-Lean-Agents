   (<x2> ^gen2 0)
   (<x2> ^done 0)
   (<s> ^column <x3>)
   (<x3> ^pos 3)
   (<x3> ^last 1)
   (<x3> ^digit1 0)
   (<x3> ^digit2 0)
   (<x3> ^result 0)
   (<x3> ^gen1 0)
   (<x3> ^gen2 0)
   (<x3> ^done 0)
   (<s> ^digit <x4>)
