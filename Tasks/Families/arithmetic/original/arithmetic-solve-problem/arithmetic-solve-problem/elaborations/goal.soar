
sp {arithmetic*elaborate*goal*success
   (state <s> ^name arithmetic)
   (<s> ^desired <d>)
   (<s> ^problem <x>)
   (<d> ^problem <dx>)
   (<dx> ^count <g-count>)
   (<x> ^count <g-count>)
-->
   (<s> ^success <d>)
}

sp {arithmetic*halt*goal*success
   (state <s> ^superstate nil)
   (<s> ^desired <d>)
   (<s> ^success <d>)
-->
   (write (crlf) |The problem has been solved.|)
   (halt)
}
