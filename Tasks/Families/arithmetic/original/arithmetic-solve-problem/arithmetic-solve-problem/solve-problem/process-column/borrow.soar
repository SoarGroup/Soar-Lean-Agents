
sp {process-column*propose*borrow
   (state <s> ^name process-column)
   (<s> ^superstate <ss>)
   (<s> ^task-state <ts>)
   (<s> ^p <p>)
   (<s> ^|c1| <c1>)
   (<s> ^|c2| <c2>)
   (<s> ^|c3| <c3>)
   (<s> ^c <c>)
   (<s> ^|d1| <_v8>)
   (<p> ^operation 2)
   (<s> ^adj 1)
   (<s> ^ten 0)
   (<s> ^|d1| { <s-d1> < <s-d2> })
   (<s> ^|d2| <s-d2>)
-->
   (<s> ^operator <o> +)
   (<s> ^operator <o> =)
   (<o> ^name borrow)
}
