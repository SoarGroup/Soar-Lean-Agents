
sp {process-column*propose*subtract-digits
   (state <s> ^name process-column)
   (<s> ^superstate <ss>)
   (<s> ^task-state <ts>)
   (<s> ^p <p>)
   (<s> ^|c1| <c1>)
   (<s> ^|c2| <c2>)
   (<s> ^|c3| <c3>)
   (<s> ^c <c>)
   (<s> ^|d1| <_v8>)
   (<ts> ^sub-fact <f>)
   (<p> ^operation 2)
   (<s> ^adj 1)
   (<s> ^r -1)
   (<f> ^|d1| <s-d1>)
   (<s> ^|d1| <s-d1>)
   (<f> ^|d2| <s-d2>)
   (<s> ^|d2| <s-d2>)
-->
   (<s> ^operator <o> +)
   (<s> ^operator <o> =)
   (<o> ^name subtract-digits)
   (<o> ^f <f>)
}

sp {process-column*apply*subtract-digits
   (state <s> ^name process-column)
   (<s> ^superstate <ss>)
   (<s> ^task-state <ts>)
   (<s> ^p <p>)
   (<s> ^|c1| <c1>)
   (<s> ^|c2| <c2>)
   (<s> ^|c3| <c3>)
   (<s> ^c <c>)
   (<s> ^operator <o>)
   (<o> ^name subtract-digits)
   (<o> ^f <f>)
   (<s> ^r <s-r>)
   (<f> ^diff <f-diff>)
-->
   (<s> ^r <f-diff>)
   (<s> ^r <s-r> -)
}
