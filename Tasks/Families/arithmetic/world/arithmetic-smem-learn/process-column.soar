## arithmetic-smem-learn: implementation of process-column in its operator-implementation substate.
## The column work (d1, d2, adj, r, cout, ten, ...) is local reasoning state of the substate,
## not part of the world; only write-result (a task operator) changes the world.
## Substate attributes ^argument1 (problem) and ^argument2 (column) are copied from the
## process-column operator by agent-world.

sp {process-column*propose*init-local
   (state <s> ^name process-column
              ^argument1 <p>
              ^argument2 <c>
             -^|d1|)
-->
   (<s> ^operator <o> +)
   (<o> ^name init-local
        ^task-operator false)
}

sp {process-column*apply*init-local
   (state <s> ^name process-column
              ^operator.name init-local
              ^argument1 <p>
              ^argument2 <c>)
   (<c> ^digit1 <c-digit1>
        ^digit2 <c-digit2>)
   (<p> ^carry <p-carry>)
-->
   (<s> ^|d1| <c-digit1>
        ^|d2| <c-digit2>
        ^adj (- 1 <p-carry>)
        ^r -1
        ^cout 0
        ^ten 0)
}

sp {process-column*propose*get-digit2
   (state <s> ^name process-column
              ^|d1|
              ^adj 0)
-->
   (<s> ^operator <o> + =)
   (<o> ^name get-digit2
        ^task-operator false)
}

sp {get-digit2*propose*increment-digit2
   (state <s> ^name get-digit2)
-->
   (<s> ^operator <o> + =)
   (<o> ^name increment-digit2
        ^task-operator false)
}

sp {get-digit2*apply*increment-digit2*query
   (state <s> ^name get-digit2
              ^superstate <ss>
              ^operator <o>
             -^queried <o>
              ^smem.command <cmd>)
   (<o> ^name increment-digit2)
   (<ss> ^|d2| <ss-d2>)
-->
   (<s> ^queried <o>)
   (<cmd> ^query <q>)
   (<q> ^kind inc-fact
        ^n <ss-d2>)
}

sp {get-digit2*apply*increment-digit2
   (state <s> ^name get-digit2
              ^superstate <ss>
              ^operator <o>
              ^smem <sm>)
   (<o> ^name increment-digit2)
   (<sm> ^result.retrieved <i>
         ^command <cmd>)
   (<cmd> ^query <q>)
   (<ss> ^|d2| <ss-d2>
         ^adj <ss-adj>)
   (<i> ^next <i-next>)
-->
   (<ss> ^|d2| <i-next>)
   (<ss> ^|d2| <ss-d2> -)
   (<ss> ^adj 1)
   (<ss> ^adj <ss-adj> -)
   (<cmd> ^query <q> -)
}

sp {process-column*propose*add-digits
   (state <s> ^name process-column
              ^argument1 <p>
              ^|d1|
              ^adj 1
              ^r -1)
   (<p> ^operation 1)
-->
   (<s> ^operator <o> + =)
   (<o> ^name add-digits
        ^task-operator false)
}

sp {process-column*apply*add-digits*query
   (state <s> ^name process-column
              ^operator <o>
             -^queried <o>
              ^smem.command <cmd>)
   (<o> ^name add-digits)
   (<s> ^|d1| <s-d1>
        ^|d2| <s-d2>)
-->
   (<s> ^queried <o>)
   (<cmd> ^query <q>)
   (<q> ^kind add-fact
        ^|d1| <s-d1>
        ^|d2| <s-d2>)
}

sp {process-column*apply*add-digits*retrieval-failed
   (state <s> ^name process-column
              ^operator <o>
              ^smem <sm>)
   (<o> ^name add-digits)
   (<sm> ^result.failure <q>
         ^command <cmd>)
   (<cmd> ^query <q>)
-->
   (<cmd> ^query <q> -)
}

sp {process-column*apply*add-digits
   (state <s> ^name process-column
              ^operator <o>
              ^smem <sm>
              ^r <s-r>
              ^cout <s-cout>)
   (<o> ^name add-digits)
   (<sm> ^result.retrieved <f>
         ^command <cmd>)
   (<cmd> ^query <q>)
   (<f> ^sum <f-sum>
        ^carry <f-carry>)
-->
   (<s> ^r <f-sum>)
   (<s> ^r <s-r> -)
   (<s> ^cout <f-carry>)
   (<s> ^cout <s-cout> -)
   (<cmd> ^query <q> -)
}

sp {process-column*propose*borrow
   (state <s> ^name process-column
              ^argument1 <p>
              ^adj 1
              ^ten 0
              ^|d1| { <s-d1> < <s-d2> }
              ^|d2| <s-d2>)
   (<p> ^operation 2)
-->
   (<s> ^operator <o> + =)
   (<o> ^name borrow
        ^task-operator false)
}

sp {borrow*propose*add-ten
   (state <s> ^name borrow)
-->
   (<s> ^operator <o> + =)
   (<o> ^name add-ten
        ^task-operator false)
}

sp {borrow*apply*add-ten*query
   (state <s> ^name borrow
              ^superstate <ss>
              ^operator <o>
             -^queried <o>
              ^smem.command <cmd>)
   (<o> ^name add-ten)
   (<ss> ^|d1| <ss-d1>)
-->
   (<s> ^queried <o>)
   (<cmd> ^query <q>)
   (<q> ^kind ten-fact
        ^n <ss-d1>)
}

sp {borrow*apply*add-ten
   (state <s> ^name borrow
              ^superstate <ss>
              ^operator <o>)
   (<o> ^name add-ten)
   (<s> ^smem <sm>)
   (<sm> ^result.retrieved <t>
         ^command <cmd>)
   (<cmd> ^query <q>)
   (<ss> ^|d1| <ss-d1>
         ^ten <ss-ten>
         ^cout <ss-cout>)
   (<t> ^plus10 <t-plus10>)
-->
   (<ss> ^|d1| <t-plus10>)
   (<ss> ^|d1| <ss-d1> -)
   (<ss> ^ten 1)
   (<ss> ^ten <ss-ten> -)
   (<ss> ^cout 1)
   (<ss> ^cout <ss-cout> -)
   (<cmd> ^query <q> -)
}

sp {process-column*propose*subtract-digits
   (state <s> ^name process-column
              ^argument1 <p>
              ^adj 1
              ^r -1
              ^|d1| { <s-d1> >= <s-d2> }
              ^|d2| <s-d2>)
   (<p> ^operation 2)
-->
   (<s> ^operator <o> + =)
   (<o> ^name subtract-digits
        ^task-operator false)
}

sp {process-column*apply*subtract-digits*query
   (state <s> ^name process-column
              ^operator <o>
             -^queried <o>
              ^smem.command <cmd>)
   (<o> ^name subtract-digits)
   (<s> ^|d1| <s-d1>
        ^|d2| <s-d2>)
-->
   (<s> ^queried <o>)
   (<cmd> ^query <q>)
   (<q> ^kind sub-fact
        ^|d1| <s-d1>
        ^|d2| <s-d2>)
}

sp {process-column*apply*subtract-digits*retrieval-failed
   (state <s> ^name process-column
              ^operator <o>
              ^smem <sm>)
   (<o> ^name subtract-digits)
   (<sm> ^result.failure <q>
         ^command <cmd>)
   (<cmd> ^query <q>)
-->
   (<cmd> ^query <q> -)
}

sp {process-column*apply*subtract-digits
   (state <s> ^name process-column
              ^operator <o>
              ^smem <sm>
              ^r <s-r>)
   (<o> ^name subtract-digits)
   (<sm> ^result.retrieved <f>
         ^command <cmd>)
   (<cmd> ^query <q>)
   (<f> ^diff <f-diff>)
-->
   (<s> ^r <f-diff>)
   (<s> ^r <s-r> -)
   (<cmd> ^query <q> -)
}

## Counting substates (arithmetic-smem-learn): when no fact is retrieved, add-digits /
## subtract-digits are implemented by counting, and the new fact is stored in smem.

sp {add-digits*propose*init-local
   (state <s> ^name add-digits
             -^sum)
-->
   (<s> ^operator <o> +)
   (<o> ^name init-local
        ^task-operator false)
}

sp {add-digits*apply*init-local
   (state <s> ^name add-digits
              ^superstate <ss>
              ^operator.name init-local)
   (<ss> ^|d1| <ss-d1>)
-->
   (<s> ^sum <ss-d1>
        ^n 0
        ^stored 0)
}

sp {add-digits*propose*count-add
   (state <s> ^name add-digits
              ^superstate <ss>
              ^sum
              ^n <> <ss-d2>)
   (<ss> ^|d2| <ss-d2>)
-->
   (<s> ^operator <o> + =)
   (<o> ^name count-add
        ^task-operator false)
}

sp {add-digits*apply*count-add
   (state <s> ^name add-digits
              ^operator.name count-add
              ^sum <s-sum>
              ^n <s-n>)
-->
   (<s> ^sum (+ <s-sum> 1))
   (<s> ^sum <s-sum> -)
   (<s> ^n (+ <s-n> 1))
   (<s> ^n <s-n> -)
}

sp {add-digits*propose*store-add
   (state <s> ^name add-digits
              ^superstate <ss>
              ^sum
              ^n <ss-d2>
              ^stored 0)
   (<ss> ^|d2| <ss-d2>)
-->
   (<s> ^operator <o> + =)
   (<o> ^name store-add
        ^task-operator false)
}

sp {add-digits*apply*store-add
   (state <s> ^name add-digits
              ^superstate <ss>
              ^operator.name store-add
              ^stored <s-stored>
              ^sum <local-sum>
              ^smem.command <cmd>)
   (<ss> ^|d1| <up-d1>
         ^|d2| <up-d2>)
-->
   (<s> ^stored 1)
   (<s> ^stored <s-stored> -)
   (<cmd> ^store <st0>)
   (<st0> ^kind add-fact
          ^|d1| <up-d1>
          ^|d2| <up-d2>
          ^sum (- <local-sum> (* (div <local-sum> 10) 10))
          ^carry (div <local-sum> 10))
   (<cmd> ^store <st1>)
   (<st1> ^kind add-fact
          ^|d1| <up-d2>
          ^|d2| <up-d1>
          ^sum (- <local-sum> (* (div <local-sum> 10) 10))
          ^carry (div <local-sum> 10))
}

sp {add-digits*propose*done-add
   (state <s> ^name add-digits
              ^sum
              ^stored 1)
-->
   (<s> ^operator <o> + =)
   (<o> ^name done-add
        ^task-operator false)
}

sp {add-digits*apply*done-add
   (state <s> ^name add-digits
              ^superstate <ss>
              ^operator.name done-add
              ^sum <s-sum>)
   (<ss> ^r <ss-r>
         ^cout <ss-cout>)
-->
   (<ss> ^r (- <s-sum> (* (div <s-sum> 10) 10)))
   (<ss> ^r <ss-r> -)
   (<ss> ^cout (div <s-sum> 10))
   (<ss> ^cout <ss-cout> -)
}

sp {subtract-digits*propose*init-local
   (state <s> ^name subtract-digits
             -^base)
-->
   (<s> ^operator <o> +)
   (<o> ^name init-local
        ^task-operator false)
}

sp {subtract-digits*apply*init-local
   (state <s> ^name subtract-digits
              ^superstate <ss>
              ^operator.name init-local)
   (<ss> ^|d1| <ss-d1>)
-->
   (<s> ^base <ss-d1>
        ^n 0
        ^stored 0)
}

sp {subtract-digits*propose*count-sub
   (state <s> ^name subtract-digits
              ^superstate <ss>
              ^base
              ^n <> <ss-d2>)
   (<ss> ^|d2| <ss-d2>)
-->
   (<s> ^operator <o> + =)
   (<o> ^name count-sub
        ^task-operator false)
}

sp {subtract-digits*apply*count-sub
   (state <s> ^name subtract-digits
              ^operator.name count-sub
              ^base <s-base>
              ^n <s-n>)
-->
   (<s> ^base (- <s-base> 1))
   (<s> ^base <s-base> -)
   (<s> ^n (+ <s-n> 1))
   (<s> ^n <s-n> -)
}

sp {subtract-digits*propose*store-sub
   (state <s> ^name subtract-digits
              ^superstate <ss>
              ^base
              ^n <ss-d2>
              ^stored 0)
   (<ss> ^|d2| <ss-d2>)
-->
   (<s> ^operator <o> + =)
   (<o> ^name store-sub
        ^task-operator false)
}

sp {subtract-digits*apply*store-sub
   (state <s> ^name subtract-digits
              ^superstate <ss>
              ^operator.name store-sub
              ^stored <s-stored>
              ^base <local-base>
              ^smem.command <cmd>)
   (<ss> ^|d1| <up-d1>
         ^|d2| <up-d2>)
-->
   (<s> ^stored 1)
   (<s> ^stored <s-stored> -)
   (<cmd> ^store <st0>)
   (<st0> ^kind sub-fact
          ^|d1| <up-d1>
          ^|d2| <up-d2>
          ^diff <local-base>)
}

sp {subtract-digits*propose*done-sub
   (state <s> ^name subtract-digits
              ^base
              ^stored 1)
-->
   (<s> ^operator <o> + =)
   (<o> ^name done-sub
        ^task-operator false)
}

sp {subtract-digits*apply*done-sub
   (state <s> ^name subtract-digits
              ^superstate <ss>
              ^operator.name done-sub
              ^base <s-base>)
   (<ss> ^r <ss-r>)
-->
   (<ss> ^r <s-base>)
   (<ss> ^r <ss-r> -)
}

sp {process-column*propose*write-result
   (state <s> ^name process-column
              ^argument1 <p>
              ^argument2 <c>
              ^|d1|
              ^r <> -1
              ^top-state.desireds.desired <d>)
-->
   (<s> ^operator <o> + =)
   (<o> ^name write-result
        ^task-operator true
        ^action-handle write-result
        ^super-desired <d>
        ^argument1 <c>
        ^argument2 <p>
        ^argument-count 2
        ^desireds <pre>)
   (<pre> ^desired-count 0)
}

sp {process-column*apply*write-result*internal
   (state <s> ^name process-column
              ^operator <o>
              ^internal-actions true
              ^r <s-r>
              ^cout <s-cout>)
   (<o> ^name write-result
        ^pre-conditions-satisfied true
        ^argument1 <c>
        ^argument2 <p>)
   (<c> ^result <c-result>
        ^done <c-done>
        ^pos <c-pos>
        ^digit1 <c-digit1>
        ^digit2 <c-digit2>)
   (<p> ^carry <p-carry>
        ^pid <p-pid>
        ^operation <p-operation>)
-->
   (log 1 (crlf) |Apply write-result: column | <c-pos>)
   (<c> ^result <s-r>)
   (<c> ^result <c-result> -)
   (<p> ^carry <s-cout>)
   (<p> ^carry <p-carry> -)
   (<c> ^done <p-pid>)
   (<c> ^done <c-done> -)
   (write |column | <c-pos> | op | <p-operation> |: | <c-digit1> | | <c-digit2> | -> | <s-r> | carry | <s-cout>)
}

