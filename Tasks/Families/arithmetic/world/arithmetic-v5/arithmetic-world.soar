## arithmetic-v5: task situation, goal and knowledge tables (world conventions, the shared library)
## The problem and its columns are world objects; the goal is ^desireds on the top state.
## The task has no external environment: the top state is marked ^environment none.

sp {arithmetic*propose*initialize-arithmetic
   (state <s> ^superstate nil
              ^world <w>
             -^name)
-->
   (<s> ^operator <o> + >)
   (<o> ^name initialize-arithmetic
        ^task-operator false)
}

sp {arithmetic*compare*initialize-arithmetic*initialize-agent-world
   (state <s> ^superstate nil
              ^operator <o> +
              ^operator <iaw> +)
   (<o> ^name initialize-arithmetic)
   (<iaw> ^name initialize-agent-world)
-->
   (<s> ^operator <o> > <iaw>)
}

sp {arithmetic*apply*initialize-arithmetic
   (state <s> ^operator.name initialize-arithmetic
              ^world <w>)
   (<w> ^objects <objs>)
-->
   (<s> ^name arithmetic
        ^environment none
        ^problem-space <ps>
        ^flag-override <flags>
        ^desireds <ds>)
   (<ps> ^name arithmetic
         ^agent-world true)
   (<flags> ^mea-operator-selection false
            ^look-ahead-planning false)
   (<objs> ^object <p>)
   (<p> ^object-handle problem
        ^anchored true
        ^operation 0
        ^carry 0
        ^count 10000
        ^pid 1
        ^digits 0)
   (<objs> ^object <c1>)
   (<c1> ^object-handle column1
         ^anchored true
         ^pos 1
         ^last 0
         ^digit1 0
         ^digit2 0
         ^result 0
         ^gen1 0
         ^gen2 0
         ^done 0
         ^newd1 0)
   (<objs> ^object <c2>)
   (<c2> ^object-handle column2
         ^anchored true
         ^pos 2
         ^last 0
         ^digit1 0
         ^digit2 0
         ^result 0
         ^gen1 0
         ^gen2 0
         ^done 0
         ^newd1 0)
   (<objs> ^object <c3>)
   (<c3> ^object-handle column3
         ^anchored true
         ^pos 3
         ^last 1
         ^digit1 0
         ^digit2 0
         ^result 0
         ^gen1 0
         ^gen2 0
         ^done 0
         ^newd1 0)
   (<ds> ^desired <d>
         ^desired-count 1)
   (<d> ^object <do>)
   (<do> ^object-handle problem
         ^count 0)
}

## Fixed knowledge (digits and arithmetic fact tables): a lookup table on the top state, not part of the world.
