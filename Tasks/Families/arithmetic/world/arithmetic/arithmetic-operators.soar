sp {arithmetic*propose*generate-digit1*subtraction*last
   (state <s> ^problem-space.name arithmetic
              ^world <w>
              ^desireds <ds>)
   (<w> ^anchored-world true
        ^objects <objs>)
   (<ds> ^desired <d>
         ^unachieved <d>)
   (<objs> ^object <p>
           ^object <c>)
   (<p> ^object-handle $ problem
        ^pid <pid>)
   (<c> ^pos
        ^gen1 <> <pid>)
   (<s> ^facts.digit <dg>)
   (<dg> ^val <val>)
   (<p> ^operation 2)
   (<c> ^last 1)
   (<dg> ^val > 0)
-->
   (<s> ^operator <o> + =)
   (<o> ^name generate-digit1
        ^task-operator true
        ^action-handle generate-digit1
        ^super-desired <d>
        ^argument1 <c>
        ^argument2 <val>
