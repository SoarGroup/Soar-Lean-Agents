}

sp {arithmetic*apply*generate-digit2*internal
   (state <s> ^operator <o>
              ^internal-actions true)
   (<o> ^name generate-digit2
        ^pre-conditions-satisfied true
        ^argument1 <c>
        ^argument2 <val>
        ^argument3 <p>)
   (<c> ^digit2 <c-digit2>
        ^gen2 <c-gen2>)
   (<p> ^pid <pid>
        ^digits <p-digits>)
-->
   (log 1 (crlf) |Apply generate-digit2: column | <c> | digit | <val>)
   (<c> ^digit2 <val>)
   (<c> ^digit2 <c-digit2> -)
   (<c> ^gen2 <pid>)
   (<c> ^gen2 <c-gen2> -)
   (<p> ^digits (+ <p-digits> 1))
   (<p> ^digits <p-digits> -)
}

sp {arithmetic*propose*process-column
   (state <s> ^problem-space.name arithmetic
              ^world <w>
              ^desireds <ds>)
   (<w> ^anchored-world true
        ^objects <objs>)
   (<ds> ^desired <d>
         ^unachieved <d>)
   (<objs> ^object <p>
           ^object <c>)
   (<p> ^object-handle $ problem
        ^pid <pid>
        ^digits 6)
   (<c> ^pos <c-pos>
        ^done <> <pid>)
  -{(<objs> ^object <cx>)
    (<cx> ^pos < <c-pos>
          ^done <> <pid>)}
-->
   (<s> ^operator <o> + =)
   (<o> ^name process-column
        ^task-operator true
        ^super-desired <d>
        ^argument1 <p>
        ^argument2 <c>
        ^argument-count 2
        ^desireds <pre>)
   (<pre> ^desired-count 0)
}

sp {arithmetic*propose*finish-problem
   (state <s> ^problem-space.name arithmetic
              ^world <w>
              ^desireds <ds>)
   (<w> ^anchored-world true
        ^objects <objs>)
   (<ds> ^desired <d>
         ^unachieved <d>)
   (<objs> ^object <p>
           ^object <c1>
           ^object <c2>
           ^object <c3>)
   (<p> ^object-handle $ problem
        ^pid <pid>
        ^digits 6)
   (<c1> ^pos 1)
   (<c2> ^pos 2)
   (<c3> ^pos 3)
  -{(<objs> ^object <cx>)
    (<cx> ^done <> <pid>)}
-->
   (<s> ^operator <o> + =)
   (<o> ^name finish-problem
        ^task-operator true
        ^action-handle finish-problem
        ^super-desired <d>
        ^argument1 <p>
        ^argument-count 1
        ^desireds <pre>)
   (<pre> ^desired-count 0)
}

sp {arithmetic*apply*finish-problem*internal
   (state <s> ^operator <o>
              ^internal-actions true
              ^world <w>)
   (<w> ^anchored-world true
        ^objects <objs>)
   (<o> ^name finish-problem
        ^pre-conditions-satisfied true
        ^argument1 <p>)
   (<objs> ^object <c1> ^object <c2> ^object <c3>)
   (<c1> ^pos 1
         ^digit1 <c1-digit1>
         ^digit2 <c1-digit2>
         ^result <c1-result>)
   (<c2> ^pos 2
         ^digit1 <c2-digit1>
         ^digit2 <c2-digit2>
         ^result <c2-result>)
   (<c3> ^pos 3
         ^digit1 <c3-digit1>
         ^digit2 <c3-digit2>
         ^result <c3-result>)
   (<p> ^count <p-count>
        ^pid <p-pid>
        ^digits <p-digits>
        ^operation <p-operation>
        ^carry <p-carry>)
-->
   (log 1 (crlf) |Apply finish-problem|)
   (<p> ^count (- <p-count> 1))
   (<p> ^count <p-count> -)
   (<p> ^pid (+ <p-pid> 1))
   (<p> ^pid <p-pid> -)
   (<p> ^digits 0)
   (<p> ^digits <p-digits> -)
   (<p> ^operation 0)
   (<p> ^operation <p-operation> -)
   (write |problem op | <p-operation> | top | <c3-digit1> <c2-digit1> <c1-digit1> | bottom | <c3-digit2> <c2-digit2> <c1-digit2> | answer | <c3-result> <c2-result> <c1-result> | carry | <p-carry>)
}

