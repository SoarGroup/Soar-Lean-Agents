## arithmetic: top-level task operators. Each is applied by an internal application rule that
## updates the world in the decision it is selected (^environment none).

sp {arithmetic*propose*choose-operation*k-1
   (state <s> ^problem-space.name arithmetic
              ^world <w>
              ^desireds <ds>)
   (<w> ^anchored-world true
        ^objects <objs>)
   (<ds> ^desired <d>
         ^unachieved <d>)
   (<objs> ^object <p>)
   (<p> ^object-handle $ problem
        ^operation 0
        ^count > 0)
-->
   (<s> ^operator <o> + =)
   (<o> ^name choose-operation
        ^task-operator true
        ^action-handle choose-operation
        ^super-desired <d>
        ^argument1 <p>
        ^argument2 1
        ^argument-count 2
        ^desireds <pre>)
   (<pre> ^desired-count 0)
}

sp {arithmetic*propose*choose-operation*k-2
   (state <s> ^problem-space.name arithmetic
              ^world <w>
              ^desireds <ds>)
   (<w> ^anchored-world true
        ^objects <objs>)
   (<ds> ^desired <d>
         ^unachieved <d>)
   (<objs> ^object <p>)
   (<p> ^object-handle $ problem
        ^operation 0
        ^count > 0)
-->
   (<s> ^operator <o> + =)
   (<o> ^name choose-operation
        ^task-operator true
        ^action-handle choose-operation
        ^super-desired <d>
        ^argument1 <p>
        ^argument2 2
        ^argument-count 2
        ^desireds <pre>)
   (<pre> ^desired-count 0)
}

sp {arithmetic*apply*choose-operation*internal
   (state <s> ^operator <o>
              ^internal-actions true)
   (<o> ^name choose-operation
        ^pre-conditions-satisfied true
        ^argument1 <p>
        ^argument2 <k>)
   (<p> ^operation <p-operation>
        ^carry <p-carry>)
-->
   (log 1 (crlf) |Apply choose-operation: | <k>)
   (<p> ^operation <k>)
   (<p> ^operation <p-operation> -)
   (<p> ^carry 0)
   (<p> ^carry <p-carry> -)
}

sp {arithmetic*propose*generate-digit1*addition
   (state <s> ^problem-space.name arithmetic
              ^world <w>
              ^desireds <ds>)
   (<w> ^anchored-world true
        ^objects <objs>)
   (<ds> ^desired <d>
         ^unachieved <d>)
   (<objs> ^object <p>
           ^object <c>)
   (<p> ^object-handle $ problem
        ^pid <pid>)
   (<c> ^pos
        ^gen1 <> <pid>)
   (<s> ^facts.digit <dg>)
   (<dg> ^val <val>)
   (<p> ^operation 1)
-->
   (<s> ^operator <o> + =)
   (<o> ^name generate-digit1
        ^task-operator true
        ^action-handle generate-digit1
        ^super-desired <d>
        ^argument1 <c>
        ^argument2 <val>
        ^argument3 <p>
        ^argument-count 3
        ^desireds <pre>)
   (<pre> ^desired-count 0)
}

