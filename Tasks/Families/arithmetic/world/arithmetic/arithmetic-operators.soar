sp {arithmetic*propose*generate-digit2*subtraction*last
   (state <s> ^problem-space.name arithmetic
              ^world <w>
              ^desireds <ds>)
   (<w> ^anchored-world true
        ^objects <objs>)
   (<ds> ^desired <d>
         ^unachieved <d>)
   (<objs> ^object <p>
           ^object <c>)
   (<p> ^object-handle $ problem
        ^pid <pid>)
   (<c> ^gen1 <pid>
        ^gen2 <> <pid>)
   (<s> ^facts.digit <dg>)
   (<dg> ^val <val>)
   (<p> ^operation 2)
   (<c> ^last 1
        ^digit1 <c-digit1>)
   (<dg> ^val < <c-digit1>)
-->
   (<s> ^operator <o> + =)
   (<o> ^name generate-digit2
        ^task-operator true
        ^action-handle generate-digit2
        ^super-desired <d>
        ^argument1 <c>
        ^argument2 <val>
        ^argument3 <p>
        ^argument-count 3
        ^desireds <pre>)
