sp {arithmetic*apply*generate-digit1*internal
   (state <s> ^operator <o>
              ^internal-actions true)
   (<o> ^name generate-digit1
        ^pre-conditions-satisfied true
        ^argument1 <c>
        ^argument2 <val>
        ^argument3 <p>)
   (<c> ^digit1 <c-digit1>
        ^gen1 <c-gen1>)
   (<p> ^pid <pid>
        ^digits <p-digits>)
-->
   (log 1 (crlf) |Apply generate-digit1: column | <c> | digit | <val>)
   (<c> ^digit1 <val>)
   (<c> ^digit1 <c-digit1> -)
   (<c> ^gen1 <pid>)
   (<c> ^gen1 <c-gen1> -)
   (<p> ^digits (+ <p-digits> 1))
   (<p> ^digits <p-digits> -)
}

