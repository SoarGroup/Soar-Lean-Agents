## Blocks world (families, from English): generated by spec_backend.py (WorldSpec, path B: Lean description, Python rules) from the instructor statements.
##
## Instructor statements used (numbers as in english-input.txt):
##  1. Lettered blocks sit on a table, some stacked on others.
##  2. You may move one block at a time, and only a block with nothing on top of it.
##  3. A block can go onto the table or onto another block that has nothing on top of it.
##  4. Blocks A and B start on the table and block C is on block A.
##  5. The goal is A on B, B on C and C on the table.
##
## Assumption ledger:
##   A-BW1: One on relation from each block to what it sits on, a block or the table (a single table object).
##   A-BW2: "nothing on top of it": no block is on it, a derived relation clear(block) tested positively (W-CHK-009). Two operators: move-to-table for a block that is on a block, and move-to-block onto a different clear block.
##   A-BW3: Search control, not from the English (as for the other WorldSpec search tasks): a look-ahead state that returns to a situation already on its path fails; a situation is where each block is.
## Matching hints for learned rules (World-Conventions L3-095, L11-009): many-valued attributes, sized from the initial world.
production optimize-attribute object 5
production optimize-attribute on 3


## Propose initialize-blocks-world when its conditions below hold.
sp {blocks-world*propose*initialize-blocks-world
   (state <s> ^superstate nil ^world <w> -^name)
-->
   (<s> ^operator <o> + >)
   (<o> ^name initialize-blocks-world ^task-operator false)
}

sp {blocks-world*apply*initialize-blocks-world
   (state <s> ^operator.name initialize-blocks-world ^world <w>)
   (<w> ^objects <objs>)
-->
   (<s> ^name blocks-world ^desireds <ds>)
   (<objs> ^object <k-table> <k-a> <k-b> <k-c> <k-task>)
   (<k-table> ^object-handle table ^anchored true ^type table ^name table ^static true)
   (<k-a> ^object-handle a ^anchored true ^type block ^name a ^static true)
   (<k-b> ^object-handle b ^anchored true ^type block ^name b ^static true)
   (<k-c> ^object-handle c ^anchored true ^type block ^name c ^static true)
   (<k-task> ^object-handle task ^anchored true ^type task)
   (<ds> ^desired-count 1 ^desired <d1>)
   (<d1> ^object <d1-o>)
   (<d1-o> ^object-handle task ^goal-met true)
   (<w> ^on <rel-1>)
   (<rel-1> ^argument1 <k-a> ^argument2 <k-table>)
   (<w> ^on <rel-2>)
   (<rel-2> ^argument1 <k-b> ^argument2 <k-table>)
   (<w> ^on <rel-3>)
   (<rel-3> ^argument1 <k-c> ^argument2 <k-a>)
   (log 1 (crlf) |Initialize blocks-world.|)
}

## Elaborate problem space: adds ^dont-copy-object-attribute, ^problem-space.
sp {blocks-world*elaborate*problem-space
   (state <s> ^name blocks-world)
-->
   (<s> ^problem-space <p>)
   (<p> ^name blocks-world ^dont-copy-object-attribute goal-met)
}

sp {blocks-world*elaborate*problem-space*mea-substate
   (state <s> ^impasse no-change ^attribute operator ^superstate <ss>)
   (<ss> ^problem-space.name blocks-world ^operator <so>)
   (<so> ^task-operator true -^pre-conditions-satisfied true)
-->
   (<s> ^problem-space <p>)
   (<p> ^name blocks-world ^dont-copy-object-attribute goal-met)
}

## Elaborate flags: adds ^flag-override, ^mea-operator-selection.
sp {blocks-world*elaborate*flags
   (state <s> ^superstate nil ^name blocks-world)
-->
   (<s> ^flag-override <f>)
   (<f> ^mea-operator-selection true)
}

## Achievement of object-property desireds (supplied by the task).
sp {blocks-world*elaborate*state*achieved*object-property
   (state <s> ^problem-space.name blocks-world ^desireds <ds> ^world <w>)
   (<ds> ^desired <d>)
   (<d> ^object <do>)
   (<do> ^object-handle <h> ^{ <> object-handle <a> } <v>)
   (<w> ^anchored-world true ^objects.object <ob>)
   (<ob> ^object-handle <h> ^<a> <v>)
-->
   (<ds> ^achieved <d>)
}

sp {blocks-world*elaborate*state*unachieved*object-property
   (state <s> ^problem-space.name blocks-world ^desireds <ds> ^world <w>)
   (<ds> ^desired <d>)
   (<d> ^object <do>)
   (<do> ^object-handle <h> ^{ <> object-handle <a> } <v>)
   (<w> ^anchored-world true)
  -{(<w> ^objects.object <ob>)
    (<ob> ^object-handle <h> ^<a> <v>)}
-->
   (<ds> ^unachieved <d>)
}

## Operator move-to-table (statements 2, 3).
sp {blocks-world*propose*move-to-table
   (state <s> ^problem-space.name blocks-world ^flags.mea-operator-selection true ^world <w> ^desireds <ds>)
   (<w> ^anchored-world true ^objects <objs>)
   (<objs> ^object <b>)
   (<b> ^type block)
   (<w> ^clear <r1>)
   (<r1> ^argument1 <b>)
   (<w> ^on <r2>)
   (<r2> ^argument1 <b> ^argument2 <from>)
   (<from> ^type block)
   (<ds> ^unachieved-desireds true)
-->
   (<s> ^operator <op> +)
   (<op> ^name move-to-table ^task-operator true ^action-handle move-to-table ^argument1 <b> ^argument-count 1 ^pre-conditions-satisfied true)
}

## Effect of move-to-table (look-ahead).
sp {blocks-world*apply*move-to-table*internal
   (state <s> ^problem-space.name blocks-world ^operator <op> ^internal-actions true ^world <w>)
   (<op> ^task-operator true ^name move-to-table ^pre-conditions-satisfied true ^argument1.object-handle $ <b-h>)
   (<w> ^anchored-world true ^objects <objs>)
   (<objs> ^object <b>)
   (<b> ^object-handle $ <b-h>)
   (<w> ^on <r1>)
   (<r1> ^argument1 <b> ^argument2 <old>)
   (<objs> ^object <k-table>)
   (<k-table> ^object-handle table)
-->
   (<r1> ^argument2 <old> - <k-table>)
}

## Effect of a completed move-to-table command on the real world (once per command).
sp {blocks-world*apply*move-to-table*environment-effect
   :o-support
   (state <s> ^problem-space.name blocks-world ^superstate nil ^world <w> ^io.output-link.perform-action <pa>)
   (<pa> ^name move-to-table ^status complete ^argument1 <b-h> -^effect-applied true)
   (<w> ^anchored-world true ^objects <objs>)
   (<objs> ^object <b>)
   (<b> ^object-handle $ <b-h>)
   (<w> ^on <r1>)
   (<r1> ^argument1 <b> ^argument2 <old>)
   (<objs> ^object <k-table>)
   (<k-table> ^object-handle table)
-->
   (<r1> ^argument2 <old> - <k-table>)
   (<pa> ^effect-applied true)
   (write |Move block | <b-h> | to the table| (crlf))
}

## Operator move-to-block (statements 2, 3).
sp {blocks-world*propose*move-to-block
   (state <s> ^problem-space.name blocks-world ^flags.mea-operator-selection true ^world <w> ^desireds <ds>)
   (<w> ^anchored-world true ^objects <objs>)
   (<objs> ^object <b>)
   (<b> ^type block)
   (<objs> ^object <to>)
   (<to> ^type block)
   (<w> ^clear <r1>)
   (<r1> ^argument1 <b>)
   (<w> ^clear <r2>)
   (<r2> ^argument1 <to>)
   (<objs> ^object { <> <b> <to> })
   (<w> ^on <r3>)
   (<r3> ^argument1 <b> ^argument2 <from>)
   (<objs> ^object { <> <from> <to> })
   (<ds> ^unachieved-desireds true)
-->
   (<s> ^operator <op> +)
   (<op> ^name move-to-block ^task-operator true ^action-handle move-to-block ^argument1 <b> ^argument2 <to> ^argument-count 2 ^pre-conditions-satisfied true)
}

## Effect of move-to-block (look-ahead).
sp {blocks-world*apply*move-to-block*internal
   (state <s> ^problem-space.name blocks-world ^operator <op> ^internal-actions true ^world <w>)
   (<op> ^task-operator true ^name move-to-block ^pre-conditions-satisfied true ^argument1.object-handle $ <b-h> ^argument2.object-handle $ <to-h>)
   (<w> ^anchored-world true ^objects <objs>)
   (<objs> ^object <b>)
   (<b> ^object-handle $ <b-h>)
   (<objs> ^object <to>)
   (<to> ^object-handle $ <to-h>)
   (<w> ^on <r1>)
   (<r1> ^argument1 <b> ^argument2 <old>)
-->
   (<r1> ^argument2 <old> - <to>)
}

## Effect of a completed move-to-block command on the real world (once per command).
sp {blocks-world*apply*move-to-block*environment-effect
   :o-support
   (state <s> ^problem-space.name blocks-world ^superstate nil ^world <w> ^io.output-link.perform-action <pa>)
   (<pa> ^name move-to-block ^status complete ^argument1 <b-h> ^argument2 <to-h> -^effect-applied true)
   (<w> ^anchored-world true ^objects <objs>)
   (<objs> ^object <b>)
   (<b> ^object-handle $ <b-h>)
   (<objs> ^object <to>)
   (<to> ^object-handle $ <to-h>)
   (<w> ^on <r1>)
   (<r1> ^argument1 <b> ^argument2 <old>)
-->
   (<r1> ^argument2 <old> - <to>)
   (<pa> ^effect-applied true)
   (write |Move block | <b-h> | onto block | <to-h> (crlf))
}

## Derived relation clear (statements 2, 3): recomputed in every world, never copied into look-ahead.
sp {blocks-world*elaborate*derived*clear
   (state <s> ^problem-space.name blocks-world ^world <w>)
   (<w> ^anchored-world true ^objects <objs>)
   (<objs> ^object <b>)
   (<b> ^type block)
  -{  (<w> ^on <r1>)
  (<r1> ^argument1 <x> ^argument2 <b>)}
-->
   (<w> ^clear <dr>)
   (<dr> ^argument1 <b>)
}

## Goal (statement 5): ^goal-met true on the task object.
sp {blocks-world*elaborate*goal
   (state <s> ^problem-space.name blocks-world ^world <w>)
   (<w> ^anchored-world true ^objects <objs>)
   (<objs> ^object <task>)
   (<task> ^type task)
   (<objs> ^object <k-a>)
   (<k-a> ^object-handle a)
   (<objs> ^object <k-b>)
   (<k-b> ^object-handle b)
   (<w> ^on <r1>)
   (<r1> ^argument1 <k-a> ^argument2 <k-b>)
   (<objs> ^object <k-c>)
   (<k-c> ^object-handle c)
   (<w> ^on <r2>)
   (<r2> ^argument1 <k-b> ^argument2 <k-c>)
   (<objs> ^object <k-table>)
   (<k-table> ^object-handle table)
   (<w> ^on <r3>)
   (<r3> ^argument1 <k-c> ^argument2 <k-table>)
-->
   (<task> ^goal-met true)
}

## ---- Search control (stated in the description, not taught): a look-ahead state that returns to a situation on
## its look-ahead path fails, and the library rejects it. Situation: where each block is (on).
sp {blocks-world*elaborate*ancestor-world*parent
   (state <s> ^name evaluate-operator ^superstate.superstate.world <aw>)
-->
   (<s> ^ancestor-world <aw>)
}

sp {blocks-world*elaborate*ancestor-world*inherited
   (state <s> ^name evaluate-operator ^superstate.superstate.ancestor-world <aw>)
-->
   (<s> ^ancestor-world <aw>)
}

## Elaborate failure repeated situation: adds ^failure.
sp {blocks-world*elaborate*failure*repeated-situation
   (state <s> ^name evaluate-operator ^look-ahead-operator <o> ^ancestor-world <aw> ^desireds <ds> ^world <w>)
   (<w> ^anchored-world true ^versioned-operator <o>)
  -{(<w> ^on <r>)
    (<r> ^argument1 <x> ^argument2 <p>)
    (<x> ^type << block >> ^object-handle <h>)
    (<p> ^object-handle <ph>)
    (<aw> ^on <ar>)
    (<ar> ^argument1 <ax> ^argument2 <ap>)
    (<ax> ^object-handle <h>)
    (<ap> ^object-handle <> <ph>)}
-->
   (<s> ^failure <ds>)
}
