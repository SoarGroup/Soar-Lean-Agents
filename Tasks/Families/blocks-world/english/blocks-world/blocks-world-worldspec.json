{
  "format": "worldspec-1",
  "name": "blocks-world",
  "title": "Blocks world (families, from English)",
  "statements": [
    [
      1,
      "Lettered blocks sit on a table, some stacked on others."
    ],
    [
      2,
      "You may move one block at a time, and only a block with nothing on top of it."
    ],
    [
      3,
      "A block can go onto the table or onto another block that has nothing on top of it."
    ],
    [
      4,
      "Blocks A and B start on the table and block C is on block A."
    ],
    [
      5,
      "The goal is A on B, B on C and C on the table."
    ]
  ],
  "assumptions": [
    {
      "id": "A-BW1",
      "kind": "intent",
      "text": "One on relation from each block to what it sits on, a block or the table (a single table object).",
      "stmts": [
        1,
        4
      ]
    },
    {
      "id": "A-BW2",
      "kind": "intent",
      "text": "\"nothing on top of it\": no block is on it, a derived relation clear(block) tested positively (W-CHK-009). Two operators: move-to-table for a block that is on a block, and move-to-block onto a different clear block.",
      "stmts": [
        2,
        3
      ]
    },
    {
      "id": "A-BW3",
      "kind": "intent",
      "text": "Search control, not from the English (as for the other WorldSpec search tasks): a look-ahead state that returns to a situation already on its path fails; a situation is where each block is.",
      "stmts": []
    }
  ],
