   (<s> ^tried-tied-operator <_v1>)
   (<s> ^desired <d>)
   (<s> ^object <u0>)
   (<u0> ^name A)
   (<u0> ^on <u0t>)
   (<u0t> ^name <> B)
   (<s> ^object <l1>)
   (<l1> ^name B)
   (<l1> ^in-place 1)
