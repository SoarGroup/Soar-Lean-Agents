
sp {blocks-world*propose*move-block*1
   (state <s> ^name blocks-world)
   (<s> ^object <block>)
   (<s> ^object { <dest> <> <block> })
   (<block> ^table 0)
   (<block> ^on { <block-on> <> <dest> })
   (<dest> ^table 1)
   -{ (<s> ^object <none2>) (<none2> ^on <block>) }
-->
   (<s> ^operator <o> +)
   (<o> ^name move-block)
   (<o> ^block <block>)
   (<o> ^dest <dest>)
}

