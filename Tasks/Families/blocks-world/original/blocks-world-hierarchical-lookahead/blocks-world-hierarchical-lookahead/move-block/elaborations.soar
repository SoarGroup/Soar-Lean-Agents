}

sp {move-block*elaborate*substate*desired
   (state <s> ^name move-block)
   -(<s> ^duplicate-of <_v1>)
-->
   (<s> ^desired <d>)
}

sp {move-block*elaborate*problem-space
   (state <s> ^name move-block)
-->
   (<s> ^problem-space <p>)
   (<p> ^name move-block)
   (<p> ^default-state-copy yes)
   (<p> ^default-operator-copy yes)
   (<p> ^two-level-attributes object)
   (<p> ^two-level-attributes gripper)
   (<p> ^dont-copy block)
   (<p> ^dont-copy dest)
   (<p> ^dont-copy g)
   (<p> ^dont-copy in-place)
   (<p> ^dont-copy clear)
   (<p> ^dont-copy free)
   (<p> ^dont-copy task-state)
}

sp {move-block*elaborate*copy*block
   (state <s> ^name move-block)
   (<s> ^duplicate-of <orig>)
   (<orig> ^block <x>)
   (<x> ^name <xk>)
   (<s> ^object <y>)
   (<y> ^name <xk>)
-->
   (<s> ^block <y>)
}

sp {move-block*elaborate*copy*dest
   (state <s> ^name move-block)
   (<s> ^duplicate-of <orig>)
   (<orig> ^dest <x>)
   (<x> ^name <xk>)
   (<s> ^object <y>)
   (<y> ^name <xk>)
-->
