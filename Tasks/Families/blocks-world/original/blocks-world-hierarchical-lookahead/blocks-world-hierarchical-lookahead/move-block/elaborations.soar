sp {move-block*elaborate*copy*g
   (state <s> ^name move-block)
   (<s> ^duplicate-of <orig>)
   (<orig> ^g <x>)
   (<x> ^name <xk>)
   (<s> ^gripper <y>)
   (<y> ^name <xk>)
-->
