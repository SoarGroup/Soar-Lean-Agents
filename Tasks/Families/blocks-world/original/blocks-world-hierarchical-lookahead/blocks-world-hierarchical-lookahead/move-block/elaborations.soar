sp {move-block*evaluate*success
   (state <s> ^name move-block)
   (<s> ^tried-tied-operator <_v1>)
   (<s> ^desired <d>)
   (<s> ^block <block>)
   (<s> ^dest <dest>)
   (<s> ^g <g>)
   (<block> ^on <dest>)
-->
   (<s> ^success <d>)
}

sp {move-block*evaluate*failure*1
   (state <s> ^name move-block)
   (<s> ^tried-tied-operator <_v1>)
   (<s> ^desired <d>)
   (<s> ^block <block>)
   (<s> ^dest <dest>)
   (<s> ^g <g>)
   (<g> ^empty 0)
   (<g> ^holding { <g-holding> <> <block> })
-->
   (<s> ^failure <d>)
}

sp {move-block*evaluate*failure*2
   (state <s> ^name move-block)
   (<s> ^tried-tied-operator <_v1>)
   (<s> ^desired <d>)
   (<s> ^block <block>)
   (<s> ^dest <dest>)
   (<s> ^g <g>)
   (<g> ^empty 1)
   (<block> ^on { <block-on> <> <dest> })
-->
