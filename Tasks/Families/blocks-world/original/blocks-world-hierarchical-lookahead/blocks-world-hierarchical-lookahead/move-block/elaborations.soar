}

sp {move-block*copy*blocks-world*elaborate*object*in-place*base
   (state <s> ^name move-block)
   (<s> ^object <self>)
   (<self> ^table 1)
   (<s> ^duplicate-of <_v3>)
-->
   (<self> ^in-place 1)
}

sp {move-block*copy*blocks-world*elaborate*object*in-place*via-on
   (state <s> ^name move-block)
   (<s> ^object <self>)
   (<self> ^on <below>)
   (<below> ^in-place 1)
   (<s> ^desired <des0>)
   (<des0> ^object <dx0>)
   (<self> ^name <ko0>)
   (<dx0> ^name <ko0>)
   (<dx0> ^on <dt0>)
   (<dt0> ^name <kt0>)
   (<below> ^name <kt0>)
   (<s> ^duplicate-of <_v11>)
-->
   (<self> ^in-place 1)
}

sp {move-block*copy*blocks-world*elaborate*object*clear*base*2
   (state <s> ^name move-block)
