sp {move-block*copy*blocks-world*elaborate*object*clear*base*3
   (state <s> ^name move-block)
   (<s> ^object <self>)
   -{ (<s> ^object <none1>) (<none1> ^on <self>) }
   -{ (<s> ^gripper <none2>) (<none2> ^empty 0) (<none2> ^holding <self>) }
   (<s> ^duplicate-of <_v4>)
-->
   (<self> ^clear 1)
}

