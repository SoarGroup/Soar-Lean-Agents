
sp {pick-up*elaborate*substate
   (state <s> ^impasse no-change)
   (<s> ^attribute operator)
   (<s> ^superstate <ss>)
   (<ss> ^operator <so>)
   (<so> ^name pick-up)
   (<ss> ^task-state <ts>)
   (<so> ^x <x>)
   (<ss> ^block <block>)
   (<ss> ^dest <dest>)
   (<ss> ^g <g>)
-->
   (<s> ^name pick-up)
   (<s> ^task-state <ts>)
   (<s> ^block <block>)
   (<s> ^dest <dest>)
   (<s> ^g <g>)
   (<s> ^x <x>)
}
