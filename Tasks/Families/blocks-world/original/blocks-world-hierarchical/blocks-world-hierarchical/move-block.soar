
sp {blocks-world*propose*move-block
   (state <s> ^name blocks-world)
   (<s> ^object <block>)
   (<s> ^object { <dest> <> <block> })
   (<s> ^gripper <g>)
   (<dest> ^clear 1)
   (<block> ^table 0)
   (<block> ^on { <block-on> <> <dest> })
   -{ (<s> ^object <none2>) (<none2> ^on <block>) }
   -{ (<s> ^gripper <none6>) (<none6> ^empty 0) (<none6> ^holding <> <block>) }
-->
   (<s> ^operator <o> +)
   (<s> ^operator <o> =)
   (<o> ^name move-block)
   (<o> ^block <block>)
   (<o> ^dest <dest>)
   (<o> ^g <g>)
}
