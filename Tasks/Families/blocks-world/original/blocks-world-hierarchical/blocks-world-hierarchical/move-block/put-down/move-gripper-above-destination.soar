
sp {put-down*propose*move-gripper-above-destination
   (state <s> ^name put-down)
   (<s> ^superstate <ss>)
   (<s> ^task-state <ts>)
   (<s> ^block <block>)
   (<s> ^dest <dest>)
   (<s> ^g <g>)
   (<g> ^position 1)
   (<g> ^above { <g-above> <> <dest> })
-->
   (<s> ^operator <o> +)
   (<s> ^operator <o> =)
   (<o> ^name move-gripper-above-destination)
}

sp {put-down*apply*move-gripper-above-destination
   (state <s> ^name put-down)
   (<s> ^superstate <ss>)
   (<s> ^task-state <ts>)
   (<s> ^block <block>)
   (<s> ^dest <dest>)
   (<s> ^g <g>)
   (<s> ^operator <o>)
   (<o> ^name move-gripper-above-destination)
   (<g> ^above <g-above>)
-->
   (<g> ^above <dest>)
   (<g> ^above <g-above> -)
}
