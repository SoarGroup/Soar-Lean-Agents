
sp {put-down*reward*1
   (state <s> ^name put-down)
   (<s> ^superstate <ss>)
   (<s> ^task-state <ts>)
   (<s> ^block <block>)
   (<s> ^dest <dest>)
   (<s> ^g <g>)
   (<s> ^reward-link <rl>)
   (<block> ^on <dest>)
   (<g> ^empty 1)
-->
   (<rl> ^reward <w>)
   (<w> ^value 1)
}
gp {put-down*rl*up-holding
   (state <s> ^name put-down ^operator <o> +)
   (<o> ^name up-holding)
   (<s> ^block <block>)
   (<block> ^name [ table A B C ])
   (<s> ^dest <dest>)
   (<dest> ^name [ table A B C ])
   (<s> ^g <g>)
   (<g> ^name [ gripper ])
   (<g> ^position [ 0 1 ])
   (<g> ^open [ 0 1 ])
   (<g> ^empty [ 0 1 ])
   (<g> ^above <g-above>)
   (<g-above> ^name [ table A B C ])
-->
   (<s> ^operator <o> = 0)
}

