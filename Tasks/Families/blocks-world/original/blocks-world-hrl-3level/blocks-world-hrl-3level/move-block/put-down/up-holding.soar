
sp {put-down*propose*up-holding
   (state <s> ^name put-down)
   (<s> ^superstate <ss>)
   (<s> ^task-state <ts>)
   (<s> ^block <block>)
   (<s> ^dest <dest>)
   (<s> ^g <g>)
   (<g> ^position 0)
-->
   (<s> ^operator <o> +)
   (<s> ^operator <o> =)
   (<o> ^name up-holding)
}

sp {put-down*apply*up-holding
   (state <s> ^name put-down)
   (<s> ^superstate <ss>)
   (<s> ^task-state <ts>)
   (<s> ^block <block>)
   (<s> ^dest <dest>)
   (<s> ^g <g>)
   (<s> ^operator <o>)
   (<o> ^name up-holding)
   (<g> ^position <g-position>)
-->
   (<g> ^position 1)
   (<g> ^position <g-position> -)
}
