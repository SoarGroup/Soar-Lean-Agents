
sp {blocks-world*rl*move-block
   :template
   (state <s> ^name blocks-world)
   (<s> ^operator <o> +)
   (<o> ^name move-block)
   (<o> ^block <block>)
   (<o> ^dest <dest>)
   (<o> ^g <g>)
   (<block> ^name <block-name>)
   (<block> ^table <block-table>)
   (<dest> ^name <dest-name>)
   (<dest> ^table <dest-table>)
   (<g> ^name <g-name>)
   (<g> ^position <g-position>)
   (<g> ^open <g-open>)
   (<g> ^empty <g-empty>)
   (<s> ^object <w0>)
   (<w0> ^name table)
   (<s> ^object <w1>)
   (<w1> ^name A)
   (<w1> ^on <w1-on>)
   (<w1-on> ^name <w1-on-name>)
   (<s> ^object <w2>)
   (<w2> ^name B)
   (<w2> ^on <w2-on>)
   (<w2-on> ^name <w2-on-name>)
   (<s> ^object <w3>)
   (<w3> ^name C)
   (<w3> ^on <w3-on>)
   (<w3-on> ^name <w3-on-name>)
   (<s> ^gripper <w4>)
   (<w4> ^name gripper)
   (<w4> ^above <w4-above>)
   (<w4-above> ^name <w4-above-name>)
   (<w4> ^holding <w4-holding>)
   (<w4-holding> ^name <w4-holding-name>)
-->
   (<s> ^operator <o> = 0)
}

sp {blocks-world*reward*success
   (state <s> ^name blocks-world)
   (<s> ^reward-link <r>)
   (<s> ^success <_v2>)
-->
   (<r> ^reward <w>)
   (<w> ^value 1)
}
