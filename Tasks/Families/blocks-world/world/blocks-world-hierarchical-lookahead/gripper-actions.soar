sp {put-down*propose*move-gripper-down-holding
   (state <s> ^problem-space.name put-down
              ^argument1 <a1>
              ^world <w>)
   (<w> ^anchored-world true
        ^objects.object <g>)
   (<g> ^class gripper)
   (<s> ^argument2 <a2>)
   (<g> ^position up)
   (<w> ^above <ab>)
   (<ab> ^argument1 <g>
