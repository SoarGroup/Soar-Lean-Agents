              ^world <w>)
   (<o> ^name move-gripper-above-destination
        ^pre-conditions-satisfied true
        ^argument1 <g>)
   (<w> ^anchored-world true)
   (<s> ^argument2 <a2>)
   (<w> ^above <ab>)
   (<ab> ^argument1 <g>
         ^argument2 { <> <a2> })
-->
   (log 1 (crlf) |Apply move-gripper-above-destination|)
   (<w> ^above <ab> -
        ^above <nab>)
   (<nab> ^argument1 <g>
          ^argument2 <a2>
          ^argument-count 2)
