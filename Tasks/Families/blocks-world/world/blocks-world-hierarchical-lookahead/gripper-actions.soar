sp {put-down*propose*open-gripper
   (state <s> ^problem-space.name put-down
              ^argument1 <a1>
              ^world <w>)
   (<w> ^anchored-world true
        ^objects.object <g>)
   (<g> ^class gripper)
   (<s> ^argument2 <a2>)
   (<g> ^position down
        ^open false)
   (<w> ^above <ab>)
   (<ab> ^argument1 <g>
         ^argument2 <a2>)
-->
   (<s> ^operator <o> + =)
   (<o> ^name open-gripper
        ^task-operator true
        ^action-handle open-gripper
        ^argument1 <g>
        ^argument-count 1
        ^desireds <pre>)
   (<pre> ^desired-count 0)
}

sp {put-down*apply*open-gripper*gripper
   (state <s> ^operator <o>
              ^internal-actions true
              ^argument1 <a1>
              ^argument2 <a2>
              ^world <w>)
   (<o> ^name open-gripper
        ^pre-conditions-satisfied true
        ^argument1 <g>)
   (<w> ^anchored-world true
        ^holding-object <y>
        ^above <ab>)
   (<y> ^object-handle <> none)
   (<ab> ^argument1 <g>
         ^argument2 <a2>)
   (<g> ^open false)
-->
   (log 1 (crlf) |Apply open-gripper|)
   (<g> ^open false -
        ^open true)
   (<w> ^holding-object <y> -
        ^holding-object <hn>
        ^above <ab> -
        ^above <nab>)
   (<hn> ^object-handle none)
   (<nab> ^argument1 <g>
          ^argument2 <a1>
          ^argument-count 2)
}

sp {put-down*apply*open-gripper*on
   (state <s> ^operator <o>
              ^internal-actions true
              ^argument1 <a1>
              ^argument2 <a2>
              ^world <w>)
   (<o> ^name open-gripper
        ^pre-conditions-satisfied true
        ^argument1 <g>)
   (<w> ^anchored-world true
        ^holding-object <a1>
        ^above.argument2 <a2>
        ^on <r>)
   (<r> ^argument1 <a1>
        ^argument2 <> <a2>)
-->
   (<w> ^on <r> -
        ^on <nr>)
   (<nr> ^argument1 <a1>
         ^argument2 <a2>
         ^argument-count 2)
}
