## Rewards (each substate's own reward-link), as in the original.
sp {pick-up*reward*holding-block
   (state <s> ^problem-space.name pick-up
              ^reward-link <rl>
              ^argument1 <a1>
              ^world <w>)
   (<w> ^holding-object <a1>)
-->
   (<rl> ^reward <rw>)
   (<rw> ^value 1)
}

sp {pick-up*reward*closed-empty
   (state <s> ^problem-space.name pick-up
              ^reward-link <rl>
              ^world <w>)
   (<w> ^objects.object <g>
        ^holding-object.object-handle $ none)
   (<g> ^class gripper
        ^open false)
-->
   (<rl> ^reward <rw>)
   (<rw> ^value -1)
}

sp {put-down*reward*placed
   (state <s> ^problem-space.name put-down
              ^reward-link <rl>
              ^argument1 <a1>
              ^argument2 <a2>
              ^world <w>)
   (<w> ^on <r>
        ^holding-object.object-handle $ none)
   (<r> ^argument1 <a1>
        ^argument2 <a2>)
-->
   (<rl> ^reward <rw>)
   (<rw> ^value 1)
}
