## RL in the pick-up and put-down spaces: gp expands one Q-value rule per (block, destination,
## gripper position, open, empty or holding, object the gripper is above), as in the original.
gp {pick-up*rl*up*empty
   (state <s> ^problem-space.name pick-up
              ^operator <o> +
              ^world <w>
              ^argument1.object-handle [ table A B C ]
              ^superstate.argument2.object-handle [ table A B C ])
   (<o> ^name up)
   (<w> ^objects.object <g>
        ^holding-object.object-handle $ none
        ^above <ab>)
   (<g> ^class gripper
        ^position [ up down ]
        ^open [ true false ])
   (<ab> ^argument1 <g>
         ^argument2.object-handle [ table A B C ])
-->
   (<s> ^operator <o> = 0)
}

gp {pick-up*rl*up*holding
   (state <s> ^problem-space.name pick-up
              ^operator <o> +
              ^world <w>
              ^argument1.object-handle [ table A B C ]
              ^superstate.argument2.object-handle [ table A B C ])
   (<o> ^name up)
   (<w> ^objects.object <g>
        ^holding-object.object-handle <> none
        ^above <ab>)
   (<g> ^class gripper
        ^position [ up down ]
        ^open [ true false ])
   (<ab> ^argument1 <g>
         ^argument2.object-handle [ table A B C ])
-->
   (<s> ^operator <o> = 0)
}

