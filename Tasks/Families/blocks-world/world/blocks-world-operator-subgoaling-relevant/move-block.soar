## move-block is a task-action operator whose preconditions are desireds: both the block and the
## destination must be clear. It is proposed whenever the block is not already on the
## destination (relevant moves only); if it is selected before its preconditions hold, it has no application and
## the operator no-change becomes an MEA subgoal whose ^desireds are those preconditions
## (W-MEA-001/002). agent-world shares the world into that subgoal, so moves made there change
## the real situation.

## Relevant moves only: (1) a move that achieves one of this state's ^on desireds ...
sp {blocks-world*propose*move-block*achieves-desired
   (state <s> ^problem-space.name blocks-world
              ^world <w>
              ^top-state.desireds.desired <sd>)
   (<w> ^anchored-world true
        ^objects <os>
        ^on <r>)
   (<os> ^object <block> { <dest> <> <block> })
   (<block> ^class block
            ^object-handle $ <bh>)
   (<dest> ^object-handle $ <dh>)
   (<r> ^argument1 <block>
        ^argument2 <> <dest>)
   (<sd> ^on.argument1.object-handle $ <bh>)
   (<s> ^desireds.desired.on <dr>)
   (<dr> ^argument1.object-handle $ <bh>
         ^argument2.object-handle $ <dh>)
-->
   (<s> ^operator <o> + =)
   (<o> ^name move-block
        ^task-operator true
        ^action-handle move-block
        ^argument1 <block>
        ^argument2 <dest>
        ^argument-count 2
        ^super-desired <sd>
        ^desireds <pre>)
   (<pre> ^desired-count 2
          ^desired <c1> <c2>)
   (<c1> ^object <co1>)
   (<co1> ^object-handle <bh>
          ^clear true)
   (<c2> ^object <co2>)
   (<co2> ^object-handle <dh>
          ^clear true)
}

## ... or (2) a move of a block that sits on an object this state wants clear, onto a clear object.
sp {blocks-world*propose*move-block*clears-desired
   (state <s> ^problem-space.name blocks-world
              ^world <w>
              ^top-state.desireds.desired <sd>)
   (<w> ^anchored-world true
        ^objects <os>
        ^on <r>)
   (<os> ^object <block> { <dest> <> <block> })
   (<block> ^class block
            ^object-handle $ <bh>)
   (<dest> ^object-handle $ <dh>)
   (<r> ^argument1 <block>
        ^argument2 <> <dest>)
   (<sd> ^on.argument1.object-handle $ <bh>)
   (<s> ^desireds.desired.object <do>)
   (<do> ^clear true
         ^object-handle $ <uh>)
   (<r> ^argument2.object-handle $ <uh>)
   (<dest> ^clear true)
-->
   (<s> ^operator <o> + =)
   (<o> ^name move-block
        ^task-operator true
        ^action-handle move-block
        ^argument1 <block>
        ^argument2 <dest>
        ^argument-count 2
        ^super-desired <sd>
        ^desireds <pre>)
   (<pre> ^desired-count 2
          ^desired <c1> <c2>)
   (<c1> ^object <co1>)
   (<co1> ^object-handle <bh>
          ^clear true)
   (<c2> ^object <co2>)
   (<co2> ^object-handle <dh>
          ^clear true)
}

## Internal application, in the decision the operator is selected once its preconditions hold.
sp {blocks-world*apply*move-block
   (state <s> ^operator <o>
              ^internal-actions true
              ^world <w>)
   (<o> ^name move-block
        ^pre-conditions-satisfied true
        ^argument1.object-handle $ <bh>
        ^argument2.object-handle $ <dh>)
   (<w> ^anchored-world true
        ^objects <os>
        ^on <r>)
   (<os> ^object <b> <d>)
   (<b> ^object-handle $ <bh>)
   (<d> ^object-handle $ <dh>)
   (<r> ^argument1 <b>
        ^argument2 <> <d>)
-->
   (log 1 (crlf) |Apply move-block: | <bh> | -> | <dh>)
   (<w> ^on <r> -
        ^on <nr>)
   (<nr> ^argument1 <b>
         ^argument2 <d>
         ^argument-count 2)
}
