## Counting (families, from English): generated by spec_backend.py (WorldSpec, path B: Lean description, Python rules) from the instructor statements.
##
## Instructor statements used (numbers as in english-input.txt):
##  1. Count upwards from a starting number to a target number, one at a time.
##  2. This instance counts from 0 to 100.
##
## Assumption ledger:
##   A-CT1: A counter object holds the current number (count, starting at 0) and the target (100).
##   A-CT2: "one at a time": each count-up action adds 1 to the count; it is proposed only while the count is below the target, and the goal is a count equal to the target.
## Matching hints for learned rules (World-Conventions L3-095, L11-009): many-valued attributes, sized from the initial world.
production optimize-attribute object 2


## Propose initialize-counting when its conditions below hold.
sp {counting*propose*initialize-counting
   (state <s> ^superstate nil ^world <w> -^name)
-->
   (<s> ^operator <o> + >)
   (<o> ^name initialize-counting ^task-operator false)
}

sp {counting*apply*initialize-counting
   (state <s> ^operator.name initialize-counting ^world <w>)
   (<w> ^objects <objs>)
-->
   (<s> ^name counting ^desireds <ds>)
   (<objs> ^object <k-counter> <k-task>)
   (<k-counter> ^object-handle counter ^anchored true ^type counter ^name counter ^count 0 ^target 100)
   (<k-task> ^object-handle task ^anchored true ^type task)
   (<ds> ^desired-count 1 ^desired <d1>)
   (<d1> ^object <d1-o>)
   (<d1-o> ^object-handle task ^goal-met true)

   (log 1 (crlf) |Initialize counting.|)
}

## Elaborate problem space: adds ^dont-copy-object-attribute, ^problem-space.
sp {counting*elaborate*problem-space
   (state <s> ^name counting)
-->
   (<s> ^problem-space <p>)
   (<p> ^name counting ^dont-copy-object-attribute goal-met)
}

sp {counting*elaborate*problem-space*mea-substate
   (state <s> ^impasse no-change ^attribute operator ^superstate <ss>)
   (<ss> ^problem-space.name counting ^operator <so>)
   (<so> ^task-operator true -^pre-conditions-satisfied true)
-->
   (<s> ^problem-space <p>)
   (<p> ^name counting ^dont-copy-object-attribute goal-met)
}

## Elaborate flags: adds ^flag-override, ^mea-operator-selection.
sp {counting*elaborate*flags
   (state <s> ^superstate nil ^name counting)
-->
   (<s> ^flag-override <f>)
   (<f> ^mea-operator-selection true)
}

## Achievement of object-property desireds (supplied by the task).
sp {counting*elaborate*state*achieved*object-property
   (state <s> ^problem-space.name counting ^desireds <ds> ^world <w>)
   (<ds> ^desired <d>)
   (<d> ^object <do>)
   (<do> ^object-handle <h> ^{ <> object-handle <a> } <v>)
   (<w> ^anchored-world true ^objects.object <ob>)
   (<ob> ^object-handle <h> ^<a> <v>)
-->
   (<ds> ^achieved <d>)
}

sp {counting*elaborate*state*unachieved*object-property
   (state <s> ^problem-space.name counting ^desireds <ds> ^world <w>)
   (<ds> ^desired <d>)
   (<d> ^object <do>)
   (<do> ^object-handle <h> ^{ <> object-handle <a> } <v>)
   (<w> ^anchored-world true)
  -{(<w> ^objects.object <ob>)
    (<ob> ^object-handle <h> ^<a> <v>)}
-->
   (<ds> ^unachieved <d>)
}

## Operator count-up (statement 1).
sp {counting*propose*count-up
   (state <s> ^problem-space.name counting ^flags.mea-operator-selection true ^world <w> ^desireds <ds>)
   (<w> ^anchored-world true ^objects <objs>)
   (<objs> ^object <c>)
   (<c> ^type counter)
   (<c> ^target <c-target>)
   (<c> ^count < <c-target>)
   (<ds> ^unachieved-desireds true)
-->
   (<s> ^operator <op> +)
   (<op> ^name count-up ^task-operator true ^action-handle count-up  ^argument-count 0 ^pre-conditions-satisfied true)
}

## Effect of count-up (look-ahead).
sp {counting*apply*count-up*internal
   (state <s> ^problem-space.name counting ^operator <op> ^internal-actions true ^world <w>)
   (<op> ^task-operator true ^name count-up ^pre-conditions-satisfied true )
   (<w> ^anchored-world true ^objects <objs>)
   (<objs> ^object <c>)
   (<c> ^type counter)
   (<c> ^count <c-count>)
-->
   (<c> ^count <c-count> - (+ <c-count> 1))
}

## Effect of a completed count-up command on the real world (once per command).
sp {counting*apply*count-up*environment-effect
   :o-support
   (state <s> ^problem-space.name counting ^superstate nil ^world <w> ^io.output-link.perform-action <pa>)
   (<pa> ^name count-up ^status complete  -^effect-applied true)
   (<w> ^anchored-world true ^objects <objs>)
   (<objs> ^object <c>)
   (<c> ^type counter)
   (<c> ^count <c-count>)
-->
   (<c> ^count <c-count> - (+ <c-count> 1))
   (<pa> ^effect-applied true)
   (write |Count one more| (crlf))
}

## Goal (statement 1): ^goal-met true on the task object.
sp {counting*elaborate*goal
   (state <s> ^problem-space.name counting ^world <w>)
   (<w> ^anchored-world true ^objects <objs>)
   (<objs> ^object <task>)
   (<task> ^type task)
   (<objs> ^object <c>)
   (<c> ^type counter)
   (<c> ^target <c-target>)
   (<c> ^count <c-target>)
-->
   (<task> ^goal-met true)
}
