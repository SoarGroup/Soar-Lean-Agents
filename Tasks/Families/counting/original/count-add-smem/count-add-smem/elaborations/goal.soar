
sp {count-add-smem*elaborate*goal*success
   (state <s> ^name count-add-smem)
   (<s> ^desired <d>)
   (<s> ^adder <x>)
   (<d> ^adder <dx>)
   (<dx> ^done <g-done>)
   (<x> ^done <g-done>)
-->
   (<s> ^success <d>)
}

sp {count-add-smem*halt*goal*success
   (state <s> ^superstate nil)
   (<s> ^desired <d>)
   (<s> ^success <d>)
-->
   (write (crlf) |The problem has been solved.|)
   (halt)
}
