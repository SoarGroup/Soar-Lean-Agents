## Task initialization: proposed after agent-world's initialize-agent-world (tests ^world).
sp {count-add-smem*propose*initialize-count-add-smem
   (state <s> ^superstate nil
              ^world <w>
             -^name)
-->
   (<s> ^operator <o> +)
   (<o> ^name initialize-count-add-smem
        ^task-operator false)
}

## initialize-agent-world (best, proposed while the top state has no ^name) stays acceptable
## after it applies; prefer the task's initialization to it so that it is not reselected.
sp {count-add-smem*compare*initialize-count-add-smem*initialize-agent-world
   (state <s> ^superstate nil
              ^operator <o1> +
              ^operator <o2> +)
   (<o1> ^name initialize-count-add-smem)
   (<o2> ^name initialize-agent-world)
-->
   (<s> ^operator <o1> > <o2>)
}

## World: one adder object (digit1 9, digit2 9, carry 0, done 0). Goal: adder done.
sp {count-add-smem*apply*initialize-count-add-smem
   (state <s> ^operator.name initialize-count-add-smem
              ^world.objects <objs>)
-->
   (<s> ^name count-add-smem
        ^environment none
        ^problem-space <ps>
        ^flag-override <f>
        ^desireds <ds>)
   (<ps> ^name count-add-smem
         ^agent-world true)
   (<f> ^mea-operator-selection true)
   (<objs> ^object <a>)
   (<a> ^object-handle adder
        ^anchored true
        ^digit1 9
        ^digit2 9
        ^carry 0
        ^done 0)
   (<ds> ^desired <d>
         ^desired-count 1)
   (<d> ^object <do>)
   (<do> ^object-handle adder
         ^done 1)
}
