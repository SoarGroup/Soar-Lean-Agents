   (state <s> ^problem-space.name eight-puzzle ^world <w>)
   (<w> ^anchored-world true ^objects <objs>)
   (<objs> ^task <task>)
   (<objs> ^tile <k-one>)
   (<k-one> ^object-handle one)
   (<objs> ^square <k-top-left>)
   (<k-top-left> ^object-handle top-left)
   (<w> ^at <r1>)
   (<r1> ^argument1 <k-one> ^argument2 <k-top-left>)
   (<objs> ^tile <k-eight>)
   (<k-eight> ^object-handle eight)
   (<objs> ^square <k-top-middle>)
   (<k-top-middle> ^object-handle top-middle)
   (<w> ^at <r2>)
   (<r2> ^argument1 <k-eight> ^argument2 <k-top-middle>)
   (<objs> ^tile <k-seven>)
   (<k-seven> ^object-handle seven)
   (<objs> ^square <k-top-right>)
   (<k-top-right> ^object-handle top-right)
   (<w> ^at <r3>)
   (<r3> ^argument1 <k-seven> ^argument2 <k-top-right>)
   (<objs> ^tile <k-two>)
   (<k-two> ^object-handle two)
   (<objs> ^square <k-middle-left>)
   (<k-middle-left> ^object-handle middle-left)
   (<w> ^at <r4>)
   (<r4> ^argument1 <k-two> ^argument2 <k-middle-left>)
   (<objs> ^blank <k-blank>)
   (<k-blank> ^object-handle blank)
   (<objs> ^square <k-center>)
   (<k-center> ^object-handle center)
   (<w> ^at <r5>)
   (<r5> ^argument1 <k-blank> ^argument2 <k-center>)
   (<objs> ^tile <k-six>)
   (<k-six> ^object-handle six)
   (<objs> ^square <k-middle-right>)
   (<k-middle-right> ^object-handle middle-right)
   (<w> ^at <r6>)
   (<r6> ^argument1 <k-six> ^argument2 <k-middle-right>)
   (<objs> ^tile <k-three>)
   (<k-three> ^object-handle three)
   (<objs> ^square <k-bottom-left>)
   (<k-bottom-left> ^object-handle bottom-left)
   (<w> ^at <r7>)
   (<r7> ^argument1 <k-three> ^argument2 <k-bottom-left>)
   (<objs> ^tile <k-four>)
   (<k-four> ^object-handle four)
   (<objs> ^square <k-bottom-middle>)
   (<k-bottom-middle> ^object-handle bottom-middle)
   (<w> ^at <r8>)
   (<r8> ^argument1 <k-four> ^argument2 <k-bottom-middle>)
   (<objs> ^tile <k-five>)
   (<k-five> ^object-handle five)
   (<objs> ^square <k-bottom-right>)
   (<k-bottom-right> ^object-handle bottom-right)
   (<w> ^at <r9>)
   (<r9> ^argument1 <k-five> ^argument2 <k-bottom-right>)
-->
   (<task> ^goal-met true)
}

## ---- Search control (stated in the description, not taught): a look-ahead state that returns to a situation on
## its look-ahead path fails, and the library rejects it. Situation: where each tile / blank is (at).
sp {eight-puzzle*elaborate*ancestor-world*parent
   (state <s> ^name evaluate-operator ^superstate.superstate.world <aw>)
-->
   (<s> ^ancestor-world <aw>)
}

sp {eight-puzzle*elaborate*ancestor-world*inherited
   (state <s> ^name evaluate-operator ^superstate.superstate.ancestor-world <aw>)
-->
   (<s> ^ancestor-world <aw>)
}

## Elaborate failure repeated situation: adds ^failure.
sp {eight-puzzle*elaborate*failure*repeated-situation
   (state <s> ^name evaluate-operator ^look-ahead-operator <o> ^ancestor-world <aw> ^desireds <ds> ^world <w>)
   (<w> ^anchored-world true ^versioned-operator <o>)
  -{(<w> ^at <r>)
    (<r> ^argument1 <x> ^argument2 <p>)
    (<x> ^type << tile blank >> ^object-handle <h>)
    (<p> ^object-handle <ph>)
    (<aw> ^at <ar>)
    (<ar> ^argument1 <ax> ^argument2 <ap>)
    (<ax> ^object-handle <h>)
    (<ap> ^object-handle <> <ph>)}
-->
   (<s> ^failure <ds>)
}
