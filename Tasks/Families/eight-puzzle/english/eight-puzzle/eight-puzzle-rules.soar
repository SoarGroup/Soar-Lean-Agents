## Eight puzzle (families, from English): generated by spec_backend.py (WorldSpec, path B: Lean description, Python rules) from the instructor statements.
##
## Instructor statements used (numbers as in english-input.txt):
##  1. A 3 x 3 tray holds eight numbered tiles and one empty square.
##  2. A tile next to the empty square (left, right, above or below, not diagonally) may slide into it, leaving its own square empty.
##  3. Tiles may not be lifted out.
##  4. The goal is to slide tiles until they match the target arrangement.
##
## Assumption ledger:
##   A-EP1: Nine square objects with names by position (top-left ... bottom-right) and a static next-to relation between squares that share a side, both ways ("not diagonally").
##   A-EP2: The empty square is marked by a blank object that is at a square like a tile, so a slide swaps the squares of a tile and the blank. Tiles are named one ... eight.
##   A-EP3: "may not be lifted out": slide is the only operator.
##   A-EP4: The start and target arrangements are not in the English; they were read from the original agent's initialize rules (JL allowed this). The goal names the square of every tile and of the blank.
##   A-EP5: Search control, not from the English (as for the other WorldSpec search tasks): a look-ahead state that returns to a situation already on its path fails; a situation is where each tile and the blank are.
## Matching hints for learned rules (World-Conventions L3-095, L11-009): many-valued attributes, sized from the initial world.
production optimize-attribute square 19
production optimize-attribute tile 19
production optimize-attribute blank 19
production optimize-attribute task 19
production optimize-attribute object 19
production optimize-attribute at 9
production optimize-attribute next-to 24


## Propose initialize-eight-puzzle when its conditions below hold.
sp {eight-puzzle*propose*initialize-eight-puzzle
   (state <s> ^superstate nil ^world <w> -^name)
-->
   (<s> ^operator <o> + >)
   (<o> ^name initialize-eight-puzzle ^task-operator false)
}

sp {eight-puzzle*apply*initialize-eight-puzzle
   (state <s> ^operator.name initialize-eight-puzzle ^world <w>)
   (<w> ^objects <objs>)
-->
   (<s> ^name eight-puzzle ^desireds <ds>)
   (<objs> ^square <k-top-left> <k-top-middle> <k-top-right> <k-middle-left> <k-center> <k-middle-right> <k-bottom-left> <k-bottom-middle> <k-bottom-right> ^tile <k-one> <k-two> <k-three> <k-four> <k-five> <k-six> <k-seven> <k-eight> ^blank <k-blank> ^task <k-task>)
   (<k-top-left> ^object-handle top-left ^anchored true ^type square ^name top-left ^static true)
   (<k-top-middle> ^object-handle top-middle ^anchored true ^type square ^name top-middle ^static true)
   (<k-top-right> ^object-handle top-right ^anchored true ^type square ^name top-right ^static true)
   (<k-middle-left> ^object-handle middle-left ^anchored true ^type square ^name middle-left ^static true)
   (<k-center> ^object-handle center ^anchored true ^type square ^name center ^static true)
   (<k-middle-right> ^object-handle middle-right ^anchored true ^type square ^name middle-right ^static true)
   (<k-bottom-left> ^object-handle bottom-left ^anchored true ^type square ^name bottom-left ^static true)
   (<k-bottom-middle> ^object-handle bottom-middle ^anchored true ^type square ^name bottom-middle ^static true)
   (<k-bottom-right> ^object-handle bottom-right ^anchored true ^type square ^name bottom-right ^static true)
   (<k-one> ^object-handle one ^anchored true ^type tile ^name one ^static true)
   (<k-two> ^object-handle two ^anchored true ^type tile ^name two ^static true)
   (<k-three> ^object-handle three ^anchored true ^type tile ^name three ^static true)
   (<k-four> ^object-handle four ^anchored true ^type tile ^name four ^static true)
   (<k-five> ^object-handle five ^anchored true ^type tile ^name five ^static true)
   (<k-six> ^object-handle six ^anchored true ^type tile ^name six ^static true)
   (<k-seven> ^object-handle seven ^anchored true ^type tile ^name seven ^static true)
   (<k-eight> ^object-handle eight ^anchored true ^type tile ^name eight ^static true)
   (<k-blank> ^object-handle blank ^anchored true ^type blank ^name blank ^static true)
   (<k-task> ^object-handle task ^anchored true ^type task)
   (<ds> ^desired-count 1 ^desired <d1>)
   (<d1> ^object <d1-o>)
   (<d1-o> ^object-handle task ^goal-met true)
   (<w> ^at <rel-1>)
   (<rel-1> ^argument1 <k-two> ^argument2 <k-top-left>)
   (<w> ^at <rel-2>)
   (<rel-2> ^argument1 <k-one> ^argument2 <k-top-middle>)
   (<w> ^at <rel-3>)
   (<rel-3> ^argument1 <k-seven> ^argument2 <k-top-right>)
   (<w> ^at <rel-4>)
   (<rel-4> ^argument1 <k-eight> ^argument2 <k-middle-left>)
   (<w> ^at <rel-5>)
   (<rel-5> ^argument1 <k-six> ^argument2 <k-center>)
   (<w> ^at <rel-6>)
   (<rel-6> ^argument1 <k-blank> ^argument2 <k-middle-right>)
   (<w> ^at <rel-7>)
   (<rel-7> ^argument1 <k-three> ^argument2 <k-bottom-left>)
   (<w> ^at <rel-8>)
   (<rel-8> ^argument1 <k-four> ^argument2 <k-bottom-middle>)
   (<w> ^at <rel-9>)
   (<rel-9> ^argument1 <k-five> ^argument2 <k-bottom-right>)
   (<w> ^next-to <rel-10>)
   (<rel-10> ^argument1 <k-top-left> ^argument2 <k-top-middle>)
   (<w> ^next-to <rel-11>)
   (<rel-11> ^argument1 <k-top-left> ^argument2 <k-middle-left>)
   (<w> ^next-to <rel-12>)
   (<rel-12> ^argument1 <k-top-middle> ^argument2 <k-top-right>)
   (<w> ^next-to <rel-13>)
   (<rel-13> ^argument1 <k-top-middle> ^argument2 <k-center>)
   (<w> ^next-to <rel-14>)
   (<rel-14> ^argument1 <k-top-middle> ^argument2 <k-top-left>)
   (<w> ^next-to <rel-15>)
   (<rel-15> ^argument1 <k-top-right> ^argument2 <k-middle-right>)
   (<w> ^next-to <rel-16>)
   (<rel-16> ^argument1 <k-top-right> ^argument2 <k-top-middle>)
   (<w> ^next-to <rel-17>)
   (<rel-17> ^argument1 <k-middle-left> ^argument2 <k-center>)
   (<w> ^next-to <rel-18>)
   (<rel-18> ^argument1 <k-middle-left> ^argument2 <k-bottom-left>)
   (<w> ^next-to <rel-19>)
   (<rel-19> ^argument1 <k-middle-left> ^argument2 <k-top-left>)
   (<w> ^next-to <rel-20>)
   (<rel-20> ^argument1 <k-center> ^argument2 <k-middle-right>)
   (<w> ^next-to <rel-21>)
   (<rel-21> ^argument1 <k-center> ^argument2 <k-bottom-middle>)
   (<w> ^next-to <rel-22>)
   (<rel-22> ^argument1 <k-center> ^argument2 <k-middle-left>)
   (<w> ^next-to <rel-23>)
   (<rel-23> ^argument1 <k-center> ^argument2 <k-top-middle>)
   (<w> ^next-to <rel-24>)
   (<rel-24> ^argument1 <k-middle-right> ^argument2 <k-bottom-right>)
   (<w> ^next-to <rel-25>)
   (<rel-25> ^argument1 <k-middle-right> ^argument2 <k-center>)
   (<w> ^next-to <rel-26>)
   (<rel-26> ^argument1 <k-middle-right> ^argument2 <k-top-right>)
   (<w> ^next-to <rel-27>)
   (<rel-27> ^argument1 <k-bottom-left> ^argument2 <k-bottom-middle>)
   (<w> ^next-to <rel-28>)
   (<rel-28> ^argument1 <k-bottom-left> ^argument2 <k-middle-left>)
   (<w> ^next-to <rel-29>)
   (<rel-29> ^argument1 <k-bottom-middle> ^argument2 <k-bottom-right>)
   (<w> ^next-to <rel-30>)
   (<rel-30> ^argument1 <k-bottom-middle> ^argument2 <k-bottom-left>)
   (<w> ^next-to <rel-31>)
   (<rel-31> ^argument1 <k-bottom-middle> ^argument2 <k-center>)
   (<w> ^next-to <rel-32>)
   (<rel-32> ^argument1 <k-bottom-right> ^argument2 <k-bottom-middle>)
   (<w> ^next-to <rel-33>)
   (<rel-33> ^argument1 <k-bottom-right> ^argument2 <k-middle-right>)
   (log 1 (crlf) |Initialize eight-puzzle.|)
}

## Elaborate problem space: adds ^copy-relation, ^dont-copy-object-attribute, ^problem-space, ^share-relation.
sp {eight-puzzle*elaborate*problem-space
   (state <s> ^name eight-puzzle)
-->
   (<s> ^problem-space <p>)
   (<p> ^name eight-puzzle ^copy-relation at ^share-relation next-to ^dont-copy-object-attribute goal-met)
}

sp {eight-puzzle*elaborate*problem-space*mea-substate
   (state <s> ^impasse no-change ^attribute operator ^superstate <ss>)
   (<ss> ^problem-space.name eight-puzzle ^operator <so>)
   (<so> ^task-operator true -^pre-conditions-satisfied true)
-->
   (<s> ^problem-space <p>)
   (<p> ^name eight-puzzle ^dont-copy-object-attribute goal-met)
}

## Elaborate flags: adds ^flag-override, ^mea-operator-selection.
sp {eight-puzzle*elaborate*flags
   (state <s> ^superstate nil ^name eight-puzzle)
-->
   (<s> ^flag-override <f>)
   (<f> ^mea-operator-selection true)
}

## Achievement of object-property desireds (supplied by the task).
sp {eight-puzzle*elaborate*state*achieved*object-property
   (state <s> ^problem-space.name eight-puzzle ^desireds <ds> ^world <w>)
   (<ds> ^desired <d>)
   (<d> ^object <do>)
   (<do> ^object-handle <h> ^{ <> object-handle <a> } <v>)
   (<w> ^anchored-world true ^objects.object <ob>)
   (<ob> ^object-handle <h> ^<a> <v>)
-->
   (<ds> ^achieved <d>)
}

sp {eight-puzzle*elaborate*state*unachieved*object-property
   (state <s> ^problem-space.name eight-puzzle ^desireds <ds> ^world <w>)
   (<ds> ^desired <d>)
   (<d> ^object <do>)
   (<do> ^object-handle <h> ^{ <> object-handle <a> } <v>)
   (<w> ^anchored-world true)
  -{(<w> ^objects.object <ob>)
    (<ob> ^object-handle <h> ^<a> <v>)}
-->
   (<ds> ^unachieved <d>)
}

## Operator slide (statements 2, 3).
sp {eight-puzzle*propose*slide
   (state <s> ^problem-space.name eight-puzzle ^flags.mea-operator-selection true ^world <w> ^desireds <ds>)
   (<w> ^anchored-world true ^objects <objs>)
   (<objs> ^tile <t>)
   (<objs> ^square <to>)
   (<objs> ^blank <bl>)
   (<w> ^at <r1>)
   (<r1> ^argument1 <bl> ^argument2 <to>)
   (<w> ^at <r2>)
   (<r2> ^argument1 <t> ^argument2 <from>)
   (<w> ^next-to <r3>)
   (<r3> ^argument1 <from> ^argument2 <to>)
   (<ds> ^unachieved-desireds true)
-->
   (<s> ^operator <op> +)
   (<op> ^name slide ^task-operator true ^action-handle slide ^argument1 <t> ^argument2 <to> ^argument-count 2 ^pre-conditions-satisfied true)
}

## Effect of slide (look-ahead).
sp {eight-puzzle*apply*slide*internal
   (state <s> ^problem-space.name eight-puzzle ^operator <op> ^internal-actions true ^world <w>)
   (<op> ^task-operator true ^name slide ^pre-conditions-satisfied true ^argument1.object-handle $ <t-h> ^argument2.object-handle $ <to-h>)
   (<w> ^anchored-world true ^objects <objs>)
   (<objs> ^tile <t>)
   (<t> ^object-handle $ <t-h>)
   (<objs> ^square <to>)
   (<to> ^object-handle $ <to-h>)
   (<objs> ^blank <bl>)
   (<w> ^at <r1>)
   (<r1> ^argument1 <t> ^argument2 <old>)
   (<w> ^at <r2>)
   (<r2> ^argument1 <bl> ^argument2 <bold>)
-->
   (<r1> ^argument2 <old> - <to>)
   (<r2> ^argument2 <bold> - <old>)
}

## Effect of a completed slide command on the real world (once per command).
sp {eight-puzzle*apply*slide*environment-effect
   :o-support
   (state <s> ^problem-space.name eight-puzzle ^superstate nil ^world <w> ^io.output-link.perform-action <pa>)
   (<pa> ^name slide ^status complete ^argument1 <t-h> ^argument2 <to-h> -^effect-applied true)
   (<w> ^anchored-world true ^objects <objs>)
   (<objs> ^tile <t>)
   (<t> ^object-handle $ <t-h>)
   (<objs> ^square <to>)
   (<to> ^object-handle $ <to-h>)
   (<objs> ^blank <bl>)
   (<w> ^at <r1>)
   (<r1> ^argument1 <t> ^argument2 <old>)
   (<w> ^at <r2>)
   (<r2> ^argument1 <bl> ^argument2 <bold>)
-->
   (<r1> ^argument2 <old> - <to>)
   (<r2> ^argument2 <bold> - <old>)
   (<pa> ^effect-applied true)
   (write |Slide tile | <t-h> | into | <to-h> (crlf))
}

## Goal (statement 4): ^goal-met true on the task object.
