{
  "format": "worldspec-1",
  "name": "eight-puzzle",
  "title": "Eight puzzle (families, from English)",
  "statements": [
    [
      1,
      "A 3 x 3 tray holds eight numbered tiles and one empty square."
    ],
    [
      2,
      "A tile next to the empty square (left, right, above or below, not diagonally) may slide into it, leaving its own square empty."
    ],
    [
      3,
      "Tiles may not be lifted out."
    ],
    [
      4,
      "The goal is to slide tiles until they match the target arrangement."
    ]
  ],
  "assumptions": [
    {
      "id": "A-EP1",
      "kind": "intent",
      "text": "Nine square objects with names by position (top-left ... bottom-right) and a static next-to relation between squares that share a side, both ways (\"not diagonally\").",
      "stmts": [
        1
      ]
    },
    {
      "id": "A-EP2",
      "kind": "intent",
      "text": "The empty square is marked by a blank object that is at a square like a tile, so a slide swaps the squares of a tile and the blank. Tiles are named one ... eight.",
      "stmts": [
        1,
        2
      ]
    },
    {
      "id": "A-EP3",
      "kind": "intent",
      "text": "\"may not be lifted out\": slide is the only operator.",
      "stmts": [
        3
      ]
    },
    {
      "id": "A-EP4",
      "kind": "intent",
      "text": "The start and target arrangements are not in the English; they were read from the original agent's initialize rules (JL allowed this). The goal names the square of every tile and of the blank.",
      "stmts": [
        4
      ]
    },
    {
      "id": "A-EP5",
      "kind": "intent",
      "text": "Search control, not from the English (as for the other WorldSpec search tasks): a look-ahead state that returns to a situation already on its path fails; a situation is where each tile and the blank are.",
      "stmts": []
    }
  ],
