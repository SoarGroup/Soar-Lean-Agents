
sp {fifteen-puzzle*evaluate*state*moved-into-place
   (state <s> ^name fifteen-puzzle)
   (<s> ^tried-tied-operator <o>)
   (<o> ^name move-tile)
   (<o> ^bb <x>)
   (<o> ^bt <p>)
   (<o> ^t <m>)
   (<s> ^desired <d>)
   (<x> ^name <xn>)
   (<d> ^binding <dx>)
   (<dx> ^name <xn>)
   (<dx> ^tile <dxt>)
   (<dxt> ^name <dxn>)
   (<x> ^tile <xt>)
   (<xt> ^name <xtn>)
   (<p> ^name <pn>)
   (<d> ^binding <dp>)
   (<dp> ^name <pn>)
   (<dp> ^tile <dpt>)
   (<dpt> ^name <dpn>)
   (<m> ^name <mn>)
   (<xt> ^name <dxn>)
-->
   (<s> ^numeric-value 1)
}

