         ^anchored true
         ^id 22
         ^neighbor c12
         ^neighbor c32
         ^neighbor c21
         ^neighbor c23
         ^tile t15)
   (<objs> ^object <x6>)
   (<x6> ^object-handle c23
         ^anchored true
         ^id 23
         ^neighbor c13
         ^neighbor c33
         ^neighbor c22
         ^neighbor c24
         ^tile t3)
   (<objs> ^object <x7>)
   (<x7> ^object-handle c24
         ^anchored true
         ^id 24
         ^neighbor c14
         ^neighbor c34
         ^neighbor c23
         ^tile t4)
   (<objs> ^object <x8>)
