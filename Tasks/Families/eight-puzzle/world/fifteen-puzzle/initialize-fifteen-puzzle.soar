   (<x11> ^object-handle c34
         ^anchored true
         ^id 34
         ^neighbor c24
         ^neighbor c44
         ^neighbor c33
         ^tile t11)
   (<objs> ^object <x12>)
   (<x12> ^object-handle c41
         ^anchored true
         ^id 41
         ^neighbor c31
         ^neighbor c42
         ^tile t12)
   (<objs> ^object <x13>)
   (<x13> ^object-handle c42
         ^anchored true
         ^id 42
         ^neighbor c32
