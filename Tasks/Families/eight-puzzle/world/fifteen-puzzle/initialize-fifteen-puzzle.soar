## Task initialization: proposed after agent-world's initialize-agent-world (tests ^world).
sp {fifteen-puzzle*propose*initialize-fifteen-puzzle
   (state <s> ^superstate nil
              ^world <w>
             -^name)
-->
   (<s> ^operator <o> +)
   (<o> ^name initialize-fifteen-puzzle
        ^task-operator false)
}

## initialize-agent-world (best, proposed while the top state has no ^name) stays acceptable
## after it applies; prefer the task's initialization to it so that it is not reselected.
sp {fifteen-puzzle*compare*initialize-fifteen-puzzle*initialize-agent-world
   (state <s> ^superstate nil
              ^operator <o1> +
              ^operator <o2> +)
   (<o1> ^name initialize-fifteen-puzzle)
   (<o2> ^name initialize-agent-world)
-->
   (<s> ^operator <o1> > <o2>)
}

## World: one object per cell (handle c11 ..., with ^id, the handles of its neighbour
## cells and the handle of the tile it holds, ^tile), one object per tile (handle t0 ...,
## ^number; t0 is the blank) and the board (handle board).
## Goal: a single desired on the board, ^arrangement: the tile wanted in each cell
## (^binding ^cell <cell-handle> ^tile <tile-handle>). The original goal is one conjunction of
## 16 cell bindings; agent-world desireds hold at most 6 desired, so the conjunction is
## kept inside one desired whose achievement is computed by the task (elaborations.soar).
## Numeric evaluations: higher is better (^better higher on the desireds).
sp {fifteen-puzzle*apply*initialize-fifteen-puzzle
   (state <s> ^operator.name initialize-fifteen-puzzle
              ^world.objects <objs>)
-->
   (<s> ^name fifteen-puzzle
        ^environment none
        ^flag-override <f>
        ^desireds <ds>)
   (<f> ^mea-operator-selection true
        ^look-ahead-planning true)
   (<objs> ^object <board>)
   (<board> ^object-handle board
            ^anchored true)
   (<ds> ^desired <d>
         ^desired-count 1
         ^better higher)
   (<d> ^object <do>)
   (<do> ^object-handle board
         ^arrangement <arr>)
   (<objs> ^object <x0>)
   (<x0> ^object-handle c11
         ^anchored true
         ^id 11
         ^neighbor c21
         ^neighbor c12
         ^tile t2)
   (<objs> ^object <x1>)
   (<x1> ^object-handle c12
         ^anchored true
         ^id 12
         ^neighbor c22
         ^neighbor c11
         ^neighbor c13
         ^tile t1)
   (<objs> ^object <x2>)
   (<x2> ^object-handle c13
         ^anchored true
         ^id 13
         ^neighbor c23
         ^neighbor c12
         ^neighbor c14
         ^tile t7)
   (<objs> ^object <x3>)
