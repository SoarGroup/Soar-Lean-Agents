         ^anchored true
         ^number 12)
   (<objs> ^object <x29>)
   (<x29> ^object-handle t13
         ^anchored true
         ^number 13)
   (<objs> ^object <x30>)
   (<x30> ^object-handle t14
         ^anchored true
         ^number 14)
   (<objs> ^object <x31>)
   (<x31> ^object-handle t15
         ^anchored true
         ^number 15)
   (<arr> ^binding <dg0>)
   (<dg0> ^cell c11
         ^tile t1)
   (<arr> ^binding <dg1>)
   (<dg1> ^cell c12
         ^tile t2)
   (<arr> ^binding <dg2>)
   (<dg2> ^cell c13
         ^tile t3)
   (<arr> ^binding <dg3>)
   (<dg3> ^cell c14
         ^tile t4)
   (<arr> ^binding <dg4>)
   (<dg4> ^cell c21
         ^tile t5)
   (<arr> ^binding <dg5>)
   (<dg5> ^cell c22
         ^tile t6)
   (<arr> ^binding <dg6>)
   (<dg6> ^cell c23
         ^tile t7)
   (<arr> ^binding <dg7>)
   (<dg7> ^cell c24
         ^tile t8)
   (<arr> ^binding <dg8>)
   (<dg8> ^cell c31
         ^tile t9)
   (<arr> ^binding <dg9>)
   (<dg9> ^cell c32
         ^tile t10)
   (<arr> ^binding <dg10>)
   (<dg10> ^cell c33
