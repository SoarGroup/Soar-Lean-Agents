## Hello World (families, from English): generated by spec_backend.py (WorldSpec, path B: Lean description, Python rules) from the instructor statements.
##
## Instructor statements used (numbers as in english-input.txt):
##  1. Write the words "Hello World" once, then stop.
##
## Assumption ledger:
##   A-HW1: Writing is an action of the agent (a perform-action command); its report prints "Hello World".
##   A-HW2: "once, then stop": a page object records what is written on it (nothing at the start); the operator needs a page with nothing written, and the goal is a page with the words, so the agent writes once and the task ends. (A test that the page lacks the property is a negation, which the compiled conditions may not contain, W-CHK-009.)
## Matching hints for learned rules (World-Conventions L3-095, L11-009): many-valued attributes, sized from the initial world.
production optimize-attribute page 2
production optimize-attribute task 2
production optimize-attribute object 2


## Propose initialize-hello-world when its conditions below hold.
sp {hello-world*propose*initialize-hello-world
   (state <s> ^superstate nil ^world <w> -^name)
-->
   (<s> ^operator <o> + >)
   (<o> ^name initialize-hello-world ^task-operator false)
}

sp {hello-world*apply*initialize-hello-world
   (state <s> ^operator.name initialize-hello-world ^world <w>)
   (<w> ^objects <objs>)
-->
   (<s> ^name hello-world ^desireds <ds>)
   (<objs> ^page <k-page> ^task <k-task>)
   (<k-page> ^object-handle page ^anchored true ^type page ^name page ^written nothing)
   (<k-task> ^object-handle task ^anchored true ^type task)
   (<ds> ^desired-count 1 ^desired <d1>)
   (<d1> ^object <d1-o>)
   (<d1-o> ^object-handle task ^goal-met true)

   (log 1 (crlf) |Initialize hello-world.|)
}

## Elaborate problem space: adds ^dont-copy-object-attribute, ^problem-space.
sp {hello-world*elaborate*problem-space
   (state <s> ^name hello-world)
-->
   (<s> ^problem-space <p>)
   (<p> ^name hello-world ^dont-copy-object-attribute goal-met)
}

sp {hello-world*elaborate*problem-space*mea-substate
   (state <s> ^impasse no-change ^attribute operator ^superstate <ss>)
   (<ss> ^problem-space.name hello-world ^operator <so>)
   (<so> ^task-operator true -^pre-conditions-satisfied true)
-->
   (<s> ^problem-space <p>)
   (<p> ^name hello-world ^dont-copy-object-attribute goal-met)
}

## Elaborate flags: adds ^flag-override, ^mea-operator-selection.
sp {hello-world*elaborate*flags
   (state <s> ^superstate nil ^name hello-world)
-->
   (<s> ^flag-override <f>)
   (<f> ^mea-operator-selection true)
}

## Achievement of object-property desireds (supplied by the task).
sp {hello-world*elaborate*state*achieved*object-property
   (state <s> ^problem-space.name hello-world ^desireds <ds> ^world <w>)
   (<ds> ^desired <d>)
   (<d> ^object <do>)
   (<do> ^object-handle <h> ^{ <> object-handle <a> } <v>)
   (<w> ^anchored-world true ^objects.object <ob>)
   (<ob> ^object-handle <h> ^<a> <v>)
-->
   (<ds> ^achieved <d>)
}

sp {hello-world*elaborate*state*unachieved*object-property
   (state <s> ^problem-space.name hello-world ^desireds <ds> ^world <w>)
   (<ds> ^desired <d>)
   (<d> ^object <do>)
   (<do> ^object-handle <h> ^{ <> object-handle <a> } <v>)
   (<w> ^anchored-world true)
  -{(<w> ^objects.object <ob>)
    (<ob> ^object-handle <h> ^<a> <v>)}
-->
   (<ds> ^unachieved <d>)
}

## Operator write-hello-world (statement 1).
sp {hello-world*propose*write-hello-world
   (state <s> ^problem-space.name hello-world ^flags.mea-operator-selection true ^world <w> ^desireds <ds>)
   (<w> ^anchored-world true ^objects <objs>)
   (<objs> ^page <p>)
   (<p> ^written nothing)
   (<ds> ^unachieved-desireds true)
-->
   (<s> ^operator <op> +)
   (<op> ^name write-hello-world ^task-operator true ^action-handle write-hello-world  ^argument-count 0 ^pre-conditions-satisfied true)
}

## Effect of write-hello-world (look-ahead).
sp {hello-world*apply*write-hello-world*internal
   (state <s> ^problem-space.name hello-world ^operator <op> ^internal-actions true ^world <w>)
   (<op> ^task-operator true ^name write-hello-world ^pre-conditions-satisfied true )
   (<w> ^anchored-world true ^objects <objs>)
   (<objs> ^page <p>)
   (<p> ^written <p-written>)
-->
   (<p> ^written <p-written> - hello-world)
}

## Effect of a completed write-hello-world command on the real world (once per command).
sp {hello-world*apply*write-hello-world*environment-effect
   :o-support
   (state <s> ^problem-space.name hello-world ^superstate nil ^world <w> ^io.output-link.perform-action <pa>)
   (<pa> ^name write-hello-world ^status complete  -^effect-applied true)
   (<w> ^anchored-world true ^objects <objs>)
   (<objs> ^page <p>)
   (<p> ^written <p-written>)
-->
   (<p> ^written <p-written> - hello-world)
   (<pa> ^effect-applied true)
   (write |Hello World| (crlf))
}

## Goal (statement 1): ^goal-met true on the task object.
sp {hello-world*elaborate*goal
   (state <s> ^problem-space.name hello-world ^world <w>)
   (<w> ^anchored-world true ^objects <objs>)
   (<objs> ^task <task>)
   (<objs> ^page <p>)
   (<p> ^written hello-world)
-->
   (<task> ^goal-met true)
}
