
sp {kenken*propose*choose-cell-3
   (state <s> ^name kenken)
   (<s> ^puzzle <p>)
   (<s> ^cell <c>)
   (<p> ^gcell 0)
   (<c> ^mark 0)
   (<c> ^cand <lk3x1>)
   (<lk3x1> ^alive 1)
   (<c> ^cand { <lk3x2> <> <lk3x1> })
   (<lk3x2> ^alive 1)
   (<c> ^cand { <lk3x3> <> <lk3x1> <> <lk3x2> })
   (<lk3x3> ^alive 1)
   -{ (<c> ^cand <fw4x1>) (<fw4x1> ^alive 1) (<c> ^cand { <fw4x2> <> <fw4x1> }) (<fw4x2> ^alive 1) (<c> ^cand { <fw4x3> <> <fw4x1> <> <fw4x2> }) (<fw4x3> ^alive 1) (<c> ^cand { <fw4x4> <> <fw4x1> <> <fw4x2> <> <fw4x3> }) (<fw4x4> ^alive 1) }
-->
   (<s> ^operator <o> +)
   (<s> ^operator <o> =)
   (<o> ^name choose-cell-3)
   (<o> ^p <p>)
   (<o> ^c <c>)
}

sp {kenken*apply*choose-cell-3
   (state <s> ^name kenken)
   (<s> ^operator <o>)
   (<o> ^name choose-cell-3)
   (<o> ^p <p>)
   (<o> ^c <c>)
   (<p> ^gcell <p-gcell>)
   (<c> ^coord <c-coord>)
-->
   (<p> ^gcell <c-coord>)
   (<p> ^gcell <p-gcell> -)
   (write |Guess cell: | <c-coord>)
}
