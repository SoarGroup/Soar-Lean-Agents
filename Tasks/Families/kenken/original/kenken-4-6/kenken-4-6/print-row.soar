sp {kenken*apply*print-row
   (state <s> ^name kenken)
   (<s> ^operator <o>)
   (<o> ^name print-row)
   (<o> ^p <p>)
   (<o> ^|k1| <k1>)
   (<o> ^|k2| <k2>)
   (<o> ^|k3| <k3>)
   (<o> ^|k4| <k4>)
   (<o> ^r <r>)
   (<o> ^rp <rp>)
   (<p> ^printed <p-printed>)
   (<k1> ^mark <k1-mark>)
   (<k2> ^mark <k2-mark>)
   (<k3> ^mark <k3-mark>)
   (<k4> ^mark <k4-mark>)
-->
   (<p> ^printed <r>)
   (<p> ^printed <p-printed> -)
   (write |\| | <k1-mark> | \| | <k2-mark> | \| | <k3-mark> | \| | <k4-mark> | \| |)
}
