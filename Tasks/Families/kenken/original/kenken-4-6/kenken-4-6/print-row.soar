
sp {kenken*propose*print-row*r-1*rp-0
   (state <s> ^name kenken)
   (<s> ^superstate nil)
   (<s> ^goal-reached <_v2>)
   (<s> ^puzzle <p>)
   (<s> ^cell <k1>)
   (<s> ^cell <k2>)
   (<s> ^cell <k3>)
   (<s> ^cell <k4>)
   (<p> ^printed 0)
   (<k1> ^row 1)
   (<k1> ^col 1)
   (<k2> ^row 1)
   (<k2> ^col 2)
   (<k3> ^row 1)
   (<k3> ^col 3)
   (<k4> ^row 1)
   (<k4> ^col 4)
-->
   (<s> ^operator <o> +)
   (<s> ^operator <o> =)
   (<o> ^name print-row)
   (<o> ^p <p>)
   (<o> ^|k1| <k1>)
   (<o> ^|k2| <k2>)
   (<o> ^|k3| <k3>)
   (<o> ^|k4| <k4>)
   (<o> ^r 1)
   (<o> ^rp 0)
}

