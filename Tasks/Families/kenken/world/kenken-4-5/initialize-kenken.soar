## Task initialization (generated from the original puzzle data)
sp {kenken*propose*initialize-kenken
   (state <s> ^superstate nil
              ^world <w>
             -^name)
-->
   (<s> ^operator <o> +)
   (<o> ^name initialize-kenken
        ^task-operator false)
}

## agent-world keeps initialize-agent-world proposed (best) until the top state has a name
sp {kenken*select*initialize-kenken*after-agent-world
   (state <s> ^operator <o> +
              ^operator <aw> +)
   (<o> ^name initialize-kenken)
   (<aw> ^name initialize-agent-world)
-->
   (<s> ^operator <o> > <aw>)
}

sp {kenken*apply*initialize-kenken
   (state <s> ^operator.name initialize-kenken
              ^world <w>)
   (<w> ^objects <objs>)
-->
   (<s> ^name kenken
        ^environment none
        ^flag-override <f>
        ^desireds <ds>
        ^printed-rows 0
        ^grid-size 4)
