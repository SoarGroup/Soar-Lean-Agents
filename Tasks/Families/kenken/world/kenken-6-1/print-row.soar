## Print the solved grid, one row per print-row operator (real top state only)
sp {kenken*propose*print-row*r-1
   (state <s> ^problem-space.name kenken
              ^superstate nil
              ^real true
              ^desireds <ds>
              ^success <ds>
              ^printed-rows 0
              ^world <w>)
   (<w> ^anchored-world true
        ^objects <objs>)
   (<objs> ^object <k1> ^object <k2> ^object <k3> ^object <k4> ^object <k5> ^object <k6>)
   (<k1> ^type cell ^row 1 ^col 1)
   (<k2> ^type cell ^row 1 ^col 2)
   (<k3> ^type cell ^row 1 ^col 3)
   (<k4> ^type cell ^row 1 ^col 4)
   (<k5> ^type cell ^row 1 ^col 5)
   (<k6> ^type cell ^row 1 ^col 6)
-->
   (<s> ^operator <o> +)
   (<o> ^name print-row
        ^task-operator false
        ^row-number 1
        ^cell1 <k1>
        ^cell2 <k2>
        ^cell3 <k3>
        ^cell4 <k4>
        ^cell5 <k5>
        ^cell6 <k6>)
}

