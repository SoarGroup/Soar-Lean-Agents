sp {knights*apply*backup
   (state <s> ^name knights)
   (<s> ^operator <o>)
   (<o> ^name backup)
   (<o> ^t <t>)
   (<o> ^c <c>)
   (<o> ^p <p>)
   (<t> ^at <t-at>)
   (<c> ^used <c-used>)
   (<p> ^visit <p-visit>)
   (<t> ^depth <t-depth>)
   (<t> ^moves <t-moves>)
   (<t> ^goal <t-goal>)
-->
   (<t> ^at <p>)
   (<t> ^at <t-at> -)
   (<c> ^used 0)
   (<c> ^used <c-used> -)
   (<c> ^tried <p-visit>)
   (<t> ^depth (- <t-depth> 1))
   (<t> ^depth <t-depth> -)
   (<t> ^moves (+ <t-moves> 1))
   (<t> ^moves <t-moves> -)
   (<t> ^goal 0)
   (<t> ^goal <t-goal> -)
}

