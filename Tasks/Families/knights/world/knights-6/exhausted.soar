## Task operator exhausted (tour, current square c): back at the first square with no
## untried unused neighbour: the search is complete; the tour is done.
sp {knights*propose*exhausted
   (state <s> ^problem-space.name knights
              ^flags.mea-operator-selection true
              ^desireds <ds>
              ^world <w>)
   (<ds> ^desired <d>
         ^unachieved <d>)
   (<d> ^object.object-handle $ <th>)
   (<w> ^anchored-world true
        ^objects <objs>)
   (<objs> ^object <t>)
   (<t> ^object-handle $ <th>
        ^at <ch>
        ^first <ch>
        ^done 0)
   (<objs> ^object <c>)
   (<c> ^object-handle $ <ch>
        ^visit <c-visit>)
  -{(<c> ^move <lkh>)
    (<objs> ^object <lk>)
    (<lk> ^object-handle <lkh>
          ^used 0)
   -(<lk> ^tried <c-visit>)}
-->
   (<s> ^operator <o> + =)
   (<o> ^name exhausted
        ^task-operator true
        ^action-handle exhausted
        ^super-desired <d>
        ^argument1 <t>
        ^argument2 <c>
        ^argument-count 2
        ^desireds <pd>)
   (<pd> ^desired-count 0)
}

sp {knights*apply*exhausted*internal
   (state <s> ^internal-actions true
              ^operator <o>
              ^world.objects <objs>)
   (<o> ^name exhausted
        ^pre-conditions-satisfied true
        ^argument1.object-handle $ <th>)
   (<objs> ^object <t>)
   (<t> ^object-handle $ <th>
        ^done <t-done>
        ^solutions <t-solutions>)
-->
   (<t> ^done 1)
   (<t> ^done <t-done> -)
   (write |Search complete: | <t-solutions> | solutions|)
}
