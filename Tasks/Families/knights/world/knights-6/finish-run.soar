## Task operator finish-run (tour): after 1,000,000 moves the run is over; the tour is done.
sp {knights*propose*finish-run
   (state <s> ^problem-space.name knights
              ^flags.mea-operator-selection true
              ^desireds <ds>
              ^world <w>)
   (<ds> ^desired <d>
         ^unachieved <d>)
   (<d> ^object.object-handle $ <th>)
   (<w> ^anchored-world true
        ^objects <objs>)
   (<objs> ^object <t>)
   (<t> ^object-handle $ <th>
        ^done 0
        ^moves >= 1000000)
-->
   (<s> ^operator <o> + =)
   (<o> ^name finish-run
        ^task-operator true
        ^action-handle finish-run
        ^super-desired <d>
        ^argument1 <t>
        ^argument-count 1
        ^desireds <pd>)
   (<pd> ^desired-count 0)
}

sp {knights*apply*finish-run*internal
   (state <s> ^internal-actions true
              ^operator <o>
              ^world.objects <objs>)
   (<o> ^name finish-run
        ^pre-conditions-satisfied true
        ^argument1.object-handle $ <th>)
   (<objs> ^object <t>)
   (<t> ^object-handle $ <th>
        ^done <t-done>
        ^solutions <t-solutions>)
-->
   (<t> ^done 1)
   (<t> ^done <t-done> -)
   (write |Run over: | <t-solutions> | solutions|)
}
