## Task initialization: proposed after agent-world's initialize-agent-world (tests ^world).
sp {knights*propose*initialize-knights
   (state <s> ^superstate nil
              ^world <w>
             -^name)
-->
   (<s> ^operator <o> +)
   (<o> ^name initialize-knights
        ^task-operator false)
}

## initialize-agent-world (best, proposed while the top state has no ^name) stays acceptable
## after it applies; prefer the task's initialization to it so that it is not reselected.
sp {knights*compare*initialize-knights*initialize-agent-world
   (state <s> ^superstate nil
              ^operator <o1> +
              ^operator <o2> +)
   (<o1> ^name initialize-knights)
   (<o2> ^name initialize-agent-world)
-->
   (<s> ^operator <o1> > <o2>)
}

## World: one object per square of the 8x8 board (handle = the original square name,
## e.g. b23), with its coordinate, used flag, current degree (unused neighbours), original
## degree (odeg), visit number, the handles of the squares a knight move reaches (^move) and
## of the square it was entered from (^prev); and the tour object (handle tour) with depth,
## move count, frame, solution count, goal and done flags, and the handles of the current
## (^at) and first (^first) squares. Links between objects are object-handle constants.
## Goal: the tour is done (^done 1).
sp {knights*apply*initialize-knights
   (state <s> ^operator.name initialize-knights
              ^world.objects <objs>)
-->
   (<s> ^name knights
        ^environment none
        ^problem-space <ps>
        ^flag-override <f>
        ^desireds <ds>)
   (<ps> ^name knights
         ^agent-world true)
   (<f> ^mea-operator-selection true)
   (<ds> ^desired <d>
         ^desired-count 1)
   (<d> ^object <do>)
   (<do> ^object-handle tour
         ^done 1)
   (<objs> ^object <x0>)
   (<x0> ^object-handle b11
         ^anchored true
         ^coord 11
         ^used 0
         ^degree 2
         ^odeg 2
         ^visit 0
         ^move b23
         ^move b32
         ^prev b11)
   (<objs> ^object <x1>)
   (<x1> ^object-handle b12
         ^anchored true
