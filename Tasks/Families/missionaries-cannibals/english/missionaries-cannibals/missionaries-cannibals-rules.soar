## Effect of a completed cross-one-missionary command on the real world (once per command).
sp {missionaries-cannibals*apply*cross-one-missionary*environment-effect
   :o-support
   (state <s> ^problem-space.name missionaries-cannibals ^superstate nil ^world <w> ^io.output-link.perform-action <pa>)
   (<pa> ^name cross-one-missionary ^status complete ^argument1 <to-h> -^effect-applied true)
   (<w> ^anchored-world true ^objects <objs>)
   (<objs> ^object <to>)
   (<to> ^object-handle $ <to-h>)
   (<objs> ^object <bt>)
   (<bt> ^type boat)
   (<w> ^at <r1>)
   (<r1> ^argument1 <bt> ^argument2 <bold>)
   (<objs> ^object <mf>)
   (<mf> ^type group)
   (<mf> ^role missionary)
   (<w> ^side <r2>)
   (<r2> ^argument1 <mf> ^argument2 <bold>)
   (<objs> ^object <mt>)
   (<mt> ^type group)
   (<mt> ^role missionary)
   (<w> ^side <r3>)
   (<r3> ^argument1 <mt> ^argument2 <to>)
   (<w> ^at <r4>)
   (<r4> ^argument1 <mf> ^argument2 <mold>)
   (<w> ^one-less <r5>)
   (<r5> ^argument1 <mold> ^argument2 <mnew>)
   (<w> ^at <r6>)
   (<r6> ^argument1 <mt> ^argument2 <mtold>)
   (<w> ^one-less <r7>)
   (<r7> ^argument1 <mtnew> ^argument2 <mtold>)
-->
