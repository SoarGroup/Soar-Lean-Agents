## Missionaries and cannibals (families, from English): generated by spec_backend.py (WorldSpec, path B: Lean description, Python rules) from the instructor statements.
##
## Instructor statements used (numbers as in english-input.txt):
##  1. Three missionaries and three cannibals stand on the left bank of a river with a rowing boat.
##  2. The boat carries one or two people and never crosses empty.
##  3. If, on either bank, the cannibals ever outnumber the missionaries who are there, the missionaries are eaten.
##  4. A bank with no missionaries is safe.
##  5. The goal is to get all six people to the right bank.
##
## Assumption ledger:
##   A-MC1: The three missionaries are interchangeable, and so are the three cannibals, so the state is how many of each are on each bank. Four group objects (the missionaries and the cannibals on the left and on the right bank, side relation to their bank) are at a number object (zero to three, with a value). The boat is at a bank; the two banks have a static other relation both ways.
##   A-MC2: "carries one or two people and never crosses empty": five crossing operators, one for each mix of one or two people (one or two missionaries, one or two cannibals, one of each). A crossing moves the boat to the other bank and moves the people from the group on the boat's bank to the group of the same role on the other bank.
##   A-MC3: WorldSpec has no subtraction, so the counts are number objects linked by static one-less(n, n - 1) and two-less(n, n - 2) relations; a crossing is legal only when the starting group has enough people (the relation exists for its number).
##   A-MC4: "cannibals outnumber the missionaries", with no missionaries safe: a losing state is a bank whose missionaries number more than zero and fewer than its cannibals. "ever": wherever it arises, in the real world or in look-ahead.
##   A-MC5: The goal is three missionaries and three cannibals on the right bank.
##   A-MC6: Search control, not from the English (as for the other WorldSpec river crossings): a look-ahead state that returns to a situation already on its path fails; a situation is the number in each group and where the boat is.
##   A-MC7: Representation choice (25 Nov 2026): a first version with six person objects stated the losing states with negated conditions (exactly one or two missionaries on a bank); its learned rules dropped the negations and rejected every crossing at the start, and without learning its look-ahead did not finish in 100,000 decisions. Counting the groups needs no negation.
## Matching hints for learned rules (World-Conventions L3-095, L11-009): many-valued attributes, sized from the initial world.
production optimize-attribute object 12
production optimize-attribute at 5
production optimize-attribute other 2
production optimize-attribute side 4
production optimize-attribute one-less 3
production optimize-attribute two-less 2


## Propose initialize-missionaries-cannibals when its conditions below hold.
sp {missionaries-cannibals*propose*initialize-missionaries-cannibals
   (state <s> ^superstate nil ^world <w> -^name)
-->
   (<s> ^operator <o> + >)
   (<o> ^name initialize-missionaries-cannibals ^task-operator false)
}

sp {missionaries-cannibals*apply*initialize-missionaries-cannibals
   (state <s> ^operator.name initialize-missionaries-cannibals ^world <w>)
   (<w> ^objects <objs>)
-->
   (<s> ^name missionaries-cannibals ^desireds <ds>)
   (<objs> ^object <k-left> <k-right> <k-boat> <k-zero> <k-one> <k-two> <k-three> <k-left-missionaries> <k-left-cannibals> <k-right-missionaries> <k-right-cannibals> <k-task>)
   (<k-left> ^object-handle left ^anchored true ^type bank ^name left ^static true)
   (<k-right> ^object-handle right ^anchored true ^type bank ^name right ^static true)
   (<k-boat> ^object-handle boat ^anchored true ^type boat ^name boat ^static true)
   (<k-zero> ^object-handle zero ^anchored true ^type number ^name zero ^value 0 ^static true)
   (<k-one> ^object-handle one ^anchored true ^type number ^name one ^value 1 ^static true)
   (<k-two> ^object-handle two ^anchored true ^type number ^name two ^value 2 ^static true)
   (<k-three> ^object-handle three ^anchored true ^type number ^name three ^value 3 ^static true)
   (<k-left-missionaries> ^object-handle left-missionaries ^anchored true ^type group ^name left-missionaries ^role missionary ^static true)
   (<k-left-cannibals> ^object-handle left-cannibals ^anchored true ^type group ^name left-cannibals ^role cannibal ^static true)
   (<k-right-missionaries> ^object-handle right-missionaries ^anchored true ^type group ^name right-missionaries ^role missionary ^static true)
   (<k-right-cannibals> ^object-handle right-cannibals ^anchored true ^type group ^name right-cannibals ^role cannibal ^static true)
   (<k-task> ^object-handle task ^anchored true ^type task)
   (<ds> ^desired-count 1 ^desired <d1>)
   (<d1> ^object <d1-o>)
   (<d1-o> ^object-handle task ^goal-met true)
   (<w> ^at <rel-1>)
   (<rel-1> ^argument1 <k-left-missionaries> ^argument2 <k-three>)
   (<w> ^at <rel-2>)
   (<rel-2> ^argument1 <k-left-cannibals> ^argument2 <k-three>)
   (<w> ^at <rel-3>)
   (<rel-3> ^argument1 <k-right-missionaries> ^argument2 <k-zero>)
   (<w> ^at <rel-4>)
   (<rel-4> ^argument1 <k-right-cannibals> ^argument2 <k-zero>)
   (<w> ^at <rel-5>)
   (<rel-5> ^argument1 <k-boat> ^argument2 <k-left>)
   (<w> ^other <rel-6>)
   (<rel-6> ^argument1 <k-left> ^argument2 <k-right>)
   (<w> ^other <rel-7>)
   (<rel-7> ^argument1 <k-right> ^argument2 <k-left>)
   (<w> ^side <rel-8>)
   (<rel-8> ^argument1 <k-left-missionaries> ^argument2 <k-left>)
   (<w> ^side <rel-9>)
   (<rel-9> ^argument1 <k-left-cannibals> ^argument2 <k-left>)
   (<w> ^side <rel-10>)
   (<rel-10> ^argument1 <k-right-missionaries> ^argument2 <k-right>)
   (<w> ^side <rel-11>)
   (<rel-11> ^argument1 <k-right-cannibals> ^argument2 <k-right>)
   (<w> ^one-less <rel-12>)
   (<rel-12> ^argument1 <k-one> ^argument2 <k-zero>)
   (<w> ^one-less <rel-13>)
   (<rel-13> ^argument1 <k-two> ^argument2 <k-one>)
   (<w> ^one-less <rel-14>)
   (<rel-14> ^argument1 <k-three> ^argument2 <k-two>)
   (<w> ^two-less <rel-15>)
   (<rel-15> ^argument1 <k-two> ^argument2 <k-zero>)
   (<w> ^two-less <rel-16>)
   (<rel-16> ^argument1 <k-three> ^argument2 <k-one>)
   (log 1 (crlf) |Initialize missionaries-cannibals.|)
}

## Elaborate problem space: adds ^copy-relation, ^dont-copy-object-attribute, ^problem-space, ^share-relation.
sp {missionaries-cannibals*elaborate*problem-space
   (state <s> ^name missionaries-cannibals)
-->
   (<s> ^problem-space <p>)
   (<p> ^name missionaries-cannibals ^copy-relation at ^share-relation other ^share-relation side ^share-relation one-less ^share-relation two-less ^dont-copy-object-attribute goal-met)
}

sp {missionaries-cannibals*elaborate*problem-space*mea-substate
   (state <s> ^impasse no-change ^attribute operator ^superstate <ss>)
   (<ss> ^problem-space.name missionaries-cannibals ^operator <so>)
   (<so> ^task-operator true -^pre-conditions-satisfied true)
-->
   (<s> ^problem-space <p>)
   (<p> ^name missionaries-cannibals ^dont-copy-object-attribute goal-met)
}

## Elaborate flags: adds ^flag-override, ^mea-operator-selection.
sp {missionaries-cannibals*elaborate*flags
   (state <s> ^superstate nil ^name missionaries-cannibals)
-->
   (<s> ^flag-override <f>)
   (<f> ^mea-operator-selection true)
}

## Achievement of object-property desireds (supplied by the task).
sp {missionaries-cannibals*elaborate*state*achieved*object-property
   (state <s> ^problem-space.name missionaries-cannibals ^desireds <ds> ^world <w>)
   (<ds> ^desired <d>)
   (<d> ^object <do>)
   (<do> ^object-handle <h> ^{ <> object-handle <a> } <v>)
   (<w> ^anchored-world true ^objects.object <ob>)
   (<ob> ^object-handle <h> ^<a> <v>)
-->
   (<ds> ^achieved <d>)
}

sp {missionaries-cannibals*elaborate*state*unachieved*object-property
   (state <s> ^problem-space.name missionaries-cannibals ^desireds <ds> ^world <w>)
   (<ds> ^desired <d>)
   (<d> ^object <do>)
   (<do> ^object-handle <h> ^{ <> object-handle <a> } <v>)
   (<w> ^anchored-world true)
  -{(<w> ^objects.object <ob>)
    (<ob> ^object-handle <h> ^<a> <v>)}
-->
   (<ds> ^unachieved <d>)
}

