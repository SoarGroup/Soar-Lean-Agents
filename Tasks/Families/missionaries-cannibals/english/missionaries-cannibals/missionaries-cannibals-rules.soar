}

## Goal (statement 5): ^goal-met true on the task object.
sp {missionaries-cannibals*elaborate*goal
   (state <s> ^problem-space.name missionaries-cannibals ^world <w>)
   (<w> ^anchored-world true ^objects <objs>)
   (<objs> ^object <task>)
   (<task> ^type task)
   (<objs> ^object <g>)
   (<g> ^type group)
   (<objs> ^object <k-right>)
   (<k-right> ^object-handle right)
   (<w> ^side <r1>)
   (<r1> ^argument1 <g> ^argument2 <k-right>)
   (<g> ^role missionary)
   (<w> ^at <r2>)
   (<r2> ^argument1 <g> ^argument2 <n>)
   (<n> ^value 3)
   (<objs> ^object <h>)
   (<h> ^type group)
   (<w> ^side <r3>)
   (<r3> ^argument1 <h> ^argument2 <k-right>)
   (<h> ^role cannibal)
   (<w> ^at <r4>)
   (<r4> ^argument1 <h> ^argument2 <k>)
   (<k> ^value 3)
-->
   (<task> ^goal-met true)
}

## ---- Search control (stated in the description, not taught): a look-ahead state that returns to a situation on
## its look-ahead path fails, and the library rejects it. Situation: where each group / boat is (at).
sp {missionaries-cannibals*elaborate*ancestor-world*parent
   (state <s> ^name evaluate-operator ^superstate.superstate.world <aw>)
-->
   (<s> ^ancestor-world <aw>)
}

sp {missionaries-cannibals*elaborate*ancestor-world*inherited
   (state <s> ^name evaluate-operator ^superstate.superstate.ancestor-world <aw>)
-->
   (<s> ^ancestor-world <aw>)
}

## Elaborate failure repeated situation: adds ^failure.
sp {missionaries-cannibals*elaborate*failure*repeated-situation
   (state <s> ^name evaluate-operator ^look-ahead-operator <o> ^ancestor-world <aw> ^desireds <ds> ^world <w>)
   (<w> ^anchored-world true ^versioned-operator <o>)
  -{(<w> ^at <r>)
    (<r> ^argument1 <x> ^argument2 <p>)
    (<x> ^type << group boat >> ^object-handle <h>)
    (<p> ^object-handle <ph>)
    (<aw> ^at <ar>)
    (<ar> ^argument1 <ax> ^argument2 <ap>)
    (<ax> ^object-handle <h>)
    (<ap> ^object-handle <> <ph>)}
-->
   (<s> ^failure <ds>)
}
