## ^quiescence t: no chunk is built over duplicate detection. The ancestor comparison lies inside the
## subgoal stack, so a chunk over it would drop it and reject the move in any state (to-do row 6, 21 Nov 2026).

sp {mac*evaluate*state*failure*duplicate
   (state <s> ^name mac
              ^quiescence t)
   (<s> ^tried-tied-operator <_v1>)
   (<s> ^desired <d>)
   (<s> ^ancestor <a>)
   (<a> ^name mac)
   (<s> ^bank <x0>)
   (<x0> ^name <k0-name>)
   (<x0> ^missionaries <k0-missionaries>)
   (<x0> ^cannibals <k0-cannibals>)
   (<x0> ^boat <k0-boat>)
   (<s> ^bank { <x1> <> <x0> })
   (<x1> ^name <k1-name>)
   (<x1> ^missionaries <k1-missionaries>)
   (<x1> ^cannibals <k1-cannibals>)
   (<x1> ^boat <k1-boat>)
   (<a> ^bank <y0>)
   (<y0> ^name <k0-name>)
   (<y0> ^missionaries <k0-missionaries>)
   (<y0> ^cannibals <k0-cannibals>)
   (<y0> ^boat <k0-boat>)
   (<a> ^bank <y1>)
   (<y1> ^name <k1-name>)
   (<y1> ^missionaries <k1-missionaries>)
   (<y1> ^cannibals <k1-cannibals>)
   (<y1> ^boat <k1-boat>)
-->
   (<s> ^failure <d>)
}
