
sp {mac*propose*move-boat*missionaries-0*cannibals-1
   (state <s> ^name mac)
   (<s> ^bank <from>)
   (<s> ^bank <to>)
   (<from> ^other-bank <to>)
   (<from> ^boat 1)
   (<from> ^missionaries { <from-missionaries> >= 0 })
   (<from> ^cannibals { <from-cannibals> >= 1 })
-->
   (<s> ^operator <o> +)
   (<o> ^name move-boat)
   (<o> ^from <from>)
   (<o> ^to <to>)
   (<o> ^missionaries 0)
   (<o> ^cannibals 1)
}

