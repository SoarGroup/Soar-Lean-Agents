   (<s> ^operator <o> +)
   (<o> ^name move-boat
        ^task-operator true
        ^action-handle move-boat
        ^argument1 <from>
        ^argument2 <to>
        ^argument-count 2
        ^missionaries 0
        ^cannibals 2
        ^desireds <pre>)
   (<pre> ^desired-count 0)
}

