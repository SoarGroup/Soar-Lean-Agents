##############################################################################
## move-boat: task-action operator (one proposal per value combination, OPR-016)
##   ^argument1 = bank the boat leaves (world object), ^argument2 = other bank,
##   ^missionaries / ^cannibals = constants carried.  No preconditions
##   (^desireds.desired-count 0): legality is tested in the proposal, as in the
##   original.  Applied internally (^environment none) in the decision it is
##   selected, at the top state and in look-ahead alike.
##############################################################################

sp {mac*propose*move-boat*missionaries-0*cannibals-1
   (state <s> ^problem-space.name mac
              ^world <w>)
   (<w> ^anchored-world true
        ^objects.object <from> <to>)
   (<from> ^boat 1
           ^other-bank-handle <to-handle>
           ^missionaries >= 0
           ^cannibals >= 1)
   (<to> ^object-handle $ <to-handle>)
-->
   (<s> ^operator <o> +)
   (<o> ^name move-boat
        ^task-operator true
        ^action-handle move-boat
        ^argument1 <from>
        ^argument2 <to>
        ^argument-count 2
        ^missionaries 0
        ^cannibals 1
        ^desireds <pre>)
   (<pre> ^desired-count 0)
}

