sp {mac*propose*move-boat*missionaries-2*cannibals-0
   (state <s> ^problem-space.name mac
              ^world <w>)
   (<w> ^anchored-world true
        ^objects.object <from> <to>)
   (<from> ^boat 1
           ^other-bank-handle <to-handle>
           ^missionaries >= 2
           ^cannibals >= 0)
   (<to> ^object-handle $ <to-handle>)
-->
   (<s> ^operator <o> +)
   (<o> ^name move-boat
        ^task-operator true
        ^action-handle move-boat
        ^argument1 <from>
        ^argument2 <to>
        ^argument-count 2
        ^missionaries 2
        ^cannibals 0
        ^desireds <pre>)
   (<pre> ^desired-count 0)
}

## Internal application: objects are found in the state's own world by handle, because in
## look-ahead the operator evaluated is the tied (uncopied) operator whose arguments are
## the superstate's objects.  ^boat 1 on the from bank guards against a second firing
## while the operator stays selected.
sp {apply*move-boat*internal
   (state <s> ^operator <o>
              ^internal-actions true
              ^world <w>)
   (<o> ^name move-boat
        ^pre-conditions-satisfied true
        ^argument1.object-handle $ <fh>
        ^argument2.object-handle $ <th>
        ^missionaries <m>
        ^cannibals <c>)
   (<w> ^anchored-world true
        ^objects.object <from> <to>)
   (<from> ^object-handle $ <fh>
           ^boat 1
           ^missionaries <fm>
           ^cannibals <fc>)
   (<to> ^object-handle $ <th>
         ^boat <tb>
         ^missionaries <tm>
         ^cannibals <tc>)
-->
   (log 1 (crlf) |Apply move-boat: | <m> | missionaries, | <c> | cannibals from | <fh>)
   (<from> ^missionaries <fm> - (- <fm> <m>)
           ^cannibals <fc> - (- <fc> <c>)
           ^boat 1 - 0)
   (<to> ^missionaries <tm> - (+ <tm> <m>)
         ^cannibals <tc> - (+ <tc> <c>)
         ^boat <tb> - 1)
}
