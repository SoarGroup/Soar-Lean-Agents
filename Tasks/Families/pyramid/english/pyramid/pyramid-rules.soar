## Pyramid problem (families, from English): generated by spec_backend.py (WorldSpec, path B: Lean description, Python rules) from the instructor statements.
##
## Instructor statements used (numbers as in english-input.txt):
##  1. A pyramid problem adds a run of consecutive numbers counting down from a base.
##  2. The base is the first term, and each term is one less than the one before.
##  3. The height says how many terms follow the first, so height h gives h + 1 terms.
##  4. This problem has base 5 and height 10 (5 + 4 + ... + (-5)).
##  5. The goal is to compute the sum.
##
## Assumption ledger:
##   A-PY1: A problem object holds the next term (starting at the base, 5), the running sum (starting at 0) and the number of terms still to add after the next one (remaining, starting at the height, 10).
##   A-PY2: add-term adds the next term to the sum, lowers the term by 1 and lowers remaining by 1 (adding -1; WorldSpec has no subtraction, so a negative constant is added). It is proposed while remaining is 0 or more, which gives h + 1 terms.
##   A-PY3: "compute the sum": the goal is that every term has been added (remaining below 0); the sum is then on the problem object (0 for this instance).
## Matching hints for learned rules (World-Conventions L3-095, L11-009): many-valued attributes, sized from the initial world.
production optimize-attribute problem 2
production optimize-attribute task 2
production optimize-attribute object 2


## Propose initialize-pyramid when its conditions below hold.
sp {pyramid*propose*initialize-pyramid
   (state <s> ^superstate nil ^world <w> -^name)
-->
   (<s> ^operator <o> + >)
   (<o> ^name initialize-pyramid ^task-operator false)
}

sp {pyramid*apply*initialize-pyramid
   (state <s> ^operator.name initialize-pyramid ^world <w>)
   (<w> ^objects <objs>)
-->
   (<s> ^name pyramid ^desireds <ds>)
   (<objs> ^problem <k-problem> ^task <k-task>)
   (<k-problem> ^object-handle problem ^anchored true ^type problem ^name problem ^term 5 ^sum 0 ^remaining 10)
   (<k-task> ^object-handle task ^anchored true ^type task)
   (<ds> ^desired-count 1 ^desired <d1>)
   (<d1> ^object <d1-o>)
   (<d1-o> ^object-handle task ^goal-met true)

   (log 1 (crlf) |Initialize pyramid.|)
}

## Elaborate problem space: adds ^dont-copy-object-attribute, ^problem-space.
sp {pyramid*elaborate*problem-space
   (state <s> ^name pyramid)
-->
   (<s> ^problem-space <p>)
   (<p> ^name pyramid ^dont-copy-object-attribute goal-met)
}

sp {pyramid*elaborate*problem-space*mea-substate
   (state <s> ^impasse no-change ^attribute operator ^superstate <ss>)
   (<ss> ^problem-space.name pyramid ^operator <so>)
   (<so> ^task-operator true -^pre-conditions-satisfied true)
-->
   (<s> ^problem-space <p>)
   (<p> ^name pyramid ^dont-copy-object-attribute goal-met)
}

## Elaborate flags: adds ^flag-override, ^mea-operator-selection.
sp {pyramid*elaborate*flags
   (state <s> ^superstate nil ^name pyramid)
-->
   (<s> ^flag-override <f>)
   (<f> ^mea-operator-selection true)
}

## Achievement of object-property desireds (supplied by the task).
sp {pyramid*elaborate*state*achieved*object-property
   (state <s> ^problem-space.name pyramid ^desireds <ds> ^world <w>)
   (<ds> ^desired <d>)
   (<d> ^object <do>)
   (<do> ^object-handle <h> ^{ <> object-handle <a> } <v>)
   (<w> ^anchored-world true ^objects.object <ob>)
   (<ob> ^object-handle <h> ^<a> <v>)
-->
   (<ds> ^achieved <d>)
}

sp {pyramid*elaborate*state*unachieved*object-property
   (state <s> ^problem-space.name pyramid ^desireds <ds> ^world <w>)
   (<ds> ^desired <d>)
   (<d> ^object <do>)
   (<do> ^object-handle <h> ^{ <> object-handle <a> } <v>)
   (<w> ^anchored-world true)
  -{(<w> ^objects.object <ob>)
    (<ob> ^object-handle <h> ^<a> <v>)}
-->
   (<ds> ^unachieved <d>)
}

## Operator add-term (statements 1, 2, 3).
sp {pyramid*propose*add-term
   (state <s> ^problem-space.name pyramid ^flags.mea-operator-selection true ^world <w> ^desireds <ds>)
   (<w> ^anchored-world true ^objects <objs>)
   (<objs> ^problem <p>)
   (<p> ^remaining >= 0)
   (<ds> ^unachieved-desireds true)
-->
   (<s> ^operator <op> +)
   (<op> ^name add-term ^task-operator true ^action-handle add-term  ^argument-count 0 ^pre-conditions-satisfied true)
}

## Effect of add-term (look-ahead).
sp {pyramid*apply*add-term*internal
   (state <s> ^problem-space.name pyramid ^operator <op> ^internal-actions true ^world <w>)
   (<op> ^task-operator true ^name add-term ^pre-conditions-satisfied true )
   (<w> ^anchored-world true ^objects <objs>)
   (<objs> ^problem <p>)
   (<p> ^sum <p-sum>)
   (<p> ^term <p-term>)
   (<p> ^remaining <p-remaining>)
-->
   (<p> ^sum <p-sum> - (+ <p-sum> <p-term>))
   (<p> ^term <p-term> - (+ <p-term> -1))
   (<p> ^remaining <p-remaining> - (+ <p-remaining> -1))
}

## Effect of a completed add-term command on the real world (once per command).
sp {pyramid*apply*add-term*environment-effect
   :o-support
   (state <s> ^problem-space.name pyramid ^superstate nil ^world <w> ^io.output-link.perform-action <pa>)
   (<pa> ^name add-term ^status complete  -^effect-applied true)
   (<w> ^anchored-world true ^objects <objs>)
   (<objs> ^problem <p>)
   (<p> ^sum <p-sum>)
   (<p> ^term <p-term>)
   (<p> ^remaining <p-remaining>)
-->
   (<p> ^sum <p-sum> - (+ <p-sum> <p-term>))
   (<p> ^term <p-term> - (+ <p-term> -1))
   (<p> ^remaining <p-remaining> - (+ <p-remaining> -1))
   (<pa> ^effect-applied true)
   (write |Add the next term| (crlf))
}

## Goal (statements 3, 5): ^goal-met true on the task object.
sp {pyramid*elaborate*goal
   (state <s> ^problem-space.name pyramid ^world <w>)
   (<w> ^anchored-world true ^objects <objs>)
   (<objs> ^task <task>)
   (<objs> ^problem <p>)
   (<p> ^remaining < 0)
-->
   (<task> ^goal-met true)
}
