
sp {pyramid*propose*add-next-term
   (state <s> ^name pyramid)
   (<s> ^pyramid <pyramid>)
   (<pyramid> ^height { <pyramid-height> >= 0 })
-->
   (<s> ^operator <o> +)
   (<s> ^operator <o> =)
   (<o> ^name add-next-term)
   (<o> ^pyramid <pyramid>)
}

sp {pyramid*apply*add-next-term
   (state <s> ^name pyramid)
   (<s> ^operator <o>)
   (<o> ^name add-next-term)
   (<o> ^pyramid <pyramid>)
   (<pyramid> ^sum <pyramid-sum>)
   (<pyramid> ^term <pyramid-term>)
   (<pyramid> ^height <pyramid-height>)
-->
   (<pyramid> ^sum (+ <pyramid-sum> <pyramid-term>))
   (<pyramid> ^sum <pyramid-sum> -)
   (<pyramid> ^term (- <pyramid-term> 1))
   (<pyramid> ^term <pyramid-term> -)
   (<pyramid> ^height (- <pyramid-height> 1))
   (<pyramid> ^height <pyramid-height> -)
   (write | + | <pyramid-term>)
}
