
sp {TicTacToe*elaborate*goal*success
   (state <s> ^name TicTacToe)
   (<s> ^desired <d>)
   (<s> ^game <x>)
   (<d> ^game <dx>)
   (<dx> ^over <g-over>)
   (<x> ^over <g-over>)
-->
   (<s> ^success <d>)
}

sp {TicTacToe*halt*goal*success
   (state <s> ^superstate nil)
   (<s> ^desired <d>)
   (<s> ^success <d>)
-->
   (write (crlf) |The problem has been solved.|)
   (halt)
}
