
# Written by hand (Raw): Monitor (trace output only), as TicTacToe V1's tictactoe*monitor*state: prints the board after every change, with X, O and blank for the cells' contents (`^shown`, an attribute used only by the monitor). Written by hand (JL, 6 Nov 2026: monitors are allowed as Raw).
sp {TicTacToe*elaborate*cell*shown*0
   (state <s> ^name TicTacToe ^cell <c>)
   (<c> ^content 0)
-->
   (<c> ^shown | |)
}
sp {TicTacToe*elaborate*cell*shown*1
   (state <s> ^name TicTacToe ^cell <c>)
   (<c> ^content 1)
-->
   (<c> ^shown |X|)
}
sp {TicTacToe*elaborate*cell*shown*2
   (state <s> ^name TicTacToe ^cell <c>)
   (<c> ^content 2)
-->
   (<c> ^shown |O|)
}
sp {TicTacToe*monitor*board
   (state <s> ^name TicTacToe ^cell <c11> <c21> <c31> <c12> <c22> <c32> <c13> <c23> <c33>)
   (<c11> ^x 1 ^y 1 ^shown <v11>)
   (<c21> ^x 2 ^y 1 ^shown <v21>)
   (<c31> ^x 3 ^y 1 ^shown <v31>)
   (<c12> ^x 1 ^y 2 ^shown <v12>)
   (<c22> ^x 2 ^y 2 ^shown <v22>)
   (<c32> ^x 3 ^y 2 ^shown <v32>)
   (<c13> ^x 1 ^y 3 ^shown <v13>)
   (<c23> ^x 2 ^y 3 ^shown <v23>)
   (<c33> ^x 3 ^y 3 ^shown <v33>)
-->
   (write (crlf) |     -------------| (crlf))
   (write |     \|| | | <v11> | | |\|| | | <v21> | | |\|| | | <v31> | | |\|| (crlf))
   (write |     \|---\|---\|---\|| (crlf))
   (write |     \|| | | <v12> | | |\|| | | <v22> | | |\|| | | <v32> | | |\|| (crlf))
   (write |     \|---\|---\|---\|| (crlf))
   (write |     \|| | | <v13> | | |\|| | | <v23> | | |\|| | | <v33> | | |\|| (crlf))
   (write |     -------------| (crlf))
}

