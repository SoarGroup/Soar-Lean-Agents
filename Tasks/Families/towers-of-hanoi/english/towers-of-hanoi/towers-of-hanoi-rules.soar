## Tower of Hanoi (families, from English): generated by spec_backend.py (WorldSpec, path B: Lean description, Python rules) from the instructor statements.
##
## Instructor statements used (numbers as in english-input.txt):
##  1. There are three pegs, A, B and C, and three disks of different sizes, all on peg A, largest at the bottom.
##  2. Move one disk at a time, taking only the top disk of a peg.
##  3. A disk is placed on an empty peg or on a larger disk; a disk may never rest on a smaller one.
##  4. The goal is to move the whole stack to another peg.
##
## Assumption ledger:
##   A-TH1: Each disk (small, medium, large) has a size (1, 2, 3) and an on relation to the peg it is on; the order within a peg follows from the sizes, since a disk never rests on a smaller one.
##   A-TH2: "the top disk of a peg": the smallest disk on its peg (no smaller disk on the same peg), a derived relation top(disk, peg).
##   A-TH3: "an empty peg or a larger disk": the target peg has no disk smaller than the moved one (its top disk, if any, is larger), a derived relation can-take(peg, disk). Negations stay in derived relations, which the operators test positively (W-CHK-009).
##   A-TH4: "another peg": peg C, read from the original agent's initialize rules (the English does not name it; JL allowed reading initial states there).
##   A-TH5: Search control, not from the English (as for the other WorldSpec search tasks): a look-ahead state that returns to a situation already on its path fails; a situation is where each disk is.
## Matching hints for learned rules (World-Conventions L3-095, L11-009): many-valued attributes, sized from the initial world.
production optimize-attribute object 7
production optimize-attribute on 3


## Propose initialize-towers-of-hanoi when its conditions below hold.
sp {towers-of-hanoi*propose*initialize-towers-of-hanoi
   (state <s> ^superstate nil ^world <w> -^name)
-->
   (<s> ^operator <o> + >)
   (<o> ^name initialize-towers-of-hanoi ^task-operator false)
}

sp {towers-of-hanoi*apply*initialize-towers-of-hanoi
   (state <s> ^operator.name initialize-towers-of-hanoi ^world <w>)
   (<w> ^objects <objs>)
-->
   (<s> ^name towers-of-hanoi ^desireds <ds>)
   (<objs> ^object <k-a> <k-b> <k-c> <k-small> <k-medium> <k-large> <k-task>)
   (<k-a> ^object-handle a ^anchored true ^type peg ^name a ^static true)
   (<k-b> ^object-handle b ^anchored true ^type peg ^name b ^static true)
   (<k-c> ^object-handle c ^anchored true ^type peg ^name c ^static true)
   (<k-small> ^object-handle small ^anchored true ^type disk ^name small ^size 1 ^static true)
   (<k-medium> ^object-handle medium ^anchored true ^type disk ^name medium ^size 2 ^static true)
   (<k-large> ^object-handle large ^anchored true ^type disk ^name large ^size 3 ^static true)
   (<k-task> ^object-handle task ^anchored true ^type task)
   (<ds> ^desired-count 1 ^desired <d1>)
   (<d1> ^object <d1-o>)
   (<d1-o> ^object-handle task ^goal-met true)
   (<w> ^on <rel-1>)
   (<rel-1> ^argument1 <k-small> ^argument2 <k-a>)
   (<w> ^on <rel-2>)
   (<rel-2> ^argument1 <k-medium> ^argument2 <k-a>)
   (<w> ^on <rel-3>)
   (<rel-3> ^argument1 <k-large> ^argument2 <k-a>)
   (log 1 (crlf) |Initialize towers-of-hanoi.|)
}

## Elaborate problem space: adds ^dont-copy-object-attribute, ^problem-space.
sp {towers-of-hanoi*elaborate*problem-space
   (state <s> ^name towers-of-hanoi)
-->
   (<s> ^problem-space <p>)
   (<p> ^name towers-of-hanoi ^dont-copy-object-attribute goal-met)
}

sp {towers-of-hanoi*elaborate*problem-space*mea-substate
   (state <s> ^impasse no-change ^attribute operator ^superstate <ss>)
   (<ss> ^problem-space.name towers-of-hanoi ^operator <so>)
   (<so> ^task-operator true -^pre-conditions-satisfied true)
-->
   (<s> ^problem-space <p>)
   (<p> ^name towers-of-hanoi ^dont-copy-object-attribute goal-met)
}

## Elaborate flags: adds ^flag-override, ^mea-operator-selection.
sp {towers-of-hanoi*elaborate*flags
   (state <s> ^superstate nil ^name towers-of-hanoi)
-->
   (<s> ^flag-override <f>)
   (<f> ^mea-operator-selection true)
}

## Achievement of object-property desireds (supplied by the task).
sp {towers-of-hanoi*elaborate*state*achieved*object-property
   (state <s> ^problem-space.name towers-of-hanoi ^desireds <ds> ^world <w>)
   (<ds> ^desired <d>)
   (<d> ^object <do>)
   (<do> ^object-handle <h> ^{ <> object-handle <a> } <v>)
   (<w> ^anchored-world true ^objects.object <ob>)
   (<ob> ^object-handle <h> ^<a> <v>)
-->
   (<ds> ^achieved <d>)
}

sp {towers-of-hanoi*elaborate*state*unachieved*object-property
   (state <s> ^problem-space.name towers-of-hanoi ^desireds <ds> ^world <w>)
   (<ds> ^desired <d>)
   (<d> ^object <do>)
   (<do> ^object-handle <h> ^{ <> object-handle <a> } <v>)
   (<w> ^anchored-world true)
  -{(<w> ^objects.object <ob>)
    (<ob> ^object-handle <h> ^<a> <v>)}
-->
   (<ds> ^unachieved <d>)
}

## Operator move-disk (statements 2, 3).
sp {towers-of-hanoi*propose*move-disk
   (state <s> ^problem-space.name towers-of-hanoi ^flags.mea-operator-selection true ^world <w> ^desireds <ds>)
   (<w> ^anchored-world true ^objects <objs>)
   (<objs> ^object <d>)
   (<d> ^type disk)
   (<objs> ^object <to>)
   (<to> ^type peg)
   (<w> ^top <r1>)
   (<r1> ^argument1 <d> ^argument2 <from>)
   (<w> ^can-take <r2>)
   (<r2> ^argument1 <to> ^argument2 <d>)
   (<objs> ^object { <> <from> <to> })
   (<ds> ^unachieved-desireds true)
-->
   (<s> ^operator <op> +)
   (<op> ^name move-disk ^task-operator true ^action-handle move-disk ^argument1 <d> ^argument2 <to> ^argument-count 2 ^pre-conditions-satisfied true)
}

## Effect of move-disk (look-ahead).
sp {towers-of-hanoi*apply*move-disk*internal
   (state <s> ^problem-space.name towers-of-hanoi ^operator <op> ^internal-actions true ^world <w>)
   (<op> ^task-operator true ^name move-disk ^pre-conditions-satisfied true ^argument1.object-handle $ <d-h> ^argument2.object-handle $ <to-h>)
   (<w> ^anchored-world true ^objects <objs>)
   (<objs> ^object <d>)
   (<d> ^object-handle $ <d-h>)
   (<objs> ^object <to>)
   (<to> ^object-handle $ <to-h>)
   (<w> ^on <r1>)
   (<r1> ^argument1 <d> ^argument2 <old>)
-->
   (<r1> ^argument2 <old> - <to>)
}

## Effect of a completed move-disk command on the real world (once per command).
sp {towers-of-hanoi*apply*move-disk*environment-effect
   :o-support
   (state <s> ^problem-space.name towers-of-hanoi ^superstate nil ^world <w> ^io.output-link.perform-action <pa>)
   (<pa> ^name move-disk ^status complete ^argument1 <d-h> ^argument2 <to-h> -^effect-applied true)
   (<w> ^anchored-world true ^objects <objs>)
   (<objs> ^object <d>)
   (<d> ^object-handle $ <d-h>)
   (<objs> ^object <to>)
   (<to> ^object-handle $ <to-h>)
   (<w> ^on <r1>)
   (<r1> ^argument1 <d> ^argument2 <old>)
-->
   (<r1> ^argument2 <old> - <to>)
   (<pa> ^effect-applied true)
   (write |Move disk | <d-h> | to peg | <to-h> (crlf))
}

## Derived relation top (statement 2): recomputed in every world, never copied into look-ahead.
sp {towers-of-hanoi*elaborate*derived*top
   (state <s> ^problem-space.name towers-of-hanoi ^world <w>)
   (<w> ^anchored-world true ^objects <objs>)
   (<objs> ^object <d>)
   (<d> ^type disk)
   (<w> ^on <r1>)
   (<r1> ^argument1 <d> ^argument2 <p>)
  -{  (<objs> ^object <e>)
  (<e> ^type disk)
  (<w> ^on <r2>)
  (<r2> ^argument1 <e> ^argument2 <p>)
  (<d> ^size <d-size>)
  (<e> ^size < <d-size>)}
-->
   (<w> ^top <dr>)
   (<dr> ^argument1 <d> ^argument2 <p>)
}

## Derived relation can-take (statement 3): recomputed in every world, never copied into look-ahead.
sp {towers-of-hanoi*elaborate*derived*can-take
   (state <s> ^problem-space.name towers-of-hanoi ^world <w>)
   (<w> ^anchored-world true ^objects <objs>)
   (<objs> ^object <q>)
   (<q> ^type peg)
   (<objs> ^object <d>)
   (<d> ^type disk)
  -{  (<objs> ^object <f>)
  (<f> ^type disk)
  (<w> ^on <r1>)
  (<r1> ^argument1 <f> ^argument2 <q>)
  (<d> ^size <d-size>)
  (<f> ^size < <d-size>)}
-->
   (<w> ^can-take <dr>)
   (<dr> ^argument1 <q> ^argument2 <d>)
}

## Goal (statement 4): ^goal-met true on the task object.
sp {towers-of-hanoi*elaborate*goal
   (state <s> ^problem-space.name towers-of-hanoi ^world <w>)
   (<w> ^anchored-world true ^objects <objs>)
   (<objs> ^object <task>)
   (<task> ^type task)
   (<objs> ^object <x-small>)
   (<x-small> ^object-handle small)
   (<objs> ^object <k-c>)
   (<k-c> ^object-handle c)
   (<w> ^on <r1>)
   (<r1> ^argument1 <x-small> ^argument2 <k-c>)
   (<objs> ^object <x-medium>)
   (<x-medium> ^object-handle medium)
   (<w> ^on <r2>)
   (<r2> ^argument1 <x-medium> ^argument2 <k-c>)
   (<objs> ^object <x-large>)
   (<x-large> ^object-handle large)
   (<w> ^on <r3>)
   (<r3> ^argument1 <x-large> ^argument2 <k-c>)
-->
   (<task> ^goal-met true)
}

## ---- Search control (stated in the description, not taught): a look-ahead state that returns to a situation on
## its look-ahead path fails, and the library rejects it. Situation: where each disk is (on).
sp {towers-of-hanoi*elaborate*ancestor-world*parent
   (state <s> ^name evaluate-operator ^superstate.superstate.world <aw>)
-->
   (<s> ^ancestor-world <aw>)
}

sp {towers-of-hanoi*elaborate*ancestor-world*inherited
   (state <s> ^name evaluate-operator ^superstate.superstate.ancestor-world <aw>)
-->
   (<s> ^ancestor-world <aw>)
}

## Elaborate failure repeated situation: adds ^failure.
sp {towers-of-hanoi*elaborate*failure*repeated-situation
   (state <s> ^name evaluate-operator ^look-ahead-operator <o> ^ancestor-world <aw> ^desireds <ds> ^world <w>)
   (<w> ^anchored-world true ^versioned-operator <o>)
  -{(<w> ^on <r>)
    (<r> ^argument1 <x> ^argument2 <p>)
    (<x> ^type << disk >> ^object-handle <h>)
    (<p> ^object-handle <ph>)
    (<aw> ^on <ar>)
    (<ar> ^argument1 <ax> ^argument2 <ap>)
    (<ax> ^object-handle <h>)
    (<ap> ^object-handle <> <ph>)}
-->
   (<s> ^failure <ds>)
}
