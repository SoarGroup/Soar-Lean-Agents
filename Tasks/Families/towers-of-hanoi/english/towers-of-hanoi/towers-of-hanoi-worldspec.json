{
  "format": "worldspec-1",
  "name": "towers-of-hanoi",
  "title": "Tower of Hanoi (families, from English)",
  "statements": [
    [
      1,
      "There are three pegs, A, B and C, and three disks of different sizes, all on peg A, largest at the bottom."
    ],
    [
      2,
      "Move one disk at a time, taking only the top disk of a peg."
    ],
    [
      3,
      "A disk is placed on an empty peg or on a larger disk; a disk may never rest on a smaller one."
    ],
    [
      4,
      "The goal is to move the whole stack to another peg."
    ]
  ],
  "assumptions": [
    {
      "id": "A-TH1",
      "kind": "intent",
      "text": "Each disk (small, medium, large) has a size (1, 2, 3) and an on relation to the peg it is on; the order within a peg follows from the sizes, since a disk never rests on a smaller one.",
      "stmts": [
        1
      ]
    },
    {
      "id": "A-TH2",
      "kind": "intent",
      "text": "\"the top disk of a peg\": the smallest disk on its peg (no smaller disk on the same peg), a derived relation top(disk, peg).",
      "stmts": [
        2
      ]
    },
    {
      "id": "A-TH3",
      "kind": "intent",
      "text": "\"an empty peg or a larger disk\": the target peg has no disk smaller than the moved one (its top disk, if any, is larger), a derived relation can-take(peg, disk). Negations stay in derived relations, which the operators test positively (W-CHK-009).",
      "stmts": [
        3
      ]
    },
    {
      "id": "A-TH4",
      "kind": "intent",
      "text": "\"another peg\": peg C, read from the original agent's initialize rules (the English does not name it; JL allowed reading initial states there).",
      "stmts": [
        4
      ]
    },
    {
      "id": "A-TH5",
      "kind": "intent",
      "text": "Search control, not from the English (as for the other WorldSpec search tasks): a look-ahead state that returns to a situation already on its path fails; a situation is where each disk is.",
      "stmts": []
    }
  ],
