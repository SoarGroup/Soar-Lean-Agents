}

sp {towers-of-hanoi*elaborate*operator-subgoal*share*holds
   (state <s> ^type operator-subgoal)
   (<s> ^superstate <ss>)
   (<ss> ^holds <x>)
-->
   (<s> ^holds <x>)
}

sp {towers-of-hanoi*elaborate*operator-subgoal*share*control
   (state <s> ^type operator-subgoal)
