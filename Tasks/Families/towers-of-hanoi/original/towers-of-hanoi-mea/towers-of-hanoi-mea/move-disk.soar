   (<target> ^name <kt5>)
   (<h> ^size { <h-size> <= 5 })
   (<h> ^on <src>)
   -{ (<s> ^holds <none8>) (<none8> ^size > <h-size>) (<none8> ^size <= 5) (<none8> ^on <> <target>) }
-->
   (<s> ^operator <o> +)
   (<s> ^operator <o> =)
   (<o> ^name move-disk)
   (<o> ^h <h>)
   (<o> ^d <d>)
   (<o> ^src <src>)
   (<o> ^target <target>)
   (<o> ^hd <hd>)
   (<o> ^dd <dd>)
}

