
sp {towers-of-hanoi*propose*move-disk*1
   (state <s> ^name towers-of-hanoi)
   (<s> ^holds <h>)
   (<s> ^disk <d>)
   (<s> ^peg <src>)
   (<s> ^peg { <target> <> <src> })
   (<s> ^holds <hd>)
   (<s> ^disk <dd>)
   (<h> ^disk <d>)
   (<hd> ^disk <dd>)
   (<h> ^disk <dd>)
   (<s> ^desired <des5>)
