sp {towers-of-hanoi*apply*move-disk
   (state <s> ^name towers-of-hanoi)
   (<s> ^operator <o>)
   (<o> ^name move-disk)
   (<o> ^h <h>)
   (<o> ^d <d>)
   (<o> ^src <src>)
   (<o> ^target <target>)
   (<o> ^hd <hd>)
   (<o> ^dd <dd>)
   (<s> ^holds <t>)
   (<s> ^disk <td>)
   (<t> ^disk <td>)
   (<h> ^on <h-on>)
   (<h> ^above <h-above>)
   (<d> ^size <d-size>)
   (<target> ^name <target-name>)
   (<t> ^on <target>)
   (<td> ^size { <td-size> > <d-size> })
   -{ (<s> ^holds <none1>) (<none1> ^above <d>) }
   -{ (<s> ^holds <none4>) (<none4> ^above <td>) }
-->
   (<h> ^on <target>)
   (<h> ^on <h-on> -)
   (<h> ^above <td>)
   (<h> ^above <h-above> -)
   (write |Move Disk: | <d-size> | to peg | <target-name>)
}
