
sp {towers-of-hanoi*elaborate*goal*success
   (state <s> ^name towers-of-hanoi)
   (<s> ^desired <d>)
   (<d> ^holds <dx0>)
   (<dx0> ^name |h1|)
   (<dx0> ^on <dt0>)
   (<dt0> ^name <tn0>)
   (<s> ^holds <x0>)
   (<x0> ^name |h1|)
   (<x0> ^on <t0>)
   (<t0> ^name <tn0>)
   (<d> ^holds <dx1>)
   (<dx1> ^name |h2|)
   (<dx1> ^on <dt1>)
   (<dt1> ^name <tn1>)
   (<s> ^holds <x1>)
   (<x1> ^name |h2|)
   (<x1> ^on <t1>)
   (<t1> ^name <tn1>)
   (<d> ^holds <dx2>)
   (<dx2> ^name |h3|)
   (<dx2> ^on <dt2>)
   (<dt2> ^name <tn2>)
   (<s> ^holds <x2>)
   (<x2> ^name |h3|)
   (<x2> ^on <t2>)
   (<t2> ^name <tn2>)
   (<d> ^holds <dx3>)
   (<dx3> ^name |h4|)
   (<dx3> ^on <dt3>)
   (<dt3> ^name <tn3>)
   (<s> ^holds <x3>)
   (<x3> ^name |h4|)
   (<x3> ^on <t3>)
   (<t3> ^name <tn3>)
   (<d> ^holds <dx4>)
   (<dx4> ^name |h5|)
   (<dx4> ^on <dt4>)
   (<dt4> ^name <tn4>)
   (<s> ^holds <x4>)
   (<x4> ^name |h5|)
   (<x4> ^on <t4>)
   (<t4> ^name <tn4>)
-->
   (<s> ^success <d>)
}

sp {towers-of-hanoi*halt*goal*success
   (state <s> ^superstate nil)
   (<s> ^desired <d>)
   (<s> ^success <d>)
-->
   (write (crlf) |The problem has been solved.|)
   (halt)
}
