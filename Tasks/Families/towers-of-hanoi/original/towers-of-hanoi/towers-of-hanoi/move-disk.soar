
sp {towers-of-hanoi*propose*move-disk*1
   (state <s> ^name towers-of-hanoi)
   (<s> ^holds <h>)
   (<s> ^disk <d>)
   (<s> ^holds <t>)
   (<s> ^disk <td>)
   (<s> ^peg <src>)
   (<s> ^peg { <target> <> <src> })
   (<s> ^control <control>)
   (<h> ^disk <d>)
   (<t> ^disk <td>)
   (<d> ^size { <d-size> <= 5 })
   (<d> ^size 1)
   (<h> ^on <src>)
   (<t> ^on <target>)
   (<td> ^size { <td-size> > <d-size> })
   (<control> ^lastsize { <control-lastsize> <> 1 })
   (<control> ^lastpeg { <control-lastpeg> <> <target> })
   -{ (<s> ^holds <none6>) (<none6> ^above <d>) }
   -{ (<s> ^holds <none8>) (<none8> ^above <td>) }
-->
   (<s> ^operator <o> +)
   (<s> ^operator <o> =)
   (<o> ^name move-disk)
   (<o> ^h <h>)
   (<o> ^d <d>)
   (<o> ^t <t>)
   (<o> ^td <td>)
   (<o> ^src <src>)
   (<o> ^target <target>)
   (<o> ^control <control>)
}

sp {towers-of-hanoi*propose*move-disk*2
   (state <s> ^name towers-of-hanoi)
   (<s> ^holds <h>)
   (<s> ^disk <d>)
   (<s> ^holds <t>)
   (<s> ^disk <td>)
   (<s> ^peg <src>)
   (<s> ^peg { <target> <> <src> })
   (<s> ^control <control>)
   (<h> ^disk <d>)
   (<t> ^disk <td>)
   (<d> ^size { <d-size> <= 5 > 1 })
   (<h> ^on <src>)
   (<t> ^on <target>)
   (<td> ^size { <td-size> > <d-size> })
   (<control> ^lastsize 1)
   -{ (<s> ^holds <none6>) (<none6> ^above <d>) }
   -{ (<s> ^holds <none8>) (<none8> ^above <td>) }
-->
   (<s> ^operator <o> +)
   (<s> ^operator <o> =)
   (<o> ^name move-disk)
   (<o> ^h <h>)
   (<o> ^d <d>)
   (<o> ^t <t>)
   (<o> ^td <td>)
   (<o> ^src <src>)
   (<o> ^target <target>)
   (<o> ^control <control>)
}

sp {towers-of-hanoi*apply*move-disk*case1
   (state <s> ^name towers-of-hanoi)
   (<s> ^operator <o>)
   (<o> ^name move-disk)
   (<o> ^h <h>)
   (<o> ^d <d>)
   (<o> ^t <t>)
   (<o> ^td <td>)
   (<o> ^src <src>)
   (<o> ^target <target>)
   (<o> ^control <control>)
   (<h> ^on <h-on>)
   (<h> ^above <h-above>)
   (<control> ^lastsize <control-lastsize>)
   (<d> ^size <d-size>)
   (<d> ^size 1)
   (<control> ^lastpeg <control-lastpeg>)
   (<target> ^name <target-name>)
-->
   (<h> ^on <target>)
   (<h> ^on <h-on> -)
   (<h> ^above <td>)
   (<h> ^above <h-above> -)
   (<control> ^lastsize <d-size>)
   (<control> ^lastsize <control-lastsize> -)
   (<control> ^lastpeg <src>)
   (<control> ^lastpeg <control-lastpeg> -)
   (write |Move Disk: | <d-size> | to peg | <target-name>)
}

sp {towers-of-hanoi*apply*move-disk*case2
   (state <s> ^name towers-of-hanoi)
   (<s> ^operator <o>)
   (<o> ^name move-disk)
   (<o> ^h <h>)
   (<o> ^d <d>)
   (<o> ^t <t>)
   (<o> ^td <td>)
   (<o> ^src <src>)
   (<o> ^target <target>)
   (<o> ^control <control>)
   (<h> ^on <h-on>)
   (<h> ^above <h-above>)
   (<control> ^lastsize <control-lastsize>)
   (<d> ^size { <d-size> > 1 })
   (<target> ^name <target-name>)
-->
   (<h> ^on <target>)
   (<h> ^on <h-on> -)
   (<h> ^above <td>)
   (<h> ^above <h-above> -)
   (<control> ^lastsize <d-size>)
   (<control> ^lastsize <control-lastsize> -)
   (write |Move Disk: | <d-size> | to peg | <target-name>)
}
