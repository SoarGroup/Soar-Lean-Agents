   (<w> ^anchored-world true ^objects <objs>)
   (<objs> ^jug <a>)
   (<a> ^object-handle $ <a-h>)
   (<objs> ^jug <b>)
   (<b> ^object-handle $ <b-h>)
   (<a> ^amount <a-amount>)
   (<b> ^room <b-room>)
   (<a> ^room <a-room>)
   (<b> ^amount <b-amount>)
   (<b> ^capacity <b-capacity>)
-->
   (<a> ^amount <a-amount> - (- <a-amount> <b-room>))
   (<a> ^room <a-room> - (+ <a-room> <b-room>))
   (<b> ^amount <b-amount> - <b-capacity>)
   (<b> ^room <b-room> - 0)
   (<pa> ^effect-applied true)
   (write |Pour the | <a-h> | jug into the | <b-h> | jug until it is full| (crlf))
}

