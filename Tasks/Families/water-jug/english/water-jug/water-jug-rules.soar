## Operator pour-all (statement 3).
sp {water-jug*propose*pour-all
   (state <s> ^problem-space.name water-jug ^flags.mea-operator-selection true ^world <w> ^desireds <ds>)
   (<w> ^anchored-world true ^objects <objs>)
   (<objs> ^jug <a>)
   (<objs> ^jug <b>)
   (<objs> ^jug { <> <a> <b> })
   (<a> ^amount > 0)
   (<b> ^room <b-room>)
   (<a> ^amount <= <b-room>)
   (<ds> ^unachieved-desireds true)
-->
   (<s> ^operator <op> +)
   (<op> ^name pour-all ^task-operator true ^action-handle pour-all ^argument1 <a> ^argument2 <b> ^argument-count 2 ^pre-conditions-satisfied true)
}

## Effect of pour-all (look-ahead).
sp {water-jug*apply*pour-all*internal
   (state <s> ^problem-space.name water-jug ^operator <op> ^internal-actions true ^world <w>)
   (<op> ^task-operator true ^name pour-all ^pre-conditions-satisfied true ^argument1.object-handle $ <a-h> ^argument2.object-handle $ <b-h>)
   (<w> ^anchored-world true ^objects <objs>)
   (<objs> ^jug <a>)
   (<a> ^object-handle $ <a-h>)
   (<objs> ^jug <b>)
   (<b> ^object-handle $ <b-h>)
   (<b> ^amount <b-amount>)
   (<a> ^amount <a-amount>)
   (<b> ^room <b-room>)
   (<a> ^room <a-room>)
   (<a> ^capacity <a-capacity>)
-->
   (<b> ^amount <b-amount> - (+ <b-amount> <a-amount>))
   (<b> ^room <b-room> - (- <b-room> <a-amount>))
   (<a> ^amount <a-amount> - 0)
   (<a> ^room <a-room> - <a-capacity>)
}

## Effect of a completed pour-all command on the real world (once per command).
sp {water-jug*apply*pour-all*environment-effect
   :o-support
   (state <s> ^problem-space.name water-jug ^superstate nil ^world <w> ^io.output-link.perform-action <pa>)
   (<pa> ^name pour-all ^status complete ^argument1 <a-h> ^argument2 <b-h> -^effect-applied true)
   (<w> ^anchored-world true ^objects <objs>)
   (<objs> ^jug <a>)
   (<a> ^object-handle $ <a-h>)
   (<objs> ^jug <b>)
   (<b> ^object-handle $ <b-h>)
   (<b> ^amount <b-amount>)
   (<a> ^amount <a-amount>)
   (<b> ^room <b-room>)
   (<a> ^room <a-room>)
   (<a> ^capacity <a-capacity>)
-->
   (<b> ^amount <b-amount> - (+ <b-amount> <a-amount>))
   (<b> ^room <b-room> - (- <b-room> <a-amount>))
   (<a> ^amount <a-amount> - 0)
   (<a> ^room <a-room> - <a-capacity>)
   (<pa> ^effect-applied true)
   (write |Pour the | <a-h> | jug into the | <b-h> | jug until it is empty| (crlf))
}

## Operator pour-until-full (statement 3).
sp {water-jug*propose*pour-until-full
   (state <s> ^problem-space.name water-jug ^flags.mea-operator-selection true ^world <w> ^desireds <ds>)
   (<w> ^anchored-world true ^objects <objs>)
   (<objs> ^jug <a>)
   (<objs> ^jug <b>)
   (<objs> ^jug { <> <a> <b> })
   (<b> ^room > 0)
   (<b> ^room <b-room>)
   (<a> ^amount > <b-room>)
   (<ds> ^unachieved-desireds true)
-->
   (<s> ^operator <op> +)
   (<op> ^name pour-until-full ^task-operator true ^action-handle pour-until-full ^argument1 <a> ^argument2 <b> ^argument-count 2 ^pre-conditions-satisfied true)
}

## Effect of pour-until-full (look-ahead).
sp {water-jug*apply*pour-until-full*internal
   (state <s> ^problem-space.name water-jug ^operator <op> ^internal-actions true ^world <w>)
   (<op> ^task-operator true ^name pour-until-full ^pre-conditions-satisfied true ^argument1.object-handle $ <a-h> ^argument2.object-handle $ <b-h>)
   (<w> ^anchored-world true ^objects <objs>)
   (<objs> ^jug <a>)
   (<a> ^object-handle $ <a-h>)
   (<objs> ^jug <b>)
   (<b> ^object-handle $ <b-h>)
   (<a> ^amount <a-amount>)
   (<b> ^room <b-room>)
   (<a> ^room <a-room>)
   (<b> ^amount <b-amount>)
   (<b> ^capacity <b-capacity>)
-->
   (<a> ^amount <a-amount> - (- <a-amount> <b-room>))
   (<a> ^room <a-room> - (+ <a-room> <b-room>))
   (<b> ^amount <b-amount> - <b-capacity>)
   (<b> ^room <b-room> - 0)
}

