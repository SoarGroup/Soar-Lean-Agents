## Water jug (families, from English): generated by spec_backend.py (WorldSpec, path B: Lean description, Python rules) from the instructor statements.
##
## Instructor statements used (numbers as in english-input.txt):
##  1. You have two unmarked jugs, one holding 3 gallons and one holding 5 gallons, both empty, and an unlimited supply of water.
##  2. In one step you may fill a jug completely or empty a jug completely.
##  3. In one step you may pour from one jug into the other until the receiving jug is full or the pouring jug is empty.
##  4. The goal is to end with exactly 1 gallon in the 3-gallon jug.
##
## Assumption ledger:
##   A-WJ1: Two jug objects, three-gallon and five-gallon, with a capacity and the amount of water in them (both 0 at the start). The supply of water is not an object: fill needs nothing.
##   A-WJ2: Pouring needs the amount that fits in the receiving jug, room = capacity - amount, in a condition, where arithmetic cannot be compiled; so each jug keeps room as a property beside its amount, and every operator updates both (with minus, added to WorldSpec 26 Nov 2026; the first version kept negated copies of the amounts, since WorldSpec then had only addition).
##   A-WJ3: "until the receiving jug is full or the pouring jug is empty": two operators. pour-all when the pouring jug's amount fits in the room of the other (the pouring jug ends empty); pour-until-full when it is more than the room (the receiving jug ends full and the rest stays behind).
##   A-WJ4: Filling a full jug or emptying an empty one changes nothing, so fill needs room in the jug and empty needs water in it.
##   A-WJ5: No repeated-situation control: it compares relations, and the amounts are numbers on the jugs. The look-ahead's depth limit bounds the search.
## Matching hints for learned rules (World-Conventions L3-095, L11-009): many-valued attributes, sized from the initial world.
production optimize-attribute jug 3
production optimize-attribute task 3
production optimize-attribute object 3


## Propose initialize-water-jug when its conditions below hold.
sp {water-jug*propose*initialize-water-jug
   (state <s> ^superstate nil ^world <w> -^name)
-->
   (<s> ^operator <o> + >)
   (<o> ^name initialize-water-jug ^task-operator false)
}

sp {water-jug*apply*initialize-water-jug
   (state <s> ^operator.name initialize-water-jug ^world <w>)
   (<w> ^objects <objs>)
-->
   (<s> ^name water-jug ^desireds <ds>)
   (<objs> ^jug <k-three-gallon> <k-five-gallon> ^task <k-task>)
   (<k-three-gallon> ^object-handle three-gallon ^anchored true ^type jug ^name three-gallon ^capacity 3 ^amount 0 ^room 3)
   (<k-five-gallon> ^object-handle five-gallon ^anchored true ^type jug ^name five-gallon ^capacity 5 ^amount 0 ^room 5)
   (<k-task> ^object-handle task ^anchored true ^type task)
   (<ds> ^desired-count 1 ^desired <d1>)
   (<d1> ^object <d1-o>)
   (<d1-o> ^object-handle task ^goal-met true)

   (log 1 (crlf) |Initialize water-jug.|)
}

## Elaborate problem space: adds ^dont-copy-object-attribute, ^problem-space.
sp {water-jug*elaborate*problem-space
   (state <s> ^name water-jug)
-->
   (<s> ^problem-space <p>)
   (<p> ^name water-jug ^dont-copy-object-attribute goal-met)
}

sp {water-jug*elaborate*problem-space*mea-substate
   (state <s> ^impasse no-change ^attribute operator ^superstate <ss>)
   (<ss> ^problem-space.name water-jug ^operator <so>)
   (<so> ^task-operator true -^pre-conditions-satisfied true)
-->
   (<s> ^problem-space <p>)
   (<p> ^name water-jug ^dont-copy-object-attribute goal-met)
}

## Elaborate flags: adds ^flag-override, ^mea-operator-selection.
sp {water-jug*elaborate*flags
   (state <s> ^superstate nil ^name water-jug)
-->
   (<s> ^flag-override <f>)
   (<f> ^mea-operator-selection true)
}

## Achievement of object-property desireds (supplied by the task).
sp {water-jug*elaborate*state*achieved*object-property
   (state <s> ^problem-space.name water-jug ^desireds <ds> ^world <w>)
   (<ds> ^desired <d>)
   (<d> ^object <do>)
   (<do> ^object-handle <h> ^{ <> object-handle <a> } <v>)
   (<w> ^anchored-world true ^objects.object <ob>)
   (<ob> ^object-handle <h> ^<a> <v>)
-->
   (<ds> ^achieved <d>)
}

sp {water-jug*elaborate*state*unachieved*object-property
   (state <s> ^problem-space.name water-jug ^desireds <ds> ^world <w>)
   (<ds> ^desired <d>)
   (<d> ^object <do>)
   (<do> ^object-handle <h> ^{ <> object-handle <a> } <v>)
   (<w> ^anchored-world true)
  -{(<w> ^objects.object <ob>)
    (<ob> ^object-handle <h> ^<a> <v>)}
-->
   (<ds> ^unachieved <d>)
}

## Operator fill (statements 1, 2).
sp {water-jug*propose*fill
   (state <s> ^problem-space.name water-jug ^flags.mea-operator-selection true ^world <w> ^desireds <ds>)
   (<w> ^anchored-world true ^objects <objs>)
   (<objs> ^jug <j>)
   (<j> ^room > 0)
   (<ds> ^unachieved-desireds true)
-->
   (<s> ^operator <op> +)
   (<op> ^name fill ^task-operator true ^action-handle fill ^argument1 <j> ^argument-count 1 ^pre-conditions-satisfied true)
}

## Effect of fill (look-ahead).
sp {water-jug*apply*fill*internal
   (state <s> ^problem-space.name water-jug ^operator <op> ^internal-actions true ^world <w>)
   (<op> ^task-operator true ^name fill ^pre-conditions-satisfied true ^argument1.object-handle $ <j-h>)
   (<w> ^anchored-world true ^objects <objs>)
   (<objs> ^jug <j>)
   (<j> ^object-handle $ <j-h>)
   (<j> ^amount <j-amount>)
   (<j> ^capacity <j-capacity>)
   (<j> ^room <j-room>)
-->
   (<j> ^amount <j-amount> - <j-capacity>)
   (<j> ^room <j-room> - 0)
}

## Effect of a completed fill command on the real world (once per command).
sp {water-jug*apply*fill*environment-effect
   :o-support
   (state <s> ^problem-space.name water-jug ^superstate nil ^world <w> ^io.output-link.perform-action <pa>)
   (<pa> ^name fill ^status complete ^argument1 <j-h> -^effect-applied true)
   (<w> ^anchored-world true ^objects <objs>)
   (<objs> ^jug <j>)
   (<j> ^object-handle $ <j-h>)
   (<j> ^amount <j-amount>)
   (<j> ^capacity <j-capacity>)
   (<j> ^room <j-room>)
-->
   (<j> ^amount <j-amount> - <j-capacity>)
   (<j> ^room <j-room> - 0)
   (<pa> ^effect-applied true)
   (write |Fill the | <j-h> | jug| (crlf))
}

