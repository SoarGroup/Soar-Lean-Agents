{
  "format": "worldspec-1",
  "name": "water-jug",
  "title": "Water jug (families, from English)",
  "statements": [
    [
      1,
      "You have two unmarked jugs, one holding 3 gallons and one holding 5 gallons, both empty, and an unlimited supply of water."
    ],
    [
      2,
      "In one step you may fill a jug completely or empty a jug completely."
    ],
    [
      3,
      "In one step you may pour from one jug into the other until the receiving jug is full or the pouring jug is empty."
    ],
    [
      4,
      "The goal is to end with exactly 1 gallon in the 3-gallon jug."
    ]
  ],
  "assumptions": [
    {
      "id": "A-WJ1",
      "kind": "intent",
      "text": "Two jug objects, three-gallon and five-gallon, with a capacity and the amount of water in them (both 0 at the start). The supply of water is not an object: fill needs nothing.",
      "stmts": [
        1
      ]
    },
    {
      "id": "A-WJ2",
      "kind": "intent",
      "text": "Pouring needs the amount that fits in the receiving jug, room = capacity - amount, in a condition, where arithmetic cannot be compiled; so each jug keeps room as a property beside its amount, and every operator updates both (with minus, added to WorldSpec 26 Nov 2026; the first version kept negated copies of the amounts, since WorldSpec then had only addition).",
      "stmts": [
        2,
        3
      ]
    },
    {
      "id": "A-WJ3",
      "kind": "intent",
      "text": "\"until the receiving jug is full or the pouring jug is empty\": two operators. pour-all when the pouring jug's amount fits in the room of the other (the pouring jug ends empty); pour-until-full when it is more than the room (the receiving jug ends full and the rest stays behind).",
      "stmts": [
        3
      ]
    },
    {
      "id": "A-WJ4",
      "kind": "intent",
      "text": "Filling a full jug or emptying an empty one changes nothing, so fill needs room in the jug and empty needs water in it.",
      "stmts": [
        2
      ]
    },
    {
      "id": "A-WJ5",
      "kind": "intent",
      "text": "No repeated-situation control: it compares relations, and the amounts are numbers on the jugs. The look-ahead's depth limit bounds the search.",
      "stmts": []
    }
  ],
