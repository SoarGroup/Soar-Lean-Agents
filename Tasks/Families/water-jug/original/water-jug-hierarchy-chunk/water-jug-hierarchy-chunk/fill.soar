
sp {water-jug*elaborate*fill-relevant*1
   (state <s> ^name water-jug)
   (<s> ^jug <jug>)
   (<jug> ^free { <jug-free> > 0 })
-->
   (<s> ^fill-relevant <jug>)
}

sp {water-jug*elaborate*fill-relevant*2
   (state <s> ^name water-jug)
   (<s> ^jug <jug>)
   (<jug> ^free { <jug-free> <= 0 })
   (<s> ^holding <jug>)
-->
   (<s> ^fill-relevant <jug>)
}

sp {water-jug*propose*fill
   (state <s> ^name water-jug)
   (<s> ^fill-relevant <jug>)
-->
   (<s> ^operator <o> +)
   (<s> ^operator <o> =)
   (<o> ^name fill)
   (<o> ^jug <jug>)
}
