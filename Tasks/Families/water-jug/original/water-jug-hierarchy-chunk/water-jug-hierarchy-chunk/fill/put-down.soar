
sp {fill*propose*put-down
   (state <s> ^name fill)
   (<s> ^superstate <ss>)
   (<s> ^jug <jug>)
   (<jug> ^free { <jug-free> <= 0 })
   (<ss> ^holding <jug>)
-->
   (<s> ^operator <o> +)
   (<s> ^operator <o> =)
   (<o> ^name put-down)
}

sp {fill*apply*put-down
   (state <s> ^name fill)
   (<s> ^superstate <ss>)
   (<s> ^jug <jug>)
   (<s> ^operator <o>)
   (<o> ^name put-down)
   (<ss> ^holding <holding-old>)
-->
   (<ss> ^holding <holding-old> -)
}
