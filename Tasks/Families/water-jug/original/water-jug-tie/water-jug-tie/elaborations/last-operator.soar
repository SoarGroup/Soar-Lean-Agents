
sp {water-jug*apply*record*last-operator
   (state <s> ^name water-jug)
   (<s> ^operator <o>)
   (<o> ^name { <n> <> initialize-water-jug })
-->
   (<s> ^last-operator <n>)
}

sp {water-jug*apply*remove*last-operator
   (state <s> ^name water-jug)
   (<s> ^last-operator <l>)
   (<s> ^operator <o>)
   (<o> ^name { <n> <> <l> <> initialize-water-jug })
-->
   (<s> ^last-operator <l> -)
}
