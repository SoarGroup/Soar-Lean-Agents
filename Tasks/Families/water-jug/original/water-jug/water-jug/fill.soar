
sp {water-jug*propose*fill
   (state <s> ^name water-jug)
   (<s> ^jug <jug>)
   (<jug> ^free { <jug-free> > 0 })
-->
   (<s> ^operator <o> +)
   (<s> ^operator <o> =)
   (<o> ^name fill)
   (<o> ^jug <jug>)
}

sp {water-jug*apply*fill
   (state <s> ^name water-jug)
   (<s> ^operator <o>)
   (<o> ^name fill)
   (<o> ^jug <jug>)
   (<jug> ^contents <jug-contents>)
   (<jug> ^volume <jug-volume>)
-->
   (<jug> ^contents <jug-volume>)
   (<jug> ^contents <jug-contents> -)
}
