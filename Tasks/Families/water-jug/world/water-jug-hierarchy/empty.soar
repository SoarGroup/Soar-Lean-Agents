## empty <jug>: proposed when the jug has contents > 0, indifferent.

sp {water-jug*propose*empty
   (state <s> ^problem-space.name water-jug
              ^world <w>
              ^desireds.desired <d>)
   (<w> ^anchored-world true
        ^objects.object <jug>)
   (<jug> ^contents > 0)
-->
   (<s> ^operator <o> + =)
   (<o> ^name empty
        ^task-operator true
        ^action-handle empty
        ^super-desired <d>
        ^argument1 <jug>
        ^argument-count 1
        ^desireds <pre>)
   (<pre> ^desired-count 0)
}

sp {water-jug*apply*empty*internal
   (state <s> ^operator <o>
              ^internal-actions true
              ^world.objects.object <jug>)
   (<o> ^name empty
        ^pre-conditions-satisfied true
        ^argument1.object-handle $ <h>)
   (<jug> ^object-handle $ <h>
          ^contents { > 0 <c> })
-->
   (log 1 (crlf) |Apply empty: | <h>)
   (<jug> ^contents <c> - 0)
}
