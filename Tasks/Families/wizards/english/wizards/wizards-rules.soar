sp {wizards*apply*ask*environment-effect*each3
   :o-support
   (state <s> ^problem-space.name wizards ^superstate nil ^world <w> ^io.output-link.perform-action <pa>)
   (<pa> ^name ask ^status complete ^argument1 <r-h> -^effect-applied true)
   (<w> ^anchored-world true ^objects <objs>)
   (<objs> ^object <r>)
   (<r> ^object-handle $ <r-h>)
   (<objs> ^object <t>)
   (<t> ^type stage)
   (<w> ^answer-differs-too <r1>)
   (<r1> ^argument1 <pw> ^argument2 <r>)
-->
   (<w> ^out-at <new-2>)
   (<new-2> ^argument1 <pw> ^argument2 <r>)
}

## Derived relation all-black (statement 3): recomputed in every world, never copied into look-ahead.
sp {wizards*elaborate*derived*all-black
   (state <s> ^problem-space.name wizards ^world <w>)
   (<w> ^anchored-world true ^objects <objs>)
   (<objs> ^object <pw>)
   (<pw> ^type world)
  -{  (<objs> ^object <k-white>)
  (<k-white> ^object-handle white)
  (<w> ^spot <r1>)
  (<r1> ^argument1 <c> ^argument2 <pw> ^argument3 <k-white>)}
-->
   (<w> ^all-black <dr>)
   (<dr> ^argument1 <pw>)
}

## Derived relation live-at (statements 3, 4, 5): recomputed in every world, never copied into look-ahead.
sp {wizards*elaborate*derived*live-at
   (state <s> ^problem-space.name wizards ^world <w>)
   (<w> ^anchored-world true ^objects <objs>)
   (<objs> ^object <pw>)
   (<pw> ^type world)
   (<objs> ^object <r>)
   (<r> ^type turn)
  -{  (<w> ^out-at <r1>)
  (<r1> ^argument1 <pw> ^argument2 <earlier>)
  (<r> ^n <r-n>)
  (<earlier> ^n < <r-n>)}
-->
   (<w> ^live-at <dr>)
   (<dr> ^argument1 <pw> ^argument2 <r>)
}

## Derived relation knows-at (statements 1, 4, 5): recomputed in every world, never copied into look-ahead.
sp {wizards*elaborate*derived*knows-at
   (state <s> ^problem-space.name wizards ^world <w>)
   (<w> ^anchored-world true ^objects <objs>)
   (<objs> ^object <c>)
   (<c> ^type wizard)
   (<w> ^live-at <r1>)
   (<r1> ^argument1 <pw> ^argument2 <r>)
  -{  (<w> ^view-mate <r2>)
  (<r2> ^argument1 <c> ^argument2 <pw> ^argument3 <w2>)
  (<w> ^live-at <r3>)
  (<r3> ^argument1 <w2> ^argument2 <r>)}
-->
   (<w> ^knows-at <dr>)
   (<dr> ^argument1 <c> ^argument2 <pw> ^argument3 <r>)
}

## Derived relation answer-differs (statements 4, 5): recomputed in every world, never copied into look-ahead.
sp {wizards*elaborate*derived*answer-differs
   (state <s> ^problem-space.name wizards ^world <w>)
   (<w> ^anchored-world true ^objects <objs>)
   (<w> ^live-at <r1>)
   (<r1> ^argument1 <pw> ^argument2 <r>)
   (<w> ^asks <r2>)
   (<r2> ^argument1 <r> ^argument2 <c>)
   (<w> ^actual <r3>)
   (<r3> ^argument1 <wa>)
   (<w> ^knows-at <r4>)
   (<r4> ^argument1 <c> ^argument2 <wa> ^argument3 <r>)
  -{  (<w> ^knows-at <r5>)
  (<r5> ^argument1 <c> ^argument2 <pw> ^argument3 <r>)}
-->
   (<w> ^answer-differs <dr>)
   (<dr> ^argument1 <pw> ^argument2 <r>)
}

## Derived relation answer-differs-too (statements 4, 5): recomputed in every world, never copied into look-ahead.
sp {wizards*elaborate*derived*answer-differs-too
   (state <s> ^problem-space.name wizards ^world <w>)
   (<w> ^anchored-world true ^objects <objs>)
   (<w> ^live-at <r1>)
   (<r1> ^argument1 <pw> ^argument2 <r>)
   (<w> ^asks <r2>)
   (<r2> ^argument1 <r> ^argument2 <c>)
   (<w> ^actual <r3>)
   (<r3> ^argument1 <wa>)
   (<w> ^knows-at <r4>)
   (<r4> ^argument1 <c> ^argument2 <pw> ^argument3 <r>)
  -{  (<w> ^knows-at <r5>)
  (<r5> ^argument1 <c> ^argument2 <wa> ^argument3 <r>)}
-->
   (<w> ^answer-differs-too <dr>)
   (<dr> ^argument1 <pw> ^argument2 <r>)
}

## Goal (statement 7): ^goal-met true on the task object.
sp {wizards*elaborate*goal
   (state <s> ^problem-space.name wizards ^world <w>)
   (<w> ^anchored-world true ^objects <objs>)
   (<objs> ^object <task>)
   (<task> ^type task)
   (<w> ^says <r1>)
   (<r1> ^argument1 <c> ^argument2 <col>)
-->
   (<task> ^goal-met true)
}
