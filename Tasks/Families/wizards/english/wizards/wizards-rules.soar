## Elaborate problem space: adds ^copy-relation, ^dont-copy-object-attribute, ^problem-space, ^share-relation.
sp {wizards*elaborate*problem-space
   (state <s> ^name wizards)
-->
   (<s> ^problem-space <p>)
   (<p> ^name wizards ^copy-relation out-at ^copy-relation says ^share-relation spot ^share-relation view-mate ^share-relation actual ^share-relation asks ^dont-copy-object-attribute goal-met)
}

sp {wizards*elaborate*problem-space*mea-substate
   (state <s> ^impasse no-change ^attribute operator ^superstate <ss>)
   (<ss> ^problem-space.name wizards ^operator <so>)
   (<so> ^task-operator true -^pre-conditions-satisfied true)
-->
   (<s> ^problem-space <p>)
   (<p> ^name wizards ^dont-copy-object-attribute goal-met)
}

## Elaborate flags: adds ^flag-override, ^mea-operator-selection.
sp {wizards*elaborate*flags
   (state <s> ^superstate nil ^name wizards)
-->
   (<s> ^flag-override <f>)
   (<f> ^mea-operator-selection true)
}

## Achievement of object-property desireds (supplied by the task).
sp {wizards*elaborate*state*achieved*object-property
   (state <s> ^problem-space.name wizards ^desireds <ds> ^world <w>)
   (<ds> ^desired <d>)
   (<d> ^object <do>)
   (<do> ^object-handle <h> ^{ <> object-handle <a> } <v>)
   (<w> ^anchored-world true ^objects.object <ob>)
   (<ob> ^object-handle <h> ^<a> <v>)
-->
   (<ds> ^achieved <d>)
}

sp {wizards*elaborate*state*unachieved*object-property
   (state <s> ^problem-space.name wizards ^desireds <ds> ^world <w>)
   (<ds> ^desired <d>)
   (<d> ^object <do>)
   (<do> ^object-handle <h> ^{ <> object-handle <a> } <v>)
   (<w> ^anchored-world true)
  -{(<w> ^objects.object <ob>)
    (<ob> ^object-handle <h> ^<a> <v>)}
-->
   (<ds> ^unachieved <d>)
}

## Operator tell (statement 3).
sp {wizards*propose*tell
   (state <s> ^problem-space.name wizards ^flags.mea-operator-selection true ^world <w> ^desireds <ds>)
   (<w> ^anchored-world true ^objects <objs>)
   (<objs> ^object <t>)
   (<t> ^type stage)
   (<t> ^step 0)
   (<ds> ^unachieved-desireds true)
-->
   (<s> ^operator <op> +)
   (<op> ^name tell ^task-operator true ^monotonic true ^action-handle tell ^argument1 <t> ^argument-count 1 ^pre-conditions-satisfied true)
}

## Effect of tell (look-ahead).
sp {wizards*apply*tell*internal
   (state <s> ^problem-space.name wizards ^operator <op> ^internal-actions true ^world <w>)
   (<op> ^task-operator true ^name tell ^pre-conditions-satisfied true ^argument1.object-handle $ <t-h>)
   (<w> ^anchored-world true ^objects <objs>)
   (<objs> ^object <t>)
   (<t> ^object-handle $ <t-h>)
   (<t> ^step <t-step>)
-->
   (<t> ^step <t-step> - (+ <t-step> 1))
}

## Effect of a completed tell command on the real world (once per command).
sp {wizards*apply*tell*environment-effect
   :o-support
   (state <s> ^problem-space.name wizards ^superstate nil ^world <w> ^io.output-link.perform-action <pa>)
   (<pa> ^name tell ^status complete ^argument1 <t-h> -^effect-applied true)
   (<w> ^anchored-world true ^objects <objs>)
   (<objs> ^object <t>)
   (<t> ^object-handle $ <t-h>)
   (<t> ^step <t-step>)
-->
   (<t> ^step <t-step> - (+ <t-step> 1))
   (<pa> ^effect-applied true)
   (write |Told: at least one spot is white| (crlf))
}

## Effect of tell on every match (look-ahead).
sp {wizards*apply*tell*internal*each1
   (state <s> ^problem-space.name wizards ^operator <op> ^internal-actions true ^world <w>)
   (<op> ^task-operator true ^name tell ^pre-conditions-satisfied true ^argument1.object-handle $ <t-h>)
   (<w> ^anchored-world true ^objects <objs>)
   (<objs> ^object <t>)
   (<t> ^object-handle $ <t-h>)
   (<w> ^all-black <r1>)
   (<r1> ^argument1 <pw>)
   (<objs> ^object <k-told>)
   (<k-told> ^object-handle told)
-->
   (<w> ^out-at <new-2>)
   (<new-2> ^argument1 <pw> ^argument2 <k-told>)
}

## Effect of a completed tell command on every match (real world).
sp {wizards*apply*tell*environment-effect*each1
   :o-support
   (state <s> ^problem-space.name wizards ^superstate nil ^world <w> ^io.output-link.perform-action <pa>)
   (<pa> ^name tell ^status complete ^argument1 <t-h> -^effect-applied true)
   (<w> ^anchored-world true ^objects <objs>)
   (<objs> ^object <t>)
   (<t> ^object-handle $ <t-h>)
   (<w> ^all-black <r1>)
   (<r1> ^argument1 <pw>)
   (<objs> ^object <k-told>)
   (<k-told> ^object-handle told)
-->
   (<w> ^out-at <new-2>)
   (<new-2> ^argument1 <pw> ^argument2 <k-told>)
}

## Operator ask (statements 4, 5, 7).
sp {wizards*propose*ask
   (state <s> ^problem-space.name wizards ^flags.mea-operator-selection true ^world <w> ^desireds <ds>)
   (<w> ^anchored-world true ^objects <objs>)
   (<objs> ^object <r>)
   (<r> ^type turn)
   (<objs> ^object <t>)
   (<t> ^type stage)
   (<r> ^n <r-n>)
   (<t> ^step <r-n>)
   (<r> ^n > 0)
   (<ds> ^unachieved-desireds true)
-->
   (<s> ^operator <op> +)
   (<op> ^name ask ^task-operator true ^monotonic true ^action-handle ask ^argument1 <r> ^argument-count 1 ^pre-conditions-satisfied true)
}

