
sp {wizards*propose*complement*u-1
   (state <s> ^name wizards)
   (<s> ^view <k1>)
   (<s> ^rec <w1>)
   (<s> ^view <k2>)
   (<s> ^rec <w2>)
   (<s> ^markvar <m>)
   (<w1> ^view <k1>)
   (<k2> ^parent <k1>)
   (<w2> ^view <k2>)
   (<w2> ^mv <m>)
   (<w1> ^contra 1)
   (<m> ^assigned <k2-vid>)
   (<k2> ^vid <k2-vid>)
   (<m> ^untried 1)
-->
   (<s> ^operator <o> +)
   (<s> ^operator <o> =)
   (<o> ^name complement)
   (<o> ^|k1| <k1>)
   (<o> ^|w1| <w1>)
   (<o> ^|k2| <k2>)
   (<o> ^|w2| <w2>)
   (<o> ^m <m>)
   (<o> ^u 1)
}

sp {wizards*propose*complement*u-2
   (state <s> ^name wizards)
   (<s> ^view <k1>)
   (<s> ^rec <w1>)
   (<s> ^view <k2>)
   (<s> ^rec <w2>)
   (<s> ^markvar <m>)
   (<w1> ^view <k1>)
   (<k2> ^parent <k1>)
   (<w2> ^view <k2>)
   (<w2> ^mv <m>)
   (<w1> ^contra 1)
   (<m> ^assigned <k2-vid>)
   (<k2> ^vid <k2-vid>)
   (<m> ^untried 2)
-->
   (<s> ^operator <o> +)
   (<s> ^operator <o> =)
   (<o> ^name complement)
   (<o> ^|k1| <k1>)
   (<o> ^|w1| <w1>)
   (<o> ^|k2| <k2>)
   (<o> ^|w2| <w2>)
   (<o> ^m <m>)
   (<o> ^u 2)
}

sp {wizards*apply*complement
   (state <s> ^name wizards)
   (<s> ^operator <o>)
   (<o> ^name complement)
   (<o> ^|k1| <k1>)
   (<o> ^|w1| <w1>)
   (<o> ^|k2| <k2>)
   (<o> ^|w2| <w2>)
   (<o> ^m <m>)
   (<o> ^u <u>)
   (<w2> ^mark <w2-mark>)
   (<w2> ^var <w2-var>)
   (<k1> ^owner <k1-owner>)
   (<k2> ^owner <k2-owner>)
   (<w2> ^wiz <w2-wiz>)
-->
   (<w2> ^mark <u>)
   (<w2> ^mark <w2-mark> -)
   (<w2> ^mv <m> -)
   (<w2> ^var 0)
   (<w2> ^var <w2-var> -)
   (write |Contradiction in the view of wizard | <k1-owner> |: in the view of wizard | <k2-owner> |, wizard | <w2-wiz> |'s spot must be | <u>)
}
