
sp {wizards*propose*consider-knows
   (state <s> ^name wizards)
   (<s> ^world <wd>)
   (<s> ^view <k>)
   (<s> ^rec <w>)
   (<s> ^rec <a1>)
   (<s> ^rec <a2>)
   (<s> ^rec <a3>)
   (<w> ^view <k>)
   (<a1> ^view <k>)
   (<a2> ^view <k>)
   (<a3> ^view <k>)
   -(<w> ^own 1)
   (<w> ^modeled 0)
   (<a1> ^wiz 1)
   (<a2> ^wiz 2)
   (<a3> ^wiz 3)
-->
   (<s> ^operator <o> +)
   (<s> ^operator <o> =)
   (<o> ^name consider-knows)
   (<o> ^wd <wd>)
   (<o> ^k <k>)
   (<o> ^w <w>)
   (<o> ^|a1| <a1>)
   (<o> ^|a2| <a2>)
   (<o> ^|a3| <a3>)
}

sp {wizards*apply*consider-knows
   (state <s> ^name wizards)
   (<s> ^operator <o>)
   (<o> ^name consider-knows)
   (<o> ^wd <wd>)
   (<o> ^k <k>)
   (<o> ^w <w>)
   (<o> ^|a1| <a1>)
   (<o> ^|a2| <a2>)
   (<o> ^|a3| <a3>)
   (<wd> ^nviews <wd-nviews>)
   (<w> ^modeled <w-modeled>)
   (<k> ^owner <k-owner>)
   (<w> ^wiz <w-wiz>)
   (<k> ^depth <k-depth>)
-->
   (<s> ^view <v>)
   (<v> ^vid (+ <wd-nviews> 1))
   (<v> ^owner <w-wiz>)
   (<v> ^depth (+ <k-depth> 1))
   (<s> ^rec <r1>)
   (<r1> ^wiz 1)
   (<r1> ^mark 0)
   (<r1> ^var 0)
   (<r1> ^modeled 0)
   (<s> ^rec <r2>)
   (<r2> ^wiz 2)
   (<r2> ^mark 0)
   (<r2> ^var 0)
   (<r2> ^modeled 0)
   (<s> ^rec <r3>)
   (<r3> ^wiz 3)
   (<r3> ^mark 0)
   (<r3> ^var 0)
   (<r3> ^modeled 0)
   (<wd> ^nviews (+ <wd-nviews> 1))
   (<wd> ^nviews <wd-nviews> -)
   (<w> ^modeled 1)
   (<w> ^modeled <w-modeled> -)
   (<v> ^parent <k>)
   (<r1> ^view <v>)
   (<r2> ^view <v>)
   (<r3> ^view <v>)
   (<r1> ^sib <r2>)
   (<r1> ^sib <r3>)
   (<r2> ^sib <r1>)
   (<r2> ^sib <r3>)
   (<r3> ^sib <r1>)
   (<r3> ^sib <r2>)
   (<a1> ^sub <r1>)
   (<a2> ^sub <r2>)
   (<a3> ^sub <r3>)
   (write |In the view of wizard | <k-owner> |, model what wizard | <w-wiz> | knows.|)
}
