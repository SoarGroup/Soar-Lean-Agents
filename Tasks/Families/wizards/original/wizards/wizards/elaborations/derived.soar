}

sp {wizards*elaborate*rec*white*base*3
   (state <s> ^name wizards)
   (<s> ^rec <self>)
   (<self> ^own 1)
   (<self> ^sib <lk2x1>)
   (<lk2x1> ^blackish 1)
   (<self> ^sib { <lk2x2> <> <lk2x1> })
   (<lk2x2> ^blackish 1)
-->
   (<self> ^white 1)
}

sp {wizards*elaborate*rec*white*via-sub
   (state <s> ^name wizards)
   (<s> ^rec <self>)
   (<self> ^sub <below>)
   (<below> ^white 1)
   -(<below> ^contra 1)
-->
   (<self> ^white 1)
}

