
sp {wizards*elaborate*rec*own*base
   (state <s> ^name wizards)
   (<s> ^rec <self>)
   (<self> ^wiz <self-wiz>)
   (<self> ^view <lk1x1>)
   (<lk1x1> ^owner <self-wiz>)
-->
   (<self> ^own 1)
}

sp {wizards*elaborate*rec*white*base*2
