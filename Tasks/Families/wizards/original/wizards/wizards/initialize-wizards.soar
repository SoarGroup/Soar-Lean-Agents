
sp {wizards*propose*initialize-wizards
   (state <s> ^superstate nil)
   -(<s> ^name <_v1>)
-->
   (<s> ^operator <o> +)
   (<o> ^name initialize-wizards)
}

sp {wizards*apply*initialize-wizards
   (state <s> ^operator <o>)
   (<o> ^name initialize-wizards)
-->
   (<s> ^name wizards)
   (<s> ^world <x0>)
   (<x0> ^done 0)
   (<x0> ^nviews 1)
   (<x0> ^name world)
   (<s> ^view <x1>)
   (<x1> ^vid 1)
   (<x1> ^owner 1)
   (<x1> ^depth 1)
   (<x1> ^name A-view)
   (<s> ^rec <x2>)
   (<x2> ^wiz 1)
   (<x2> ^mark 0)
   (<x2> ^var 0)
   (<x2> ^modeled 0)
   (<x2> ^aguess 0)
   (<x2> ^name A)
   (<x2> ^view <x1>)
   (<x2> ^sib <x3>)
   (<x2> ^sib <x4>)
   (<s> ^rec <x3>)
   (<x3> ^wiz 2)
   (<x3> ^mark 1)
   (<x3> ^var 0)
   (<x3> ^modeled 0)
   (<x3> ^aguess 0)
   (<x3> ^name B)
   (<x3> ^view <x1>)
   (<x3> ^sib <x2>)
   (<x3> ^sib <x4>)
   (<s> ^rec <x4>)
   (<x4> ^wiz 3)
   (<x4> ^mark 1)
   (<x4> ^var 0)
   (<x4> ^modeled 0)
   (<x4> ^aguess 0)
   (<x4> ^name C)
   (<x4> ^view <x1>)
   (<x4> ^sib <x2>)
   (<x4> ^sib <x3>)
   (<s> ^desired <d>)
   (<d> ^world <dg>)
   (<dg> ^done 1)
}
