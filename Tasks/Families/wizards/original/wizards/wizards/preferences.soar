sp {wizards*select*consider-last
   (state <s> ^name wizards)
   (<s> ^operator <o> +)
   (<o> ^name consider-knows)
   (<o> ^wd <wd>)
   (<o> ^k <k>)
   (<o> ^w <w>)
   (<o> ^|a1| <a1>)
   (<o> ^|a2| <a2>)
   (<o> ^|a3| <a3>)
   (<w> ^modeled 0)
-->
   (<s> ^operator <o> <)
}

