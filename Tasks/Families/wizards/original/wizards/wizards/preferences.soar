
sp {wizards*select*self-unknown-first
   (state <s> ^name wizards)
   (<s> ^operator <o> +)
   (<o> ^name self-unknown)
   (<o> ^r <r>)
   (<r> ^var 0)
-->
   (<s> ^operator <o> >)
}

sp {wizards*select*complement-first
   (state <s> ^name wizards)
   (<s> ^operator <o> +)
   (<o> ^name complement)
   (<o> ^|k1| <k1>)
   (<o> ^|w1| <w1>)
   (<o> ^|k2| <k2>)
   (<o> ^|w2| <w2>)
   (<o> ^m <m>)
   (<o> ^u <u>)
   (<w1> ^contra 1)
-->
   (<s> ^operator <o> >)
}

sp {wizards*select*guess-first
   (state <s> ^name wizards)
   (<s> ^operator <o> +)
   (<o> ^name guess-white)
   (<o> ^wd <wd>)
   (<o> ^k <k>)
   (<o> ^r <r>)
   (<wd> ^done 0)
-->
   (<s> ^operator <o> >)
}

