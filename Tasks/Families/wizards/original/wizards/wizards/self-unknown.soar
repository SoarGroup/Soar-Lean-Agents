
sp {wizards*propose*self-unknown
   (state <s> ^name wizards)
   (<s> ^rec <r>)
   (<r> ^own 1)
   -(<r> ^white 1)
   -(<r> ^black 1)
   (<r> ^mark 0)
   (<r> ^var 0)
-->
   (<s> ^operator <o> +)
   (<s> ^operator <o> =)
   (<o> ^name self-unknown)
   (<o> ^r <r>)
}

sp {wizards*apply*self-unknown
   (state <s> ^name wizards)
   (<s> ^operator <o>)
   (<o> ^name self-unknown)
   (<o> ^r <r>)
   (<r> ^var <r-var>)
   (<r> ^wiz <r-wiz>)
-->
   (<s> ^markvar <m>)
   (<m> ^value 0)
   (<m> ^assigned 0)
   (<m> ^untried 1)
   (<m> ^untried 2)
   (<r> ^mv <m>)
   (<r> ^var 1)
   (<r> ^var <r-var> -)
   (write |In the view of wizard | <r-wiz> |, his own spot is unknown.|)
}
