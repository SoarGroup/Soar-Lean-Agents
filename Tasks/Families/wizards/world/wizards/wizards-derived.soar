##############################################################################
## Derived properties of rec objects (i-supported, as in the original): own, white, black,
## blackish, gwhite, gblack, contra.  They are derived on world objects; this program does no
## look-ahead, so no copied world can hold stale values.
##############################################################################
sp {wizards*elaborate*rec*own*base
   (state <s> ^problem-space.name wizards
              ^world <w>)
   (<w> ^anchored-world true
        ^objects.object <self>)
   (<self> ^type rec)
   (<self> ^wiz <self-wiz>
          ^view <lk1x1>)
   (<lk1x1> ^owner <self-wiz>)
-->
   (<self> ^own 1)
}

sp {wizards*elaborate*rec*white*base*2
   (state <s> ^problem-space.name wizards
              ^world <w>)
   (<w> ^anchored-world true
        ^objects.object <self>)
   (<self> ^type rec)
   (<self> ^mark 1)
-->
   (<self> ^white 1)
}

sp {wizards*elaborate*rec*white*base*3
   (state <s> ^problem-space.name wizards
              ^world <w>)
   (<w> ^anchored-world true
        ^objects.object <self>)
   (<self> ^type rec)
   (<self> ^own 1
          ^sib <lk2x1>
          ^sib { <lk2x2> <> <lk2x1> })
   (<lk2x1> ^blackish 1)
   (<lk2x2> ^blackish 1)
-->
   (<self> ^white 1)
}

sp {wizards*elaborate*rec*white*via-sub
   (state <s> ^problem-space.name wizards
              ^world <w>)
   (<w> ^anchored-world true
        ^objects.object <self>)
   (<self> ^type rec)
   (<self> ^sub <below>)
   (<below> ^white 1)
  -(<below> ^contra 1)
-->
   (<self> ^white 1)
}

sp {wizards*elaborate*rec*black*base*5
   (state <s> ^problem-space.name wizards
              ^world <w>)
   (<w> ^anchored-world true
        ^objects.object <self>)
   (<self> ^type rec)
   (<self> ^mark 2)
-->
   (<self> ^black 1)
}

sp {wizards*elaborate*rec*black*via-sub
   (state <s> ^problem-space.name wizards
              ^world <w>)
   (<w> ^anchored-world true
        ^objects.object <self>)
   (<self> ^type rec)
   (<self> ^sub <below>)
   (<below> ^black 1)
  -(<below> ^contra 1)
-->
   (<self> ^black 1)
}

sp {wizards*elaborate*rec*blackish*base*7
   (state <s> ^problem-space.name wizards
              ^world <w>)
   (<w> ^anchored-world true
        ^objects.object <self>)
   (<self> ^type rec)
   (<self> ^black 1)
-->
   (<self> ^blackish 1)
}

sp {wizards*elaborate*rec*blackish*base*8
   (state <s> ^problem-space.name wizards
              ^world <w>)
   (<w> ^anchored-world true
        ^objects.object <self>)
   (<self> ^type rec)
   (<self> ^mv <lk1x1>)
   (<lk1x1> ^value 2)
-->
   (<self> ^blackish 1)
}

sp {wizards*elaborate*rec*gwhite*base*9
   (state <s> ^problem-space.name wizards
              ^world <w>)
   (<w> ^anchored-world true
        ^objects.object <self>)
   (<self> ^type rec)
   (<self> ^own 1
          ^white 1)
-->
   (<self> ^gwhite 1)
}

