sp {wizards*elaborate*rec*contra*base*15
   (state <s> ^problem-space.name wizards
              ^world <w>)
   (<w> ^anchored-world true
        ^objects.object <self>)
   (<self> ^type rec)
   (<self> ^gwhite 1
          ^aguess 0)
