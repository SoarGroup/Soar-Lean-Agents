##############################################################################
## Task operators (all ^task-operator true, applied internally, ^environment none; no
## precondition desireds, ^desireds.desired-count 0: as in the original, applicability is
## tested in the proposals).  The original's operator parameters become ^argument1..3; those
## the application can find from the arguments (a rec's view, the view's parent, the recs of
## a view) are no longer parameters.  Each application re-tests the condition its change
## falsifies, so it fires once while the operator stays selected.
##   self-unknown     argument1 rec
##   consider-knows   argument1 rec (wizard to model; the recs of its view are found)
##   ascribe-mark     argument1 rec x1, argument2 rec x2 (x1 ^sub x2)
##   ascribe-unknown  argument1 x1, argument2 x2, argument3 markvar
##   ascribe-guess    argument1 x1, argument2 x2, ^gv 0/1/2
##   assume-black     argument1 rec, argument2 markvar
##   assume-white     argument1 rec, argument2 markvar
##   complement       argument1 rec w2, argument2 rec w1 (contra), argument3 markvar, ^u 1/2
##   guess-white      argument1 rec, argument2 puzzle
##   guess-black      argument1 rec, argument2 puzzle
##############################################################################

### self-unknown

sp {wizards*propose*self-unknown
   (state <s> ^problem-space.name wizards
              ^world <w>)
   (<w> ^anchored-world true
        ^objects.object <r>)
   (<r> ^type rec
        ^own 1
       -^white 1
       -^black 1
        ^mark 0
        ^var 0)
-->
   (<s> ^operator <o> +)
   (<o> ^name self-unknown
        ^task-operator true
        ^action-handle self-unknown
        ^argument1 <r>
        ^argument-count 1
        ^desireds <pre>)
   (<pre> ^desired-count 0)
}

sp {apply*self-unknown*internal
   (state <s> ^operator <o>
              ^internal-actions true
              ^world <w>)
   (<o> ^name self-unknown
        ^pre-conditions-satisfied true
        ^argument1.object-handle $ <rh>)
   (<w> ^anchored-world true
        ^objects <objs>)
   (<objs> ^object <r>)
   (<r> ^object-handle $ <rh>
        ^var 0
        ^wiz <r-wiz>)
-->
   (log 1 (crlf) |Apply self-unknown: | <rh>)
   (<objs> ^object <m>)
   (<m> ^object-handle (concat |markvar-| <rh>)
        ^anchored true
        ^type markvar
        ^value 0
        ^assigned 0
        ^untried 1 2)
   (<r> ^mv <m>
        ^var 0 - 1)
   (write |In the view of wizard | <r-wiz> |, his own spot is unknown.|)
}

### consider-knows

sp {wizards*propose*consider-knows
   (state <s> ^problem-space.name wizards
              ^world <wd>)
   (<wd> ^anchored-world true
        ^objects.object <puzzle> <k> <w> <a1> <a2> <a3>)
   (<puzzle> ^type puzzle)
   (<k> ^type view)
   (<w> ^type rec
        ^view <k>
       -^own 1
        ^modeled 0)
   (<a1> ^type rec ^view <k> ^wiz 1)
   (<a2> ^type rec ^view <k> ^wiz 2)
   (<a3> ^type rec ^view <k> ^wiz 3)
-->
   (<s> ^operator <o> +)
   (<o> ^name consider-knows
        ^task-operator true
        ^action-handle consider-knows
        ^argument1 <w>
        ^argument-count 1
        ^desireds <pre>)
   (<pre> ^desired-count 0)
}

sp {apply*consider-knows*internal
   (state <s> ^operator <o>
              ^internal-actions true
              ^world <wd>)
   (<o> ^name consider-knows
        ^pre-conditions-satisfied true
        ^argument1.object-handle $ <wh>)
   (<wd> ^anchored-world true
        ^objects <objs>)
   (<objs> ^object <puzzle> <w> <a1> <a2> <a3>)
   (<puzzle> ^type puzzle
             ^nviews <nviews>)
   (<w> ^object-handle $ <wh>
        ^modeled 0
        ^wiz <w-wiz>
        ^view <k>)
   (<k> ^owner <k-owner>
        ^depth <k-depth>)
   (<a1> ^type rec ^view <k> ^wiz 1)
   (<a2> ^type rec ^view <k> ^wiz 2)
   (<a3> ^type rec ^view <k> ^wiz 3)
-->
   (log 1 (crlf) |Apply consider-knows: | <wh>)
   (<objs> ^object <v> <r1> <r2> <r3>)
   (<v> ^object-handle (concat |view-| (+ <nviews> 1))
        ^anchored true
        ^type view
        ^vid (+ <nviews> 1)
        ^owner <w-wiz>
        ^depth (+ <k-depth> 1)
        ^parent <k>)
   (<r1> ^object-handle (concat |rec-| (+ <nviews> 1) |-1|)
         ^anchored true ^type rec
         ^wiz 1 ^mark 0 ^var 0 ^modeled 0
         ^view <v> ^sib <r2> <r3>)
   (<r2> ^object-handle (concat |rec-| (+ <nviews> 1) |-2|)
         ^anchored true ^type rec
         ^wiz 2 ^mark 0 ^var 0 ^modeled 0
         ^view <v> ^sib <r1> <r3>)
   (<r3> ^object-handle (concat |rec-| (+ <nviews> 1) |-3|)
         ^anchored true ^type rec
         ^wiz 3 ^mark 0 ^var 0 ^modeled 0
         ^view <v> ^sib <r1> <r2>)
   (<puzzle> ^nviews <nviews> - (+ <nviews> 1))
   (<w> ^modeled 0 - 1)
   (<a1> ^sub <r1>)
   (<a2> ^sub <r2>)
   (<a3> ^sub <r3>)
   (write |In the view of wizard | <k-owner> |, model what wizard | <w-wiz> | knows.|)
}

### ascribe-mark

sp {wizards*propose*ascribe-mark
   (state <s> ^problem-space.name wizards
              ^world <w>)
   (<w> ^anchored-world true
        ^objects.object <x1> <x2>)
   (<x1> ^type rec
         ^sub <x2>
         ^mark <> 0)
   (<x2> -^own 1
          ^mark 0)
-->
   (<s> ^operator <o> +)
   (<o> ^name ascribe-mark
        ^task-operator true
        ^action-handle ascribe-mark
        ^argument1 <x1>
        ^argument2 <x2>
        ^argument-count 2
        ^desireds <pre>)
   (<pre> ^desired-count 0)
}

sp {apply*ascribe-mark*internal
   (state <s> ^operator <o>
              ^internal-actions true
              ^world <w>)
   (<o> ^name ascribe-mark
        ^pre-conditions-satisfied true
        ^argument1.object-handle $ <x1h>
        ^argument2.object-handle $ <x2h>)
   (<w> ^anchored-world true
        ^objects.object <x1> <x2>)
   (<x1> ^object-handle $ <x1h>
         ^mark <x1-mark>)
   (<x2> ^object-handle $ <x2h>
         ^mark 0)
-->
   (log 1 (crlf) |Apply ascribe-mark: | <x1h> | to | <x2h>)
   (<x2> ^mark 0 - <x1-mark>)
}

### ascribe-unknown

sp {wizards*propose*ascribe-unknown
   (state <s> ^problem-space.name wizards
              ^world <w>)
   (<w> ^anchored-world true
        ^objects.object <x1> <x2> <m>)
   (<m> ^type markvar)
   (<x1> ^type rec
         ^sub <x2>
         ^mv <m>)
   (<x2> -^own 1
          ^var 0)
-->
   (<s> ^operator <o> +)
   (<o> ^name ascribe-unknown
        ^task-operator true
        ^action-handle ascribe-unknown
        ^argument1 <x1>
        ^argument2 <x2>
        ^argument3 <m>
        ^argument-count 3
        ^desireds <pre>)
   (<pre> ^desired-count 0)
}

sp {apply*ascribe-unknown*internal
   (state <s> ^operator <o>
              ^internal-actions true
              ^world <w>)
   (<o> ^name ascribe-unknown
        ^pre-conditions-satisfied true
        ^argument2.object-handle $ <x2h>
        ^argument3.object-handle $ <mh>)
   (<w> ^anchored-world true
        ^objects.object <x2> <m>)
   (<x2> ^object-handle $ <x2h>
         ^var 0)
   (<m> ^object-handle $ <mh>)
-->
   (log 1 (crlf) |Apply ascribe-unknown: | <x2h>)
   (<x2> ^mv <m>
         ^var 0 - 1)
}

### ascribe-guess (one proposal per guess value)

sp {wizards*propose*ascribe-guess*gv-0
   (state <s> ^problem-space.name wizards
              ^world <w>)
   (<w> ^anchored-world true
        ^objects.object <x1> <x2>)
   (<x1> ^type rec
         ^sub <x2>
         ^aguess 0)
   (<x2> -^own 1
         -^aguess 0)
-->
   (<s> ^operator <o> +)
   (<o> ^name ascribe-guess
        ^task-operator true
        ^action-handle ascribe-guess
        ^argument1 <x1>
        ^argument2 <x2>
        ^argument-count 2
        ^gv 0
        ^desireds <pre>)
   (<pre> ^desired-count 0)
}

sp {wizards*propose*ascribe-guess*gv-1
   (state <s> ^problem-space.name wizards
              ^world <w>)
   (<w> ^anchored-world true
        ^objects.object <x1> <x2>)
   (<x1> ^type rec
         ^sub <x2>
         ^aguess 1)
   (<x2> -^own 1
         -^aguess 1)
-->
   (<s> ^operator <o> +)
   (<o> ^name ascribe-guess
        ^task-operator true
        ^action-handle ascribe-guess
        ^argument1 <x1>
        ^argument2 <x2>
        ^argument-count 2
        ^gv 1
        ^desireds <pre>)
   (<pre> ^desired-count 0)
}

sp {wizards*propose*ascribe-guess*gv-2
   (state <s> ^problem-space.name wizards
              ^world <w>)
   (<w> ^anchored-world true
        ^objects.object <x1> <x2>)
   (<x1> ^type rec
         ^sub <x2>
         ^aguess 2)
   (<x2> -^own 1
         -^aguess 2)
-->
   (<s> ^operator <o> +)
   (<o> ^name ascribe-guess
        ^task-operator true
        ^action-handle ascribe-guess
        ^argument1 <x1>
        ^argument2 <x2>
        ^argument-count 2
        ^gv 2
        ^desireds <pre>)
   (<pre> ^desired-count 0)
}

sp {apply*ascribe-guess*internal
   (state <s> ^operator <o>
              ^internal-actions true
              ^world <w>)
   (<o> ^name ascribe-guess
        ^pre-conditions-satisfied true
        ^argument2.object-handle $ <x2h>
        ^gv <gv>)
   (<w> ^anchored-world true
        ^objects.object <x2>)
   (<x2> ^object-handle $ <x2h>
        -^aguess <gv>)
-->
   (log 1 (crlf) |Apply ascribe-guess: | <x2h> | | <gv>)
   (<x2> ^aguess <gv>)
}

### assume-black / assume-white

sp {wizards*propose*assume-black
   (state <s> ^problem-space.name wizards
              ^world <w>)
   (<w> ^anchored-world true
        ^objects.object <k> <r> <m>)
   (<k> ^type view)
   (<m> ^type markvar
        ^value 0
        ^untried 2)
   (<r> ^type rec
        ^view <k>
        ^mv <m>
       -^own 1)
-->
   (<s> ^operator <o> +)
   (<o> ^name assume-black
        ^task-operator true
        ^action-handle assume-black
        ^argument1 <r>
        ^argument2 <m>
        ^argument-count 2
        ^desireds <pre>)
   (<pre> ^desired-count 0)
}

sp {apply*assume-black*internal
   (state <s> ^operator <o>
              ^internal-actions true
              ^world <w>)
   (<o> ^name assume-black
        ^pre-conditions-satisfied true
        ^argument1.object-handle $ <rh>
        ^argument2.object-handle $ <mh>)
   (<w> ^anchored-world true
        ^objects.object <r> <m>)
   (<r> ^object-handle $ <rh>
        ^wiz <r-wiz>
        ^view <k>)
   (<k> ^vid <k-vid>
        ^owner <k-owner>)
   (<m> ^object-handle $ <mh>
        ^value 0
        ^untried 2
        ^assigned <m-assigned>)
-->
   (log 1 (crlf) |Apply assume-black: | <rh>)
   (<m> ^value 0 - 2
        ^untried 2 -
        ^assigned <m-assigned> - <k-vid>)
   (write |In the view of wizard | <k-owner> |, assume wizard | <r-wiz> |'s spot is black.|)
}

sp {wizards*propose*assume-white
   (state <s> ^problem-space.name wizards
              ^world <w>)
   (<w> ^anchored-world true
        ^objects.object <k> <r> <m>)
   (<k> ^type view)
   (<m> ^type markvar
        ^value 0
        ^untried 1
       -^untried 2)
   (<r> ^type rec
        ^view <k>
        ^mv <m>
       -^own 1)
-->
   (<s> ^operator <o> +)
   (<o> ^name assume-white
        ^task-operator true
        ^action-handle assume-white
        ^argument1 <r>
        ^argument2 <m>
        ^argument-count 2
        ^desireds <pre>)
   (<pre> ^desired-count 0)
}

sp {apply*assume-white*internal
   (state <s> ^operator <o>
              ^internal-actions true
              ^world <w>)
   (<o> ^name assume-white
        ^pre-conditions-satisfied true
        ^argument1.object-handle $ <rh>
        ^argument2.object-handle $ <mh>)
   (<w> ^anchored-world true
        ^objects.object <r> <m>)
   (<r> ^object-handle $ <rh>
        ^wiz <r-wiz>
        ^view <k>)
   (<k> ^vid <k-vid>
        ^owner <k-owner>)
   (<m> ^object-handle $ <mh>
        ^value 0
        ^untried 1
        ^assigned <m-assigned>)
-->
   (log 1 (crlf) |Apply assume-white: | <rh>)
   (<m> ^value 0 - 1
        ^untried 1 -
        ^assigned <m-assigned> - <k-vid>)
   (write |In the view of wizard | <k-owner> |, assume wizard | <r-wiz> |'s spot is white.|)
}

### complement (one proposal per untried value)

sp {wizards*propose*complement*u-1
   (state <s> ^problem-space.name wizards
              ^world <w>)
   (<w> ^anchored-world true
        ^objects.object <k1> <w1> <k2> <w2> <m>)
   (<k1> ^type view)
   (<k2> ^type view
         ^parent <k1>
         ^vid <k2-vid>)
   (<w1> ^type rec
         ^view <k1>
         ^contra 1)
   (<w2> ^type rec
         ^view <k2>
         ^mv <m>)
   (<m> ^type markvar
        ^assigned <k2-vid>
        ^untried 1)
-->
   (<s> ^operator <o> +)
   (<o> ^name complement
        ^task-operator true
        ^action-handle complement
        ^argument1 <w2>
        ^argument2 <w1>
        ^argument3 <m>
        ^argument-count 3
        ^u 1
        ^desireds <pre>)
   (<pre> ^desired-count 0)
}

sp {wizards*propose*complement*u-2
   (state <s> ^problem-space.name wizards
              ^world <w>)
   (<w> ^anchored-world true
        ^objects.object <k1> <w1> <k2> <w2> <m>)
   (<k1> ^type view)
   (<k2> ^type view
         ^parent <k1>
         ^vid <k2-vid>)
   (<w1> ^type rec
         ^view <k1>
         ^contra 1)
   (<w2> ^type rec
         ^view <k2>
         ^mv <m>)
   (<m> ^type markvar
        ^assigned <k2-vid>
        ^untried 2)
-->
   (<s> ^operator <o> +)
   (<o> ^name complement
        ^task-operator true
        ^action-handle complement
        ^argument1 <w2>
        ^argument2 <w1>
        ^argument3 <m>
        ^argument-count 3
        ^u 2
        ^desireds <pre>)
   (<pre> ^desired-count 0)
}

sp {apply*complement*internal
   (state <s> ^operator <o>
              ^internal-actions true
              ^world <w>)
   (<o> ^name complement
        ^pre-conditions-satisfied true
        ^argument1.object-handle $ <w2h>
        ^argument3.object-handle $ <mh>
        ^u <u>)
   (<w> ^anchored-world true
        ^objects.object <w2> <m>)
   (<m> ^object-handle $ <mh>)
   (<w2> ^object-handle $ <w2h>
         ^mv <m>
         ^mark <w2-mark>
         ^var <w2-var>
         ^wiz <w2-wiz>
         ^view <k2>)
   (<k2> ^owner <k2-owner>
         ^parent.owner <k1-owner>)
-->
   (log 1 (crlf) |Apply complement: | <w2h> | | <u>)
   (<w2> ^mark <w2-mark> - <u>
         ^mv <m> -
         ^var <w2-var> - 0)
   (write |Contradiction in the view of wizard | <k1-owner> |: in the view of wizard | <k2-owner> |, wizard | <w2-wiz> |'s spot must be | <u>)
}

### guess-white / guess-black (wizard 1's guess, in the first view)

sp {wizards*propose*guess-white
   (state <s> ^problem-space.name wizards
              ^world <w>)
   (<w> ^anchored-world true
        ^objects.object <wd> <k> <r>)
   (<wd> ^type puzzle
         ^done 0)
   (<k> ^type view
        ^depth 1)
   (<r> ^type rec
        ^view <k>
        ^own 1
        ^gwhite 1)
-->
   (<s> ^operator <o> +)
   (<o> ^name guess-white
        ^task-operator true
        ^action-handle guess-white
        ^argument1 <r>
        ^argument2 <wd>
        ^argument-count 2
        ^desireds <pre>)
   (<pre> ^desired-count 0)
}

sp {apply*guess-white*internal
   (state <s> ^operator <o>
              ^internal-actions true
              ^world <w>)
   (<o> ^name guess-white
        ^pre-conditions-satisfied true
        ^argument1.object-handle $ <rh>
        ^argument2.object-handle $ <wdh>)
   (<w> ^anchored-world true
        ^objects.object <r> <wd>)
   (<r> ^object-handle $ <rh>
        ^wiz <r-wiz>)
   (<wd> ^object-handle $ <wdh>
         ^done 0)
-->
   (log 1 (crlf) |Apply guess-white: | <rh>)
   (<wd> ^done 0 - 1)
   (write |Wizard | <r-wiz> | guesses his spot is white.|)
}

sp {wizards*propose*guess-black
   (state <s> ^problem-space.name wizards
              ^world <w>)
   (<w> ^anchored-world true
        ^objects.object <wd> <k> <r>)
   (<wd> ^type puzzle
         ^done 0)
   (<k> ^type view
        ^depth 1)
   (<r> ^type rec
        ^view <k>
        ^own 1
        ^gblack 1)
-->
   (<s> ^operator <o> +)
   (<o> ^name guess-black
        ^task-operator true
        ^action-handle guess-black
        ^argument1 <r>
        ^argument2 <wd>
        ^argument-count 2
        ^desireds <pre>)
   (<pre> ^desired-count 0)
}

sp {apply*guess-black*internal
   (state <s> ^operator <o>
              ^internal-actions true
              ^world <w>)
   (<o> ^name guess-black
        ^pre-conditions-satisfied true
        ^argument1.object-handle $ <rh>
        ^argument2.object-handle $ <wdh>)
   (<w> ^anchored-world true
        ^objects.object <r> <wd>)
   (<r> ^object-handle $ <rh>
        ^wiz <r-wiz>)
   (<wd> ^object-handle $ <wdh>
         ^done 0)
-->
   (log 1 (crlf) |Apply guess-black: | <rh>)
   (<wd> ^done 0 - 1)
   (write |Wizard | <r-wiz> | guesses his spot is black.|)
}
