## Goal: all the blocks are on a red location.
sp {king-stacked-frogs*elaborate*goal*on-red-location
   (state <s> ^world <w>)
   (<w> ^objects <objs>)
   (<objs> ^object <t> <b-block-5> <l-block-5> <b-block-6> <l-block-6> <b-block-7> <l-block-7> <b-block-8> <l-block-8>)
   (<t> ^type task)
   (<b-block-5> ^object-handle block-5)
   (<l-block-5> ^type location ^color red)
   (<w> ^on <on-block-5>)
   (<on-block-5> ^argument1 <b-block-5> ^argument2 <l-block-5>)
   (<b-block-6> ^object-handle block-6)
   (<l-block-6> ^type location ^color red)
   (<w> ^on <on-block-6>)
   (<on-block-6> ^argument1 <b-block-6> ^argument2 <l-block-6>)
   (<b-block-7> ^object-handle block-7)
   (<l-block-7> ^type location ^color red)
   (<w> ^on <on-block-7>)
   (<on-block-7> ^argument1 <b-block-7> ^argument2 <l-block-7>)
   (<b-block-8> ^object-handle block-8)
   (<l-block-8> ^type location ^color red)
   (<w> ^on <on-block-8>)
   (<on-block-8> ^argument1 <b-block-8> ^argument2 <l-block-8>)
-->
   (<t> ^goal-met true)
}
