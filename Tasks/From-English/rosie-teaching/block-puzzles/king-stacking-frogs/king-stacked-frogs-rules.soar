## Stacking frogs (king-stacked-frogs), generated from the Rosie teaching script (english-input.txt) under the world conventions.
##
## Instructor statements used (numbers as in english-input.txt):
##   4. If the number of the locations between a location and a covered location is the number of the blocks that are on the covered location then you can move it onto the former location.
##   5. If a location is below an object then it is covered.
##   6. There is six.
##   8. The goal is that all the blocks are on a red location.
## World: init-kstacked-frogs.world (four locations in a row, one block on each)
##
## Translation (tools/rosie-language.md gives the general reading; the assumption ledger is in README.md):
##   - Operator move (argument1 = the covered location C whose blocks move, argument2 = the location L they move onto). All the
##     blocks on C move together onto L (A-F1).
##   - "the number of the locations between L and C" is read so that adjacent locations count 1 (A-F2): the reading that
##     gives the instructor's answer to Rosie's question on the number of instances. It is a static relation apart-k,
##     computed from the locations' x and y and declared ^copy-relation.
##   - "the number of the blocks that are on C" is the maintained attribute ^block-count of each location; covered (below an
##     object) holds exactly when the count is at least 1, so it needs no test of its own.
##   - The goal ("all the blocks are on a red location") is expanded over the blocks of the world file (A-F3).
## Search settings: ^iterative-step tie-impasse, chosen by the P6 probe (probe_settings.py, 16 Nov 2026, library
## v2.34, seeds 1-3): same 3-move plans as operator depth with fewer decisions (probe.json).

sp {king-stacked-frogs*propose*initialize-king-stacked-frogs
   (state <s> ^superstate nil ^world <w> -^name)
-->
   (<s> ^operator <o> + >)
   (<o> ^name initialize-king-stacked-frogs ^task-operator false)
}

sp {king-stacked-frogs*apply*initialize-king-stacked-frogs
   (state <s> ^operator.name initialize-king-stacked-frogs ^world <w>)
   (<w> ^objects <objs>)
-->
   (<s> ^name king-stacked-frogs ^desireds <ds>)
   (<objs> ^object <o-location-1> <o-location-2> <o-location-3> <o-location-4> <o-block-5> <o-block-6> <o-block-7> <o-block-8> <o-task>)
   (<o-location-1> ^object-handle location-1 ^anchored true ^type location ^x 1 ^y 1 ^color red ^block-count 1)
   (<o-location-2> ^object-handle location-2 ^anchored true ^type location ^x 2 ^y 1 ^block-count 1)
   (<o-location-3> ^object-handle location-3 ^anchored true ^type location ^x 3 ^y 1 ^block-count 1)
   (<o-location-4> ^object-handle location-4 ^anchored true ^type location ^x 4 ^y 1 ^block-count 1)
   (<o-block-5> ^object-handle block-5 ^anchored true ^type block)
   (<o-block-6> ^object-handle block-6 ^anchored true ^type block)
   (<o-block-7> ^object-handle block-7 ^anchored true ^type block)
   (<o-block-8> ^object-handle block-8 ^anchored true ^type block)
   (<o-task> ^object-handle task ^anchored true ^type task)
   (<ds> ^desired-count 1 ^desired <d1>)
   (<d1> ^object <d1-o>)
   (<d1-o> ^object-handle task ^goal-met true)
   (<w> ^on <on-0>)
   (<on-0> ^argument1 <o-block-5> ^argument2 <o-location-1>)
   (<w> ^on <on-1>)
   (<on-1> ^argument1 <o-block-6> ^argument2 <o-location-2>)
   (<w> ^on <on-2>)
   (<on-2> ^argument1 <o-block-7> ^argument2 <o-location-3>)
   (<w> ^on <on-3>)
   (<on-3> ^argument1 <o-block-8> ^argument2 <o-location-4>)
   (<w> ^below <below-0>)
   (<below-0> ^argument1 <o-location-1> ^argument2 <o-block-5>)
   (<w> ^below <below-1>)
   (<below-1> ^argument1 <o-location-2> ^argument2 <o-block-6>)
   (<w> ^below <below-2>)
   (<below-2> ^argument1 <o-location-3> ^argument2 <o-block-7>)
   (<w> ^below <below-3>)
   (<below-3> ^argument1 <o-location-4> ^argument2 <o-block-8>)
   (<w> ^apart-1 <apart-1-0>)
   (<apart-1-0> ^argument1 <o-location-1> ^argument2 <o-location-2>)
   (<w> ^apart-1 <apart-1-1>)
   (<apart-1-1> ^argument1 <o-location-2> ^argument2 <o-location-1>)
   (<w> ^apart-1 <apart-1-2>)
   (<apart-1-2> ^argument1 <o-location-2> ^argument2 <o-location-3>)
   (<w> ^apart-1 <apart-1-3>)
   (<apart-1-3> ^argument1 <o-location-3> ^argument2 <o-location-2>)
   (<w> ^apart-1 <apart-1-4>)
   (<apart-1-4> ^argument1 <o-location-3> ^argument2 <o-location-4>)
   (<w> ^apart-1 <apart-1-5>)
   (<apart-1-5> ^argument1 <o-location-4> ^argument2 <o-location-3>)
   (<w> ^apart-2 <apart-2-0>)
   (<apart-2-0> ^argument1 <o-location-1> ^argument2 <o-location-3>)
   (<w> ^apart-2 <apart-2-1>)
   (<apart-2-1> ^argument1 <o-location-2> ^argument2 <o-location-4>)
   (<w> ^apart-2 <apart-2-2>)
   (<apart-2-2> ^argument1 <o-location-3> ^argument2 <o-location-1>)
   (<w> ^apart-2 <apart-2-3>)
   (<apart-2-3> ^argument1 <o-location-4> ^argument2 <o-location-2>)
   (<w> ^apart-3 <apart-3-0>)
   (<apart-3-0> ^argument1 <o-location-1> ^argument2 <o-location-4>)
   (<w> ^apart-3 <apart-3-1>)
   (<apart-3-1> ^argument1 <o-location-4> ^argument2 <o-location-1>)
   (log 1 (crlf) |Initialize king-stacked-frogs.|)
}

sp {king-stacked-frogs*elaborate*problem-space
   (state <s> ^name king-stacked-frogs)
-->
   (<s> ^problem-space <p>)
   (<p> ^name king-stacked-frogs ^copy-relation below ^copy-relation apart-1 ^copy-relation apart-2 ^copy-relation apart-3 ^dont-copy-object-attribute goal-met)
}

sp {king-stacked-frogs*elaborate*problem-space*mea-substate
   (state <s> ^impasse no-change ^attribute operator ^superstate <ss>)
   (<ss> ^problem-space.name king-stacked-frogs ^operator <so>)
   (<so> ^task-operator true -^pre-conditions-satisfied true)
-->
   (<s> ^problem-space <p>)
   (<p> ^name king-stacked-frogs ^dont-copy-object-attribute goal-met)
}

sp {king-stacked-frogs*elaborate*flags
   (state <s> ^superstate nil ^name king-stacked-frogs)
-->
   (<s> ^flag-override <f>)
   (<f> ^mea-operator-selection true ^iterative-step tie-impasse)
}

## Achievement of object-property desireds (supplied by the task).
sp {king-stacked-frogs*elaborate*state*achieved*object-property
   (state <s> ^desireds <ds> ^world <w>)
   (<ds> ^desired <d>)
   (<d> ^object <do>)
   (<do> ^object-handle $ <h> ^{ <> object-handle <a> } <v>)
   (<w> ^anchored-world true ^objects.object <ob>)
   (<ob> ^object-handle $ <h> ^<a> <v>)
-->
   (<ds> ^achieved <d>)
}

sp {king-stacked-frogs*elaborate*state*unachieved*object-property
   (state <s> ^desireds <ds> ^world <w>)
   (<ds> ^desired <d>)
   (<d> ^object <do>)
   (<do> ^object-handle $ <h> ^{ <> object-handle <a> } <v>)
   (<w> ^anchored-world true)
  -{(<w> ^objects.object <ob>)
    (<ob> ^object-handle <h> ^<a> <v>)}
-->
   (<ds> ^unachieved <d>)
}
