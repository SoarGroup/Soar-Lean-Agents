## Effect of move (look-ahead).
sp {king-stacked-frogs*apply*move*internal*blocks
   (state <s> ^operator <op> ^internal-actions true ^world <w>)
   (<op> ^task-operator true ^name move ^pre-conditions-satisfied true ^argument1.object-handle $ <ch> ^argument2.object-handle $ <lh>)
   (<w> ^anchored-world true ^objects <objs>)
   (<objs> ^object <c> <l>)
   (<c> ^object-handle $ <ch>)
   (<l> ^object-handle $ <lh>)
   (<w> ^on <r> ^below <bl>)
   (<r> ^argument1 <b> ^argument2 <c>)
   (<bl> ^argument1 <c> ^argument2 <b>)
-->
   (<r> ^argument2 <c> - <l>)
   (<bl> ^argument1 <c> - <l>)
}

## Effect of a completed move command on the real world (once per command).
sp {king-stacked-frogs*apply*move*environment-effect*blocks
   :o-support
   (state <s> ^superstate nil ^world <w> ^io.output-link.perform-action <pa>)
   (<pa> ^name move ^status complete ^argument1 <ch> ^argument2 <lh> -^effect-applied true)
   (<w> ^anchored-world true ^objects <objs>)
   (<objs> ^object <c> <l>)
   (<c> ^object-handle $ <ch>)
   (<l> ^object-handle $ <lh>)
   (<w> ^on <r> ^below <bl>)
   (<r> ^argument1 <b> ^argument2 <c>)
   (<bl> ^argument1 <c> ^argument2 <b>)
-->
   (<r> ^argument2 <c> - <l>)
   (<bl> ^argument1 <c> - <l>)
}
## Effect of move (look-ahead).
sp {king-stacked-frogs*apply*move*internal*count-onto-empty
   (state <s> ^operator <op> ^internal-actions true ^world <w>)
   (<op> ^task-operator true ^name move ^pre-conditions-satisfied true ^argument1.object-handle $ <ch> ^argument2.object-handle $ <lh>)
   (<w> ^anchored-world true ^objects <objs>)
   (<objs> ^object <c> <l>)
   (<c> ^object-handle $ <ch>)
   (<l> ^object-handle $ <lh>)
   (<c> ^block-count { <k> > 0 })
   (<l> ^block-count { <m> 0 })
-->
   (<c> ^block-count <k> - 0)
   (<l> ^block-count <m> - (+ <m> <k>))
}

## Effect of a completed move command on the real world (once per command).
sp {king-stacked-frogs*apply*move*environment-effect*count-onto-empty
   :o-support
   (state <s> ^superstate nil ^world <w> ^io.output-link.perform-action <pa>)
   (<pa> ^name move ^status complete ^argument1 <ch> ^argument2 <lh> -^effect-applied true)
   (<w> ^anchored-world true ^objects <objs>)
   (<objs> ^object <c> <l>)
   (<c> ^object-handle $ <ch>)
   (<l> ^object-handle $ <lh>)
   (<c> ^block-count { <k> > 0 })
   (<l> ^block-count { <m> 0 })
-->
   (<c> ^block-count <k> - 0)
   (<l> ^block-count <m> - (+ <m> <k>))
   (<pa> ^effect-applied true)
   (write |Move the | <k> | block(s) on | <ch> | onto | <lh> (crlf))
}
