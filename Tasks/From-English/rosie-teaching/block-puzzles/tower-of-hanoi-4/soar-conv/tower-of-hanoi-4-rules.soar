# Tower of Hanoi (tower-of-hanoi-4): standard Soar conventions (Soar-Conventions.xlsx), generated from the Rosie teaching
# script (english-input.txt) by tools/rosie_plain.py.
#
# Instructor statements used (numbers as in english-input.txt):
#   4. You can move a clear block onto a clear object that is larger than the block.
#   5. If a location is not below an object then it is clear.
#   6. If the volume of a block is more than the volume of an object then the block is larger than the object.
#   8. The goal is that there are two clear green locations.
# World: init-tower4.world (two green locations and a blue one; the blocks stacked by volume)
#
# Translation:
#   - Operator move (^block, ^destination). clear is an i-supported state attribute, for blocks and locations (A-H1).
#   - larger than: the destination's volume is more than the block's (A-H2).
#   - Desired: (<d> ^clear-locations 2 ^location-color green): two different green locations are clear (A-H3).

# Propose initialize-tower-of-hanoi-4 in the top state before it has a name.
sp {tower-of-hanoi-4*propose*initialize-tower-of-hanoi-4
   (state <s> ^superstate nil)
  -(<s> ^name)
-->
   (<s> ^operator <o> +)
   (<o> ^name initialize-tower-of-hanoi-4)
}

# Apply initialize-tower-of-hanoi-4: the objects and relations of the world file, and the desired state.
sp {tower-of-hanoi-4*apply*initialize-tower-of-hanoi-4
   (state <s> ^operator <o>)
   (<o> ^name initialize-tower-of-hanoi-4)
-->
   (<s> ^name tower-of-hanoi-4 ^desired <d>)
   (<s> ^object <x1>)
   (<x1> ^name location-1 ^type location ^color green ^volume 5)
   (<s> ^object <x2>)
   (<x2> ^name location-2 ^type location ^color green ^volume 5 ^clear true)
   (<s> ^object <x3>)
   (<x3> ^name location-3 ^type location ^color blue ^volume 5 ^clear true)
   (<s> ^object <x4>)
   (<x4> ^name block-4 ^type block ^size tiny ^volume 1 ^clear true)
   (<s> ^object <x5>)
   (<x5> ^name block-5 ^type block ^size small ^volume 2)
   (<s> ^object <x6>)
   (<x6> ^name block-6 ^type block ^size medium ^volume 3)
   (<s> ^object <x7>)
   (<x7> ^name block-7 ^type block ^size large ^volume 4)
   (<x4> ^on <x5>)
   (<x5> ^on <x6>)
   (<x6> ^on <x7>)
   (<x7> ^on <x1>)
   (<d> ^clear-locations 2 ^location-color green)
}

# Elaborate the problem space: the look-ahead copies the objects (two levels) and the operators.
sp {tower-of-hanoi-4*elaborate*problem-space
   (state <s> ^name tower-of-hanoi-4)
-->
   (<s> ^problem-space <p>)
   (<p> ^name tower-of-hanoi-4 ^default-state-copy yes ^default-operator-copy yes ^two-level-attributes object)
}

# Halt when the top state reaches the desired state.
sp {tower-of-hanoi-4*halt*success
   (state <s> ^superstate nil ^name tower-of-hanoi-4 ^desired <d> ^success <d>)
-->
   (write (crlf) |The problem has been solved.|)
   (halt)
}

# Halt when the top state is a losing state.
sp {tower-of-hanoi-4*halt*failure
   (state <s> ^superstate nil ^name tower-of-hanoi-4 ^desired <d> ^failure <d>)
-->
   (write (crlf) |The task has failed.|)
   (halt)
}

# Propose move: a clear block onto a clear object that is larger than the block (volume, statement on larger).
sp {tower-of-hanoi-4*propose*move
   (state <s> ^name tower-of-hanoi-4 ^object <b> { <dest> <> <b> })
   (<b> ^type block ^clear true)
   (<dest> ^clear true)
   (<b> ^volume <vb>)
   (<dest> ^volume > <vb>)
-->
   (<s> ^operator <o> +)
   (<o> ^name move ^block <b> ^destination <dest>)
}

# Apply move: the block is on the destination instead of what it was on; what it was on is clear, the destination is not.
sp {tower-of-hanoi-4*apply*move
   (state <s> ^name tower-of-hanoi-4 ^operator <o>)
   (<o> ^name move ^block <b> ^destination <dest>)
   (<b> ^on <old>)
   (<dest> ^clear true)
-->
   (<b> ^on <old> - <dest>)
   (<old> ^clear true)
   (<dest> ^clear true -)
}

# Monitor: print the task operator selected in the top state (the plan).
sp {tower-of-hanoi-4*monitor*move
   (state <s> ^superstate nil ^name tower-of-hanoi-4 ^operator <o>)
   (<o> ^name move ^block.name <h1> ^destination.name <h2>)
-->
   (write (crlf) |ACTION: move | <h1> | | <h2>)
}

# Desired state: two different clear locations of the desired color.
sp {tower-of-hanoi-4*elaborate*goal*two-clear-locations
   (state <s> ^name tower-of-hanoi-4 ^desired <d> ^object <l1> { <l2> <> <l1> })
   (<d> ^clear-locations 2 ^location-color <c>)
   (<l1> ^type location ^color <c> ^clear true)
   (<l2> ^type location ^color <c> ^clear true)
-->
   (<s> ^success <d>)
}
