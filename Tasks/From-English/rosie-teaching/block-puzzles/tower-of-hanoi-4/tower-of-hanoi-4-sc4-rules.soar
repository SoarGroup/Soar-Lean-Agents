## Tower of Hanoi (tower-of-hanoi-4), generated from the Rosie teaching script (english-input.txt) under the world conventions.
##
## Instructor statements used (numbers as in english-input.txt):
##   4. You can move a clear block onto a clear object that is larger than the block.
##   5. If a location is not below an object then it is clear.
##   6. If the volume of a block is more than the volume of an object then the block is larger than the object.
##   8. The goal is that there are two clear green locations.
## World: init-tower4.world (two green locations and a blue one; the blocks stacked by volume on a green location)
##
## Translation (tools/rosie-language.md gives the general reading; the assumption ledger is in README.md):
##   - Operator move (argument1 = the block, argument2 = the object it is moved onto).
##   - clear tests absence and decides legality, so it is a maintained one-argument relation (W-SPEC v6 section 3); it
##     applies to blocks as well as locations (A-H1).
##   - larger than is expanded in place: the destination's volume is more than the block's (A-H2).
##   - The goal is ^goal-met true on the task object when two different green locations are clear (A-H3).

## Propose initialize-tower-of-hanoi-4 when its conditions below hold.
sp {tower-of-hanoi-4*propose*initialize-tower-of-hanoi-4
   (state <s> ^superstate nil ^world <w> -^name)
-->
   (<s> ^operator <o> + >)
   (<o> ^name initialize-tower-of-hanoi-4 ^task-operator false)
}

sp {tower-of-hanoi-4*apply*initialize-tower-of-hanoi-4
   (state <s> ^operator.name initialize-tower-of-hanoi-4 ^world <w>)
   (<w> ^objects <objs>)
-->
   (<s> ^name tower-of-hanoi-4 ^desireds <ds>)
   (<objs> ^object <o-location-1> <o-location-2> <o-location-3> <o-block-4> <o-block-5> <o-block-6> <o-block-7> <o-task>)
   (<o-location-1> ^object-handle location-1 ^anchored true ^type location ^color green ^volume 5)
   (<o-location-2> ^object-handle location-2 ^anchored true ^type location ^color green ^volume 5)
   (<o-location-3> ^object-handle location-3 ^anchored true ^type location ^color blue ^volume 5)
   (<o-block-4> ^object-handle block-4 ^anchored true ^type block ^size tiny ^volume 1)
   (<o-block-5> ^object-handle block-5 ^anchored true ^type block ^size small ^volume 2)
   (<o-block-6> ^object-handle block-6 ^anchored true ^type block ^size medium ^volume 3)
   (<o-block-7> ^object-handle block-7 ^anchored true ^type block ^size large ^volume 4)
   (<o-task> ^object-handle task ^anchored true ^type task)
   (<ds> ^desired-count 1 ^desired <d1>)
   (<d1> ^object <d1-o>)
   (<d1-o> ^object-handle task ^goal-met true)
   (<w> ^on <on-0>)
   (<on-0> ^argument1 <o-block-4> ^argument2 <o-block-5>)
   (<w> ^on <on-1>)
   (<on-1> ^argument1 <o-block-5> ^argument2 <o-block-6>)
   (<w> ^on <on-2>)
   (<on-2> ^argument1 <o-block-6> ^argument2 <o-block-7>)
   (<w> ^on <on-3>)
   (<on-3> ^argument1 <o-block-7> ^argument2 <o-location-1>)
   (<w> ^below <below-0>)
   (<below-0> ^argument1 <o-block-5> ^argument2 <o-block-4>)
   (<w> ^below <below-1>)
   (<below-1> ^argument1 <o-block-6> ^argument2 <o-block-5>)
   (<w> ^below <below-2>)
   (<below-2> ^argument1 <o-block-7> ^argument2 <o-block-6>)
   (<w> ^below <below-3>)
   (<below-3> ^argument1 <o-location-1> ^argument2 <o-block-7>)
   (<w> ^clear <clear-location-2>)
   (<clear-location-2> ^argument1 <o-location-2>)
   (<w> ^clear <clear-location-3>)
   (<clear-location-3> ^argument1 <o-location-3>)
   (<w> ^clear <clear-block-4>)
   (<clear-block-4> ^argument1 <o-block-4>)
   (log 1 (crlf) |Initialize tower-of-hanoi-4.|)
}

## Elaborate problem space: adds ^copy-relation, ^dont-copy-object-attribute, ^problem-space.
sp {tower-of-hanoi-4*elaborate*problem-space
   (state <s> ^name tower-of-hanoi-4)
-->
   (<s> ^problem-space <p>)
   (<p> ^name tower-of-hanoi-4 ^copy-relation below ^copy-relation clear ^dont-copy-object-attribute goal-met)
}

sp {tower-of-hanoi-4*elaborate*problem-space*mea-substate
   (state <s> ^impasse no-change ^attribute operator ^superstate <ss>)
   (<ss> ^problem-space.name tower-of-hanoi-4 ^operator <so>)
   (<so> ^task-operator true -^pre-conditions-satisfied true)
-->
   (<s> ^problem-space <p>)
   (<p> ^name tower-of-hanoi-4 ^dont-copy-object-attribute goal-met)
}

## Elaborate flags: adds ^flag-override, ^mea-operator-selection.
sp {tower-of-hanoi-4*elaborate*flags
   (state <s> ^superstate nil ^name tower-of-hanoi-4)
-->
   (<s> ^flag-override <f>)
   (<f> ^mea-operator-selection true)
}

## Achievement of object-property desireds (supplied by the task).
sp {tower-of-hanoi-4*elaborate*state*achieved*object-property
   (state <s> ^problem-space.name tower-of-hanoi-4 ^desireds <ds> ^world <w>)
   (<ds> ^desired <d>)
   (<d> ^object <do>)
   (<do> ^object-handle $ <h> ^{ <> object-handle <a> } <v>)
   (<w> ^anchored-world true ^objects.object <ob>)
   (<ob> ^object-handle $ <h> ^<a> <v>)
-->
   (<ds> ^achieved <d>)
}

sp {tower-of-hanoi-4*elaborate*state*unachieved*object-property
   (state <s> ^problem-space.name tower-of-hanoi-4 ^desireds <ds> ^world <w>)
   (<ds> ^desired <d>)
   (<d> ^object <do>)
   (<do> ^object-handle $ <h> ^{ <> object-handle <a> } <v>)
   (<w> ^anchored-world true)
  -{(<w> ^objects.object <ob>)
    (<ob> ^object-handle <h> ^<a> <v>)}
-->
   (<ds> ^unachieved <d>)
}
## Propose move in problem space tower-of-hanoi-4 when its conditions below hold.
sp {tower-of-hanoi-4*propose*move
   (state <s> ^problem-space.name tower-of-hanoi-4 ^flags.mea-operator-selection true ^world <w> ^desireds <ds>)
   (<w> ^anchored-world true ^objects <objs>)
   (<objs> ^object <b> <d>)
   (<b> ^type block ^object-handle $ <bh>)
   (<d> ^object-handle $ <dh>)
   (<w> ^clear <cb> <cd>)
   (<cb> ^argument1 <b>)
   (<cd> ^argument1 <d>)
   (<b> ^volume <bv>)
   (<d> ^volume > <bv>)
   (<ds> ^unachieved-desireds true)
-->
   (<s> ^operator <op> +)
   (<op> ^name move ^task-operator true ^action-handle move ^argument1 <b> ^argument2 <d> ^argument-count 2 ^desireds <pre>)
   (<pre> ^desired-count 0)
}
## Effect of move (look-ahead).
sp {tower-of-hanoi-4*apply*move*internal
   (state <s> ^problem-space.name tower-of-hanoi-4 ^operator <op> ^internal-actions true ^world <w>)
   (<op> ^task-operator true ^name move ^pre-conditions-satisfied true ^argument1.object-handle $ <bh> ^argument2.object-handle $ <dh>)
   (<w> ^anchored-world true ^objects <objs>)
   (<objs> ^object <b> <d>)
   (<b> ^object-handle $ <bh>)
   (<d> ^object-handle $ <dh>)
   (<w> ^on <r> ^below <bl> ^clear <cd>)
   (<r> ^argument1 <b> ^argument2 <old>)
   (<bl> ^argument1 <old> ^argument2 <b>)
   (<cd> ^argument1 <d>)
-->
   (<r> ^argument2 <old> - <d>)
   (<bl> ^argument1 <old> - <d>)
   (<w> ^clear <cd> - <nc>)
   (<nc> ^argument1 <old>)
}

## Effect of a completed move command on the real world (once per command).
sp {tower-of-hanoi-4*apply*move*environment-effect
   :o-support
   (state <s> ^problem-space.name tower-of-hanoi-4 ^superstate nil ^world <w> ^io.output-link.perform-action <pa>)
   (<pa> ^name move ^status complete ^argument1 <bh> ^argument2 <dh> -^effect-applied true)
   (<w> ^anchored-world true ^objects <objs>)
   (<objs> ^object <b> <d>)
   (<b> ^object-handle $ <bh>)
   (<d> ^object-handle $ <dh>)
   (<w> ^on <r> ^below <bl> ^clear <cd>)
   (<r> ^argument1 <b> ^argument2 <old>)
   (<bl> ^argument1 <old> ^argument2 <b>)
   (<cd> ^argument1 <d>)
-->
   (<r> ^argument2 <old> - <d>)
   (<bl> ^argument1 <old> - <d>)
   (<w> ^clear <cd> - <nc>)
   (<nc> ^argument1 <old>)
   (<pa> ^effect-applied true)
   (write |Move | <bh> | onto | <dh> (crlf))
}
## Goal: two different green locations are clear.
sp {tower-of-hanoi-4*elaborate*goal*two-clear-green-locations
   (state <s> ^problem-space.name tower-of-hanoi-4 ^world <w>)
   (<w> ^objects <objs> ^clear <c1> <c2>)
   (<objs> ^object <t> <l1> <l2>)
   (<t> ^type task)
   (<l1> ^type location ^color green ^object-handle $ <h1>)
   (<l2> ^type location ^color green ^object-handle { <> <h1> <h2> })
   (<c1> ^argument1 <l1>)
   (<c2> ^argument1 <l2>)
-->
   (<t> ^goal-met true)
}
## SC-4 [method]: work toward one block at a time, recursively (largest block not in place, then whatever is in its way).
## In place (state elaboration): the largest block on the home location.
sp {tower-of-hanoi-4*sc-4*elaborate*in-place*largest
   (state <s> ^problem-space.name tower-of-hanoi-4 ^world <w>)
   (<w> ^anchored-world true ^objects <objs> ^on <r>)
   (<objs> ^object <b> <h>)
   (<b> ^type block ^volume <bv>)
   (<h> ^type location ^color blue)
   (<r> ^argument1 <b> ^argument2 <h>)
  -{(<objs> ^object <x>)
    (<x> ^type block ^volume > <bv>)}
-->
   (<s> ^sc-4-in-place <b>)
}

## In place: a block on the next larger block, when that block is in place.
sp {tower-of-hanoi-4*sc-4*elaborate*in-place*next
   (state <s> ^problem-space.name tower-of-hanoi-4 ^world <w>)
   (<s> ^sc-4-in-place <y>)
   (<w> ^anchored-world true ^objects <objs> ^on <r>)
   (<objs> ^object <b>)
   (<b> ^type block ^volume <bv>)
   (<y> ^volume <yv>)
   (<r> ^argument1 <b> ^argument2 <y>)
  -{(<objs> ^object <x>)
    (<x> ^type block ^volume { > <bv> < <yv> })}
-->
   (<s> ^sc-4-in-place <b>)
}

## The location (peg) a block is on: directly on a location.
sp {tower-of-hanoi-4*sc-4*elaborate*peg*base
   (state <s> ^problem-space.name tower-of-hanoi-4 ^world <w>)
   (<w> ^anchored-world true ^on <r>)
   (<r> ^argument1 <b> ^argument2 <l>)
   (<b> ^type block)
   (<l> ^type location)
-->
   (<s> ^sc-4-peg <p>)
   (<p> ^block <b> ^location <l>)
}

## The location (peg) a block is on: on a block that is on that peg.
sp {tower-of-hanoi-4*sc-4*elaborate*peg*stack
   (state <s> ^problem-space.name tower-of-hanoi-4 ^world <w>)
   (<s> ^sc-4-peg <q>)
   (<q> ^block <y> ^location <l>)
   (<w> ^anchored-world true ^on <r>)
   (<r> ^argument1 <b> ^argument2 <y>)
   (<b> ^type block)
-->
   (<s> ^sc-4-peg <p>)
   (<p> ^block <b> ^location <l>)
}

## Above: a block directly on another block.
sp {tower-of-hanoi-4*sc-4*elaborate*above*direct
   (state <s> ^problem-space.name tower-of-hanoi-4 ^world <w>)
   (<w> ^anchored-world true ^on <r>)
   (<r> ^argument1 <c> ^argument2 <b>)
   (<c> ^type block)
   (<b> ^type block)
-->
   (<s> ^sc-4-above <a>)
   (<a> ^upper <c> ^lower <b>)
}

## Above: a block on a block that is above another.
sp {tower-of-hanoi-4*sc-4*elaborate*above*stack
   (state <s> ^problem-space.name tower-of-hanoi-4 ^world <w>)
   (<s> ^sc-4-above <q>)
   (<q> ^upper <y> ^lower <b>)
   (<w> ^anchored-world true ^on <r>)
   (<r> ^argument1 <c> ^argument2 <y>)
   (<c> ^type block)
-->
   (<s> ^sc-4-above <a>)
   (<a> ^upper <c> ^lower <b>)
}

## The first goal: the largest block not in place goes to the home location (all larger blocks are in place there).
sp {tower-of-hanoi-4*sc-4*elaborate*goal*first
   (state <s> ^problem-space.name tower-of-hanoi-4 ^world <w>)
   (<w> ^anchored-world true ^objects <objs>)
   (<objs> ^object <b> <h>)
   (<b> ^type block ^volume <bv>)
   (<h> ^type location ^color blue)
  -(<s> ^sc-4-in-place <b>)
  -{(<objs> ^object <z>)
    (<z> ^type block ^volume > <bv>)
    -(<s> ^sc-4-in-place <z>)}
-->
   (<s> ^sc-4-goal <g>)
   (<g> ^block <b> ^location <h>)
}

## A goal's blocker: a block above the goal's block.
sp {tower-of-hanoi-4*sc-4*elaborate*goal*blocker*above
   (state <s> ^problem-space.name tower-of-hanoi-4 ^world <w>)
   (<s> ^sc-4-goal <g> ^sc-4-above <a>)
   (<g> ^block <b>)
   (<a> ^upper <c> ^lower <b>)
-->
   (<g> ^blocker <c>)
}

## A goal's blocker: a block smaller than the goal's block on the goal's location.
sp {tower-of-hanoi-4*sc-4*elaborate*goal*blocker*on-location
   (state <s> ^problem-space.name tower-of-hanoi-4 ^world <w>)
   (<s> ^sc-4-goal <g> ^sc-4-peg <p>)
   (<g> ^block <b> ^location <l>)
   (<b> ^volume <bv>)
   (<p> ^block { <> <b> <c> } ^location <l>)
   (<c> ^volume < <bv>)
-->
   (<g> ^blocker <c>)
}

## A subgoal: the largest blocker goes to the third location (neither the goal block's location nor the goal's location).
sp {tower-of-hanoi-4*sc-4*elaborate*goal*subgoal
   (state <s> ^problem-space.name tower-of-hanoi-4 ^world <w>)
   (<s> ^sc-4-goal <g> ^sc-4-peg <p>)
   (<g> ^block <b> ^location <l> ^blocker <c>)
   (<c> ^volume <cv>)
  -{(<g> ^blocker <c2>)
    (<c2> ^volume > <cv>)}
   (<p> ^block <b> ^location { <> <l> <bl> })
   (<w> ^anchored-world true ^objects <objs>)
   (<objs> ^object { <> <l> <> <bl> <third> })
   (<third> ^type location)
-->
   (<s> ^sc-4-goal <g2>)
   (<g2> ^block <c> ^location <third>)
}

## Control: the move of a goal with nothing in its way is best: onto its location when that location is clear ...
sp {tower-of-hanoi-4*sc-4*compare*move*goal*to-location*best
   (state <s> ^problem-space.name tower-of-hanoi-4 ^operator <o> + ^sc-4-goal <g>)
   (<g> ^block.object-handle $ <bh> ^location.object-handle $ <lh>)
  -(<g> ^blocker)
   (<o> ^name move ^argument1.object-handle $ <bh> ^argument2.object-handle $ <lh>)
-->
   (<s> ^operator <o> >)
}

## ... or onto the top block on that location.
sp {tower-of-hanoi-4*sc-4*compare*move*goal*to-block*best
   (state <s> ^problem-space.name tower-of-hanoi-4 ^operator <o> + ^sc-4-goal <g> ^sc-4-peg <p>)
   (<g> ^block.object-handle $ <bh> ^location <l>)
  -(<g> ^blocker)
   (<p> ^block <d> ^location <l>)
   (<d> ^object-handle $ <dh>)
   (<o> ^name move ^argument1.object-handle $ <bh> ^argument2.object-handle $ <dh>)
-->
   (<s> ^operator <o> >)
}
