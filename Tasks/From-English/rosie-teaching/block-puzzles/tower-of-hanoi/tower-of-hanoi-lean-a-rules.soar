## Tower of Hanoi (tower-of-hanoi): generated by rosiegen (WorldSpec, path A: Lean) from the instructor statements.
##
## Instructor statements used (numbers as in english-input.txt):
##  4. You can move a clear block onto a clear object that is larger than the block.
##  5. If a location is not below an object then it is clear.
##  6. If the volume of a block is more than the volume of an object then the block is larger than the object.
##  8. The goal is that there are two clear green locations.
##
## Assumption ledger:
##   A-H1: "clear" is defined for a location but used for "a clear block": any object that is not below an object is clear.
##   A-H2: "larger than": X is larger than Y when X's volume is more than Y's.
##   A-H3: "two clear green locations": two different green locations, both clear.
##   A-H4: Moving X onto Y: X's on relation and the matching below relation now name Y; the object X left becomes clear.
##   A-H5: The action has no name in the dialog; it is called move.

sp {tower-of-hanoi*propose*initialize-tower-of-hanoi
   (state <s> ^superstate nil ^world <w> -^name)
-->
   (<s> ^operator <o> + >)
   (<o> ^name initialize-tower-of-hanoi ^task-operator false)
}

sp {tower-of-hanoi*apply*initialize-tower-of-hanoi
   (state <s> ^operator.name initialize-tower-of-hanoi ^world <w>)
   (<w> ^objects <objs>)
-->
   (<s> ^name tower-of-hanoi ^desireds <ds>)
   (<objs> ^object <k-location-1> <k-location-2> <k-location-3> <k-block-4> <k-block-5> <k-block-6> <k-task>)
   (<k-location-1> ^object-handle location-1 ^anchored true ^type location ^color green ^volume 4)
   (<k-location-2> ^object-handle location-2 ^anchored true ^type location ^color green ^volume 4)
   (<k-location-3> ^object-handle location-3 ^anchored true ^type location ^color blue ^volume 4)
   (<k-block-4> ^object-handle block-4 ^anchored true ^type block ^size small ^volume 1)
   (<k-block-5> ^object-handle block-5 ^anchored true ^type block ^size medium ^volume 2)
   (<k-block-6> ^object-handle block-6 ^anchored true ^type block ^size large ^volume 3)
   (<k-task> ^object-handle task ^anchored true ^type task)
   (<ds> ^desired-count 1 ^desired <d1>)
   (<d1> ^object <d1-o>)
   (<d1-o> ^object-handle task ^goal-met true)
   (<w> ^on <rel-1>)
   (<rel-1> ^argument1 <k-block-4> ^argument2 <k-block-5>)
   (<w> ^on <rel-2>)
   (<rel-2> ^argument1 <k-block-5> ^argument2 <k-block-6>)
   (<w> ^on <rel-3>)
   (<rel-3> ^argument1 <k-block-6> ^argument2 <k-location-1>)
   (<w> ^below <rel-4>)
   (<rel-4> ^argument1 <k-block-5> ^argument2 <k-block-4>)
   (<w> ^below <rel-5>)
   (<rel-5> ^argument1 <k-block-6> ^argument2 <k-block-5>)
   (<w> ^below <rel-6>)
   (<rel-6> ^argument1 <k-location-1> ^argument2 <k-block-6>)
   (<w> ^clear <rel-7>)
   (<rel-7> ^argument1 <k-location-2>)
   (<w> ^clear <rel-8>)
   (<rel-8> ^argument1 <k-location-3>)
   (<w> ^clear <rel-9>)
   (<rel-9> ^argument1 <k-block-4>)
   (log 1 (crlf) |Initialize tower-of-hanoi.|)
}

sp {tower-of-hanoi*elaborate*problem-space
   (state <s> ^name tower-of-hanoi)
-->
   (<s> ^problem-space <p>)
   (<p> ^name tower-of-hanoi ^copy-relation below ^copy-relation clear ^dont-copy-object-attribute goal-met)
}

sp {tower-of-hanoi*elaborate*problem-space*mea-substate
   (state <s> ^impasse no-change ^attribute operator ^superstate <ss>)
   (<ss> ^problem-space.name tower-of-hanoi ^operator <so>)
   (<so> ^task-operator true -^pre-conditions-satisfied true)
-->
   (<s> ^problem-space <p>)
   (<p> ^name tower-of-hanoi ^dont-copy-object-attribute goal-met)
}

sp {tower-of-hanoi*elaborate*flags
   (state <s> ^superstate nil ^name tower-of-hanoi)
-->
   (<s> ^flag-override <f>)
   (<f> ^mea-operator-selection true)
}

## Achievement of object-property desireds (supplied by the task).
sp {tower-of-hanoi*elaborate*state*achieved*object-property
   (state <s> ^desireds <ds> ^world <w>)
   (<ds> ^desired <d>)
   (<d> ^object <do>)
   (<do> ^object-handle <h> ^{ <> object-handle <a> } <v>)
   (<w> ^anchored-world true ^objects.object <ob>)
   (<ob> ^object-handle <h> ^<a> <v>)
-->
   (<ds> ^achieved <d>)
}

sp {tower-of-hanoi*elaborate*state*unachieved*object-property
   (state <s> ^desireds <ds> ^world <w>)
   (<ds> ^desired <d>)
   (<d> ^object <do>)
   (<do> ^object-handle <h> ^{ <> object-handle <a> } <v>)
   (<w> ^anchored-world true)
  -{(<w> ^objects.object <ob>)
    (<ob> ^object-handle <h> ^<a> <v>)}
-->
   (<ds> ^unachieved <d>)
}

## Operator move (statements 4, 6).
sp {tower-of-hanoi*propose*move
   (state <s> ^problem-space.name tower-of-hanoi ^flags.mea-operator-selection true ^world <w> ^desireds <ds>)
   (<w> ^anchored-world true ^objects <objs>)
   (<objs> ^object <b>)
   (<b> ^type block)
   (<objs> ^object <d>)
   (<w> ^clear <r1>)
   (<r1> ^argument1 <b>)
   (<w> ^clear <r2>)
   (<r2> ^argument1 <d>)
   (<b> ^volume <b-volume>)
   (<d> ^volume > <b-volume>)
   (<ds> ^unachieved <any-unachieved>)
-->
   (<s> ^operator <op> +)
   (<op> ^name move ^task-operator true ^action-handle move ^argument1 <b> ^argument2 <d> ^argument-count 2 ^desireds <pre>)
   (<pre> ^desired-count 0)
}

## Effect of move (look-ahead).
sp {tower-of-hanoi*apply*move*internal
   (state <s> ^operator <op> ^internal-actions true ^world <w>)
   (<op> ^task-operator true ^name move ^pre-conditions-satisfied true ^argument1.object-handle $ <b-h> ^argument2.object-handle $ <d-h>)
   (<w> ^anchored-world true ^objects <objs>)
   (<objs> ^object <b>)
   (<b> ^object-handle $ <b-h>)
   (<objs> ^object <d>)
   (<d> ^object-handle $ <d-h>)
   (<w> ^on <r1>)
   (<r1> ^argument1 <b> ^argument2 <old>)
   (<w> ^below <r2>)
   (<r2> ^argument1 <old> ^argument2 <b>)
   (<w> ^clear <e3>)
   (<e3> ^argument1 <d>)
-->
   (<r1> ^argument2 <old> - <d>)
   (<r2> ^argument1 <old> - <d>)
   (<w> ^clear <e3> -)
   (<w> ^clear <new-4>)
   (<new-4> ^argument1 <old>)
}

## Effect of a completed move command on the real world (once per command).
sp {tower-of-hanoi*apply*move*environment-effect
   :o-support
   (state <s> ^superstate nil ^world <w> ^io.output-link.perform-action <pa>)
   (<pa> ^name move ^status complete ^argument1 <b-h> ^argument2 <d-h> -^effect-applied true)
   (<w> ^anchored-world true ^objects <objs>)
   (<objs> ^object <b>)
   (<b> ^object-handle $ <b-h>)
   (<objs> ^object <d>)
   (<d> ^object-handle $ <d-h>)
   (<w> ^on <r1>)
   (<r1> ^argument1 <b> ^argument2 <old>)
   (<w> ^below <r2>)
   (<r2> ^argument1 <old> ^argument2 <b>)
   (<w> ^clear <e3>)
   (<e3> ^argument1 <d>)
-->
   (<r1> ^argument2 <old> - <d>)
   (<r2> ^argument1 <old> - <d>)
   (<w> ^clear <e3> -)
   (<w> ^clear <new-4>)
   (<new-4> ^argument1 <old>)
   (<pa> ^effect-applied true)
   (write |Move | <b-h> | onto | <d-h> (crlf))
}

## Goal (statement 8): ^goal-met true on the task object.
sp {tower-of-hanoi*elaborate*goal
   (state <s> ^world <w>)
   (<w> ^anchored-world true ^objects <objs>)
   (<objs> ^object <task>)
   (<task> ^type task)
   (<objs> ^object <l1>)
   (<l1> ^type location)
   (<l1> ^color green)
   (<objs> ^object <l2>)
   (<l2> ^type location)
   (<l2> ^color green)
   (<objs> ^object { <> <l1> <l2> })
   (<w> ^clear <r1>)
   (<r1> ^argument1 <l1>)
   (<w> ^clear <r2>)
   (<r2> ^argument1 <l2>)
-->
   (<task> ^goal-met true)
}
