## Tower of Hanoi (tower-of-hanoi), generated from the Rosie teaching script (english-input.txt) under the world conventions.
##
## Instructor statements used (numbers as in english-input.txt):
##   5. If a location is not below an object then it is clear.
##   6. If the volume of a block is more than the volume of an object then the block is larger than the object.
##   7. Load final-tower3.
##   9. Ok.
## World: init-tower3.world (two green locations and a blue one; the blocks stacked by volume on a green location)
##
## Translation (tools/rosie-language.md gives the general reading; the assumption ledger is in README.md):
##   - Operator move (argument1 = the block, argument2 = the object it is moved onto).
##   - clear tests absence and decides legality, so it is a maintained one-argument relation (W-SPEC v6 section 3); it
##     applies to blocks as well as locations (A-H1).
##   - larger than is expanded in place: the destination's volume is more than the block's (A-H2).
##   - The goal is ^goal-met true on the task object when two different green locations are clear (A-H3).
## Matching hints for learned rules (World-Conventions L3-095, L11-009): many-valued attributes, sized from the initial world.
production optimize-attribute location 7
production optimize-attribute task 7
production optimize-attribute object 7
production optimize-attribute on 3
production optimize-attribute below 3
production optimize-attribute clear 3


## Propose initialize-tower-of-hanoi when its conditions below hold.
sp {tower-of-hanoi*propose*initialize-tower-of-hanoi
   (state <s> ^superstate nil ^world <w> -^name)
-->
   (<s> ^operator <o> + >)
   (<o> ^name initialize-tower-of-hanoi ^task-operator false)
}

sp {tower-of-hanoi*apply*initialize-tower-of-hanoi
   (state <s> ^operator.name initialize-tower-of-hanoi ^world <w>)
   (<w> ^objects <objs>)
-->
   (<s> ^name tower-of-hanoi ^desireds <ds>)
   (<objs> ^location <o-location-1> <o-location-2> <o-location-3> ^block <o-block-4> <o-block-5> <o-block-6> ^task <o-task>)
   (<o-location-1> ^object-handle location-1 ^anchored true ^type location ^color green ^volume 4 ^static true)
   (<o-location-2> ^object-handle location-2 ^anchored true ^type location ^color green ^volume 4 ^static true)
   (<o-location-3> ^object-handle location-3 ^anchored true ^type location ^color blue ^volume 4 ^static true)
   (<o-block-4> ^object-handle block-4 ^anchored true ^type block ^size small ^volume 1 ^static true)
   (<o-block-5> ^object-handle block-5 ^anchored true ^type block ^size medium ^volume 2 ^static true)
   (<o-block-6> ^object-handle block-6 ^anchored true ^type block ^size large ^volume 3 ^static true)
   (<o-task> ^object-handle task ^anchored true ^type task)
   (<ds> ^desired-count 1 ^desired <d1>)
   (<d1> ^object <d1-o>)
   (<d1-o> ^object-handle task ^goal-met true)
   (<w> ^on <on-0>)
   (<on-0> ^argument1 <o-block-4> ^argument2 <o-block-5>)
   (<w> ^on <on-1>)
   (<on-1> ^argument1 <o-block-5> ^argument2 <o-block-6>)
   (<w> ^on <on-2>)
   (<on-2> ^argument1 <o-block-6> ^argument2 <o-location-1>)
   (<w> ^below <below-0>)
   (<below-0> ^argument1 <o-block-5> ^argument2 <o-block-4>)
   (<w> ^below <below-1>)
   (<below-1> ^argument1 <o-block-6> ^argument2 <o-block-5>)
   (<w> ^below <below-2>)
   (<below-2> ^argument1 <o-location-1> ^argument2 <o-block-6>)
   (<w> ^clear <clear-location-2>)
   (<clear-location-2> ^argument1 <o-location-2>)
   (<w> ^clear <clear-location-3>)
   (<clear-location-3> ^argument1 <o-location-3>)
   (<w> ^clear <clear-block-4>)
   (<clear-block-4> ^argument1 <o-block-4>)
   (log 1 (crlf) |Initialize tower-of-hanoi.|)
}

## Elaborate problem space: adds ^copy-relation, ^dont-copy-object-attribute, ^problem-space.
sp {tower-of-hanoi*elaborate*problem-space
   (state <s> ^name tower-of-hanoi)
-->
   (<s> ^problem-space <p>)
   (<p> ^name tower-of-hanoi ^copy-relation below ^copy-relation clear ^dont-copy-object-attribute goal-met)
}

sp {tower-of-hanoi*elaborate*problem-space*mea-substate
   (state <s> ^impasse no-change ^attribute operator ^superstate <ss>)
   (<ss> ^problem-space.name tower-of-hanoi ^operator <so>)
   (<so> ^task-operator true -^pre-conditions-satisfied true)
-->
   (<s> ^problem-space <p>)
   (<p> ^name tower-of-hanoi ^dont-copy-object-attribute goal-met)
}

## Elaborate flags: adds ^flag-override, ^mea-operator-selection.
sp {tower-of-hanoi*elaborate*flags
   (state <s> ^superstate nil ^name tower-of-hanoi)
-->
   (<s> ^flag-override <f>)
   (<f> ^mea-operator-selection true)
}

## Achievement of object-property desireds (supplied by the task).
sp {tower-of-hanoi*elaborate*state*achieved*object-property
   (state <s> ^problem-space.name tower-of-hanoi ^desireds <ds> ^world <w>)
   (<ds> ^desired <d>)
   (<d> ^object <do>)
   (<do> ^object-handle $ <h> ^{ <> object-handle <a> } <v>)
   (<w> ^anchored-world true ^objects.object <ob>)
   (<ob> ^object-handle $ <h> ^<a> <v>)
-->
   (<ds> ^achieved <d>)
}

sp {tower-of-hanoi*elaborate*state*unachieved*object-property
   (state <s> ^problem-space.name tower-of-hanoi ^desireds <ds> ^world <w>)
   (<ds> ^desired <d>)
   (<d> ^object <do>)
   (<do> ^object-handle $ <h> ^{ <> object-handle <a> } <v>)
   (<w> ^anchored-world true)
  -{(<w> ^objects.object <ob>)
    (<ob> ^object-handle <h> ^<a> <v>)}
-->
   (<ds> ^unachieved <d>)
}
## Propose move in problem space tower-of-hanoi when its conditions below hold.
sp {tower-of-hanoi*propose*move
   (state <s> ^problem-space.name tower-of-hanoi ^flags.mea-operator-selection true ^world <w> ^desireds <ds>)
   (<w> ^anchored-world true ^objects <objs>)
   (<objs> ^block <b>)
   (<b> ^object-handle $ <bh>)
   (<d> ^object-handle $ <dh>)
   (<w> ^clear <cb> <cd>)
   (<cb> ^argument1 <b>)
   (<cd> ^argument1 <d>)
   (<b> ^volume <bv>)
   (<d> ^volume > <bv>)
   (<ds> ^unachieved-desireds true)
-->
   (<s> ^operator <op> +)
   (<op> ^name move ^task-operator true ^action-handle move ^argument1 <b> ^argument2 <d> ^argument-count 2 ^pre-conditions-satisfied true)
}
## Effect of move (look-ahead).
sp {tower-of-hanoi*apply*move*internal
   (state <s> ^problem-space.name tower-of-hanoi ^operator <op> ^internal-actions true ^world <w>)
   (<op> ^task-operator true ^name move ^pre-conditions-satisfied true ^argument1.object-handle $ <bh> ^argument2.object-handle $ <dh>)
   (<w> ^anchored-world true ^objects <objs>)
   (<objs> ^block <b>)
   (<b> ^object-handle $ <bh>)
   (<d> ^object-handle $ <dh>)
   (<w> ^on <r> ^below <bl> ^clear <cd>)
   (<r> ^argument1 <b> ^argument2 <old>)
   (<bl> ^argument1 <old> ^argument2 <b>)
   (<cd> ^argument1 <d>)
-->
   (<r> ^argument2 <old> - <d>)
   (<bl> ^argument1 <old> - <d>)
   (<w> ^clear <cd> - <nc>)
   (<nc> ^argument1 <old>)
}

## Effect of a completed move command on the real world (once per command).
sp {tower-of-hanoi*apply*move*environment-effect
   :o-support
   (state <s> ^problem-space.name tower-of-hanoi ^superstate nil ^world <w> ^io.output-link.perform-action <pa>)
   (<pa> ^name move ^status complete ^argument1 <bh> ^argument2 <dh> -^effect-applied true)
   (<w> ^anchored-world true ^objects <objs>)
   (<objs> ^block <b>)
   (<b> ^object-handle $ <bh>)
   (<d> ^object-handle $ <dh>)
   (<w> ^on <r> ^below <bl> ^clear <cd>)
   (<r> ^argument1 <b> ^argument2 <old>)
   (<bl> ^argument1 <old> ^argument2 <b>)
   (<cd> ^argument1 <d>)
-->
   (<r> ^argument2 <old> - <d>)
   (<bl> ^argument1 <old> - <d>)
   (<w> ^clear <cd> - <nc>)
   (<nc> ^argument1 <old>)
   (<pa> ^effect-applied true)
   (write |Move | <bh> | onto | <dh> (crlf))
}
## Goal: two different green locations are clear.
sp {tower-of-hanoi*elaborate*goal*two-clear-green-locations
   (state <s> ^problem-space.name tower-of-hanoi ^world <w>)
   (<w> ^objects <objs> ^clear <c1> <c2>)
   (<objs> ^task <t> ^location <l1> <l2>)
   (<l1> ^color green ^object-handle $ <h1>)
   (<l2> ^color green ^object-handle { <> <h1> <h2> })
   (<c1> ^argument1 <l1>)
   (<c2> ^argument1 <l2>)
-->
   (<t> ^goal-met true)
}
## SC-1 [operator-preference]: during look-ahead, do not move the smallest block twice in a row.
## Bookkeeping: an internally applied move (look-ahead) or a move completed by the environment (the real world)
## records the block it moved on the task object (^sc-last-moved).
sp {tower-of-hanoi*sc-1*apply*move*last-moved*internal
   (state <s> ^problem-space.name tower-of-hanoi ^operator <op> ^internal-actions true ^world <w>)
   (<op> ^name move ^pre-conditions-satisfied true ^argument1.object-handle $ <bh>)
   (<w> ^anchored-world true ^objects.task <t>)
   (<t> ^sc-last-moved { <old> <> <bh> })
-->
   (<t> ^sc-last-moved <old> - <bh>)
}
sp {tower-of-hanoi*sc-1*apply*move*last-moved*internal*first
   (state <s> ^problem-space.name tower-of-hanoi ^operator <op> ^internal-actions true ^world <w>)
   (<op> ^name move ^pre-conditions-satisfied true ^argument1.object-handle $ <bh>)
   (<w> ^anchored-world true ^objects.task <t>)
   (<t> -^sc-last-moved)
-->
   (<t> ^sc-last-moved <bh>)
}
sp {tower-of-hanoi*sc-1*apply*move*last-moved*environment
:o-support
   (state <s> ^problem-space.name tower-of-hanoi ^superstate nil ^world <w> ^io.output-link.perform-action <pa>)
   (<pa> ^name move ^status complete ^argument1 <bh>)
   (<w> ^anchored-world true ^objects.task <t>)
   (<t> ^sc-last-moved { <old> <> <bh> })
-->
   (<t> ^sc-last-moved <old> - <bh>)
}
sp {tower-of-hanoi*sc-1*apply*move*last-moved*environment*first
:o-support
   (state <s> ^problem-space.name tower-of-hanoi ^superstate nil ^world <w> ^io.output-link.perform-action <pa>)
   (<pa> ^name move ^status complete ^argument1 <bh>)
   (<w> ^anchored-world true ^objects.task <t>)
   (<t> -^sc-last-moved)
-->
   (<t> ^sc-last-moved <bh>)
}

## Control: in look-ahead, reject moving the smallest block again right after it was moved.
sp {tower-of-hanoi*sc-1*compare*move*smallest-twice*reject
   (state <s> ^problem-space.name tower-of-hanoi ^real false ^operator <o> + ^world <w>)
   (<o> ^name move ^argument1.object-handle $ <bh>)
   (<w> ^anchored-world true ^objects <objs>)
   (<objs> ^task <t> ^block <b>)
   (<t> ^sc-last-moved $ <bh>)
   (<b> ^object-handle $ <bh> ^volume <bv>)
  -{(<objs> ^block <x>)
    (<x> ^volume < <bv>)}
-->
   (<s> ^operator <o> -)
}
## SC-2 [operator-preference]: work first on the largest block that is not yet in place.
## In place (state elaboration): the largest block on the home location.
sp {tower-of-hanoi*sc-2*elaborate*in-place*largest
   (state <s> ^problem-space.name tower-of-hanoi ^world <w>)
   (<w> ^anchored-world true ^objects <objs> ^on <r>)
   (<objs> ^block <b> ^location <h>)
   (<b> ^volume <bv>)
   (<h> ^color blue)
   (<r> ^argument1 <b> ^argument2 <h>)
  -{(<objs> ^block <x>)
    (<x> ^volume > <bv>)}
-->
   (<s> ^sc-in-place <b>)
}

## In place: a block on the next larger block, when that block is in place.
sp {tower-of-hanoi*sc-2*elaborate*in-place*next
   (state <s> ^problem-space.name tower-of-hanoi ^world <w>)
   (<s> ^sc-in-place <y>)
   (<w> ^anchored-world true ^objects <objs> ^on <r>)
   (<objs> ^block <b>)
   (<b> ^volume <bv>)
   (<y> ^volume <yv>)
   (<r> ^argument1 <b> ^argument2 <y>)
  -{(<objs> ^block <x>)
    (<x> ^volume { > <bv> < <yv> })}
-->
   (<s> ^sc-in-place <b>)
}

## The largest block not in place, when it is the largest block: its place is the home location.
sp {tower-of-hanoi*sc-2*elaborate*target*largest
   (state <s> ^problem-space.name tower-of-hanoi ^world <w>)
   (<w> ^anchored-world true ^objects <objs>)
   (<objs> ^block <b> ^location <h>)
   (<b> ^volume <bv>)
   (<h> ^color blue)
  -(<s> ^sc-in-place <b>)
  -{(<objs> ^block <x>)
    (<x> ^volume > <bv>)}
-->
   (<s> ^sc-target <tg>)
   (<tg> ^block <b> ^place <h>)
}

## The largest block not in place, when larger blocks are all in place: its place is the next larger block.
sp {tower-of-hanoi*sc-2*elaborate*target*next
   (state <s> ^problem-space.name tower-of-hanoi ^world <w>)
   (<s> ^sc-in-place <y>)
   (<w> ^anchored-world true ^objects <objs>)
   (<objs> ^block <b>)
   (<b> ^volume <bv>)
   (<y> ^volume { <yv> > <bv> })
  -(<s> ^sc-in-place <b>)
  -{(<objs> ^block <x>)
    (<x> ^volume { > <bv> < <yv> })}
  -{(<objs> ^block <z>)
    (<z> ^volume > <bv>)
    -(<s> ^sc-in-place <z>)}
-->
   (<s> ^sc-target <tg>)
   (<tg> ^block <b> ^place <y>)
}

## Control: never move a block that is in place.
sp {tower-of-hanoi*sc-2*compare*move*in-place*reject
   (state <s> ^problem-space.name tower-of-hanoi ^operator <o> + ^sc-in-place <b>)
   (<o> ^name move ^argument1.object-handle $ <bh>)
   (<b> ^object-handle $ <bh>)
-->
   (<s> ^operator <o> -)
}

## Control: moving the largest block that is not in place onto its place is best.
sp {tower-of-hanoi*sc-2*compare*move*largest-to-place*best
   (state <s> ^problem-space.name tower-of-hanoi ^operator <o> + ^sc-target <tg>)
   (<tg> ^block.object-handle $ <bh> ^place.object-handle $ <ph>)
   (<o> ^name move ^argument1.object-handle $ <bh> ^argument2.object-handle $ <ph>)
-->
   (<s> ^operator <o> >)
}
