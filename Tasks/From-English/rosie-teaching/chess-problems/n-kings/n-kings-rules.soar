## Elaborate problem space: adds ^copy-relation, ^dont-copy-object-attribute, ^problem-space.
sp {n-kings*elaborate*problem-space
   (state <s> ^name n-kings)
-->
   (<s> ^problem-space <p>)
   (<p> ^name n-kings ^copy-relation below ^share-relation near ^copy-relation clear ^copy-relation available ^dont-copy-object-attribute goal-met)
}

sp {n-kings*elaborate*problem-space*mea-substate
   (state <s> ^impasse no-change ^attribute operator ^superstate <ss>)
   (<ss> ^problem-space.name n-kings ^operator <so>)
   (<so> ^task-operator true -^pre-conditions-satisfied true)
-->
   (<s> ^problem-space <p>)
   (<p> ^name n-kings ^dont-copy-object-attribute goal-met)
}

## Elaborate flags: adds ^flag-override, ^mea-operator-selection.
sp {n-kings*elaborate*flags
   (state <s> ^superstate nil ^name n-kings)
-->
   (<s> ^flag-override <f>)
   (<f> ^mea-operator-selection true)
}

## Achievement of object-property desireds (supplied by the task).
sp {n-kings*elaborate*state*achieved*object-property
   (state <s> ^problem-space.name n-kings ^desireds <ds> ^world <w>)
   (<ds> ^desired <d>)
   (<d> ^object <do>)
   (<do> ^object-handle $ <h> ^{ <> object-handle <a> } <v>)
   (<w> ^anchored-world true ^objects.object <ob>)
   (<ob> ^object-handle $ <h> ^<a> <v>)
-->
   (<ds> ^achieved <d>)
}

sp {n-kings*elaborate*state*unachieved*object-property
   (state <s> ^problem-space.name n-kings ^desireds <ds> ^world <w>)
   (<ds> ^desired <d>)
   (<d> ^object <do>)
   (<do> ^object-handle $ <h> ^{ <> object-handle <a> } <v>)
   (<w> ^anchored-world true)
  -{(<w> ^objects.object <ob>)
    (<ob> ^object-handle <h> ^<a> <v>)}
-->
   (<ds> ^unachieved <d>)
}
## Propose place-block in problem space n-kings when its conditions below hold.
sp {n-kings*propose*place-block
   (state <s> ^problem-space.name n-kings ^flags.mea-operator-selection true ^world <w> ^desireds <ds>)
   (<w> ^anchored-world true ^objects <objs>)
   (<objs> ^object <b> <d>)
   (<b> ^type block ^object-handle $ <bh>)
   (<d> ^type location ^object-handle $ <dh>)
   (<w> ^available <av>)
   (<av> ^argument1 <b>)
   (<w> ^clear <clear-b>)
   (<clear-b> ^argument1 <b>)
   (<w> ^clear <clear-d>)
   (<clear-d> ^argument1 <d>)
   (<ds> ^unachieved-desireds true)
-->
   (<s> ^operator <op> +)
   (<op> ^name place-block ^task-operator true ^action-handle place-block ^argument1 <b> ^argument2 <d> ^argument-count 2 ^pre-conditions-satisfied true)
}
## Effect of place-block (look-ahead).
sp {n-kings*apply*place-block*internal*from-block
   (state <s> ^problem-space.name n-kings ^operator <op> ^internal-actions true ^world <w>)
   (<op> ^task-operator true ^name place-block ^pre-conditions-satisfied true ^argument1.object-handle $ <bh> ^argument2.object-handle $ <dh>)
   (<w> ^anchored-world true ^objects <objs>)
   (<objs> ^object <b> <d>)
   (<b> ^object-handle $ <bh>)
   (<d> ^object-handle $ <dh>)
   (<w> ^clear <cd> ^available <av>)
   (<cd> ^argument1 <d>)
   (<av> ^argument1 <b>)
   (<w> ^on <r> ^below <bl>)
   (<r> ^argument1 <b> ^argument2 <old>)
   (<bl> ^argument1 <old> ^argument2 <b>)
-->
   (<r> ^argument2 <old> - <d>)
   (<bl> ^argument1 <old> - <d>)
   (<w> ^clear <cd> - <nc> ^available <av> -)
   (<nc> ^argument1 <old>)
}

## Effect of a completed place-block command on the real world (once per command).
sp {n-kings*apply*place-block*environment-effect*from-block
   :o-support
   (state <s> ^problem-space.name n-kings ^superstate nil ^world <w> ^io.output-link.perform-action <pa>)
   (<pa> ^name place-block ^status complete ^argument1 <bh> ^argument2 <dh> -^effect-applied true)
   (<w> ^anchored-world true ^objects <objs>)
   (<objs> ^object <b> <d>)
   (<b> ^object-handle $ <bh>)
   (<d> ^object-handle $ <dh>)
   (<w> ^clear <cd> ^available <av>)
   (<cd> ^argument1 <d>)
   (<av> ^argument1 <b>)
   (<w> ^on <r> ^below <bl>)
   (<r> ^argument1 <b> ^argument2 <old>)
   (<bl> ^argument1 <old> ^argument2 <b>)
-->
   (<r> ^argument2 <old> - <d>)
   (<bl> ^argument1 <old> - <d>)
   (<w> ^clear <cd> - <nc> ^available <av> -)
   (<nc> ^argument1 <old>)
   (<pa> ^effect-applied true)
   (write |Place | <bh> | onto | <dh> (crlf))
}
## Effect of place-block (look-ahead).
sp {n-kings*apply*place-block*internal*from-nothing
   (state <s> ^problem-space.name n-kings ^operator <op> ^internal-actions true ^world <w>)
   (<op> ^task-operator true ^name place-block ^pre-conditions-satisfied true ^argument1.object-handle $ <bh> ^argument2.object-handle $ <dh>)
   (<w> ^anchored-world true ^objects <objs>)
   (<objs> ^object <b> <d>)
   (<b> ^object-handle $ <bh>)
   (<d> ^object-handle $ <dh>)
   (<w> ^clear <cd> ^available <av>)
   (<cd> ^argument1 <d>)
   (<av> ^argument1 <b>)
  -{(<w> ^on <r>)
    (<r> ^argument1 <b>)}
-->
   (<w> ^on <nr> ^below <nb> ^clear <cd> - ^available <av> -)
   (<nr> ^argument1 <b> ^argument2 <d>)
   (<nb> ^argument1 <d> ^argument2 <b>)
}

## Effect of a completed place-block command on the real world (once per command).
sp {n-kings*apply*place-block*environment-effect*from-nothing
   :o-support
   (state <s> ^problem-space.name n-kings ^superstate nil ^world <w> ^io.output-link.perform-action <pa>)
   (<pa> ^name place-block ^status complete ^argument1 <bh> ^argument2 <dh> -^effect-applied true)
   (<w> ^anchored-world true ^objects <objs>)
   (<objs> ^object <b> <d>)
   (<b> ^object-handle $ <bh>)
   (<d> ^object-handle $ <dh>)
   (<w> ^clear <cd> ^available <av>)
   (<cd> ^argument1 <d>)
   (<av> ^argument1 <b>)
  -{(<w> ^on <r>)
    (<r> ^argument1 <b>)}
-->
   (<w> ^on <nr> ^below <nb> ^clear <cd> - ^available <av> -)
   (<nr> ^argument1 <b> ^argument2 <d>)
   (<nb> ^argument1 <d> ^argument2 <b>)
   (<pa> ^effect-applied true)
   (write |Place | <bh> | onto | <dh> (crlf))
}
## Failure (next-to): a block is next to another block.
sp {n-kings*elaborate*failure*next-to
   (state <s> ^problem-space.name n-kings ^desireds <ds> ^world <w>)
   (<w> ^anchored-world true ^objects <objs>)
   (<objs> ^object <b1> <b2> <l1> <l2>)
   (<b1> ^type block ^object-handle $ <h1>)
   (<b2> ^type block ^object-handle { <> <h1> })
   (<w> ^on <on-1>)
   (<on-1> ^argument1 <b1> ^argument2 <l1>)
   (<w> ^on <on-2>)
   (<on-2> ^argument1 <b2> ^argument2 <l2>)
   (<w> ^near <near-x>)
   (<near-x> ^argument1 <l1> ^argument2 <l2>)
-->
   (<s> ^failure <ds>)
}
## Goal: all blocks are placed (on a location).
sp {n-kings*elaborate*goal*all-placed
   (state <s> ^problem-space.name n-kings ^world <w>)
   (<w> ^objects <objs>)
   (<objs> ^object <t> <b-block-17> <l-block-17> <b-block-18> <l-block-18> <b-block-19> <l-block-19> <b-block-20> <l-block-20>)
   (<t> ^type task)
   (<b-block-17> ^object-handle block-17)
   (<l-block-17> ^type location)
   (<w> ^on <on-block-17>)
   (<on-block-17> ^argument1 <b-block-17> ^argument2 <l-block-17>)
   (<b-block-18> ^object-handle block-18)
   (<l-block-18> ^type location)
   (<w> ^on <on-block-18>)
   (<on-block-18> ^argument1 <b-block-18> ^argument2 <l-block-18>)
   (<b-block-19> ^object-handle block-19)
   (<l-block-19> ^type location)
   (<w> ^on <on-block-19>)
   (<on-block-19> ^argument1 <b-block-19> ^argument2 <l-block-19>)
   (<b-block-20> ^object-handle block-20)
   (<l-block-20> ^type location)
   (<w> ^on <on-block-20>)
   (<on-block-20> ^argument1 <b-block-20> ^argument2 <l-block-20>)
-->
   (<t> ^goal-met true)
}

