## N rooks (n-rooks), generated from the Rosie teaching script (english-input.txt) under the world conventions.
##
## Instructor statements used (numbers as in english-input.txt):
##   5. You can move a clear available block onto a clear location.
##   6. If a block is not on a location then it is available.
##   7. If a location is not below an object then it is clear.
##  12. If two of the blocks are placed and they have the same row then you lose.
##  13. If a block is on a location then the block is placed.
##  16. If two of the blocks are placed and they have the same column then you lose.
##  20. The goal is that all blocks are placed.
## World: init-rooks.world (a 4 by 4 grid; four blocks in a stack)
##
## Translation (tools/rosie-language.md gives the general reading; the assumption ledger is in README.md):
##   - Operator place-block (argument1 = the block, argument2 = the location), statement 5. available (statement 6) and clear
##     (statement 7) are maintained one-argument relations; the blocks start in a stack (A-C2).
##   - A placed block has the row and column of the location it is on; the relations between blocks are static relations
##     between their locations (A-C1).
##   - Failure placed-same-row: two different placed blocks on locations with the same row.
##   - Failure place-same-col: two different placed blocks on locations with the same column.
##   - The goal (all blocks are placed) is expanded over the blocks of the world file.
## Matching hints for learned rules (World-Conventions L3-095, L11-009): many-valued attributes, sized from the initial world.
production optimize-attribute location 21
production optimize-attribute block 21
production optimize-attribute task 21
production optimize-attribute object 21
production optimize-attribute on 3
production optimize-attribute below 3
production optimize-attribute clear 17
production optimize-attribute available 4


## Propose initialize-n-rooks when its conditions below hold.
sp {n-rooks*propose*initialize-n-rooks
   (state <s> ^superstate nil ^world <w> -^name)
-->
   (<s> ^operator <o> + >)
   (<o> ^name initialize-n-rooks ^task-operator false)
}

sp {n-rooks*apply*initialize-n-rooks
   (state <s> ^operator.name initialize-n-rooks ^world <w>)
   (<w> ^objects <objs>)
-->
   (<s> ^name n-rooks ^desireds <ds>)
   (<objs> ^location <o-location-1> <o-location-2> <o-location-3> <o-location-4> <o-location-5> <o-location-6> <o-location-7> <o-location-8> <o-location-9> <o-location-10> <o-location-11> <o-location-12> <o-location-13> <o-location-14> <o-location-15> <o-location-16> ^block <o-block-17> <o-block-18> <o-block-19> <o-block-20> ^task <o-task>)
   (<o-location-1> ^object-handle location-1 ^anchored true ^type location ^row 1 ^column 1 ^static true)
   (<o-location-2> ^object-handle location-2 ^anchored true ^type location ^row 2 ^column 1 ^static true)
   (<o-location-3> ^object-handle location-3 ^anchored true ^type location ^row 3 ^column 1 ^static true)
   (<o-location-4> ^object-handle location-4 ^anchored true ^type location ^row 4 ^column 1 ^static true)
   (<o-location-5> ^object-handle location-5 ^anchored true ^type location ^row 1 ^column 2 ^static true)
   (<o-location-6> ^object-handle location-6 ^anchored true ^type location ^row 2 ^column 2 ^static true)
   (<o-location-7> ^object-handle location-7 ^anchored true ^type location ^row 3 ^column 2 ^static true)
   (<o-location-8> ^object-handle location-8 ^anchored true ^type location ^row 4 ^column 2 ^static true)
   (<o-location-9> ^object-handle location-9 ^anchored true ^type location ^row 1 ^column 3 ^static true)
   (<o-location-10> ^object-handle location-10 ^anchored true ^type location ^row 2 ^column 3 ^static true)
   (<o-location-11> ^object-handle location-11 ^anchored true ^type location ^row 3 ^column 3 ^static true)
   (<o-location-12> ^object-handle location-12 ^anchored true ^type location ^row 4 ^column 3 ^static true)
   (<o-location-13> ^object-handle location-13 ^anchored true ^type location ^row 1 ^column 4 ^static true)
   (<o-location-14> ^object-handle location-14 ^anchored true ^type location ^row 2 ^column 4 ^static true)
   (<o-location-15> ^object-handle location-15 ^anchored true ^type location ^row 3 ^column 4 ^static true)
   (<o-location-16> ^object-handle location-16 ^anchored true ^type location ^row 4 ^column 4 ^static true)
   (<o-block-17> ^object-handle block-17 ^anchored true ^type block ^color blue ^static true)
   (<o-block-18> ^object-handle block-18 ^anchored true ^type block ^color blue ^static true)
   (<o-block-19> ^object-handle block-19 ^anchored true ^type block ^color blue ^static true)
   (<o-block-20> ^object-handle block-20 ^anchored true ^type block ^color blue ^static true)
   (<o-task> ^object-handle task ^anchored true ^type task)
   (<ds> ^desired-count 1 ^desired <d1>)
   (<d1> ^object <d1-o>)
   (<d1-o> ^object-handle task ^goal-met true)
   (<w> ^on <on-0>)
   (<on-0> ^argument1 <o-block-17> ^argument2 <o-block-18>)
   (<w> ^on <on-1>)
   (<on-1> ^argument1 <o-block-18> ^argument2 <o-block-19>)
   (<w> ^on <on-2>)
   (<on-2> ^argument1 <o-block-19> ^argument2 <o-block-20>)
   (<w> ^below <below-0>)
   (<below-0> ^argument1 <o-block-18> ^argument2 <o-block-17>)
   (<w> ^below <below-1>)
   (<below-1> ^argument1 <o-block-19> ^argument2 <o-block-18>)
   (<w> ^below <below-2>)
   (<below-2> ^argument1 <o-block-20> ^argument2 <o-block-19>)
   (<w> ^clear <clear-location-1>)
   (<clear-location-1> ^argument1 <o-location-1>)
   (<w> ^clear <clear-location-2>)
   (<clear-location-2> ^argument1 <o-location-2>)
   (<w> ^clear <clear-location-3>)
   (<clear-location-3> ^argument1 <o-location-3>)
   (<w> ^clear <clear-location-4>)
   (<clear-location-4> ^argument1 <o-location-4>)
   (<w> ^clear <clear-location-5>)
   (<clear-location-5> ^argument1 <o-location-5>)
   (<w> ^clear <clear-location-6>)
   (<clear-location-6> ^argument1 <o-location-6>)
   (<w> ^clear <clear-location-7>)
   (<clear-location-7> ^argument1 <o-location-7>)
   (<w> ^clear <clear-location-8>)
   (<clear-location-8> ^argument1 <o-location-8>)
   (<w> ^clear <clear-location-9>)
