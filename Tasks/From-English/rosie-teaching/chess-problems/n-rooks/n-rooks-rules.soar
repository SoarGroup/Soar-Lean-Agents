## Elaborate problem space: adds ^copy-relation, ^dont-copy-object-attribute, ^problem-space.
sp {n-rooks*elaborate*problem-space
   (state <s> ^name n-rooks)
-->
   (<s> ^problem-space <p>)
   (<p> ^name n-rooks ^copy-relation below ^copy-relation clear ^copy-relation available ^dont-copy-object-attribute goal-met)
}

sp {n-rooks*elaborate*problem-space*mea-substate
   (state <s> ^impasse no-change ^attribute operator ^superstate <ss>)
   (<ss> ^problem-space.name n-rooks ^operator <so>)
   (<so> ^task-operator true -^pre-conditions-satisfied true)
-->
   (<s> ^problem-space <p>)
   (<p> ^name n-rooks ^dont-copy-object-attribute goal-met)
}

## Elaborate flags: adds ^flag-override, ^mea-operator-selection.
sp {n-rooks*elaborate*flags
   (state <s> ^superstate nil ^name n-rooks)
-->
   (<s> ^flag-override <f>)
   (<f> ^mea-operator-selection true)
}

## Achievement of object-property desireds (supplied by the task).
sp {n-rooks*elaborate*state*achieved*object-property
   (state <s> ^problem-space.name n-rooks ^desireds <ds> ^world <w>)
   (<ds> ^desired <d>)
   (<d> ^object <do>)
   (<do> ^object-handle $ <h> ^{ <> object-handle <a> } <v>)
   (<w> ^anchored-world true ^objects.object <ob>)
   (<ob> ^object-handle $ <h> ^<a> <v>)
-->
   (<ds> ^achieved <d>)
}

sp {n-rooks*elaborate*state*unachieved*object-property
   (state <s> ^problem-space.name n-rooks ^desireds <ds> ^world <w>)
   (<ds> ^desired <d>)
   (<d> ^object <do>)
   (<do> ^object-handle $ <h> ^{ <> object-handle <a> } <v>)
   (<w> ^anchored-world true)
  -{(<w> ^objects.object <ob>)
    (<ob> ^object-handle <h> ^<a> <v>)}
-->
   (<ds> ^unachieved <d>)
}
## Propose place-block in problem space n-rooks when its conditions below hold.
sp {n-rooks*propose*place-block
   (state <s> ^problem-space.name n-rooks ^flags.mea-operator-selection true ^world <w> ^desireds <ds>)
   (<w> ^anchored-world true ^objects <objs>)
   (<objs> ^block <b> ^location <d>)
   (<b> ^object-handle $ <bh>)
   (<d> ^object-handle $ <dh>)
   (<w> ^available <av>)
   (<av> ^argument1 <b>)
   (<w> ^clear <clear-b>)
   (<clear-b> ^argument1 <b>)
   (<w> ^clear <clear-d>)
   (<clear-d> ^argument1 <d>)
   (<ds> ^unachieved-desireds true)
-->
   (<s> ^operator <op> +)
   (<op> ^name place-block ^task-operator true ^action-handle place-block ^argument1 <b> ^argument2 <d> ^argument-count 2 ^pre-conditions-satisfied true)
}
## Effect of place-block (look-ahead).
sp {n-rooks*apply*place-block*internal*from-block
   (state <s> ^problem-space.name n-rooks ^operator <op> ^internal-actions true ^world <w>)
   (<op> ^task-operator true ^name place-block ^pre-conditions-satisfied true ^argument1.object-handle $ <bh> ^argument2.object-handle $ <dh>)
   (<w> ^anchored-world true ^objects <objs>)
   (<objs> ^block <b> ^location <d>)
   (<b> ^object-handle $ <bh>)
   (<d> ^object-handle $ <dh>)
   (<w> ^clear <cd> ^available <av>)
   (<cd> ^argument1 <d>)
   (<av> ^argument1 <b>)
   (<w> ^on <r> ^below <bl>)
   (<r> ^argument1 <b> ^argument2 <old>)
   (<bl> ^argument1 <old> ^argument2 <b>)
-->
   (<r> ^argument2 <old> - <d>)
   (<bl> ^argument1 <old> - <d>)
   (<w> ^clear <cd> - <nc> ^available <av> -)
   (<nc> ^argument1 <old>)
}

## Effect of a completed place-block command on the real world (once per command).
sp {n-rooks*apply*place-block*environment-effect*from-block
   :o-support
   (state <s> ^problem-space.name n-rooks ^superstate nil ^world <w> ^io.output-link.perform-action <pa>)
   (<pa> ^name place-block ^status complete ^argument1 <bh> ^argument2 <dh> -^effect-applied true)
   (<w> ^anchored-world true ^objects <objs>)
   (<objs> ^block <b> ^location <d>)
   (<b> ^object-handle $ <bh>)
   (<d> ^object-handle $ <dh>)
   (<w> ^clear <cd> ^available <av>)
   (<cd> ^argument1 <d>)
   (<av> ^argument1 <b>)
   (<w> ^on <r> ^below <bl>)
   (<r> ^argument1 <b> ^argument2 <old>)
   (<bl> ^argument1 <old> ^argument2 <b>)
-->
   (<r> ^argument2 <old> - <d>)
   (<bl> ^argument1 <old> - <d>)
   (<w> ^clear <cd> - <nc> ^available <av> -)
   (<nc> ^argument1 <old>)
   (<pa> ^effect-applied true)
   (write |Place | <bh> | onto | <dh> (crlf))
}
## Effect of place-block (look-ahead).
sp {n-rooks*apply*place-block*internal*from-nothing
   (state <s> ^problem-space.name n-rooks ^operator <op> ^internal-actions true ^world <w>)
   (<op> ^task-operator true ^name place-block ^pre-conditions-satisfied true ^argument1.object-handle $ <bh> ^argument2.object-handle $ <dh>)
   (<w> ^anchored-world true ^objects <objs>)
   (<objs> ^block <b> ^location <d>)
   (<b> ^object-handle $ <bh>)
   (<d> ^object-handle $ <dh>)
   (<w> ^clear <cd> ^available <av>)
   (<cd> ^argument1 <d>)
   (<av> ^argument1 <b>)
  -{(<w> ^on <r>)
    (<r> ^argument1 <b>)}
-->
   (<w> ^on <nr> ^below <nb> ^clear <cd> - ^available <av> -)
   (<nr> ^argument1 <b> ^argument2 <d>)
   (<nb> ^argument1 <d> ^argument2 <b>)
}

## Effect of a completed place-block command on the real world (once per command).
sp {n-rooks*apply*place-block*environment-effect*from-nothing
   :o-support
   (state <s> ^problem-space.name n-rooks ^superstate nil ^world <w> ^io.output-link.perform-action <pa>)
   (<pa> ^name place-block ^status complete ^argument1 <bh> ^argument2 <dh> -^effect-applied true)
   (<w> ^anchored-world true ^objects <objs>)
   (<objs> ^block <b> ^location <d>)
   (<b> ^object-handle $ <bh>)
   (<d> ^object-handle $ <dh>)
   (<w> ^clear <cd> ^available <av>)
   (<cd> ^argument1 <d>)
   (<av> ^argument1 <b>)
  -{(<w> ^on <r>)
    (<r> ^argument1 <b>)}
-->
   (<w> ^on <nr> ^below <nb> ^clear <cd> - ^available <av> -)
   (<nr> ^argument1 <b> ^argument2 <d>)
   (<nb> ^argument1 <d> ^argument2 <b>)
   (<pa> ^effect-applied true)
   (write |Place | <bh> | onto | <dh> (crlf))
}
## Failure (placed-same-row): two placed blocks have the same row.
sp {n-rooks*elaborate*failure*placed-same-row
   (state <s> ^problem-space.name n-rooks ^desireds <ds> ^world <w>)
   (<w> ^anchored-world true ^objects <objs>)
   (<objs> ^block <b1> <b2>)
   (<b1> ^object-handle $ <h1>)
   (<b2> ^object-handle { <> <h1> })
   (<w> ^on <on-1>)
   (<on-1> ^argument1 <b1> ^argument2 <l1>)
   (<w> ^on <on-2>)
   (<on-2> ^argument1 <b2> ^argument2 <l2>)
   (<l1> ^row <r>)
   (<l2> ^row <r>)
-->
   (<s> ^failure <ds>)
}
