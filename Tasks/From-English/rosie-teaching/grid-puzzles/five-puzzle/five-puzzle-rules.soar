## Five puzzle (five-puzzle), generated from the Rosie teaching script (english-input.txt) under the world conventions.
##
## Instructor statements used (numbers as in english-input.txt):
##   5. If a block is adjacent to a clear location then you can move the block onto the clear location.
##   6. If a location is not below an object then it is clear.
##   7. If a location is next to an object but it is not diagonal with the object then it is adjacent to the object.
##   9. The goal is that there are five matched locations.
##  11. If the color of a location is the color of the block that is on the location then the location is matched.
## World: init-5puzzlerc.world (a 3 by 2 grid; five coloured blocks)
##
## Translation (tools/rosie-language.md gives the general reading; the assumption ledger is in README.md):
##   - Operator slide-block (argument1 = the block, argument2 = the clear location), statement 5; adjacent (statement 7) is a
##     static relation between locations, a block being adjacent to what its location is adjacent to (A-G1); clear is a
##     maintained one-argument relation (statement 6).
##   - The goal is expanded over the blocks of the world file: every block is on the location with its color (A-G3).
## Matching hints for learned rules (World-Conventions L3-095, L11-009): many-valued attributes, sized from the initial world.
production optimize-attribute location 12
production optimize-attribute block 12
production optimize-attribute task 12
production optimize-attribute object 12
production optimize-attribute on 5
production optimize-attribute below 5
production optimize-attribute clear 6
production optimize-attribute adjacent 14


## Propose initialize-five-puzzle when its conditions below hold.
sp {five-puzzle*propose*initialize-five-puzzle
   (state <s> ^superstate nil ^world <w> -^name)
-->
   (<s> ^operator <o> + >)
   (<o> ^name initialize-five-puzzle ^task-operator false)
}

sp {five-puzzle*apply*initialize-five-puzzle
   (state <s> ^operator.name initialize-five-puzzle ^world <w>)
   (<w> ^objects <objs>)
-->
   (<s> ^name five-puzzle ^desireds <ds>)
   (<objs> ^location <o-location-1> <o-location-2> <o-location-3> <o-location-4> <o-location-5> <o-location-6> ^block <o-block-7> <o-block-8> <o-block-9> <o-block-10> <o-block-11> ^task <o-task>)
   (<o-location-1> ^object-handle location-1 ^anchored true ^type location ^color red ^row 1 ^column 1 ^static true)
   (<o-location-2> ^object-handle location-2 ^anchored true ^type location ^color orange ^row 1 ^column 2 ^static true)
   (<o-location-3> ^object-handle location-3 ^anchored true ^type location ^row 1 ^column 3 ^static true)
   (<o-location-4> ^object-handle location-4 ^anchored true ^type location ^color yellow ^row 2 ^column 1 ^static true)
   (<o-location-5> ^object-handle location-5 ^anchored true ^type location ^color green ^row 2 ^column 2 ^static true)
   (<o-location-6> ^object-handle location-6 ^anchored true ^type location ^color blue ^row 2 ^column 3 ^static true)
   (<o-block-7> ^object-handle block-7 ^anchored true ^type block ^color red ^static true)
   (<o-block-8> ^object-handle block-8 ^anchored true ^type block ^color orange ^static true)
   (<o-block-9> ^object-handle block-9 ^anchored true ^type block ^color yellow ^static true)
   (<o-block-10> ^object-handle block-10 ^anchored true ^type block ^color green ^static true)
   (<o-block-11> ^object-handle block-11 ^anchored true ^type block ^color blue ^static true)
   (<o-task> ^object-handle task ^anchored true ^type task)
   (<ds> ^desired-count 1 ^desired <d1>)
   (<d1> ^object <d1-o>)
   (<d1-o> ^object-handle task ^goal-met true)
   (<w> ^on <on-0>)
   (<on-0> ^argument1 <o-block-7> ^argument2 <o-location-2>)
   (<w> ^on <on-1>)
   (<on-1> ^argument1 <o-block-8> ^argument2 <o-location-3>)
   (<w> ^on <on-2>)
   (<on-2> ^argument1 <o-block-9> ^argument2 <o-location-1>)
   (<w> ^on <on-3>)
   (<on-3> ^argument1 <o-block-10> ^argument2 <o-location-5>)
   (<w> ^on <on-4>)
   (<on-4> ^argument1 <o-block-11> ^argument2 <o-location-6>)
   (<w> ^below <below-0>)
   (<below-0> ^argument1 <o-location-2> ^argument2 <o-block-7>)
   (<w> ^below <below-1>)
   (<below-1> ^argument1 <o-location-3> ^argument2 <o-block-8>)
   (<w> ^below <below-2>)
   (<below-2> ^argument1 <o-location-1> ^argument2 <o-block-9>)
   (<w> ^below <below-3>)
   (<below-3> ^argument1 <o-location-5> ^argument2 <o-block-10>)
   (<w> ^below <below-4>)
   (<below-4> ^argument1 <o-location-6> ^argument2 <o-block-11>)
   (<w> ^clear <clear-location-4>)
   (<clear-location-4> ^argument1 <o-location-4>)
   (<w> ^clear <clear-block-7>)
   (<clear-block-7> ^argument1 <o-block-7>)
   (<w> ^clear <clear-block-8>)
   (<clear-block-8> ^argument1 <o-block-8>)
   (<w> ^clear <clear-block-9>)
   (<clear-block-9> ^argument1 <o-block-9>)
   (<w> ^clear <clear-block-10>)
   (<clear-block-10> ^argument1 <o-block-10>)
   (<w> ^clear <clear-block-11>)
   (<clear-block-11> ^argument1 <o-block-11>)
   (<w> ^adjacent <adjacent-0>)
   (<adjacent-0> ^argument1 <o-location-1> ^argument2 <o-location-2>)
   (<w> ^adjacent <adjacent-1>)
   (<adjacent-1> ^argument1 <o-location-1> ^argument2 <o-location-4>)
   (<w> ^adjacent <adjacent-2>)
   (<adjacent-2> ^argument1 <o-location-2> ^argument2 <o-location-1>)
   (<w> ^adjacent <adjacent-3>)
   (<adjacent-3> ^argument1 <o-location-2> ^argument2 <o-location-3>)
   (<w> ^adjacent <adjacent-4>)
   (<adjacent-4> ^argument1 <o-location-2> ^argument2 <o-location-5>)
   (<w> ^adjacent <adjacent-5>)
   (<adjacent-5> ^argument1 <o-location-3> ^argument2 <o-location-2>)
   (<w> ^adjacent <adjacent-6>)
   (<adjacent-6> ^argument1 <o-location-3> ^argument2 <o-location-6>)
   (<w> ^adjacent <adjacent-7>)
   (<adjacent-7> ^argument1 <o-location-4> ^argument2 <o-location-1>)
   (<w> ^adjacent <adjacent-8>)
   (<adjacent-8> ^argument1 <o-location-4> ^argument2 <o-location-5>)
   (<w> ^adjacent <adjacent-9>)
   (<adjacent-9> ^argument1 <o-location-5> ^argument2 <o-location-2>)
   (<w> ^adjacent <adjacent-10>)
   (<adjacent-10> ^argument1 <o-location-5> ^argument2 <o-location-4>)
   (<w> ^adjacent <adjacent-11>)
   (<adjacent-11> ^argument1 <o-location-5> ^argument2 <o-location-6>)
   (<w> ^adjacent <adjacent-12>)
   (<adjacent-12> ^argument1 <o-location-6> ^argument2 <o-location-3>)
   (<w> ^adjacent <adjacent-13>)
   (<adjacent-13> ^argument1 <o-location-6> ^argument2 <o-location-5>)
   (log 1 (crlf) |Initialize five-puzzle.|)
}

## Elaborate problem space: adds ^copy-relation, ^dont-copy-object-attribute, ^problem-space.
sp {five-puzzle*elaborate*problem-space
   (state <s> ^name five-puzzle)
-->
   (<s> ^problem-space <p>)
   (<p> ^name five-puzzle ^copy-relation below ^share-relation adjacent ^copy-relation clear ^dont-copy-object-attribute goal-met)
}

sp {five-puzzle*elaborate*problem-space*mea-substate
   (state <s> ^impasse no-change ^attribute operator ^superstate <ss>)
   (<ss> ^problem-space.name five-puzzle ^operator <so>)
   (<so> ^task-operator true -^pre-conditions-satisfied true)
-->
   (<s> ^problem-space <p>)
   (<p> ^name five-puzzle ^dont-copy-object-attribute goal-met)
}

## Elaborate flags: adds ^flag-override, ^mea-operator-selection.
sp {five-puzzle*elaborate*flags
   (state <s> ^superstate nil ^name five-puzzle)
-->
   (<s> ^flag-override <f>)
   (<f> ^mea-operator-selection true)
}

## Achievement of object-property desireds (supplied by the task).
sp {five-puzzle*elaborate*state*achieved*object-property
   (state <s> ^problem-space.name five-puzzle ^desireds <ds> ^world <w>)
   (<ds> ^desired <d>)
   (<d> ^object <do>)
   (<do> ^object-handle $ <h> ^{ <> object-handle <a> } <v>)
   (<w> ^anchored-world true ^objects.object <ob>)
   (<ob> ^object-handle $ <h> ^<a> <v>)
-->
   (<ds> ^achieved <d>)
}

sp {five-puzzle*elaborate*state*unachieved*object-property
   (state <s> ^problem-space.name five-puzzle ^desireds <ds> ^world <w>)
   (<ds> ^desired <d>)
   (<d> ^object <do>)
   (<do> ^object-handle $ <h> ^{ <> object-handle <a> } <v>)
   (<w> ^anchored-world true)
  -{(<w> ^objects.object <ob>)
    (<ob> ^object-handle <h> ^<a> <v>)}
-->
   (<ds> ^unachieved <d>)
}
## Propose slide-block in problem space five-puzzle when its conditions below hold (adjacent clear).
sp {five-puzzle*propose*slide-block*adjacent-clear
   (state <s> ^problem-space.name five-puzzle ^flags.mea-operator-selection true ^world <w> ^desireds <ds>)
   (<w> ^anchored-world true ^objects <objs>)
   (<objs> ^block <b> ^location <d>)
   (<b> ^object-handle $ <bh>)
   (<d> ^object-handle $ <dh>)
   (<w> ^on <on-b>)
   (<on-b> ^argument1 <b> ^argument2 <l1>)
   (<w> ^adjacent <adjacent-d>)
   (<adjacent-d> ^argument1 <d> ^argument2 <l1>)
   (<w> ^clear <clear-d>)
   (<clear-d> ^argument1 <d>)
   (<ds> ^unachieved-desireds true)
-->
   (<s> ^operator <op> +)
   (<op> ^name slide-block ^task-operator true ^action-handle slide-block ^argument1 <b> ^argument2 <d> ^argument-count 2 ^pre-conditions-satisfied true)
}
## Effect of slide-block (look-ahead).
sp {five-puzzle*apply*slide-block*internal
   (state <s> ^problem-space.name five-puzzle ^operator <op> ^internal-actions true ^world <w>)
   (<op> ^task-operator true ^name slide-block ^pre-conditions-satisfied true ^argument1.object-handle $ <bh> ^argument2.object-handle $ <dh>)
   (<w> ^anchored-world true ^objects <objs>)
   (<objs> ^block <b> ^location <d>)
   (<b> ^object-handle $ <bh>)
   (<d> ^object-handle $ <dh>)
   (<w> ^on <r> ^below <bl> ^clear <cd>)
   (<r> ^argument1 <b> ^argument2 <old>)
   (<bl> ^argument1 <old> ^argument2 <b>)
   (<cd> ^argument1 <d>)
-->
   (<r> ^argument2 <old> - <d>)
   (<bl> ^argument1 <old> - <d>)
   (<w> ^clear <cd> - <nc>)
   (<nc> ^argument1 <old>)
}

## Effect of a completed slide-block command on the real world (once per command).
sp {five-puzzle*apply*slide-block*environment-effect
   :o-support
   (state <s> ^problem-space.name five-puzzle ^superstate nil ^world <w> ^io.output-link.perform-action <pa>)
   (<pa> ^name slide-block ^status complete ^argument1 <bh> ^argument2 <dh> -^effect-applied true)
   (<w> ^anchored-world true ^objects <objs>)
   (<objs> ^block <b> ^location <d>)
   (<b> ^object-handle $ <bh>)
   (<d> ^object-handle $ <dh>)
   (<w> ^on <r> ^below <bl> ^clear <cd>)
   (<r> ^argument1 <b> ^argument2 <old>)
   (<bl> ^argument1 <old> ^argument2 <b>)
   (<cd> ^argument1 <d>)
-->
   (<r> ^argument2 <old> - <d>)
   (<bl> ^argument1 <old> - <d>)
   (<w> ^clear <cd> - <nc>)
   (<nc> ^argument1 <old>)
   (<pa> ^effect-applied true)
   (write |Slide | <bh> | onto | <dh> (crlf))
}
## Goal: every location is matched (its color is the color of the block on it).
sp {five-puzzle*elaborate*goal*all-matched
   (state <s> ^problem-space.name five-puzzle ^world <w>)
   (<w> ^objects <objs>)
   (<objs> ^task <t> ^block <b-block-7> ^location <l-block-7> ^block <b-block-8> ^location <l-block-8> ^block <b-block-9> ^location <l-block-9> ^block <b-block-10> ^location <l-block-10> ^block <b-block-11> ^location <l-block-11>)
   (<b-block-7> ^object-handle block-7)
   (<l-block-7> ^color red)
   (<w> ^on <on-block-7>)
   (<on-block-7> ^argument1 <b-block-7> ^argument2 <l-block-7>)
   (<b-block-8> ^object-handle block-8)
   (<l-block-8> ^color orange)
   (<w> ^on <on-block-8>)
   (<on-block-8> ^argument1 <b-block-8> ^argument2 <l-block-8>)
   (<b-block-9> ^object-handle block-9)
   (<l-block-9> ^color yellow)
   (<w> ^on <on-block-9>)
   (<on-block-9> ^argument1 <b-block-9> ^argument2 <l-block-9>)
   (<b-block-10> ^object-handle block-10)
   (<l-block-10> ^color green)
   (<w> ^on <on-block-10>)
   (<on-block-10> ^argument1 <b-block-10> ^argument2 <l-block-10>)
   (<b-block-11> ^object-handle block-11)
   (<l-block-11> ^color blue)
   (<w> ^on <on-block-11>)
   (<on-block-11> ^argument1 <b-block-11> ^argument2 <l-block-11>)
-->
   (<t> ^goal-met true)
}
