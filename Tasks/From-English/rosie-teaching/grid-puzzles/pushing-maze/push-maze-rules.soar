## Elaborate problem space: adds ^copy-relation, ^dont-copy-object-attribute, ^problem-space.
sp {push-maze*elaborate*problem-space
   (state <s> ^name push-maze)
-->
   (<s> ^problem-space <p>)
   (<p> ^name push-maze ^copy-relation below ^copy-relation adjacent ^copy-relation step-1 ^copy-relation step-2 ^copy-relation step-3 ^copy-relation step-4 ^copy-relation clear ^dont-copy-object-attribute goal-met)
}

sp {push-maze*elaborate*problem-space*mea-substate
   (state <s> ^impasse no-change ^attribute operator ^superstate <ss>)
   (<ss> ^problem-space.name push-maze ^operator <so>)
   (<so> ^task-operator true -^pre-conditions-satisfied true)
-->
   (<s> ^problem-space <p>)
   (<p> ^name push-maze ^dont-copy-object-attribute goal-met)
}

## Elaborate flags: adds ^flag-override, ^mea-operator-selection.
sp {push-maze*elaborate*flags
   (state <s> ^superstate nil ^name push-maze)
-->
   (<s> ^flag-override <f>)
   (<f> ^mea-operator-selection true)
}

## Achievement of object-property desireds (supplied by the task).
sp {push-maze*elaborate*state*achieved*object-property
   (state <s> ^problem-space.name push-maze ^desireds <ds> ^world <w>)
   (<ds> ^desired <d>)
   (<d> ^object <do>)
   (<do> ^object-handle $ <h> ^{ <> object-handle <a> } <v>)
   (<w> ^anchored-world true ^objects.object <ob>)
   (<ob> ^object-handle $ <h> ^<a> <v>)
-->
   (<ds> ^achieved <d>)
}

sp {push-maze*elaborate*state*unachieved*object-property
   (state <s> ^problem-space.name push-maze ^desireds <ds> ^world <w>)
   (<ds> ^desired <d>)
   (<d> ^object <do>)
   (<do> ^object-handle $ <h> ^{ <> object-handle <a> } <v>)
   (<w> ^anchored-world true)
  -{(<w> ^objects.object <ob>)
    (<ob> ^object-handle <h> ^<a> <v>)}
-->
   (<ds> ^unachieved <d>)
}
## Propose block-step in problem space push-maze when its conditions below hold (adjacent clear).
sp {push-maze*propose*block-step*adjacent-clear
   (state <s> ^problem-space.name push-maze ^flags.mea-operator-selection true ^world <w> ^desireds <ds>)
   (<w> ^anchored-world true ^objects <objs>)
   (<objs> ^object <b> <d>)
   (<b> ^type block ^object-handle $ <bh>)
   (<d> ^type location ^object-handle $ <dh>)
   (<b> ^color blue)
   (<w> ^on <on-b>)
   (<on-b> ^argument1 <b> ^argument2 <l1>)
   (<w> ^adjacent <adjacent-d>)
   (<adjacent-d> ^argument1 <d> ^argument2 <l1>)
   (<w> ^clear <clear-d>)
   (<clear-d> ^argument1 <d>)
   (<ds> ^unachieved-desireds true)
-->
   (<s> ^operator <op> +)
   (<op> ^name block-step ^task-operator true ^action-handle block-step ^argument1 <b> ^argument2 <d> ^argument-count 2 ^desireds <pre>)
   (<pre> ^desired-count 0)
}
## Effect of block-step (look-ahead).
sp {push-maze*apply*block-step*internal
   (state <s> ^problem-space.name push-maze ^operator <op> ^internal-actions true ^world <w>)
   (<op> ^task-operator true ^name block-step ^pre-conditions-satisfied true ^argument1.object-handle $ <bh> ^argument2.object-handle $ <dh>)
   (<w> ^anchored-world true ^objects <objs>)
   (<objs> ^object <b> <d>)
   (<b> ^object-handle $ <bh>)
   (<d> ^object-handle $ <dh>)
   (<w> ^on <r> ^below <bl> ^clear <cd>)
   (<r> ^argument1 <b> ^argument2 <old>)
   (<bl> ^argument1 <old> ^argument2 <b>)
   (<cd> ^argument1 <d>)
-->
   (<r> ^argument2 <old> - <d>)
   (<bl> ^argument1 <old> - <d>)
   (<w> ^clear <cd> - <nc>)
   (<nc> ^argument1 <old>)
}

## Effect of a completed block-step command on the real world (once per command).
sp {push-maze*apply*block-step*environment-effect
   :o-support
   (state <s> ^problem-space.name push-maze ^superstate nil ^world <w> ^io.output-link.perform-action <pa>)
   (<pa> ^name block-step ^status complete ^argument1 <bh> ^argument2 <dh> -^effect-applied true)
   (<w> ^anchored-world true ^objects <objs>)
   (<objs> ^object <b> <d>)
   (<b> ^object-handle $ <bh>)
   (<d> ^object-handle $ <dh>)
   (<w> ^on <r> ^below <bl> ^clear <cd>)
   (<r> ^argument1 <b> ^argument2 <old>)
   (<bl> ^argument1 <old> ^argument2 <b>)
   (<cd> ^argument1 <d>)
-->
   (<r> ^argument2 <old> - <d>)
   (<bl> ^argument1 <old> - <d>)
   (<w> ^clear <cd> - <nc>)
   (<nc> ^argument1 <old>)
   (<pa> ^effect-applied true)
   (write |Step | <bh> | onto | <dh> (crlf))
}
## Propose push in problem space push-maze when its conditions below hold (dir 1).
