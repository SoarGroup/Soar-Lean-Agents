## Goal: a blue block is on a blue location.
sp {push-maze*elaborate*goal*blue-matched
   (state <s> ^problem-space.name push-maze ^world <w>)
   (<w> ^objects <objs>)
   (<objs> ^object <t> <b0> <l0>)
   (<t> ^type task)
   (<b0> ^type block ^color blue)
   (<l0> ^type location ^color blue)
   (<w> ^on <on-0>)
   (<on-0> ^argument1 <b0> ^argument2 <l0>)
-->
   (<t> ^goal-met true)
}
