   (<w> ^anchored-world true ^objects <objs>)
   (<objs> ^object <p> <l> <c> <o> <q>)
   (<p> ^type block ^object-handle $ <ph>)
   (<l> ^type location ^object-handle $ <lh>)
   (<q> ^type block)
   (<q> ^color blue)
   (<w> ^on <on-p>)
   (<on-p> ^argument1 <p> ^argument2 <c>)
   (<w> ^on <on-q>)
   (<on-q> ^argument1 <q> ^argument2 <o>)
   (<w> ^step-1 <step-1-lc>)
   (<step-1-lc> ^argument1 <l> ^argument2 <c>)
   (<w> ^step-1 <step-1-co>)
