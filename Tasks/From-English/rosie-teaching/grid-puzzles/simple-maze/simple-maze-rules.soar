## Elaborate problem space: adds ^copy-relation, ^dont-copy-object-attribute, ^problem-space.
sp {simple-maze*elaborate*problem-space
   (state <s> ^name simple-maze)
-->
   (<s> ^problem-space <p>)
   (<p> ^name simple-maze ^copy-relation below ^share-relation adjacent ^copy-relation clear ^dont-copy-object-attribute goal-met)
}

sp {simple-maze*elaborate*problem-space*mea-substate
   (state <s> ^impasse no-change ^attribute operator ^superstate <ss>)
   (<ss> ^problem-space.name simple-maze ^operator <so>)
   (<so> ^task-operator true -^pre-conditions-satisfied true)
-->
   (<s> ^problem-space <p>)
   (<p> ^name simple-maze ^dont-copy-object-attribute goal-met)
}

## Elaborate flags: adds ^flag-override, ^mea-operator-selection.
sp {simple-maze*elaborate*flags
   (state <s> ^superstate nil ^name simple-maze)
-->
   (<s> ^flag-override <f>)
   (<f> ^mea-operator-selection true)
}

## Achievement of object-property desireds (supplied by the task).
sp {simple-maze*elaborate*state*achieved*object-property
   (state <s> ^problem-space.name simple-maze ^desireds <ds> ^world <w>)
   (<ds> ^desired <d>)
   (<d> ^object <do>)
   (<do> ^object-handle $ <h> ^{ <> object-handle <a> } <v>)
   (<w> ^anchored-world true ^objects.object <ob>)
   (<ob> ^object-handle $ <h> ^<a> <v>)
-->
   (<ds> ^achieved <d>)
}

sp {simple-maze*elaborate*state*unachieved*object-property
   (state <s> ^problem-space.name simple-maze ^desireds <ds> ^world <w>)
   (<ds> ^desired <d>)
   (<d> ^object <do>)
   (<do> ^object-handle $ <h> ^{ <> object-handle <a> } <v>)
   (<w> ^anchored-world true)
  -{(<w> ^objects.object <ob>)
    (<ob> ^object-handle <h> ^<a> <v>)}
-->
   (<ds> ^unachieved <d>)
}
## Propose block-step in problem space simple-maze when its conditions below hold (adjacent clear).
sp {simple-maze*propose*block-step*adjacent-clear
   (state <s> ^problem-space.name simple-maze ^flags.mea-operator-selection true ^world <w> ^desireds <ds>)
   (<w> ^anchored-world true ^objects <objs>)
   (<objs> ^block <b> ^location <d>)
   (<b> ^object-handle $ <bh>)
   (<d> ^object-handle $ <dh>)
   (<b> ^color blue)
   (<w> ^on <on-b>)
   (<on-b> ^argument1 <b> ^argument2 <l1>)
   (<w> ^adjacent <adjacent-d>)
   (<adjacent-d> ^argument1 <d> ^argument2 <l1>)
   (<w> ^clear <clear-d>)
   (<clear-d> ^argument1 <d>)
   (<ds> ^unachieved-desireds true)
-->
   (<s> ^operator <op> +)
   (<op> ^name block-step ^task-operator true ^action-handle block-step ^argument1 <b> ^argument2 <d> ^argument-count 2 ^pre-conditions-satisfied true)
}
## Effect of block-step (look-ahead).
sp {simple-maze*apply*block-step*internal
   (state <s> ^problem-space.name simple-maze ^operator <op> ^internal-actions true ^world <w>)
   (<op> ^task-operator true ^name block-step ^pre-conditions-satisfied true ^argument1.object-handle $ <bh> ^argument2.object-handle $ <dh>)
   (<w> ^anchored-world true ^objects <objs>)
   (<objs> ^block <b> ^location <d>)
   (<b> ^object-handle $ <bh>)
   (<d> ^object-handle $ <dh>)
   (<w> ^on <r> ^below <bl> ^clear <cd>)
   (<r> ^argument1 <b> ^argument2 <old>)
   (<bl> ^argument1 <old> ^argument2 <b>)
   (<cd> ^argument1 <d>)
-->
   (<r> ^argument2 <old> - <d>)
   (<bl> ^argument1 <old> - <d>)
   (<w> ^clear <cd> - <nc>)
   (<nc> ^argument1 <old>)
}

## Effect of a completed block-step command on the real world (once per command).
sp {simple-maze*apply*block-step*environment-effect
   :o-support
   (state <s> ^problem-space.name simple-maze ^superstate nil ^world <w> ^io.output-link.perform-action <pa>)
   (<pa> ^name block-step ^status complete ^argument1 <bh> ^argument2 <dh> -^effect-applied true)
   (<w> ^anchored-world true ^objects <objs>)
   (<objs> ^block <b> ^location <d>)
   (<b> ^object-handle $ <bh>)
   (<d> ^object-handle $ <dh>)
   (<w> ^on <r> ^below <bl> ^clear <cd>)
   (<r> ^argument1 <b> ^argument2 <old>)
   (<bl> ^argument1 <old> ^argument2 <b>)
   (<cd> ^argument1 <d>)
-->
   (<r> ^argument2 <old> - <d>)
   (<bl> ^argument1 <old> - <d>)
   (<w> ^clear <cd> - <nc>)
   (<nc> ^argument1 <old>)
   (<pa> ^effect-applied true)
   (write |Step | <bh> | onto | <dh> (crlf))
}
## Goal: a blue block is on a blue location.
sp {simple-maze*elaborate*goal*blue-matched
   (state <s> ^problem-space.name simple-maze ^world <w>)
   (<w> ^objects <objs>)
   (<objs> ^task <t> ^block <b0> ^location <l0>)
   (<b0> ^color blue)
   (<l0> ^color blue)
   (<w> ^on <on-0>)
   (<on-0> ^argument1 <b0> ^argument2 <l0>)
-->
   (<t> ^goal-met true)
}
