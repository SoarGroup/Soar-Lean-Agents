## Goal: a red block is on a red location, a green block is on a green location.
sp {sokoban*elaborate*goal*red-green-matched
   (state <s> ^problem-space.name sokoban ^world <w>)
   (<w> ^objects <objs>)
   (<objs> ^object <t> <b0> <l0> <b1> <l1>)
   (<t> ^type task)
   (<b0> ^type block ^color red)
   (<l0> ^type location ^color red)
   (<w> ^on <on-0>)
   (<on-0> ^argument1 <b0> ^argument2 <l0>)
   (<b1> ^type block ^color green)
   (<l1> ^type location ^color green)
   (<w> ^on <on-1>)
   (<on-1> ^argument1 <b1> ^argument2 <l1>)
-->
   (<t> ^goal-met true)
}
