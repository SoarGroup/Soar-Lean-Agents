## Effect of push-block in direction 1 (look-ahead): the pushed block moves onto the clear location and the pusher onto
## the location the pushed block left.
sp {sokoban*apply*push-block*internal*dir-1
   (state <s> ^problem-space.name sokoban ^operator <op> ^internal-actions true ^world <w>)
   (<op> ^task-operator true ^name push-block ^direction 1 ^pre-conditions-satisfied true ^argument1.object-handle $ <ph> ^argument2.object-handle $ <lh>)
   (<w> ^anchored-world true ^objects <objs>)
   (<objs> ^object <p> <l> <c> <o> <q>)
   (<p> ^object-handle $ <ph>)
   (<l> ^object-handle $ <lh>)
   (<q> ^type block)
   (<q> ^color blue)
   (<w> ^on <rp> <rq> ^below <bp> <bq> ^clear <cl>)
   (<rp> ^argument1 <p> ^argument2 <c>)
   (<bp> ^argument1 <c> ^argument2 <p>)
   (<rq> ^argument1 <q> ^argument2 <o>)
   (<bq> ^argument1 <o> ^argument2 <q>)
   (<cl> ^argument1 <l>)
   (<w> ^step-1 <step-1-lc>)
   (<step-1-lc> ^argument1 <l> ^argument2 <c>)
   (<w> ^step-1 <step-1-co>)
   (<step-1-co> ^argument1 <c> ^argument2 <o>)
-->
   (<rp> ^argument2 <c> - <l>)
   (<bp> ^argument1 <c> - <l>)
   (<rq> ^argument2 <o> - <c>)
   (<bq> ^argument1 <o> - <c>)
   (<w> ^clear <cl> - <nc>)
   (<nc> ^argument1 <o>)
}

