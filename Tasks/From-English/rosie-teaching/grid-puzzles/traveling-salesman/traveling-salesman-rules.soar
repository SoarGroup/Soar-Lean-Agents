## Goal: all locations are covered and a red block is adjacent to a green location.
sp {traveling-salesman*elaborate*goal*covered
   (state <s> ^problem-space.name traveling-salesman ^world <w>)
   (<w> ^objects <objs>)
   (<objs> ^object <t> <l-location-1> <l-location-2> <l-location-3> <l-location-4> <l-location-5> <l-location-6> <l-location-7> <l-location-8> <l-location-9> <l-location-10> <l-location-11> <l-location-12> <rb> <g>)
   (<t> ^type task)
   (<l-location-1> ^object-handle location-1)
   (<w> ^below <bw-location-1>)
   (<bw-location-1> ^argument1 <l-location-1>)
   (<l-location-2> ^object-handle location-2)
