## Elaborate problem space: adds ^copy-relation, ^dont-copy-object-attribute, ^problem-space.
sp {traveling-salesman*elaborate*problem-space
   (state <s> ^name traveling-salesman)
-->
   (<s> ^problem-space <p>)
   (<p> ^name traveling-salesman ^copy-relation below ^share-relation adjacent ^copy-relation clear ^copy-relation available ^dont-copy-object-attribute goal-met)
}

sp {traveling-salesman*elaborate*problem-space*mea-substate
   (state <s> ^impasse no-change ^attribute operator ^superstate <ss>)
   (<ss> ^problem-space.name traveling-salesman ^operator <so>)
   (<so> ^task-operator true -^pre-conditions-satisfied true)
-->
   (<s> ^problem-space <p>)
   (<p> ^name traveling-salesman ^dont-copy-object-attribute goal-met)
}

## Elaborate flags: adds ^flag-override, ^mea-operator-selection.
sp {traveling-salesman*elaborate*flags
   (state <s> ^superstate nil ^name traveling-salesman)
-->
   (<s> ^flag-override <f>)
   (<f> ^mea-operator-selection true)
}

## Achievement of object-property desireds (supplied by the task).
sp {traveling-salesman*elaborate*state*achieved*object-property
   (state <s> ^problem-space.name traveling-salesman ^desireds <ds> ^world <w>)
   (<ds> ^desired <d>)
   (<d> ^object <do>)
   (<do> ^object-handle $ <h> ^{ <> object-handle <a> } <v>)
   (<w> ^anchored-world true ^objects.object <ob>)
   (<ob> ^object-handle $ <h> ^<a> <v>)
-->
   (<ds> ^achieved <d>)
}

sp {traveling-salesman*elaborate*state*unachieved*object-property
   (state <s> ^problem-space.name traveling-salesman ^desireds <ds> ^world <w>)
   (<ds> ^desired <d>)
   (<d> ^object <do>)
   (<do> ^object-handle $ <h> ^{ <> object-handle <a> } <v>)
   (<w> ^anchored-world true)
  -{(<w> ^objects.object <ob>)
    (<ob> ^object-handle <h> ^<a> <v>)}
-->
   (<ds> ^unachieved <d>)
}
## Propose move-salesman in problem space traveling-salesman when its conditions below hold.
sp {traveling-salesman*propose*move-salesman
   (state <s> ^problem-space.name traveling-salesman ^flags.mea-operator-selection true ^world <w> ^desireds <ds>)
   (<w> ^anchored-world true ^objects <objs>)
   (<objs> ^object <b> <d>)
   (<b> ^type block ^color red ^object-handle $ <bh>)
   (<d> ^type location ^object-handle $ <dh>)
   (<w> ^on <on-b>)
   (<on-b> ^argument1 <b> ^argument2 <l1>)
   (<w> ^adjacent <adjacent-d>)
   (<adjacent-d> ^argument1 <d> ^argument2 <l1>)
   (<w> ^clear <clear-d>)
   (<clear-d> ^argument1 <d>)
   (<ds> ^unachieved-desireds true)
-->
   (<s> ^operator <op> +)
   (<op> ^name move-salesman ^task-operator true ^action-handle move-salesman ^argument1 <b> ^argument2 <d> ^argument-count 2 ^pre-conditions-satisfied true)
}
## Effect of move-salesman (look-ahead).
sp {traveling-salesman*apply*move-salesman*internal*blue-from-block
   (state <s> ^problem-space.name traveling-salesman ^operator <op> ^internal-actions true ^world <w>)
   (<op> ^task-operator true ^name move-salesman ^pre-conditions-satisfied true ^argument1.object-handle $ <bh> ^argument2.object-handle $ <dh>)
   (<w> ^anchored-world true ^objects <objs>)
   (<objs> ^object <b> <d> <u>)
   (<b> ^object-handle $ <bh>)
   (<d> ^object-handle $ <dh>)
   (<u> ^type block ^color blue)
   (<w> ^on <r> ^below <bl> ^clear <cd> <cu> ^available <au>)
   (<r> ^argument1 <b> ^argument2 <old>)
   (<bl> ^argument1 <old> ^argument2 <b>)
   (<cd> ^argument1 <d>)
   (<cu> ^argument1 <u>)
   (<au> ^argument1 <u>)
   (<w> ^on <ru> ^below <bu>)
   (<ru> ^argument1 <u> ^argument2 <x>)
   (<bu> ^argument1 <x> ^argument2 <u>)
-->
   (<r> ^argument2 <old> - <d>)
   (<bl> ^argument1 <old> - <d>)
   (<ru> ^argument2 <x> - <old>)
   (<bu> ^argument1 <x> - <old>)
   (<w> ^clear <cd> - <nx> ^available <au> -)
   (<nx> ^argument1 <x>)
}

## Effect of a completed move-salesman command on the real world (once per command).
sp {traveling-salesman*apply*move-salesman*environment-effect*blue-from-block
   :o-support
   (state <s> ^problem-space.name traveling-salesman ^superstate nil ^world <w> ^io.output-link.perform-action <pa>)
   (<pa> ^name move-salesman ^status complete ^argument1 <bh> ^argument2 <dh> -^effect-applied true)
   (<w> ^anchored-world true ^objects <objs>)
   (<objs> ^object <b> <d> <u>)
   (<b> ^object-handle $ <bh>)
   (<d> ^object-handle $ <dh>)
   (<u> ^type block ^color blue)
   (<w> ^on <r> ^below <bl> ^clear <cd> <cu> ^available <au>)
   (<r> ^argument1 <b> ^argument2 <old>)
   (<bl> ^argument1 <old> ^argument2 <b>)
   (<cd> ^argument1 <d>)
   (<cu> ^argument1 <u>)
   (<au> ^argument1 <u>)
   (<w> ^on <ru> ^below <bu>)
   (<ru> ^argument1 <u> ^argument2 <x>)
   (<bu> ^argument1 <x> ^argument2 <u>)
-->
   (<r> ^argument2 <old> - <d>)
   (<bl> ^argument1 <old> - <d>)
   (<ru> ^argument2 <x> - <old>)
   (<bu> ^argument1 <x> - <old>)
   (<w> ^clear <cd> - <nx> ^available <au> -)
   (<nx> ^argument1 <x>)
   (<pa> ^effect-applied true)
   (write |Move | <bh> | onto | <dh> |, leaving a blue block behind| (crlf))
}
