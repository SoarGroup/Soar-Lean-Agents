## Elaborate problem space: adds ^copy-relation, ^dont-copy-object-attribute, ^problem-space.
sp {number-map-color*elaborate*problem-space
   (state <s> ^name number-map-color)
-->
   (<s> ^problem-space <p>)
   (<p> ^name number-map-color ^copy-relation below ^copy-relation near ^copy-relation empty ^dont-copy-object-attribute goal-met ^dont-copy-object-attribute sum)
}

sp {number-map-color*elaborate*problem-space*mea-substate
   (state <s> ^impasse no-change ^attribute operator ^superstate <ss>)
   (<ss> ^problem-space.name number-map-color ^operator <so>)
   (<so> ^task-operator true -^pre-conditions-satisfied true)
-->
   (<s> ^problem-space <p>)
   (<p> ^name number-map-color ^dont-copy-object-attribute goal-met ^dont-copy-object-attribute sum)
}

## Elaborate flags: adds ^flag-override, ^mea-operator-selection.
sp {number-map-color*elaborate*flags
   (state <s> ^superstate nil ^name number-map-color)
-->
   (<s> ^flag-override <f>)
   (<f> ^mea-operator-selection true)
}

## Achievement of object-property desireds (supplied by the task).
sp {number-map-color*elaborate*state*achieved*object-property
   (state <s> ^problem-space.name number-map-color ^desireds <ds> ^world <w>)
   (<ds> ^desired <d>)
   (<d> ^object <do>)
   (<do> ^object-handle $ <h> ^{ <> object-handle <a> } <v>)
   (<w> ^anchored-world true ^objects.object <ob>)
   (<ob> ^object-handle $ <h> ^<a> <v>)
-->
   (<ds> ^achieved <d>)
}

sp {number-map-color*elaborate*state*unachieved*object-property
   (state <s> ^problem-space.name number-map-color ^desireds <ds> ^world <w>)
   (<ds> ^desired <d>)
   (<d> ^object <do>)
   (<do> ^object-handle $ <h> ^{ <> object-handle <a> } <v>)
   (<w> ^anchored-world true)
  -{(<w> ^objects.object <ob>)
    (<ob> ^object-handle <h> ^<a> <v>)}
-->
   (<ds> ^unachieved <d>)
}
## Propose write in problem space number-map-color when its conditions below hold.
sp {number-map-color*propose*write
   (state <s> ^problem-space.name number-map-color ^flags.mea-operator-selection true ^world <w> ^desireds <ds>)
   (<w> ^anchored-world true ^objects <objs>)
   (<objs> ^object <l> <n>)
   (<l> ^type location ^object-handle $ <lh>)
   (<n> ^type number ^number <k> ^object-handle $ <nh>)
   (<w> ^empty <e>)
   (<e> ^argument1 <l>)
   (<ds> ^unachieved-desireds true)
-->
   (<s> ^operator <op> +)
   (<op> ^name write ^task-operator true ^action-handle write ^argument1 <l> ^argument2 <n> ^argument-count 2 ^desireds <pre>)
   (<pre> ^desired-count 0)
}
## Effect of write (look-ahead): the location has the value; it is no longer empty.
sp {number-map-color*apply*write*internal
   (state <s> ^problem-space.name number-map-color ^operator <op> ^internal-actions true ^world <w>)
   (<op> ^task-operator true ^name write ^pre-conditions-satisfied true ^argument1.object-handle $ <lh> ^argument2.object-handle $ <nh>)
   (<w> ^anchored-world true ^objects <objs> ^empty <e>)
   (<objs> ^object <l> <n>)
   (<l> ^object-handle $ <lh>)
   (<n> ^object-handle $ <nh> ^number <k>)
   (<e> ^argument1 <l>)
-->
   (<l> ^value <k>)
   (<w> ^empty <e> -)
}

## Effect of a completed write command on the real world (once per command).
sp {number-map-color*apply*write*environment-effect
   :o-support
   (state <s> ^problem-space.name number-map-color ^superstate nil ^world <w> ^io.output-link.perform-action <pa>)
   (<pa> ^name write ^status complete ^argument1 <lh> ^argument2 <nh> -^effect-applied true)
   (<w> ^anchored-world true ^objects <objs> ^empty <e>)
   (<objs> ^object <l> <n>)
   (<l> ^object-handle $ <lh>)
   (<n> ^object-handle $ <nh> ^number <k>)
   (<e> ^argument1 <l>)
-->
   (<l> ^value <k>)
   (<w> ^empty <e> -)
   (<pa> ^effect-applied true)
   (write |Write | <k> | on | <lh> (crlf))
}
## Failure: the value of a location is the value of an object that is next to it (the near relation of the world file).
sp {number-map-color*elaborate*failure*same-value-as-neighbor
   (state <s> ^problem-space.name number-map-color ^desireds <ds> ^world <w>)
   (<w> ^anchored-world true ^near <r>)
   (<r> ^argument1 <l> ^argument2 <o>)
   (<l> ^type location ^value <v>)
   (<o> ^value <v>)
-->
   (<s> ^failure <ds>)
}
## Goal: all locations are filled (expanded over the locations of the world file; filled: value more than zero).
sp {number-map-color*elaborate*goal*all-filled
   (state <s> ^problem-space.name number-map-color ^world <w>)
   (<w> ^anchored-world true ^objects <objs>)
   (<objs> ^object <t> <l-loc-1-1> <l-loc-1-2> <l-loc-1-3> <l-loc-2-1> <l-loc-2-2> <l-loc-2-3> <l-loc-3-1> <l-loc-3-2> <l-loc-3-3>)
   (<t> ^type task)
   (<l-loc-1-1> ^object-handle loc-1-1 ^value > 0)
   (<l-loc-1-2> ^object-handle loc-1-2 ^value > 0)
   (<l-loc-1-3> ^object-handle loc-1-3 ^value > 0)
   (<l-loc-2-1> ^object-handle loc-2-1 ^value > 0)
   (<l-loc-2-2> ^object-handle loc-2-2 ^value > 0)
   (<l-loc-2-3> ^object-handle loc-2-3 ^value > 0)
   (<l-loc-3-1> ^object-handle loc-3-1 ^value > 0)
   (<l-loc-3-2> ^object-handle loc-3-2 ^value > 0)
   (<l-loc-3-3> ^object-handle loc-3-3 ^value > 0)
-->
   (<t> ^goal-met true)
}
