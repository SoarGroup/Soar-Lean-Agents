## Jigsawdoku, generated from the Rosie teaching script (english-input.txt) under the world conventions.
##
## Instructor statements used (numbers as in english-input.txt):
##   1. The name of the puzzle is jigsawdoku-sudoku.
##   4. The name of the action is write-1-to-4.
##   5. You can write a number that is between one and four onto an empty location.
##   6. If the value of a location is absent then the location is empty.
##   7. The solution has four steps.
##   9. The name of a failure is same-row-value.
##  11. If the row of a location is the row of a location and the value of the former location is the value of the latter location then you lose.
##  12. The name of a failure is same-col-value.
##  14. If the column of a location is the column of a location and the value of the former location is the value of the latter location then you lose.
##  15. The name of a failure is same-section-value.
##  17. If the section of a location is the section of a location and the value of the former location is the value of the latter location then you lose.
##  19. The name of the goal is all-filled.
##  21. The goal is that all locations are filled.
##  22. If the value of a location is more than zero then the location is filled.
## World: init-jigsawdoku.world (a 4x4 grid in four sections, four empty)
##
## Translation (tools/rosie-language.md gives the general reading; the assumption ledger is in README.md):
##   - "a location ... a location ... the former ... the latter" are two different locations (A-L1).
##   - Operator write (argument1 = the location, argument2 = number-k for k from 1 to 4).
## Matching hints for learned rules (World-Conventions L3-095, L11-009): many-valued attributes, sized from the initial world.
production optimize-attribute object 21
production optimize-attribute empty 4


## Propose initialize-jigsawdoku-sudoku when its conditions below hold.
sp {jigsawdoku-sudoku*propose*initialize-jigsawdoku-sudoku
   (state <s> ^superstate nil ^world <w> -^name)
-->
   (<s> ^operator <o> + >)
   (<o> ^name initialize-jigsawdoku-sudoku ^task-operator false)
}

sp {jigsawdoku-sudoku*apply*initialize-jigsawdoku-sudoku
   (state <s> ^operator.name initialize-jigsawdoku-sudoku ^world <w>)
   (<w> ^objects <objs>)
-->
   (<s> ^name jigsawdoku-sudoku ^desireds <ds>)
   (<objs> ^object <o-loc-1-1> <o-loc-2-1> <o-loc-3-1> <o-loc-4-1> <o-loc-1-2> <o-loc-2-2> <o-loc-3-2> <o-loc-4-2> <o-loc-1-3> <o-loc-2-3> <o-loc-3-3> <o-loc-4-3> <o-loc-1-4> <o-loc-2-4> <o-loc-3-4> <o-loc-4-4> <o-task> <o-number-1> <o-number-2> <o-number-3> <o-number-4>)
   (<o-loc-1-1> ^object-handle loc-1-1 ^anchored true ^type location ^value 3 ^fixed <o-loc-1-1-fx>)
   (<o-loc-1-1-fx> ^row 1 ^column 1 ^section 1)
   (<o-loc-2-1> ^object-handle loc-2-1 ^anchored true ^type location ^value 1 ^fixed <o-loc-2-1-fx>)
   (<o-loc-2-1-fx> ^row 2 ^column 1 ^section 1)
   (<o-loc-3-1> ^object-handle loc-3-1 ^anchored true ^type location ^value 2 ^fixed <o-loc-3-1-fx>)
   (<o-loc-3-1-fx> ^row 3 ^column 1 ^section 1)
   (<o-loc-4-1> ^object-handle loc-4-1 ^anchored true ^type location ^value 4 ^fixed <o-loc-4-1-fx>)
   (<o-loc-4-1-fx> ^row 4 ^column 1 ^section 1)
   (<o-loc-1-2> ^object-handle loc-1-2 ^anchored true ^type location ^value 4 ^fixed <o-loc-1-2-fx>)
   (<o-loc-1-2-fx> ^row 1 ^column 2 ^section 2)
   (<o-loc-2-2> ^object-handle loc-2-2 ^anchored true ^type location ^fixed <o-loc-2-2-fx>)
   (<o-loc-2-2-fx> ^row 2 ^column 2 ^section 2)
   (<o-loc-3-2> ^object-handle loc-3-2 ^anchored true ^type location ^value 1 ^fixed <o-loc-3-2-fx>)
   (<o-loc-3-2-fx> ^row 3 ^column 2 ^section 3)
   (<o-loc-4-2> ^object-handle loc-4-2 ^anchored true ^type location ^value 3 ^fixed <o-loc-4-2-fx>)
   (<o-loc-4-2-fx> ^row 4 ^column 2 ^section 3)
   (<o-loc-1-3> ^object-handle loc-1-3 ^anchored true ^type location ^value 1 ^fixed <o-loc-1-3-fx>)
   (<o-loc-1-3-fx> ^row 1 ^column 3 ^section 2)
   (<o-loc-2-3> ^object-handle loc-2-3 ^anchored true ^type location ^fixed <o-loc-2-3-fx>)
   (<o-loc-2-3-fx> ^row 2 ^column 3 ^section 2)
   (<o-loc-3-3> ^object-handle loc-3-3 ^anchored true ^type location ^value 4 ^fixed <o-loc-3-3-fx>)
   (<o-loc-3-3-fx> ^row 3 ^column 3 ^section 3)
   (<o-loc-4-3> ^object-handle loc-4-3 ^anchored true ^type location ^value 2 ^fixed <o-loc-4-3-fx>)
   (<o-loc-4-3-fx> ^row 4 ^column 3 ^section 3)
   (<o-loc-1-4> ^object-handle loc-1-4 ^anchored true ^type location ^fixed <o-loc-1-4-fx>)
   (<o-loc-1-4-fx> ^row 1 ^column 4 ^section 4)
   (<o-loc-2-4> ^object-handle loc-2-4 ^anchored true ^type location ^fixed <o-loc-2-4-fx>)
   (<o-loc-2-4-fx> ^row 2 ^column 4 ^section 4)
   (<o-loc-3-4> ^object-handle loc-3-4 ^anchored true ^type location ^value 3 ^fixed <o-loc-3-4-fx>)
   (<o-loc-3-4-fx> ^row 3 ^column 4 ^section 4)
   (<o-loc-4-4> ^object-handle loc-4-4 ^anchored true ^type location ^value 1 ^fixed <o-loc-4-4-fx>)
   (<o-loc-4-4-fx> ^row 4 ^column 4 ^section 4)
   (<o-task> ^object-handle task ^anchored true ^type task)
   (<o-number-1> ^object-handle number-1 ^anchored true ^type number ^number 1 ^static true)
   (<o-number-2> ^object-handle number-2 ^anchored true ^type number ^number 2 ^static true)
   (<o-number-3> ^object-handle number-3 ^anchored true ^type number ^number 3 ^static true)
   (<o-number-4> ^object-handle number-4 ^anchored true ^type number ^number 4 ^static true)
   (<ds> ^desired-count 1 ^desired <d1>)
   (<d1> ^object <d1-o>)
   (<d1-o> ^object-handle task ^goal-met true)
   (<w> ^empty <empty-loc-2-2>)
   (<empty-loc-2-2> ^argument1 <o-loc-2-2>)
   (<w> ^empty <empty-loc-2-3>)
   (<empty-loc-2-3> ^argument1 <o-loc-2-3>)
   (<w> ^empty <empty-loc-1-4>)
   (<empty-loc-1-4> ^argument1 <o-loc-1-4>)
   (<w> ^empty <empty-loc-2-4>)
   (<empty-loc-2-4> ^argument1 <o-loc-2-4>)
   (log 1 (crlf) |Initialize jigsawdoku-sudoku.|)
}

## Elaborate problem space: adds ^copy-relation, ^dont-copy-object-attribute, ^problem-space.
sp {jigsawdoku-sudoku*elaborate*problem-space
   (state <s> ^name jigsawdoku-sudoku)
-->
   (<s> ^problem-space <p>)
   (<p> ^name jigsawdoku-sudoku ^copy-relation below ^copy-relation empty ^dont-copy-object-attribute goal-met ^dont-copy-object-attribute sum)
}

sp {jigsawdoku-sudoku*elaborate*problem-space*mea-substate
   (state <s> ^impasse no-change ^attribute operator ^superstate <ss>)
   (<ss> ^problem-space.name jigsawdoku-sudoku ^operator <so>)
   (<so> ^task-operator true -^pre-conditions-satisfied true)
-->
   (<s> ^problem-space <p>)
   (<p> ^name jigsawdoku-sudoku ^dont-copy-object-attribute goal-met ^dont-copy-object-attribute sum)
}

