## Elaborate problem space: adds ^copy-relation, ^dont-copy-object-attribute, ^problem-space.
sp {kakuro*elaborate*problem-space
   (state <s> ^name kakuro)
-->
   (<s> ^problem-space <p>)
   (<p> ^name kakuro ^copy-relation below ^copy-relation empty ^copy-relation member ^copy-relation sum-target ^dont-copy-object-attribute goal-met ^dont-copy-object-attribute sum)
}

sp {kakuro*elaborate*problem-space*mea-substate
   (state <s> ^impasse no-change ^attribute operator ^superstate <ss>)
   (<ss> ^problem-space.name kakuro ^operator <so>)
   (<so> ^task-operator true -^pre-conditions-satisfied true)
-->
   (<s> ^problem-space <p>)
   (<p> ^name kakuro ^dont-copy-object-attribute goal-met ^dont-copy-object-attribute sum)
}

## Elaborate flags: adds ^flag-override, ^mea-operator-selection.
sp {kakuro*elaborate*flags
   (state <s> ^superstate nil ^name kakuro)
-->
   (<s> ^flag-override <f>)
   (<f> ^mea-operator-selection true)
}

## Achievement of object-property desireds (supplied by the task).
sp {kakuro*elaborate*state*achieved*object-property
   (state <s> ^problem-space.name kakuro ^desireds <ds> ^world <w>)
   (<ds> ^desired <d>)
   (<d> ^object <do>)
   (<do> ^object-handle $ <h> ^{ <> object-handle <a> } <v>)
   (<w> ^anchored-world true ^objects.object <ob>)
   (<ob> ^object-handle $ <h> ^<a> <v>)
-->
   (<ds> ^achieved <d>)
}

sp {kakuro*elaborate*state*unachieved*object-property
   (state <s> ^problem-space.name kakuro ^desireds <ds> ^world <w>)
   (<ds> ^desired <d>)
   (<d> ^object <do>)
   (<do> ^object-handle $ <h> ^{ <> object-handle <a> } <v>)
   (<w> ^anchored-world true)
  -{(<w> ^objects.object <ob>)
    (<ob> ^object-handle <h> ^<a> <v>)}
-->
   (<ds> ^unachieved <d>)
}
## Propose write in problem space kakuro when its conditions below hold.
sp {kakuro*propose*write
   (state <s> ^problem-space.name kakuro ^flags.mea-operator-selection true ^world <w> ^desireds <ds>)
   (<w> ^anchored-world true ^objects <objs>)
   (<objs> ^location <l> ^number <n>)
   (<l> ^object-handle $ <lh>)
   (<n> ^number <k> ^object-handle $ <nh>)
   (<w> ^empty <e>)
   (<e> ^argument1 <l>)
   (<ds> ^unachieved-desireds true)
-->
   (<s> ^operator <op> +)
   (<op> ^name write ^task-operator true ^action-handle write ^argument1 <l> ^argument2 <n> ^argument-count 2 ^pre-conditions-satisfied true)
}
## Effect of write (look-ahead): the location has the value; it is no longer empty.
sp {kakuro*apply*write*internal
   (state <s> ^problem-space.name kakuro ^operator <op> ^internal-actions true ^world <w>)
   (<op> ^task-operator true ^name write ^pre-conditions-satisfied true ^argument1.object-handle $ <lh> ^argument2.object-handle $ <nh>)
   (<w> ^anchored-world true ^objects <objs> ^empty <e>)
   (<objs> ^location <l> ^number <n>)
   (<l> ^object-handle $ <lh>)
   (<n> ^object-handle $ <nh> ^number <k>)
   (<e> ^argument1 <l>)
-->
   (<l> ^value <k>)
   (<w> ^empty <e> -)
}

## Effect of a completed write command on the real world (once per command).
sp {kakuro*apply*write*environment-effect
   :o-support
   (state <s> ^problem-space.name kakuro ^superstate nil ^world <w> ^io.output-link.perform-action <pa>)
   (<pa> ^name write ^status complete ^argument1 <lh> ^argument2 <nh> -^effect-applied true)
   (<w> ^anchored-world true ^objects <objs> ^empty <e>)
   (<objs> ^location <l> ^number <n>)
   (<l> ^object-handle $ <lh>)
   (<n> ^object-handle $ <nh> ^number <k>)
   (<e> ^argument1 <l>)
-->
   (<l> ^value <k>)
   (<w> ^empty <e> -)
   (<pa> ^effect-applied true)
   (write |Write | <k> | on | <lh> (crlf))
}
## Failure (identical-green-same-row): two different green locations with the same row have the same value.
sp {kakuro*elaborate*failure*identical-green-same-row
   (state <s> ^problem-space.name kakuro ^desireds <ds> ^world <w>)
   (<w> ^anchored-world true ^objects <objs>)
   (<objs> ^location <l1> <l2>)
   (<l1> ^fixed.color green ^fixed.row <a> ^value <v> ^object-handle $ <h1>)
   (<l2> ^fixed.color green ^fixed.row <a> ^value <v> ^object-handle { <> <h1> })
-->
   (<s> ^failure <ds>)
}
