## Effect of a completed write command on the real world (once per command).
sp {color-ken-ken*apply*write*environment-effect
   :o-support
   (state <s> ^problem-space.name color-ken-ken ^superstate nil ^world <w> ^io.output-link.perform-action <pa>)
   (<pa> ^name write ^status complete ^argument1 <l-h> ^argument2 <n-h> -^effect-applied true)
   (<w> ^anchored-world true ^objects <objs>)
   (<objs> ^location <l>)
   (<l> ^object-handle $ <l-h>)
   (<objs> ^number <n>)
   (<n> ^object-handle $ <n-h>)
   (<n> ^number <n-number>)
   (<w> ^empty <e1>)
   (<e1> ^argument1 <l>)
   (<w> ^empty-first <e2>)
   (<e2> ^argument1 <l>)
-->
