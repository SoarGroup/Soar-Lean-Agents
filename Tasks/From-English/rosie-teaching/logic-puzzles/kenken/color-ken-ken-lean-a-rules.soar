## sum of a group of 3, once every member has value (derived; not copied into look-ahead worlds).
sp {color-ken-ken*elaborate*group*sum*3
   (state <s> ^problem-space.name color-ken-ken ^world <w>)
   (<w> ^anchored-world true ^member <r1> <r2> <r3>)
   (<g> ^type group ^size 3)
   (<r1> ^argument1 <g> ^argument2 <m1>)
   (<m1> ^value <v1>)
   (<r2> ^argument1 <g> ^argument2 { <> <m1> <m2> })
   (<m2> ^value <v2>)
   (<r3> ^argument1 <g> ^argument2 { <> <m1> <> <m2> <m3> })
   (<m3> ^value <v3>)
-->
   (<g> ^sum (+ <v1> <v2> <v3>))
}

