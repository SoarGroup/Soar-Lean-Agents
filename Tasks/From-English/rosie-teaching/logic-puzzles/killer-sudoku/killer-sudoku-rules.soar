   (<w> ^anchored-world true ^objects <objs>)
   (<objs> ^location <l1> <l2>)
   (<l1> ^fixed.row <a> ^value <v> ^object-handle $ <h1>)
   (<l2> ^fixed.row <a> ^value <v> ^object-handle { <> <h1> })
-->
   (<s> ^failure <ds>)
}
