   (<w> ^member <member-group-red-loc-1-4>)
   (<member-group-red-loc-1-4> ^argument1 <o-group-red> ^argument2 <o-loc-1-4>)
   (<w> ^member <member-group-blue-loc-2-1>)
   (<member-group-blue-loc-2-1> ^argument1 <o-group-blue> ^argument2 <o-loc-2-1>)
   (<w> ^member <member-group-blue-loc-3-1>)
   (<member-group-blue-loc-3-1> ^argument1 <o-group-blue> ^argument2 <o-loc-3-1>)
   (<w> ^member <member-group-blue-loc-4-1>)
