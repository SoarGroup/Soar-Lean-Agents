}
## Propose write in problem space killer-sudoku when its conditions below hold.
sp {killer-sudoku*propose*write
   (state <s> ^problem-space.name killer-sudoku ^flags.mea-operator-selection true ^world <w> ^desireds <ds>)
   (<w> ^anchored-world true ^objects <objs>)
   (<objs> ^location <l> ^number <n>)
   (<l> ^object-handle $ <lh>)
   (<n> ^number <k> ^object-handle $ <nh>)
   (<w> ^empty <e>)
   (<e> ^argument1 <l>)
   (<ds> ^unachieved-desireds true)
-->
   (<s> ^operator <op> +)
   (<op> ^name write ^task-operator true ^action-handle write ^argument1 <l> ^argument2 <n> ^argument-count 2 ^pre-conditions-satisfied true)
}
## Effect of write (look-ahead): the location has the value; it is no longer empty.
sp {killer-sudoku*apply*write*internal
   (state <s> ^problem-space.name killer-sudoku ^operator <op> ^internal-actions true ^world <w>)
   (<op> ^task-operator true ^name write ^pre-conditions-satisfied true ^argument1.object-handle $ <lh> ^argument2.object-handle $ <nh>)
   (<w> ^anchored-world true ^objects <objs> ^empty <e>)
   (<objs> ^location <l> ^number <n>)
   (<l> ^object-handle $ <lh>)
   (<n> ^object-handle $ <nh> ^number <k>)
   (<e> ^argument1 <l>)
-->
   (<l> ^value <k>)
   (<w> ^empty <e> -)
}

## Effect of a completed write command on the real world (once per command).
sp {killer-sudoku*apply*write*environment-effect
   :o-support
   (state <s> ^problem-space.name killer-sudoku ^superstate nil ^world <w> ^io.output-link.perform-action <pa>)
   (<pa> ^name write ^status complete ^argument1 <lh> ^argument2 <nh> -^effect-applied true)
   (<w> ^anchored-world true ^objects <objs> ^empty <e>)
   (<objs> ^location <l> ^number <n>)
   (<l> ^object-handle $ <lh>)
   (<n> ^object-handle $ <nh> ^number <k>)
   (<e> ^argument1 <l>)
-->
   (<l> ^value <k>)
   (<w> ^empty <e> -)
   (<pa> ^effect-applied true)
   (write |Write | <k> | on | <lh> (crlf))
}
## Failure (same-row-value): two different locations with the same row have the same value.
