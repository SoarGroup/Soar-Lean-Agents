   (<ds> ^desired-count 1 ^desired <d1>)
   (<d1> ^object <d1-o>)
   (<d1-o> ^object-handle task ^goal-met true)
   (<w> ^empty <empty-loc-2-2>)
   (<empty-loc-2-2> ^argument1 <o-loc-2-2>)
