   (<w> ^member <member-group-blue-loc-4-2>)
   (<member-group-blue-loc-4-2> ^argument1 <o-group-blue> ^argument2 <o-loc-4-2>)
   (<w> ^member <member-group-green-loc-2-2>)
   (<member-group-green-loc-2-2> ^argument1 <o-group-green> ^argument2 <o-loc-2-2>)
   (<w> ^member <member-group-green-loc-3-2>)
   (<member-group-green-loc-3-2> ^argument1 <o-group-green> ^argument2 <o-loc-3-2>)
