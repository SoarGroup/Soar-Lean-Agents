   (log 1 (crlf) |Initialize killer-sudoku.|)
}

## Elaborate problem space: adds ^copy-relation, ^dont-copy-object-attribute, ^problem-space.
sp {killer-sudoku*elaborate*problem-space
   (state <s> ^name killer-sudoku)
-->
   (<s> ^problem-space <p>)
   (<p> ^name killer-sudoku ^copy-relation below ^copy-relation empty ^copy-relation member ^dont-copy-object-attribute goal-met ^dont-copy-object-attribute sum)
}

sp {killer-sudoku*elaborate*problem-space*mea-substate
   (state <s> ^impasse no-change ^attribute operator ^superstate <ss>)
   (<ss> ^problem-space.name killer-sudoku ^operator <so>)
   (<so> ^task-operator true -^pre-conditions-satisfied true)
-->
   (<s> ^problem-space <p>)
   (<p> ^name killer-sudoku ^dont-copy-object-attribute goal-met ^dont-copy-object-attribute sum)
}

## Elaborate flags: adds ^flag-override, ^mea-operator-selection.
sp {killer-sudoku*elaborate*flags
   (state <s> ^superstate nil ^name killer-sudoku)
-->
   (<s> ^flag-override <f>)
   (<f> ^mea-operator-selection true)
}

