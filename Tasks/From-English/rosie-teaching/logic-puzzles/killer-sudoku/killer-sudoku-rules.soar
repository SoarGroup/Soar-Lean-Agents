## Sum of a group of 4 locations, once every member has a value (derived; not copied into look-ahead worlds).
sp {killer-sudoku*elaborate*group*sum*4
   (state <s> ^problem-space.name killer-sudoku ^world <w>)
   (<w> ^anchored-world true ^member <r1> <r2> <r3> <r4>)
   (<g> ^type group ^size 4)
   (<r1> ^argument1 <g> ^argument2 <l1>)
   (<l1> ^value <v1> ^object-handle $ <h1>)
   (<r2> ^argument1 <g> ^argument2 <l2>)
   (<l2> ^value <v2> ^object-handle { <> <h1> <h2> })
   (<r3> ^argument1 <g> ^argument2 <l3>)
   (<l3> ^value <v3> ^object-handle { <> <h1> <> <h2> <h3> })
   (<r4> ^argument1 <g> ^argument2 <l4>)
   (<l4> ^value <v4> ^object-handle { <> <h1> <> <h2> <> <h3> <h4> })
-->
   (<g> ^sum (+ <v1> <v2> <v3> <v4>))
}
## Failure: the locations of a group are filled and their sum is not the group's number.
sp {killer-sudoku*elaborate*failure*group-sum-constant
   (state <s> ^problem-space.name killer-sudoku ^desireds <ds> ^world <w>)
   (<w> ^anchored-world true ^objects.group <g>)
   (<g> ^target-value <tv> ^sum { <> <tv> })
-->
   (<s> ^failure <ds>)
}
## Goal: all locations are filled (expanded over the locations of the world file; filled: value more than zero).
sp {killer-sudoku*elaborate*goal*all-filled
   (state <s> ^problem-space.name killer-sudoku ^world <w>)
   (<w> ^anchored-world true ^objects <objs>)
   (<objs> ^task <t> ^location <l-loc-1-1> <l-loc-2-1> <l-loc-3-1> <l-loc-4-1> <l-loc-1-2> <l-loc-2-2> <l-loc-3-2> <l-loc-4-2> <l-loc-1-3> <l-loc-2-3> <l-loc-3-3> <l-loc-4-3> <l-loc-1-4> <l-loc-2-4> <l-loc-3-4> <l-loc-4-4>)
   (<l-loc-1-1> ^object-handle loc-1-1 ^value > 0)
   (<l-loc-2-1> ^object-handle loc-2-1 ^value > 0)
   (<l-loc-3-1> ^object-handle loc-3-1 ^value > 0)
   (<l-loc-4-1> ^object-handle loc-4-1 ^value > 0)
   (<l-loc-1-2> ^object-handle loc-1-2 ^value > 0)
   (<l-loc-2-2> ^object-handle loc-2-2 ^value > 0)
   (<l-loc-3-2> ^object-handle loc-3-2 ^value > 0)
   (<l-loc-4-2> ^object-handle loc-4-2 ^value > 0)
   (<l-loc-1-3> ^object-handle loc-1-3 ^value > 0)
   (<l-loc-2-3> ^object-handle loc-2-3 ^value > 0)
   (<l-loc-3-3> ^object-handle loc-3-3 ^value > 0)
   (<l-loc-4-3> ^object-handle loc-4-3 ^value > 0)
   (<l-loc-1-4> ^object-handle loc-1-4 ^value > 0)
   (<l-loc-2-4> ^object-handle loc-2-4 ^value > 0)
   (<l-loc-3-4> ^object-handle loc-3-4 ^value > 0)
   (<l-loc-4-4> ^object-handle loc-4-4 ^value > 0)
-->
   (<t> ^goal-met true)
}
