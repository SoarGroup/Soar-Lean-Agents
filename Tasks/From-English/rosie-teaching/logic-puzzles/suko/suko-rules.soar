}
## Failure: the locations of a group are filled and their sum is not the value of the group's target.
sp {suko*elaborate*failure*group-sum-target
   (state <s> ^desireds <ds> ^world <w>)
   (<w> ^anchored-world true ^objects.object <g> ^sum-target <st>)
   (<st> ^argument1 <g> ^argument2 <tg>)
   (<g> ^type group ^sum <sum>)
   (<tg> ^value { <> <sum> })
-->
   (<s> ^failure <ds>)
}
## Goal: all locations are filled (expanded over the locations of the world file; filled: value more than zero).
sp {suko*elaborate*goal*all-filled
   (state <s> ^world <w>)
   (<w> ^anchored-world true ^objects <objs>)
   (<objs> ^object <t> <l-loc-1-1> <l-loc-2-1> <l-loc-3-1> <l-loc-1-2> <l-loc-2-2> <l-loc-3-2> <l-loc-1-3> <l-loc-2-3> <l-loc-3-3>)
   (<t> ^type task)
   (<l-loc-1-1> ^object-handle loc-1-1 ^value > 0)
   (<l-loc-2-1> ^object-handle loc-2-1 ^value > 0)
   (<l-loc-3-1> ^object-handle loc-3-1 ^value > 0)
   (<l-loc-1-2> ^object-handle loc-1-2 ^value > 0)
   (<l-loc-2-2> ^object-handle loc-2-2 ^value > 0)
   (<l-loc-3-2> ^object-handle loc-3-2 ^value > 0)
   (<l-loc-1-3> ^object-handle loc-1-3 ^value > 0)
   (<l-loc-2-3> ^object-handle loc-2-3 ^value > 0)
   (<l-loc-3-3> ^object-handle loc-3-3 ^value > 0)
-->
   (<t> ^goal-met true)
}
