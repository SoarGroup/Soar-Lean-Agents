}
sp {suko*propose*write
   (state <s> ^problem-space.name suko ^flags.mea-operator-selection true ^world <w> ^desireds <ds>)
   (<w> ^anchored-world true ^objects <objs>)
   (<objs> ^object <l> <n>)
   (<l> ^type location ^object-handle $ <lh>)
   (<n> ^type number ^number <k> ^object-handle $ <nh>)
   (<w> ^empty <e>)
   (<e> ^argument1 <l>)
   (<ds> ^unachieved <any-unachieved>)
-->
   (<s> ^operator <op> +)
   (<op> ^name write ^task-operator true ^action-handle write ^argument1 <l> ^argument2 <n> ^argument-count 2 ^desireds <pre>)
   (<pre> ^desired-count 0)
}
## Effect of write (look-ahead): the location has the value; it is no longer empty.
sp {suko*apply*write*internal
   (state <s> ^operator <op> ^internal-actions true ^world <w>)
   (<op> ^task-operator true ^name write ^pre-conditions-satisfied true ^argument1.object-handle $ <lh> ^argument2.object-handle $ <nh>)
   (<w> ^anchored-world true ^objects <objs> ^empty <e>)
   (<objs> ^object <l> <n>)
   (<l> ^object-handle $ <lh>)
   (<n> ^object-handle $ <nh> ^number <k>)
   (<e> ^argument1 <l>)
-->
   (<l> ^value <k>)
   (<w> ^empty <e> -)
}

## Effect of a completed write command on the real world (once per command).
sp {suko*apply*write*environment-effect
   :o-support
   (state <s> ^superstate nil ^world <w> ^io.output-link.perform-action <pa>)
   (<pa> ^name write ^status complete ^argument1 <lh> ^argument2 <nh> -^effect-applied true)
   (<w> ^anchored-world true ^objects <objs> ^empty <e>)
   (<objs> ^object <l> <n>)
   (<l> ^object-handle $ <lh>)
   (<n> ^object-handle $ <nh> ^number <k>)
   (<e> ^argument1 <l>)
-->
   (<l> ^value <k>)
   (<w> ^empty <e> -)
   (<pa> ^effect-applied true)
   (write |Write | <k> | on | <lh> (crlf))
}
## Failure (same-value-any): two different locations have the same value.
sp {suko*elaborate*failure*same-value-any
   (state <s> ^desireds <ds> ^world <w>)
   (<w> ^anchored-world true ^objects <objs>)
   (<objs> ^object <l1> <l2>)
   (<l1> ^type location ^value <v> ^object-handle $ <h1>)
   (<l2> ^type location ^value <v> ^object-handle { <> <h1> })
-->
   (<s> ^failure <ds>)
}
## Sum of a group of 2 locations, once every member has a value (derived; not copied into look-ahead worlds).
sp {suko*elaborate*group*sum*2
   (state <s> ^world <w>)
   (<w> ^anchored-world true ^objects.object <g> ^member <r1> <r2>)
   (<g> ^type group ^size 2)
   (<r1> ^argument1 <g> ^argument2 <l1>)
   (<l1> ^value <v1> ^object-handle $ <h1>)
   (<r2> ^argument1 <g> ^argument2 <l2>)
   (<l2> ^value <v2> ^object-handle { <> <h1> <h2> })
-->
   (<g> ^sum (+ <v1> <v2>))
}
