   (<r2> ^argument1 <g> ^argument2 <l2>)
   (<l2> ^value <v2> ^object-handle { <> <h1> <h2> })
   (<r3> ^argument1 <g> ^argument2 <l3>)
   (<l3> ^value <v3> ^object-handle { <> <h1> <> <h2> <h3> })
-->
   (<g> ^sum (+ <v1> <v2> <v3>))
}
