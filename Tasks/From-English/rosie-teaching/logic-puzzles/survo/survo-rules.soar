sp {survo*elaborate*problem-space
   (state <s> ^name survo)
-->
   (<s> ^problem-space <p>)
   (<p> ^name survo ^copy-relation below ^copy-relation empty ^copy-relation member ^copy-relation sum-target ^dont-copy-object-attribute goal-met ^dont-copy-object-attribute sum)
}

sp {survo*elaborate*problem-space*mea-substate
   (state <s> ^impasse no-change ^attribute operator ^superstate <ss>)
   (<ss> ^problem-space.name survo ^operator <so>)
   (<so> ^task-operator true -^pre-conditions-satisfied true)
-->
   (<s> ^problem-space <p>)
   (<p> ^name survo ^dont-copy-object-attribute goal-met ^dont-copy-object-attribute sum)
}

sp {survo*elaborate*flags
   (state <s> ^superstate nil ^name survo)
-->
   (<s> ^flag-override <f>)
   (<f> ^mea-operator-selection true)
}

## Achievement of object-property desireds (supplied by the task).
sp {survo*elaborate*state*achieved*object-property
   (state <s> ^desireds <ds> ^world <w>)
   (<ds> ^desired <d>)
   (<d> ^object <do>)
   (<do> ^object-handle $ <h> ^{ <> object-handle <a> } <v>)
   (<w> ^anchored-world true ^objects.object <ob>)
   (<ob> ^object-handle $ <h> ^<a> <v>)
-->
   (<ds> ^achieved <d>)
}

sp {survo*elaborate*state*unachieved*object-property
   (state <s> ^desireds <ds> ^world <w>)
   (<ds> ^desired <d>)
   (<d> ^object <do>)
   (<do> ^object-handle $ <h> ^{ <> object-handle <a> } <v>)
   (<w> ^anchored-world true)
  -{(<w> ^objects.object <ob>)
    (<ob> ^object-handle <h> ^<a> <v>)}
-->
   (<ds> ^unachieved <d>)
}
sp {survo*propose*write
   (state <s> ^problem-space.name survo ^flags.mea-operator-selection true ^world <w> ^desireds <ds>)
   (<w> ^anchored-world true ^objects <objs>)
   (<objs> ^object <l> <n>)
   (<l> ^type location ^object-handle $ <lh>)
   (<n> ^type number ^number <k> ^object-handle $ <nh>)
   (<w> ^empty <e>)
   (<e> ^argument1 <l>)
   (<ds> ^unachieved <any-unachieved>)
-->
   (<s> ^operator <op> +)
   (<op> ^name write ^task-operator true ^action-handle write ^argument1 <l> ^argument2 <n> ^argument-count 2 ^desireds <pre>)
   (<pre> ^desired-count 0)
}
## Effect of write (look-ahead): the location has the value; it is no longer empty.
sp {survo*apply*write*internal
   (state <s> ^operator <op> ^internal-actions true ^world <w>)
   (<op> ^task-operator true ^name write ^pre-conditions-satisfied true ^argument1.object-handle $ <lh> ^argument2.object-handle $ <nh>)
   (<w> ^anchored-world true ^objects <objs> ^empty <e>)
   (<objs> ^object <l> <n>)
   (<l> ^object-handle $ <lh>)
   (<n> ^object-handle $ <nh> ^number <k>)
   (<e> ^argument1 <l>)
-->
   (<l> ^value <k>)
   (<w> ^empty <e> -)
}

## Effect of a completed write command on the real world (once per command).
sp {survo*apply*write*environment-effect
   :o-support
   (state <s> ^superstate nil ^world <w> ^io.output-link.perform-action <pa>)
   (<pa> ^name write ^status complete ^argument1 <lh> ^argument2 <nh> -^effect-applied true)
   (<w> ^anchored-world true ^objects <objs> ^empty <e>)
   (<objs> ^object <l> <n>)
   (<l> ^object-handle $ <lh>)
   (<n> ^object-handle $ <nh> ^number <k>)
   (<e> ^argument1 <l>)
-->
   (<l> ^value <k>)
   (<w> ^empty <e> -)
   (<pa> ^effect-applied true)
   (write |Write | <k> | on | <lh> (crlf))
}
## Failure (same-value-green): two different green locations have the same value.
sp {survo*elaborate*failure*same-value-green
   (state <s> ^desireds <ds> ^world <w>)
   (<w> ^anchored-world true ^objects <objs>)
   (<objs> ^object <l1> <l2>)
   (<l1> ^type location ^color green ^value <v> ^object-handle $ <h1>)
   (<l2> ^type location ^color green ^value <v> ^object-handle { <> <h1> })
-->
   (<s> ^failure <ds>)
}
## Sum of a group of 3 locations, once every member has a value (derived; not copied into look-ahead worlds).
sp {survo*elaborate*group*sum*3
   (state <s> ^world <w>)
   (<w> ^anchored-world true ^objects.object <g> ^member <r1> <r2> <r3>)
   (<g> ^type group ^size 3)
   (<r1> ^argument1 <g> ^argument2 <l1>)
   (<l1> ^value <v1> ^object-handle $ <h1>)
   (<r2> ^argument1 <g> ^argument2 <l2>)
   (<l2> ^value <v2> ^object-handle { <> <h1> <h2> })
   (<r3> ^argument1 <g> ^argument2 <l3>)
   (<l3> ^value <v3> ^object-handle { <> <h1> <> <h2> <h3> })
-->
   (<g> ^sum (+ <v1> <v2> <v3>))
}
## Sum of a group of 4 locations, once every member has a value (derived; not copied into look-ahead worlds).
sp {survo*elaborate*group*sum*4
   (state <s> ^world <w>)
   (<w> ^anchored-world true ^objects.object <g> ^member <r1> <r2> <r3> <r4>)
   (<g> ^type group ^size 4)
   (<r1> ^argument1 <g> ^argument2 <l1>)
   (<l1> ^value <v1> ^object-handle $ <h1>)
   (<r2> ^argument1 <g> ^argument2 <l2>)
   (<l2> ^value <v2> ^object-handle { <> <h1> <h2> })
   (<r3> ^argument1 <g> ^argument2 <l3>)
   (<l3> ^value <v3> ^object-handle { <> <h1> <> <h2> <h3> })
   (<r4> ^argument1 <g> ^argument2 <l4>)
   (<l4> ^value <v4> ^object-handle { <> <h1> <> <h2> <> <h3> <h4> })
-->
   (<g> ^sum (+ <v1> <v2> <v3> <v4>))
}
## Failure: the locations of a group are filled and their sum is not the value of the group's target.
sp {survo*elaborate*failure*group-sum-target
   (state <s> ^desireds <ds> ^world <w>)
   (<w> ^anchored-world true ^objects.object <g> ^sum-target <st>)
   (<st> ^argument1 <g> ^argument2 <tg>)
   (<g> ^type group ^sum <sum>)
   (<tg> ^value { <> <sum> })
-->
   (<s> ^failure <ds>)
}
## Goal: all locations are filled (expanded over the locations of the world file; filled: value more than zero).
sp {survo*elaborate*goal*all-filled
   (state <s> ^world <w>)
   (<w> ^anchored-world true ^objects <objs>)
   (<objs> ^object <t> <l-loc-1-1> <l-loc-2-1> <l-loc-3-1> <l-loc-4-1> <l-loc-1-2> <l-loc-2-2> <l-loc-3-2> <l-loc-4-2> <l-loc-1-3> <l-loc-2-3> <l-loc-3-3> <l-loc-4-3> <l-loc-1-4> <l-loc-2-4> <l-loc-3-4> <l-loc-4-4> <l-loc-1-5> <l-loc-2-5> <l-loc-3-5> <l-loc-4-5>)
   (<t> ^type task)
   (<l-loc-1-1> ^object-handle loc-1-1 ^value > 0)
   (<l-loc-2-1> ^object-handle loc-2-1 ^value > 0)
   (<l-loc-3-1> ^object-handle loc-3-1 ^value > 0)
   (<l-loc-4-1> ^object-handle loc-4-1 ^value > 0)
   (<l-loc-1-2> ^object-handle loc-1-2 ^value > 0)
   (<l-loc-2-2> ^object-handle loc-2-2 ^value > 0)
   (<l-loc-3-2> ^object-handle loc-3-2 ^value > 0)
   (<l-loc-4-2> ^object-handle loc-4-2 ^value > 0)
   (<l-loc-1-3> ^object-handle loc-1-3 ^value > 0)
   (<l-loc-2-3> ^object-handle loc-2-3 ^value > 0)
   (<l-loc-3-3> ^object-handle loc-3-3 ^value > 0)
   (<l-loc-4-3> ^object-handle loc-4-3 ^value > 0)
   (<l-loc-1-4> ^object-handle loc-1-4 ^value > 0)
   (<l-loc-2-4> ^object-handle loc-2-4 ^value > 0)
   (<l-loc-3-4> ^object-handle loc-3-4 ^value > 0)
   (<l-loc-4-4> ^object-handle loc-4-4 ^value > 0)
   (<l-loc-1-5> ^object-handle loc-1-5 ^value > 0)
   (<l-loc-2-5> ^object-handle loc-2-5 ^value > 0)
   (<l-loc-3-5> ^object-handle loc-3-5 ^value > 0)
   (<l-loc-4-5> ^object-handle loc-4-5 ^value > 0)
-->
   (<t> ^goal-met true)
}
