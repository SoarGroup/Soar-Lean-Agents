## ---- Search control (added, not taught): avoid returning to a situation on the current look-ahead path. ----
## A situation is the count of every kind on every bank and the bank of the boat.

## The adult count of bank-1 after a proposed operator.
sp {family-cross*elaborate*operator*after*bank-1*adult*from
   (state <s> ^problem-space.name family-cross ^operator <op> + ^world <w>)
   (<op> ^task-operator true ^from <bank> ^move-adult <m>)
   (<bank> ^object-handle bank-1 ^adult-count <c>)
-->
   (<op> ^after-bank-1-adult (- <c> <m>))
}

sp {family-cross*elaborate*operator*after*bank-1*adult*to
   (state <s> ^problem-space.name family-cross ^operator <op> + ^world <w>)
   (<op> ^task-operator true ^to <bank> ^move-adult <m>)
   (<bank> ^object-handle bank-1 ^adult-count <c>)
-->
   (<op> ^after-bank-1-adult (+ <c> <m>))
}

