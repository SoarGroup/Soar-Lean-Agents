## ---- Search control (added, not taught): avoid returning to a situation on the current look-ahead path. ----
## Where each block would be after a proposed operator: a moved block (an argument, or the boat) on the destination bank.
sp {family-cross*elaborate*operator*after*moved-block
   (state <s> ^problem-space.name family-cross ^operator <op> + ^world <w>)
   (<op> ^task-operator true ^<< argument1 argument2 >> <b> ^to <dest>)
   (<b> ^type block ^label-key <k>)
   (<dest> ^object-handle $ <dh>)
-->
   (<op> ^<k> <dh>)
}

sp {family-cross*elaborate*operator*after*boat
   (state <s> ^problem-space.name family-cross ^operator <op> + ^world <w>)
   (<w> ^objects.object <b>)
   (<op> ^task-operator true ^to <dest>)
   (<b> ^type block ^shape boat ^label-key <k>)
   (<dest> ^object-handle $ <dh>)
-->
   (<op> ^<k> <dh>)
}

## A block that does not move stays on its bank.
sp {family-cross*elaborate*operator*after*unmoved-block
   (state <s> ^problem-space.name family-cross ^operator <op> + ^world <w>)
   (<op> ^task-operator true ^argument1 <a1> ^argument2 <a2> ^to <dest>)
   (<w> ^objects <objs> ^on <r>)
   (<objs> ^object { <> <a1> <> <a2> <b> })
   (<b> ^type block ^shape { <> boat } ^label-key <k>)
   (<r> ^argument1 <b> ^argument2 <bank>)
   (<bank> ^object-handle $ <bh>)
-->
   (<op> ^<k> <bh>)
}

## The label of the situation the operator produces.
sp {family-cross*elaborate*operator*result
   (state <s> ^problem-space.name family-cross ^operator <op> + ^world <w>)
   (<op> ^task-operator true ^pos-3 <pos-3> ^pos-4 <pos-4> ^pos-5 <pos-5> ^pos-6 <pos-6> ^pos-7 <pos-7>)
-->
   (<op> ^result (concat <pos-3> |,| <pos-4> |,| <pos-5> |,| <pos-6> |,| <pos-7>))
}

## The label of the current situation (derived; not copied into look-ahead worlds).
sp {family-cross*elaborate*situation
   (state <s> ^problem-space.name family-cross ^world <w>)
   (<w> ^anchored-world true ^objects <objs> ^on <r3> <r4> <r5> <r6> <r7>)
   (<objs> ^object <t> <b3> <b4> <b5> <b6> <b7>)
   (<t> ^type task)
   (<b3> ^label-key pos-3)
   (<r3> ^argument1 <b3> ^argument2 <bank3>)
   (<bank3> ^object-handle $ <h3>)
   (<b4> ^label-key pos-4)
   (<r4> ^argument1 <b4> ^argument2 <bank4>)
   (<bank4> ^object-handle $ <h4>)
   (<b5> ^label-key pos-5)
   (<r5> ^argument1 <b5> ^argument2 <bank5>)
   (<bank5> ^object-handle $ <h5>)
   (<b6> ^label-key pos-6)
   (<r6> ^argument1 <b6> ^argument2 <bank6>)
   (<bank6> ^object-handle $ <h6>)
   (<b7> ^label-key pos-7)
   (<r7> ^argument1 <b7> ^argument2 <bank7>)
   (<bank7> ^object-handle $ <h7>)
-->
   (<t> ^situation (concat <h3> |,| <h4> |,| <h5> |,| <h6> |,| <h7>))
}

## In look-ahead, reject an operator whose result is a situation already on the path.
sp {family-cross*reject*operator*repeated-situation
   (state <s> ^problem-space.name family-cross ^internal-actions true ^operator <op> + ^world <w>)
   (<w> ^objects.object <hist>)
   (<hist> ^type history ^visited <l>)
   (<op> ^task-operator true ^result <l>)
-->
   (<s> ^operator <op> -)
}

## ---- Search control on real moves (added, not taught; JL 16 Nov 2026, as in Tasks/From-English/mc-world): ----
## a real move back to a situation already visited is worst. It is chosen only when nothing else is left, so the agent
## prefers progress but is never trapped by its own history. The record is on the top state, not in the world, so it is
## not copied into look-ahead worlds.
## The real application records the situation it leaves (not the one it produces: recording that would make the selected
## operator itself worst, and Soar would replace it before its command completes).
sp {family-cross*apply*operator*record-real-move
   (state <s> ^problem-space.name family-cross ^superstate nil ^operator <op> ^world <w>)
   (<op> ^task-operator true)
   (<w> ^objects.object <t>)
   (<t> ^type task ^situation <sit>)
-->
   (<s> ^real-visited <sit>)
}

sp {family-cross*compare*operator*real-repeated-situation
   (state <s> ^problem-space.name family-cross ^superstate nil ^operator <op> + ^real-visited <l>)
   (<op> ^task-operator true ^result <l>)
-->
   (<s> ^operator <op> <)
}

## The look-ahead application records the situation it leaves and the one it produces.
sp {family-cross*apply*operator*record-path
   (state <s> ^problem-space.name family-cross ^operator <op> ^internal-actions true ^world <w>)
   (<op> ^task-operator true ^result <r>)
   (<w> ^objects <objs>)
   (<objs> ^object <hist> <t>)
   (<hist> ^type history)
   (<t> ^type task ^situation <sit>)
-->
   (<hist> ^visited <r> <sit>)
}
## Goal: all the blocks are on a destination bank (expanded over the blocks of the world file).
sp {family-cross*elaborate*goal*all-crossed
   (state <s> ^problem-space.name family-cross ^world <w>)
   (<w> ^anchored-world true ^objects <objs>)
   (<objs> ^object <t> <dest> <b-adult-3> <b-adult-4> <b-child-5> <b-child-6> <b-boat-7>)
   (<t> ^type task)
   (<dest> ^type location ^name destination)
   (<b-adult-3> ^object-handle adult-3)
   (<w> ^on <on-adult-3>)
   (<on-adult-3> ^argument1 <b-adult-3> ^argument2 <dest>)
   (<b-adult-4> ^object-handle adult-4)
   (<w> ^on <on-adult-4>)
   (<on-adult-4> ^argument1 <b-adult-4> ^argument2 <dest>)
   (<b-child-5> ^object-handle child-5)
   (<w> ^on <on-child-5>)
   (<on-child-5> ^argument1 <b-child-5> ^argument2 <dest>)
   (<b-child-6> ^object-handle child-6)
   (<w> ^on <on-child-6>)
   (<on-child-6> ^argument1 <b-child-6> ^argument2 <dest>)
   (<b-boat-7> ^object-handle boat-7)
   (<w> ^on <on-boat-7>)
   (<on-boat-7> ^argument1 <b-boat-7> ^argument2 <dest>)
-->
   (<t> ^goal-met true)
}
