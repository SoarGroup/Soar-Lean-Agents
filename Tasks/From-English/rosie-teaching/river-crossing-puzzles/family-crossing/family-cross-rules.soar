## Family crossing, generated from the Rosie teaching script (english-input.txt) under the world conventions.
##
## Instructor statements used (numbers as in english-input.txt):
##   4. You can move a child that is on the current bank and another child that is on the current bank and the boat onto the opposite bank.
##   5. If an object is below a boat then it is current.
##   6. If a location is not below a boat then it is opposite.
##   7. The name of an action is ferry-one.
##   8. You can move the boat and a block on the current bank onto the opposite bank.
##   9. The solution has nine steps.
##  13. The goal is that all the blocks are on a destination bank.
## World: init-familycross.world (two banks; two adults, two children and the boat on the first bank)
##
## Translation (tools/rosie-language.md gives the general reading; the assumption ledger is in README.md):
##   - Operators: ferry-one ("the boat and a block on the current bank onto the opposite bank"; argument1 = the block,
##     argument2 = the opposite bank) and ferry-two-children (statement 4, not named in the dialog: "a child ... and another child ... and the boat"; argument1 and
##     argument2 = the two blocks, the lower ^index first; the destination is the opposite bank). Each operator records the
##     bank it leaves (^from), so its look-ahead application fires once.
##   - current is expanded in place (a bank below the boat); opposite is a maintained one-argument relation.
##   - The goal ("all the blocks are on a destination bank") is expanded over the blocks of the world file (the boat is a
##     block).
##   - No losing condition is taught. "The solution has nine steps." is checked against the plans, not used.
##   - Interchangeable blocks (World-Conventions L7-027; tools/aggregate.py): the adult, child blocks are identical
##     within each kind and the statements never single one out, so only how many are on each bank matters. Each bank has
##     ^adult-count, ^child-count; each kind is an object (^type kind, ^total). The operators move kinds:
##     ferry-one argument1 = a kind, argument2 = the opposite bank; a two-block crossing has argument1 and argument2 = two
##     kinds (in name order; the same kind twice when two of it are on the bank). The boat stays an individual block. An
##     environment that moves individual blocks binds a kind to any block of that kind on the bank (the output names the
##     kind).
## Matching hints for learned rules (World-Conventions L3-095, L11-009): many-valued attributes, sized from the initial world.
production optimize-attribute object 7
production optimize-attribute on 2
production optimize-attribute below 2
production optimize-attribute opposite 2


## Propose initialize-family-cross when its conditions below hold.
sp {family-cross*propose*initialize-family-cross
   (state <s> ^superstate nil ^world <w> -^name)
-->
   (<s> ^operator <o> + >)
   (<o> ^name initialize-family-cross ^task-operator false)
}

sp {family-cross*apply*initialize-family-cross
   (state <s> ^operator.name initialize-family-cross ^world <w>)
   (<w> ^objects <objs>)
-->
   (<s> ^name family-cross ^desireds <ds>)
   (<objs> ^object <o-bank-1> <o-bank-2> <o-boat-7> <o-adult> <o-child> <o-task> <o-history>)
   (<o-bank-1> ^object-handle bank-1 ^anchored true ^type location ^shape bank ^adult-count 2 ^child-count 2)
   (<o-bank-2> ^object-handle bank-2 ^anchored true ^type location ^shape bank ^name destination ^adult-count 0 ^child-count 0)
   (<o-boat-7> ^object-handle boat-7 ^anchored true ^type block ^shape boat)
   (<o-adult> ^object-handle adult ^anchored true ^type kind ^shape adult ^kind-of block ^total 2)
   (<o-child> ^object-handle child ^anchored true ^type kind ^shape child ^kind-of block ^total 2)
   (<o-task> ^object-handle task ^anchored true ^type task)
   (<o-history> ^object-handle history ^anchored true ^type history)
   (<ds> ^desired-count 1 ^desired <d1>)
   (<d1> ^object <d1-o>)
   (<d1-o> ^object-handle task ^goal-met true)
   (<w> ^on <on-4>)
   (<on-4> ^argument1 <o-boat-7> ^argument2 <o-bank-1>)
   (<w> ^below <below-4>)
   (<below-4> ^argument1 <o-bank-1> ^argument2 <o-boat-7>)
   (<w> ^opposite <opposite-bank-2>)
   (<opposite-bank-2> ^argument1 <o-bank-2>)
   (log 1 (crlf) |Initialize family-cross.|)
}

## Elaborate problem space: adds ^copy-relation, ^dont-copy-object-attribute, ^problem-space.
sp {family-cross*elaborate*problem-space
   (state <s> ^name family-cross)
-->
   (<s> ^problem-space <p>)
   (<p> ^name family-cross ^copy-relation below ^copy-relation opposite ^dont-copy-object-attribute goal-met ^dont-copy-object-attribute situation)
}

sp {family-cross*elaborate*problem-space*mea-substate
   (state <s> ^impasse no-change ^attribute operator ^superstate <ss>)
   (<ss> ^problem-space.name family-cross ^operator <so>)
   (<so> ^task-operator true -^pre-conditions-satisfied true)
-->
   (<s> ^problem-space <p>)
   (<p> ^name family-cross ^dont-copy-object-attribute goal-met ^dont-copy-object-attribute situation)
}

## Elaborate flags: adds ^flag-override, ^mea-operator-selection.
sp {family-cross*elaborate*flags
   (state <s> ^superstate nil ^name family-cross)
-->
   (<s> ^flag-override <f>)
   (<f> ^mea-operator-selection true)
}

## Achievement of object-property desireds (supplied by the task).
sp {family-cross*elaborate*state*achieved*object-property
   (state <s> ^problem-space.name family-cross ^desireds <ds> ^world <w>)
   (<ds> ^desired <d>)
   (<d> ^object <do>)
   (<do> ^object-handle $ <h> ^{ <> object-handle <a> } <v>)
   (<w> ^anchored-world true ^objects.object <ob>)
   (<ob> ^object-handle $ <h> ^<a> <v>)
-->
   (<ds> ^achieved <d>)
}

sp {family-cross*elaborate*state*unachieved*object-property
   (state <s> ^problem-space.name family-cross ^desireds <ds> ^world <w>)
   (<ds> ^desired <d>)
   (<d> ^object <do>)
   (<do> ^object-handle $ <h> ^{ <> object-handle <a> } <v>)
   (<w> ^anchored-world true)
  -{(<w> ^objects.object <ob>)
    (<ob> ^object-handle <h> ^<a> <v>)}
-->
   (<ds> ^unachieved <d>)
}
## Propose ferry-two-children in problem space family-cross when its conditions below hold (child child).
sp {family-cross*propose*ferry-two-children*child-child
   (state <s> ^problem-space.name family-cross ^flags.mea-operator-selection true ^world <w> ^desireds <ds>)
   (<w> ^anchored-world true ^objects <objs>)
   (<objs> ^object <boat> <cur> <opp> <k-child>)
   (<boat> ^type block ^shape boat)
   (<cur> ^type location ^child-count >= 2)
   (<opp> ^type location)
   (<k-child> ^type kind ^object-handle child)
   (<w> ^below <bb> ^opposite <op-r>)
   (<bb> ^argument1 <cur> ^argument2 <boat>)
   (<op-r> ^argument1 <opp>)
   (<ds> ^unachieved-desireds true)
-->
   (<s> ^operator <op> +)
   (<op> ^name ferry-two-children ^task-operator true ^action-handle ferry-two-children ^argument1 <k-child> ^argument2 <k-child> ^argument-count 2 ^pre-conditions-satisfied true ^from <cur> ^to <opp> ^move-adult 0 ^move-child 2)
}
sp {family-cross*apply*ferry-two-children*environment-effect*child-child
   :o-support
   (state <s> ^problem-space.name family-cross ^superstate nil ^world <w> ^io.output-link.perform-action <pa>)
   (<pa> ^name ferry-two-children ^status complete ^argument1 child ^argument2 child -^effect-applied true)
   (<w> ^anchored-world true ^objects <objs>)
   (<objs> ^object <boat> <d>)
   (<boat> ^type block ^shape boat)
   (<w> ^on <rb> ^below <bb> ^opposite <od>)
   (<rb> ^argument1 <boat> ^argument2 <old>)
   (<bb> ^argument1 <old> ^argument2 <boat>)
   (<od> ^argument1 <d>)
   (<old> ^child-count <o-child>)
   (<d> ^child-count <n-child>)
-->
   (<rb> ^argument2 <old> - <d>)
   (<bb> ^argument1 <old> - <d>)
   (<w> ^opposite <od> - <no>)
   (<no> ^argument1 <old>)
   (<old> ^child-count <o-child> - (- <o-child> 2))
   (<d> ^child-count <n-child> - (+ <n-child> 2))
   (<pa> ^effect-applied true)
   (write |ferry-two-children: child and child with the boat from | <old> | to | <d> (crlf))
}
## Effect of ferry-two-children (look-ahead): the boat crosses to the opposite bank.
sp {family-cross*apply*ferry-two-children*internal*boat
   (state <s> ^problem-space.name family-cross ^operator <op> ^internal-actions true ^world <w>)
   (<op> ^task-operator true ^name ferry-two-children ^pre-conditions-satisfied true ^from.object-handle $ <oldh>)
   (<w> ^anchored-world true ^objects <objs>)
   (<objs> ^object <boat> <d>)
   (<boat> ^type block ^shape boat)
   (<w> ^on <rb> ^below <bb> ^opposite <od>)
   (<rb> ^argument1 <boat> ^argument2 <old>)
   (<bb> ^argument1 <old> ^argument2 <boat>)
   (<od> ^argument1 <d>)
   (<old> ^object-handle $ <oldh>)
-->
   (<rb> ^argument2 <old> - <d>)
   (<bb> ^argument1 <old> - <d>)
   (<w> ^opposite <od> - <no>)
   (<no> ^argument1 <old>)
}
## Effect of ferry-two-children (look-ahead): the adult count of each bank changes by the number of adult blocks moved.
sp {family-cross*apply*ferry-two-children*internal*count*adult
   (state <s> ^problem-space.name family-cross ^operator <op> ^internal-actions true ^world <w>)
   (<op> ^task-operator true ^name ferry-two-children ^pre-conditions-satisfied true ^from.object-handle $ <oldh>
         ^to.object-handle $ <dh> ^move-adult { > 0 <m> })
   (<w> ^anchored-world true ^objects <objs>)
   (<objs> ^object <old> <d>)
   (<old> ^object-handle $ <oldh> ^adult-count <o>)
   (<d> ^object-handle $ <dh> ^adult-count <c>)
-->
   (<old> ^adult-count <o> - (- <o> <m>))
   (<d> ^adult-count <c> - (+ <c> <m>))
}
## Effect of ferry-two-children (look-ahead): the child count of each bank changes by the number of child blocks moved.
sp {family-cross*apply*ferry-two-children*internal*count*child
   (state <s> ^problem-space.name family-cross ^operator <op> ^internal-actions true ^world <w>)
   (<op> ^task-operator true ^name ferry-two-children ^pre-conditions-satisfied true ^from.object-handle $ <oldh>
         ^to.object-handle $ <dh> ^move-child { > 0 <m> })
   (<w> ^anchored-world true ^objects <objs>)
   (<objs> ^object <old> <d>)
   (<old> ^object-handle $ <oldh> ^child-count <o>)
   (<d> ^object-handle $ <dh> ^child-count <c>)
-->
   (<old> ^child-count <o> - (- <o> <m>))
   (<d> ^child-count <c> - (+ <c> <m>))
}
## Propose ferry-one in problem space family-cross when its conditions below hold (adult).
sp {family-cross*propose*ferry-one*adult
   (state <s> ^problem-space.name family-cross ^flags.mea-operator-selection true ^world <w> ^desireds <ds>)
   (<w> ^anchored-world true ^objects <objs>)
   (<objs> ^object <boat> <cur> <opp> <k-adult>)
   (<boat> ^type block ^shape boat)
   (<cur> ^type location ^adult-count >= 1)
   (<opp> ^type location)
   (<k-adult> ^type kind ^object-handle adult)
   (<w> ^below <bb> ^opposite <op-r>)
