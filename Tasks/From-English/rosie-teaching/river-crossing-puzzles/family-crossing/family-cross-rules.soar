   (<op> ^name ferry-one ^task-operator true ^action-handle ferry-one ^argument1 <k-adult> ^argument2 <opp> ^argument-count 2 ^pre-conditions-satisfied true ^from <cur> ^to <opp> ^move-adult 1 ^move-child 0)
}
sp {family-cross*apply*ferry-one*environment-effect*adult
   :o-support
   (state <s> ^problem-space.name family-cross ^superstate nil ^world <w> ^io.output-link.perform-action <pa>)
   (<pa> ^name ferry-one ^status complete ^argument1 adult ^argument2 <dh> -^effect-applied true)
   (<w> ^anchored-world true ^objects <objs>)
