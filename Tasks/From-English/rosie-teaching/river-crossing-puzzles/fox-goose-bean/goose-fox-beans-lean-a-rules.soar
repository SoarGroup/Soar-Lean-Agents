## Fox, goose and beans (goose-fox-beans): generated by rosiegen (WorldSpec, path A: Lean) from the instructor statements.
##
## Instructor statements used (numbers as in english-input.txt):
##  4. The name of an action is ferry-one.
##  5. You can move the boat and a block on the current bank onto the opposite bank.
##  6. If an object is below a boat then it is current.
##  7. If a location is not below a boat then it is opposite.
##  8. You can move a boat onto the opposite bank.
##  10. If a red block is on an opposite bank and a yellow block is on the opposite bank then you lose.
##  13. If a green block is on an opposite bank and a yellow block is on the opposite bank then you lose.
##  18. The goal is that all the blocks are on a destination bank.
##
## Assumption ledger:
##   A-F1: "the boat and a block": the block is not the boat.
##   A-F2: Both the boat and the block move to the opposite bank.
##   A-F3: "all the blocks" includes the boat, which is a block in the world file.
##   A-F4: "all the blocks" ranges over the blocks of the world file (compiled by expansion, so the test is positive).
##   A-F5: The second action has no name in the dialog; it is called cross.
##   A-F6: "on an opposite bank ... on the opposite bank": both blocks on the same bank.

## Propose initialize-goose-fox-beans when its conditions below hold.
sp {goose-fox-beans*propose*initialize-goose-fox-beans
   (state <s> ^superstate nil ^world <w> -^name)
-->
   (<s> ^operator <o> + >)
   (<o> ^name initialize-goose-fox-beans ^task-operator false)
}

sp {goose-fox-beans*apply*initialize-goose-fox-beans
   (state <s> ^operator.name initialize-goose-fox-beans ^world <w>)
   (<w> ^objects <objs>)
-->
   (<s> ^name goose-fox-beans ^desireds <ds>)
   (<objs> ^object <k-bank-1> <k-bank-2> <k-red-3> <k-yellow-4> <k-green-5> <k-boat-6> <k-task>)
   (<k-bank-1> ^object-handle bank-1 ^anchored true ^type location ^shape bank)
   (<k-bank-2> ^object-handle bank-2 ^anchored true ^type location ^shape bank ^name destination)
   (<k-red-3> ^object-handle red-3 ^anchored true ^type block ^color red)
   (<k-yellow-4> ^object-handle yellow-4 ^anchored true ^type block ^color yellow)
   (<k-green-5> ^object-handle green-5 ^anchored true ^type block ^color green)
   (<k-boat-6> ^object-handle boat-6 ^anchored true ^type block ^shape boat)
   (<k-task> ^object-handle task ^anchored true ^type task)
   (<ds> ^desired-count 1 ^desired <d1>)
   (<d1> ^object <d1-o>)
   (<d1-o> ^object-handle task ^goal-met true)
   (<w> ^on <rel-1>)
   (<rel-1> ^argument1 <k-yellow-4> ^argument2 <k-bank-1>)
   (<w> ^on <rel-2>)
   (<rel-2> ^argument1 <k-green-5> ^argument2 <k-bank-1>)
   (<w> ^on <rel-3>)
   (<rel-3> ^argument1 <k-boat-6> ^argument2 <k-bank-1>)
   (<w> ^on <rel-4>)
   (<rel-4> ^argument1 <k-red-3> ^argument2 <k-bank-1>)
   (<w> ^below <rel-5>)
   (<rel-5> ^argument1 <k-bank-1> ^argument2 <k-yellow-4>)
   (<w> ^below <rel-6>)
   (<rel-6> ^argument1 <k-bank-1> ^argument2 <k-green-5>)
   (<w> ^below <rel-7>)
   (<rel-7> ^argument1 <k-bank-1> ^argument2 <k-boat-6>)
   (<w> ^below <rel-8>)
   (<rel-8> ^argument1 <k-bank-1> ^argument2 <k-red-3>)
   (<w> ^opposite <rel-9>)
   (<rel-9> ^argument1 <k-bank-2>)
   (log 1 (crlf) |Initialize goose-fox-beans.|)
}

