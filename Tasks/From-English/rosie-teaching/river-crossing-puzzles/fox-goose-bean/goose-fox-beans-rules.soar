}
## Propose ferry-one in problem space goose-fox-beans when its conditions below hold.
sp {goose-fox-beans*propose*ferry-one
   (state <s> ^problem-space.name goose-fox-beans ^flags.mea-operator-selection true ^world <w> ^desireds <ds>)
   (<w> ^anchored-world true ^objects <objs>)
   (<objs> ^object <boat> <x> <cur> <opp>)
   (<boat> ^type block ^shape boat ^object-handle $ <bh>)
   (<x> ^type block ^object-handle { <> <bh> <xh> })
   (<cur> ^type location)
   (<opp> ^type location ^object-handle $ <oh>)
   (<w> ^below <bb> ^on <xo> ^opposite <op-r>)
   (<bb> ^argument1 <cur> ^argument2 <boat>)
   (<xo> ^argument1 <x> ^argument2 <cur>)
   (<op-r> ^argument1 <opp>)
   (<ds> ^unachieved-desireds true)
-->
   (<s> ^operator <op> +)
   (<op> ^name ferry-one ^task-operator true ^action-handle ferry-one ^argument1 <x> ^argument2 <opp> ^argument-count 2 ^desireds <pre>)
   (<pre> ^desired-count 0)
}
