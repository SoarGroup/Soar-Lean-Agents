   (state <s> ^problem-space.name goose-fox-beans ^world <w>)
   (<w> ^anchored-world true ^objects <objs>)
   (<objs> ^object <t> <dest> <b-red-3> <b-yellow-4> <b-green-5> <b-boat-6>)
   (<t> ^type task)
   (<dest> ^type location ^name destination)
   (<b-red-3> ^object-handle red-3)
   (<w> ^on <on-red-3>)
   (<on-red-3> ^argument1 <b-red-3> ^argument2 <dest>)
   (<b-yellow-4> ^object-handle yellow-4)
   (<w> ^on <on-yellow-4>)
   (<on-yellow-4> ^argument1 <b-yellow-4> ^argument2 <dest>)
   (<b-green-5> ^object-handle green-5)
   (<w> ^on <on-green-5>)
   (<on-green-5> ^argument1 <b-green-5> ^argument2 <dest>)
   (<b-boat-6> ^object-handle boat-6)
   (<w> ^on <on-boat-6>)
   (<on-boat-6> ^argument1 <b-boat-6> ^argument2 <dest>)
-->
