## Jealous husbands, generated from the Rosie teaching script (english-input.txt) under the world conventions.
##
## Instructor statements used (numbers as in english-input.txt):
##   4. The name of an action is ferry-one.
##   5. You can move the boat and a block on the current bank onto the opposite bank.
##   6. If an object is below a boat then it is current.
##   7. If a location is not below a boat then it is opposite.
##   8. The name of an action is ferry-two.
##   9. You can move a block that is on the current bank and another block that is on the current bank and the boat onto the opposite bank.
##  10. The solution has five steps.
##  12. If a woman is on a bank and the husband of the woman is not on the bank and a man is on the bank then you lose.
##  14. If the last-name of a woman is the last-name of a man then the man is the husband of the woman.
##  18. The goal is that all the blocks are on a destination bank.
## World: init-husbands.world (two banks; three couples (woman and man with the same last-name) and the boat on the first bank)
##
## Translation (tools/rosie-language.md gives the general reading; the assumption ledger is in README.md):
##   - Operators: ferry-one ("the boat and a block on the current bank onto the opposite bank"; argument1 = the block,
##     argument2 = the opposite bank) and ferry-two ("a block ... and another block ... and the boat"; argument1 and
##     argument2 = the two blocks, the lower ^index first; the destination is the opposite bank). Each operator records the
##     bank it leaves (^from), so its look-ahead application fires once.
##   - current is expanded in place (a bank below the boat); opposite is a maintained one-argument relation.
##   - The goal ("all the blocks are on a destination bank") is expanded over the blocks of the world file (the boat is a
##     block).
##   - The losing condition marks the state with ^failure; husband (same last-name) is expanded in place.
##   - "The solution has five steps." does not match this world (three couples need 11 crossings; five fits the two-couple
##     world init-husbands2): reported, not used.
##   - Search control added at JL's direction (16 Nov 2026), not from the English: in look-ahead, a move whose result is a
##     situation already on the current look-ahead path is rejected. A situation is the bank of every block; each operator
##     carries the label of the situation it produces (^result), the task object the label of the current one (^situation),
##     and the look-ahead application records both on the history object (^visited). Real moves (JL, 16 Nov 2026, as in
##     mc-world): a real move back to a situation already visited is worst (the top state records ^real-visited).

## Propose initialize-jealous-husbands when its conditions below hold.
sp {jealous-husbands*propose*initialize-jealous-husbands
   (state <s> ^superstate nil ^world <w> -^name)
-->
   (<s> ^operator <o> + >)
   (<o> ^name initialize-jealous-husbands ^task-operator false)
}

sp {jealous-husbands*apply*initialize-jealous-husbands
   (state <s> ^operator.name initialize-jealous-husbands ^world <w>)
   (<w> ^objects <objs>)
-->
   (<s> ^name jealous-husbands ^desireds <ds>)
   (<objs> ^object <o-bank-1> <o-bank-2> <o-woman-smith-3> <o-woman-bale-4> <o-woman-rogers-5> <o-man-smith-6> <o-man-bale-7> <o-man-rogers-8> <o-boat-9> <o-task> <o-history>)
   (<o-bank-1> ^object-handle bank-1 ^anchored true ^type location ^shape bank)
   (<o-bank-2> ^object-handle bank-2 ^anchored true ^type location ^shape bank ^name destination)
   (<o-woman-smith-3> ^object-handle woman-smith-3 ^anchored true ^type block ^shape woman ^last-name smith ^index 3 ^label-key pos-3)
   (<o-woman-bale-4> ^object-handle woman-bale-4 ^anchored true ^type block ^shape woman ^last-name bale ^index 4 ^label-key pos-4)
   (<o-woman-rogers-5> ^object-handle woman-rogers-5 ^anchored true ^type block ^shape woman ^last-name rogers ^index 5 ^label-key pos-5)
   (<o-man-smith-6> ^object-handle man-smith-6 ^anchored true ^type block ^shape man ^last-name smith ^index 6 ^label-key pos-6)
   (<o-man-bale-7> ^object-handle man-bale-7 ^anchored true ^type block ^shape man ^last-name bale ^index 7 ^label-key pos-7)
   (<o-man-rogers-8> ^object-handle man-rogers-8 ^anchored true ^type block ^shape man ^last-name rogers ^index 8 ^label-key pos-8)
   (<o-boat-9> ^object-handle boat-9 ^anchored true ^type block ^shape boat ^label-key pos-9)
   (<o-task> ^object-handle task ^anchored true ^type task)
   (<o-history> ^object-handle history ^anchored true ^type history)
   (<ds> ^desired-count 1 ^desired <d1>)
   (<d1> ^object <d1-o>)
   (<d1-o> ^object-handle task ^goal-met true)
   (<w> ^on <on-0>)
   (<on-0> ^argument1 <o-woman-smith-3> ^argument2 <o-bank-1>)
   (<w> ^on <on-1>)
   (<on-1> ^argument1 <o-woman-bale-4> ^argument2 <o-bank-1>)
   (<w> ^on <on-2>)
   (<on-2> ^argument1 <o-woman-rogers-5> ^argument2 <o-bank-1>)
   (<w> ^on <on-3>)
   (<on-3> ^argument1 <o-man-smith-6> ^argument2 <o-bank-1>)
   (<w> ^on <on-4>)
   (<on-4> ^argument1 <o-man-bale-7> ^argument2 <o-bank-1>)
   (<w> ^on <on-5>)
   (<on-5> ^argument1 <o-man-rogers-8> ^argument2 <o-bank-1>)
   (<w> ^on <on-6>)
   (<on-6> ^argument1 <o-boat-9> ^argument2 <o-bank-1>)
   (<w> ^below <below-0>)
   (<below-0> ^argument1 <o-bank-1> ^argument2 <o-woman-smith-3>)
   (<w> ^below <below-1>)
   (<below-1> ^argument1 <o-bank-1> ^argument2 <o-woman-bale-4>)
   (<w> ^below <below-2>)
   (<below-2> ^argument1 <o-bank-1> ^argument2 <o-woman-rogers-5>)
   (<w> ^below <below-3>)
   (<below-3> ^argument1 <o-bank-1> ^argument2 <o-man-smith-6>)
   (<w> ^below <below-4>)
   (<below-4> ^argument1 <o-bank-1> ^argument2 <o-man-bale-7>)
   (<w> ^below <below-5>)
   (<below-5> ^argument1 <o-bank-1> ^argument2 <o-man-rogers-8>)
   (<w> ^below <below-6>)
   (<below-6> ^argument1 <o-bank-1> ^argument2 <o-boat-9>)
   (<w> ^opposite <opposite-bank-2>)
   (<opposite-bank-2> ^argument1 <o-bank-2>)
   (log 1 (crlf) |Initialize jealous-husbands.|)
}

## Elaborate problem space: adds ^copy-relation, ^dont-copy-object-attribute, ^problem-space.
sp {jealous-husbands*elaborate*problem-space
   (state <s> ^name jealous-husbands)
-->
   (<s> ^problem-space <p>)
   (<p> ^name jealous-husbands ^copy-relation below ^copy-relation opposite ^dont-copy-object-attribute goal-met ^dont-copy-object-attribute situation)
}

sp {jealous-husbands*elaborate*problem-space*mea-substate
   (state <s> ^impasse no-change ^attribute operator ^superstate <ss>)
   (<ss> ^problem-space.name jealous-husbands ^operator <so>)
   (<so> ^task-operator true -^pre-conditions-satisfied true)
-->
   (<s> ^problem-space <p>)
   (<p> ^name jealous-husbands ^dont-copy-object-attribute goal-met ^dont-copy-object-attribute situation)
}

## Elaborate flags: adds ^flag-override, ^mea-operator-selection.
sp {jealous-husbands*elaborate*flags
   (state <s> ^superstate nil ^name jealous-husbands)
-->
   (<s> ^flag-override <f>)
   (<f> ^mea-operator-selection true)
}

## Achievement of object-property desireds (supplied by the task).
sp {jealous-husbands*elaborate*state*achieved*object-property
   (state <s> ^problem-space.name jealous-husbands ^desireds <ds> ^world <w>)
   (<ds> ^desired <d>)
   (<d> ^object <do>)
   (<do> ^object-handle $ <h> ^{ <> object-handle <a> } <v>)
   (<w> ^anchored-world true ^objects.object <ob>)
   (<ob> ^object-handle $ <h> ^<a> <v>)
-->
   (<ds> ^achieved <d>)
}

sp {jealous-husbands*elaborate*state*unachieved*object-property
   (state <s> ^problem-space.name jealous-husbands ^desireds <ds> ^world <w>)
   (<ds> ^desired <d>)
   (<d> ^object <do>)
   (<do> ^object-handle $ <h> ^{ <> object-handle <a> } <v>)
   (<w> ^anchored-world true)
  -{(<w> ^objects.object <ob>)
    (<ob> ^object-handle <h> ^<a> <v>)}
-->
