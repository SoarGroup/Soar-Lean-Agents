## Failure: the number of cannibals on a bank is more than the number of missionaries on the bank, read with the usual
## exception that a bank with no missionaries is safe (A-M1; the literal reading makes the puzzle unsolvable).
sp {missionaries-and-cannibals*elaborate*failure*cannibals-outnumber-missionaries
   (state <s> ^problem-space.name missionaries-and-cannibals ^desireds <ds> ^world <w>)
   (<w> ^anchored-world true ^objects.object <bank>)
   (<bank> ^type location ^cannibal-count <c> ^missionary-count { > 0 < <c> })
-->
   (<s> ^failure <ds>)
}
## ---- Search control (added, not taught): avoid returning to a situation on the current look-ahead path. ----
## Where each block would be after a proposed operator: a moved block (an argument, or the boat) on the destination bank.
sp {missionaries-and-cannibals*elaborate*operator*after*moved-block
   (state <s> ^problem-space.name missionaries-and-cannibals ^operator <op> + ^world <w>)
   (<op> ^task-operator true ^<< argument1 argument2 >> <b> ^to <dest>)
   (<b> ^type block ^label-key <k>)
   (<dest> ^object-handle $ <dh>)
-->
   (<op> ^<k> <dh>)
}

sp {missionaries-and-cannibals*elaborate*operator*after*boat
   (state <s> ^problem-space.name missionaries-and-cannibals ^operator <op> + ^world <w>)
   (<w> ^objects.object <b>)
   (<op> ^task-operator true ^to <dest>)
   (<b> ^type block ^shape boat ^label-key <k>)
   (<dest> ^object-handle $ <dh>)
-->
   (<op> ^<k> <dh>)
}

## A block that does not move stays on its bank.
sp {missionaries-and-cannibals*elaborate*operator*after*unmoved-block
   (state <s> ^problem-space.name missionaries-and-cannibals ^operator <op> + ^world <w>)
   (<op> ^task-operator true ^argument1 <a1> ^argument2 <a2> ^to <dest>)
   (<w> ^objects <objs> ^on <r>)
   (<objs> ^object { <> <a1> <> <a2> <b> })
   (<b> ^type block ^shape { <> boat } ^label-key <k>)
   (<r> ^argument1 <b> ^argument2 <bank>)
   (<bank> ^object-handle $ <bh>)
-->
   (<op> ^<k> <bh>)
}

## The label of the situation the operator produces.
sp {missionaries-and-cannibals*elaborate*operator*result
   (state <s> ^problem-space.name missionaries-and-cannibals ^operator <op> + ^world <w>)
   (<op> ^task-operator true ^pos-3 <pos-3> ^pos-4 <pos-4> ^pos-5 <pos-5> ^pos-6 <pos-6> ^pos-7 <pos-7> ^pos-8 <pos-8> ^pos-9 <pos-9>)
-->
   (<op> ^result (concat <pos-3> |,| <pos-4> |,| <pos-5> |,| <pos-6> |,| <pos-7> |,| <pos-8> |,| <pos-9>))
}

## The label of the current situation (derived; not copied into look-ahead worlds).
sp {missionaries-and-cannibals*elaborate*situation
   (state <s> ^problem-space.name missionaries-and-cannibals ^world <w>)
   (<w> ^anchored-world true ^objects <objs> ^on <r3> <r4> <r5> <r6> <r7> <r8> <r9>)
   (<objs> ^object <t> <b3> <b4> <b5> <b6> <b7> <b8> <b9>)
   (<t> ^type task)
   (<b3> ^label-key pos-3)
   (<r3> ^argument1 <b3> ^argument2 <bank3>)
   (<bank3> ^object-handle $ <h3>)
   (<b4> ^label-key pos-4)
   (<r4> ^argument1 <b4> ^argument2 <bank4>)
   (<bank4> ^object-handle $ <h4>)
   (<b5> ^label-key pos-5)
   (<r5> ^argument1 <b5> ^argument2 <bank5>)
   (<bank5> ^object-handle $ <h5>)
   (<b6> ^label-key pos-6)
   (<r6> ^argument1 <b6> ^argument2 <bank6>)
   (<bank6> ^object-handle $ <h6>)
   (<b7> ^label-key pos-7)
   (<r7> ^argument1 <b7> ^argument2 <bank7>)
   (<bank7> ^object-handle $ <h7>)
   (<b8> ^label-key pos-8)
   (<r8> ^argument1 <b8> ^argument2 <bank8>)
   (<bank8> ^object-handle $ <h8>)
   (<b9> ^label-key pos-9)
   (<r9> ^argument1 <b9> ^argument2 <bank9>)
   (<bank9> ^object-handle $ <h9>)
-->
   (<t> ^situation (concat <h3> |,| <h4> |,| <h5> |,| <h6> |,| <h7> |,| <h8> |,| <h9>))
}

## In look-ahead, reject an operator whose result is a situation already on the path.
sp {missionaries-and-cannibals*reject*operator*repeated-situation
   (state <s> ^problem-space.name missionaries-and-cannibals ^internal-actions true ^operator <op> + ^world <w>)
   (<w> ^objects.object <hist>)
   (<hist> ^type history ^visited <l>)
   (<op> ^task-operator true ^result <l>)
-->
   (<s> ^operator <op> -)
}

## ---- Search control on real moves (added, not taught; JL 16 Nov 2026, as in Tasks/From-English/mc-world): ----
## a real move back to a situation already visited is worst. It is chosen only when nothing else is left, so the agent
## prefers progress but is never trapped by its own history. The record is on the top state, not in the world, so it is
## not copied into look-ahead worlds.
## The real application records the situation it leaves (not the one it produces: recording that would make the selected
## operator itself worst, and Soar would replace it before its command completes).
sp {missionaries-and-cannibals*apply*operator*record-real-move
   (state <s> ^problem-space.name missionaries-and-cannibals ^superstate nil ^operator <op> ^world <w>)
   (<op> ^task-operator true)
   (<w> ^objects.object <t>)
   (<t> ^type task ^situation <sit>)
-->
   (<s> ^real-visited <sit>)
}

sp {missionaries-and-cannibals*compare*operator*real-repeated-situation
   (state <s> ^problem-space.name missionaries-and-cannibals ^superstate nil ^operator <op> + ^real-visited <l>)
   (<op> ^task-operator true ^result <l>)
-->
   (<s> ^operator <op> <)
}

## The look-ahead application records the situation it leaves and the one it produces.
sp {missionaries-and-cannibals*apply*operator*record-path
   (state <s> ^problem-space.name missionaries-and-cannibals ^operator <op> ^internal-actions true ^world <w>)
   (<op> ^task-operator true ^result <r>)
   (<w> ^objects <objs>)
   (<objs> ^object <hist> <t>)
   (<hist> ^type history)
   (<t> ^type task ^situation <sit>)
-->
   (<hist> ^visited <r> <sit>)
}
## Goal: all the blocks are on a destination bank (expanded over the blocks of the world file).
sp {missionaries-and-cannibals*elaborate*goal*all-crossed
   (state <s> ^problem-space.name missionaries-and-cannibals ^world <w>)
   (<w> ^anchored-world true ^objects <objs>)
   (<objs> ^object <t> <dest> <b-missionary-3> <b-missionary-4> <b-missionary-5> <b-cannibal-6> <b-cannibal-7> <b-cannibal-8> <b-boat-9>)
   (<t> ^type task)
   (<dest> ^type location ^name destination)
   (<b-missionary-3> ^object-handle missionary-3)
   (<w> ^on <on-missionary-3>)
   (<on-missionary-3> ^argument1 <b-missionary-3> ^argument2 <dest>)
   (<b-missionary-4> ^object-handle missionary-4)
   (<w> ^on <on-missionary-4>)
   (<on-missionary-4> ^argument1 <b-missionary-4> ^argument2 <dest>)
   (<b-missionary-5> ^object-handle missionary-5)
   (<w> ^on <on-missionary-5>)
   (<on-missionary-5> ^argument1 <b-missionary-5> ^argument2 <dest>)
   (<b-cannibal-6> ^object-handle cannibal-6)
   (<w> ^on <on-cannibal-6>)
   (<on-cannibal-6> ^argument1 <b-cannibal-6> ^argument2 <dest>)
   (<b-cannibal-7> ^object-handle cannibal-7)
   (<w> ^on <on-cannibal-7>)
   (<on-cannibal-7> ^argument1 <b-cannibal-7> ^argument2 <dest>)
   (<b-cannibal-8> ^object-handle cannibal-8)
   (<w> ^on <on-cannibal-8>)
   (<on-cannibal-8> ^argument1 <b-cannibal-8> ^argument2 <dest>)
   (<b-boat-9> ^object-handle boat-9)
   (<w> ^on <on-boat-9>)
   (<on-boat-9> ^argument1 <b-boat-9> ^argument2 <dest>)
-->
   (<t> ^goal-met true)
}

## Learning is off for this agent: the English statement says "Learning: do not learn from look-ahead" (World-Conventions L5-021).
## Reason given: With learning on no seed finishes within 300 s; without it it stops at its 5,000-decision cap (unsolved either way). (Added 23 November 2026 by Claude, supervised by John E. Laird; an agent setting, not part of the Rosie teaching data; library v2.46 runs, seeds 1-3.)
