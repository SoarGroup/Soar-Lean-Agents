## Missionaries and cannibals, generated from the Rosie teaching script (english-input.txt) under the world conventions.
##
## Instructor statements used (numbers as in english-input.txt):
##   4. The name of an action is ferry-one.
##   5. You can move the boat and a block on the current bank onto the opposite bank.
##   6. If an object is below a boat then it is current.
##   7. If a location is not below a boat then it is opposite.
##   8. The name of an action is ferry-two.
##   9. You can move a block that is on the current bank and another block that is on the current bank and the boat onto the opposite bank.
##  10. The solution has five steps.
##  12. If the number of cannibals on a bank is more than the number of missionaries on the bank then you lose.
##  17. The goal is that all the blocks are on a destination bank.
## World: init-mac.world (two banks; three missionaries, three cannibals and the boat on the first bank)
##
## Translation (tools/rosie-language.md gives the general reading; the assumption ledger is in README.md):
##   - Operators: ferry-one ("the boat and a block on the current bank onto the opposite bank"; argument1 = the block,
##     argument2 = the opposite bank) and ferry-two ("a block ... and another block ... and the boat"; argument1 and
##     argument2 = the two blocks, the lower ^index first; the destination is the opposite bank). Each operator records the
##     bank it leaves (^from), so its look-ahead application fires once.
##   - current is expanded in place (a bank below the boat); opposite is a maintained one-argument relation.
##   - The goal ("all the blocks are on a destination bank") is expanded over the blocks of the world file (the boat is a
##     block).
##   - "the number of cannibals (missionaries) on a bank" is a maintained attribute ^cannibal-count (^missionary-count) of
##     each bank, changed by every crossing.
##   - The losing condition is read with the usual exception (A-M1): a bank with cannibals and no missionaries is safe.
##   - "The solution has five steps." does not match this world (11 crossings): reported, not used.
##   - Search control added at JL's direction (16 Nov 2026), not from the English: in look-ahead, a move whose result is a
##     situation already on the current look-ahead path is rejected. A situation is the bank of every block; each operator
##     carries the label of the situation it produces (^result), the task object the label of the current one (^situation),
##     and the look-ahead application records both on the history object (^visited). Real moves (JL, 16 Nov 2026, as in
##     mc-world): a real move back to a situation already visited is worst (the top state records ^real-visited).

## Propose initialize-missionaries-and-cannibals when its conditions below hold.
sp {missionaries-and-cannibals*propose*initialize-missionaries-and-cannibals
   (state <s> ^superstate nil ^world <w> -^name)
-->
   (<s> ^operator <o> + >)
   (<o> ^name initialize-missionaries-and-cannibals ^task-operator false)
}

sp {missionaries-and-cannibals*apply*initialize-missionaries-and-cannibals
   (state <s> ^operator.name initialize-missionaries-and-cannibals ^world <w>)
   (<w> ^objects <objs>)
-->
   (<s> ^name missionaries-and-cannibals ^desireds <ds>)
   (<objs> ^object <o-bank-1> <o-bank-2> <o-missionary-3> <o-missionary-4> <o-missionary-5> <o-cannibal-6> <o-cannibal-7> <o-cannibal-8> <o-boat-9> <o-task> <o-history>)
   (<o-bank-1> ^object-handle bank-1 ^anchored true ^type location ^shape bank ^missionary-count 3 ^cannibal-count 3)
   (<o-bank-2> ^object-handle bank-2 ^anchored true ^type location ^shape bank ^name destination ^missionary-count 0 ^cannibal-count 0)
   (<o-missionary-3> ^object-handle missionary-3 ^anchored true ^type block ^shape missionary ^index 3 ^label-key pos-3)
   (<o-missionary-4> ^object-handle missionary-4 ^anchored true ^type block ^shape missionary ^index 4 ^label-key pos-4)
   (<o-missionary-5> ^object-handle missionary-5 ^anchored true ^type block ^shape missionary ^index 5 ^label-key pos-5)
   (<o-cannibal-6> ^object-handle cannibal-6 ^anchored true ^type block ^shape cannibal ^index 6 ^label-key pos-6)
   (<o-cannibal-7> ^object-handle cannibal-7 ^anchored true ^type block ^shape cannibal ^index 7 ^label-key pos-7)
   (<o-cannibal-8> ^object-handle cannibal-8 ^anchored true ^type block ^shape cannibal ^index 8 ^label-key pos-8)
   (<o-boat-9> ^object-handle boat-9 ^anchored true ^type block ^shape boat ^label-key pos-9)
   (<o-task> ^object-handle task ^anchored true ^type task)
   (<o-history> ^object-handle history ^anchored true ^type history)
   (<ds> ^desired-count 1 ^desired <d1>)
   (<d1> ^object <d1-o>)
   (<d1-o> ^object-handle task ^goal-met true)
   (<w> ^on <on-0>)
   (<on-0> ^argument1 <o-missionary-3> ^argument2 <o-bank-1>)
   (<w> ^on <on-1>)
   (<on-1> ^argument1 <o-missionary-4> ^argument2 <o-bank-1>)
   (<w> ^on <on-2>)
   (<on-2> ^argument1 <o-missionary-5> ^argument2 <o-bank-1>)
   (<w> ^on <on-3>)
   (<on-3> ^argument1 <o-cannibal-6> ^argument2 <o-bank-1>)
   (<w> ^on <on-4>)
   (<on-4> ^argument1 <o-cannibal-7> ^argument2 <o-bank-1>)
   (<w> ^on <on-5>)
   (<on-5> ^argument1 <o-cannibal-8> ^argument2 <o-bank-1>)
   (<w> ^on <on-6>)
   (<on-6> ^argument1 <o-boat-9> ^argument2 <o-bank-1>)
   (<w> ^below <below-0>)
   (<below-0> ^argument1 <o-bank-1> ^argument2 <o-missionary-3>)
   (<w> ^below <below-1>)
   (<below-1> ^argument1 <o-bank-1> ^argument2 <o-missionary-4>)
   (<w> ^below <below-2>)
   (<below-2> ^argument1 <o-bank-1> ^argument2 <o-missionary-5>)
   (<w> ^below <below-3>)
   (<below-3> ^argument1 <o-bank-1> ^argument2 <o-cannibal-6>)
   (<w> ^below <below-4>)
   (<below-4> ^argument1 <o-bank-1> ^argument2 <o-cannibal-7>)
   (<w> ^below <below-5>)
   (<below-5> ^argument1 <o-bank-1> ^argument2 <o-cannibal-8>)
   (<w> ^below <below-6>)
   (<below-6> ^argument1 <o-bank-1> ^argument2 <o-boat-9>)
   (<w> ^opposite <opposite-bank-2>)
   (<opposite-bank-2> ^argument1 <o-bank-2>)
   (log 1 (crlf) |Initialize missionaries-and-cannibals.|)
}

## Elaborate problem space: adds ^copy-relation, ^dont-copy-object-attribute, ^problem-space.
sp {missionaries-and-cannibals*elaborate*problem-space
   (state <s> ^name missionaries-and-cannibals)
-->
   (<s> ^problem-space <p>)
   (<p> ^name missionaries-and-cannibals ^copy-relation below ^copy-relation opposite ^dont-copy-object-attribute goal-met ^dont-copy-object-attribute situation)
}

sp {missionaries-and-cannibals*elaborate*problem-space*mea-substate
   (state <s> ^impasse no-change ^attribute operator ^superstate <ss>)
   (<ss> ^problem-space.name missionaries-and-cannibals ^operator <so>)
   (<so> ^task-operator true -^pre-conditions-satisfied true)
-->
   (<s> ^problem-space <p>)
   (<p> ^name missionaries-and-cannibals ^dont-copy-object-attribute goal-met ^dont-copy-object-attribute situation)
}

## Elaborate flags: adds ^flag-override, ^mea-operator-selection.
sp {missionaries-and-cannibals*elaborate*flags
   (state <s> ^superstate nil ^name missionaries-and-cannibals)
-->
   (<s> ^flag-override <f>)
   (<f> ^mea-operator-selection true)
}

## Achievement of object-property desireds (supplied by the task).
sp {missionaries-and-cannibals*elaborate*state*achieved*object-property
   (state <s> ^problem-space.name missionaries-and-cannibals ^desireds <ds> ^world <w>)
   (<ds> ^desired <d>)
   (<d> ^object <do>)
   (<do> ^object-handle $ <h> ^{ <> object-handle <a> } <v>)
   (<w> ^anchored-world true ^objects.object <ob>)
   (<ob> ^object-handle $ <h> ^<a> <v>)
-->
   (<ds> ^achieved <d>)
}

sp {missionaries-and-cannibals*elaborate*state*unachieved*object-property
   (state <s> ^problem-space.name missionaries-and-cannibals ^desireds <ds> ^world <w>)
   (<ds> ^desired <d>)
   (<d> ^object <do>)
   (<do> ^object-handle $ <h> ^{ <> object-handle <a> } <v>)
   (<w> ^anchored-world true)
  -{(<w> ^objects.object <ob>)
    (<ob> ^object-handle <h> ^<a> <v>)}
-->
   (<ds> ^unachieved <d>)
}
## Propose ferry-one in problem space missionaries-and-cannibals when its conditions below hold.
sp {missionaries-and-cannibals*propose*ferry-one
   (state <s> ^problem-space.name missionaries-and-cannibals ^flags.mea-operator-selection true ^world <w> ^desireds <ds>)
   (<w> ^anchored-world true ^objects <objs>)
   (<objs> ^object <boat> <x> <cur> <opp>)
   (<boat> ^type block ^shape boat ^object-handle $ <bh>)
   (<x> ^type block ^object-handle { <> <bh> <xh> })
   (<cur> ^type location)
   (<opp> ^type location ^object-handle $ <oh>)
   (<w> ^below <bb> ^on <xo> ^opposite <op-r>)
   (<bb> ^argument1 <cur> ^argument2 <boat>)
   (<xo> ^argument1 <x> ^argument2 <cur>)
   (<op-r> ^argument1 <opp>)
   (<ds> ^unachieved-desireds true)
-->
   (<s> ^operator <op> +)
   (<op> ^name ferry-one ^task-operator true ^action-handle ferry-one ^argument1 <x> ^argument2 <opp> ^argument-count 2 ^desireds <pre> ^from <cur> ^to <opp>)
   (<pre> ^desired-count 0)
}
## Effect of ferry-one (look-ahead): moved shapes missionary.
sp {missionaries-and-cannibals*apply*ferry-one*internal*missionary
   (state <s> ^problem-space.name missionaries-and-cannibals ^operator <op> ^internal-actions true ^world <w>)
   (<op> ^task-operator true ^name ferry-one ^pre-conditions-satisfied true ^argument1.object-handle $ <xh> ^argument2.object-handle $ <dh> ^from.object-handle $ <oldh>)
   (<w> ^anchored-world true ^objects <objs>)
   (<objs> ^object <boat> <d>)
   (<boat> ^type block ^shape boat)
   (<w> ^on <rb> ^below <bb> ^opposite <od>)
   (<rb> ^argument1 <boat> ^argument2 <old>)
   (<bb> ^argument1 <old> ^argument2 <boat>)
   (<old> ^object-handle $ <oldh>)
   (<od> ^argument1 <d>)
   (<d> ^object-handle $ <dh>)
   (<objs> ^object <x>)
   (<x> ^object-handle $ <xh>)
   (<w> ^on <rx> ^below <bx>)
   (<rx> ^argument1 <x> ^argument2 <old>)
   (<bx> ^argument1 <old> ^argument2 <x>)
   (<x> ^shape missionary)
   (<old> ^missionary-count <o-missionary>)
   (<d> ^missionary-count <n-missionary>)
-->
   (<rb> ^argument2 <old> - <d>)
   (<bb> ^argument1 <old> - <d>)
   (<w> ^opposite <od> - <no>)
   (<no> ^argument1 <old>)
   (<rx> ^argument2 <old> - <d>)
   (<bx> ^argument1 <old> - <d>)
   (<old> ^missionary-count <o-missionary> - (- <o-missionary> 1))
   (<d> ^missionary-count <n-missionary> - (+ <n-missionary> 1))
}

