sp {missionaries-and-cannibals*apply*ferry-two*environment-effect*missionary-cannibal
   :o-support
   (state <s> ^problem-space.name missionaries-and-cannibals ^superstate nil ^world <w> ^io.output-link.perform-action <pa>)
   (<pa> ^name ferry-two ^status complete ^argument1 <xh> ^argument2 <yh> -^effect-applied true)
   (<w> ^anchored-world true ^objects <objs>)
   (<objs> ^object <boat> <d>)
   (<boat> ^type block ^shape boat)
   (<w> ^on <rb> ^below <bb> ^opposite <od>)
   (<rb> ^argument1 <boat> ^argument2 <old>)
   (<bb> ^argument1 <old> ^argument2 <boat>)
   (<old> ^object-handle $ <oldh>)
   (<od> ^argument1 <d>)
   (<objs> ^object <x>)
   (<x> ^object-handle $ <xh>)
   (<w> ^on <rx> ^below <bx>)
   (<rx> ^argument1 <x> ^argument2 <old>)
   (<bx> ^argument1 <old> ^argument2 <x>)
   (<objs> ^object <y>)
   (<y> ^object-handle $ <yh>)
   (<w> ^on <ry> ^below <by>)
   (<ry> ^argument1 <y> ^argument2 <old>)
   (<by> ^argument1 <old> ^argument2 <y>)
   (<x> ^shape missionary)
   (<y> ^shape cannibal)
   (<old> ^missionary-count <o-missionary>)
   (<d> ^missionary-count <n-missionary>)
   (<old> ^cannibal-count <o-cannibal>)
   (<d> ^cannibal-count <n-cannibal>)
-->
   (<rb> ^argument2 <old> - <d>)
   (<bb> ^argument1 <old> - <d>)
   (<w> ^opposite <od> - <no>)
   (<no> ^argument1 <old>)
   (<rx> ^argument2 <old> - <d>)
   (<bx> ^argument1 <old> - <d>)
   (<ry> ^argument2 <old> - <d>)
   (<by> ^argument1 <old> - <d>)
   (<old> ^missionary-count <o-missionary> - (- <o-missionary> 1))
   (<d> ^missionary-count <n-missionary> - (+ <n-missionary> 1))
   (<old> ^cannibal-count <o-cannibal> - (- <o-cannibal> 1))
   (<d> ^cannibal-count <n-cannibal> - (+ <n-cannibal> 1))
   (<pa> ^effect-applied true)
   (write |ferry-two: | <xh> | and | <yh> | with the boat from | <old> | to | <d> (crlf))
}
