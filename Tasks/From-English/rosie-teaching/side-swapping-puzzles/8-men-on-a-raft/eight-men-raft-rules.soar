   (<objs> ^location <o-location-1> <o-location-2> <o-location-3> <o-location-4> <o-location-5> <o-location-6> <o-location-7> <o-location-8> <o-location-9> ^block <o-block-10> <o-block-11> <o-block-12> <o-block-13> <o-block-14> <o-block-15> <o-block-16> <o-block-17> ^task <o-task>)
   (<o-location-1> ^object-handle location-1 ^anchored true ^type location ^color red ^row 1 ^column 1 ^static true)
   (<o-location-2> ^object-handle location-2 ^anchored true ^type location ^color red ^row 1 ^column 2 ^static true)
   (<o-location-3> ^object-handle location-3 ^anchored true ^type location ^color red ^row 1 ^column 3 ^static true)
