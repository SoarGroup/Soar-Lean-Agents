## Elaborate problem space: adds ^copy-relation, ^dont-copy-object-attribute, ^problem-space.
sp {eight-men-raft*elaborate*problem-space
   (state <s> ^name eight-men-raft)
-->
   (<s> ^problem-space <p>)
   (<p> ^name eight-men-raft ^copy-relation below ^share-relation left-of ^share-relation right-of ^copy-relation clear ^dont-copy-object-attribute goal-met)
}

sp {eight-men-raft*elaborate*problem-space*mea-substate
   (state <s> ^impasse no-change ^attribute operator ^superstate <ss>)
   (<ss> ^problem-space.name eight-men-raft ^operator <so>)
   (<so> ^task-operator true -^pre-conditions-satisfied true)
-->
   (<s> ^problem-space <p>)
   (<p> ^name eight-men-raft ^dont-copy-object-attribute goal-met)
}

## Elaborate flags: adds ^flag-override, ^mea-operator-selection.
sp {eight-men-raft*elaborate*flags
   (state <s> ^superstate nil ^name eight-men-raft)
-->
   (<s> ^flag-override <f>)
   (<f> ^mea-operator-selection true)
}

## Achievement of object-property desireds (supplied by the task).
sp {eight-men-raft*elaborate*state*achieved*object-property
   (state <s> ^problem-space.name eight-men-raft ^desireds <ds> ^world <w>)
   (<ds> ^desired <d>)
   (<d> ^object <do>)
   (<do> ^object-handle $ <h> ^{ <> object-handle <a> } <v>)
   (<w> ^anchored-world true ^objects.object <ob>)
   (<ob> ^object-handle $ <h> ^<a> <v>)
-->
   (<ds> ^achieved <d>)
}

sp {eight-men-raft*elaborate*state*unachieved*object-property
   (state <s> ^problem-space.name eight-men-raft ^desireds <ds> ^world <w>)
   (<ds> ^desired <d>)
   (<d> ^object <do>)
   (<do> ^object-handle $ <h> ^{ <> object-handle <a> } <v>)
   (<w> ^anchored-world true)
  -{(<w> ^objects.object <ob>)
    (<ob> ^object-handle <h> ^<a> <v>)}
-->
   (<ds> ^unachieved <d>)
}
