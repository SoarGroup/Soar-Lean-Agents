   (<b> ^object-handle $ <bh>)
   (<d> ^object-handle $ <dh>)
   (<b> ^color blue)
   (<w> ^on <on-b>)
   (<on-b> ^argument1 <b> ^argument2 <l1>)
   (<w> ^right-of <right-of-d>)
   (<right-of-d> ^argument1 <d> ^argument2 <l1>)
   (<w> ^clear <clear-d>)
   (<clear-d> ^argument1 <d>)
