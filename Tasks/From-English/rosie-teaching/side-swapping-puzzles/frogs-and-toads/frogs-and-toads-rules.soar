## Frogs and toads (frogs-and-toads), generated from the Rosie teaching script (english-input.txt) under the world conventions.
##
## Instructor statements used (numbers as in english-input.txt):
##   4. If a clear location is to the right of a toad then you can move the toad onto the location.
##   5. If a location is not below an object then it is clear.
##   6. If an object is blue and the object is a block then it is a toad.
##   7. If a clear location is to the left of a frog then you can move the frog onto the location.
##   8. If an object is red and the object is a block then it is a frog.
##  10. If a frog is to the right of a toad and the toad is to the right of a clear location then you can move the frog onto the clear location.
##  11. If a toad is to the left of a frog and the frog is to the left of a clear location then you can move the toad onto the clear location.
##  15. The goal is that all the red blocks are on the red locations and all the blue blocks are on the blue locations.
## World: init-frog.world (five locations in a row; two toads, a clear location, two frogs)
##
## Translation (tools/rosie-language.md gives the general reading; the assumption ledger is in README.md):
##   - Operator move (argument1 = the block, argument2 = the clear location it moves onto); four proposals, one per move
##     statement (4, 7, 10, 11). A toad is a blue block, a frog a red block (statements 6, 8), expanded in place.
##   - clear is a maintained one-argument relation (statement 5). left-of and right-of are static relations between
##     locations; a block is to the left/right of a location when the location it is on is (A-S1).
##   - The goal (statement 15) is expanded over the blocks of the world file: each block is on a location of its colour (A-S2).
## Matching hints for learned rules (World-Conventions L3-095, L11-009): many-valued attributes, sized from the initial world.
production optimize-attribute location 10
production optimize-attribute block 10
production optimize-attribute task 10
production optimize-attribute object 10
production optimize-attribute on 4
production optimize-attribute below 4
production optimize-attribute clear 5
production optimize-attribute left-of 4
production optimize-attribute right-of 4


## Propose initialize-frogs-and-toads when its conditions below hold.
sp {frogs-and-toads*propose*initialize-frogs-and-toads
   (state <s> ^superstate nil ^world <w> -^name)
-->
   (<s> ^operator <o> + >)
   (<o> ^name initialize-frogs-and-toads ^task-operator false)
}

sp {frogs-and-toads*apply*initialize-frogs-and-toads
   (state <s> ^operator.name initialize-frogs-and-toads ^world <w>)
   (<w> ^objects <objs>)
-->
   (<s> ^name frogs-and-toads ^desireds <ds>)
   (<objs> ^location <o-location-1> <o-location-2> <o-location-3> <o-location-4> <o-location-5> ^block <o-block-6> <o-block-7> <o-block-8> <o-block-9> ^task <o-task>)
   (<o-location-1> ^object-handle location-1 ^anchored true ^type location ^color red ^row 1 ^column 1 ^static true)
   (<o-location-2> ^object-handle location-2 ^anchored true ^type location ^color red ^row 1 ^column 2 ^static true)
   (<o-location-3> ^object-handle location-3 ^anchored true ^type location ^row 1 ^column 3 ^static true)
   (<o-location-4> ^object-handle location-4 ^anchored true ^type location ^color blue ^row 1 ^column 4 ^static true)
   (<o-location-5> ^object-handle location-5 ^anchored true ^type location ^color blue ^row 1 ^column 5 ^static true)
   (<o-block-6> ^object-handle block-6 ^anchored true ^type block ^color blue ^static true)
   (<o-block-7> ^object-handle block-7 ^anchored true ^type block ^color blue ^static true)
   (<o-block-8> ^object-handle block-8 ^anchored true ^type block ^color red ^static true)
   (<o-block-9> ^object-handle block-9 ^anchored true ^type block ^color red ^static true)
   (<o-task> ^object-handle task ^anchored true ^type task)
   (<ds> ^desired-count 1 ^desired <d1>)
   (<d1> ^object <d1-o>)
   (<d1-o> ^object-handle task ^goal-met true)
   (<w> ^on <on-0>)
   (<on-0> ^argument1 <o-block-6> ^argument2 <o-location-1>)
   (<w> ^on <on-1>)
   (<on-1> ^argument1 <o-block-7> ^argument2 <o-location-2>)
   (<w> ^on <on-2>)
   (<on-2> ^argument1 <o-block-8> ^argument2 <o-location-4>)
   (<w> ^on <on-3>)
   (<on-3> ^argument1 <o-block-9> ^argument2 <o-location-5>)
   (<w> ^below <below-0>)
   (<below-0> ^argument1 <o-location-1> ^argument2 <o-block-6>)
   (<w> ^below <below-1>)
   (<below-1> ^argument1 <o-location-2> ^argument2 <o-block-7>)
   (<w> ^below <below-2>)
   (<below-2> ^argument1 <o-location-4> ^argument2 <o-block-8>)
   (<w> ^below <below-3>)
   (<below-3> ^argument1 <o-location-5> ^argument2 <o-block-9>)
   (<w> ^clear <clear-location-3>)
   (<clear-location-3> ^argument1 <o-location-3>)
   (<w> ^clear <clear-block-6>)
   (<clear-block-6> ^argument1 <o-block-6>)
   (<w> ^clear <clear-block-7>)
   (<clear-block-7> ^argument1 <o-block-7>)
   (<w> ^clear <clear-block-8>)
   (<clear-block-8> ^argument1 <o-block-8>)
   (<w> ^clear <clear-block-9>)
   (<clear-block-9> ^argument1 <o-block-9>)
   (<w> ^left-of <left-of-0>)
   (<left-of-0> ^argument1 <o-location-1> ^argument2 <o-location-2>)
   (<w> ^left-of <left-of-1>)
   (<left-of-1> ^argument1 <o-location-2> ^argument2 <o-location-3>)
   (<w> ^left-of <left-of-2>)
   (<left-of-2> ^argument1 <o-location-3> ^argument2 <o-location-4>)
   (<w> ^left-of <left-of-3>)
   (<left-of-3> ^argument1 <o-location-4> ^argument2 <o-location-5>)
   (<w> ^right-of <right-of-0>)
   (<right-of-0> ^argument1 <o-location-2> ^argument2 <o-location-1>)
   (<w> ^right-of <right-of-1>)
   (<right-of-1> ^argument1 <o-location-3> ^argument2 <o-location-2>)
   (<w> ^right-of <right-of-2>)
   (<right-of-2> ^argument1 <o-location-4> ^argument2 <o-location-3>)
   (<w> ^right-of <right-of-3>)
   (<right-of-3> ^argument1 <o-location-5> ^argument2 <o-location-4>)
   (log 1 (crlf) |Initialize frogs-and-toads.|)
}

## Elaborate problem space: adds ^copy-relation, ^dont-copy-object-attribute, ^problem-space.
sp {frogs-and-toads*elaborate*problem-space
   (state <s> ^name frogs-and-toads)
-->
   (<s> ^problem-space <p>)
   (<p> ^name frogs-and-toads ^copy-relation below ^share-relation left-of ^share-relation right-of ^copy-relation clear ^dont-copy-object-attribute goal-met)
}

sp {frogs-and-toads*elaborate*problem-space*mea-substate
   (state <s> ^impasse no-change ^attribute operator ^superstate <ss>)
   (<ss> ^problem-space.name frogs-and-toads ^operator <so>)
   (<so> ^task-operator true -^pre-conditions-satisfied true)
-->
   (<s> ^problem-space <p>)
   (<p> ^name frogs-and-toads ^dont-copy-object-attribute goal-met)
}

## Elaborate flags: adds ^flag-override, ^mea-operator-selection.
sp {frogs-and-toads*elaborate*flags
   (state <s> ^superstate nil ^name frogs-and-toads)
-->
   (<s> ^flag-override <f>)
   (<f> ^mea-operator-selection true)
}

## Achievement of object-property desireds (supplied by the task).
sp {frogs-and-toads*elaborate*state*achieved*object-property
   (state <s> ^problem-space.name frogs-and-toads ^desireds <ds> ^world <w>)
   (<ds> ^desired <d>)
   (<d> ^object <do>)
   (<do> ^object-handle $ <h> ^{ <> object-handle <a> } <v>)
   (<w> ^anchored-world true ^objects.object <ob>)
   (<ob> ^object-handle $ <h> ^<a> <v>)
-->
   (<ds> ^achieved <d>)
}

sp {frogs-and-toads*elaborate*state*unachieved*object-property
   (state <s> ^problem-space.name frogs-and-toads ^desireds <ds> ^world <w>)
   (<ds> ^desired <d>)
   (<d> ^object <do>)
   (<do> ^object-handle $ <h> ^{ <> object-handle <a> } <v>)
   (<w> ^anchored-world true)
  -{(<w> ^objects.object <ob>)
    (<ob> ^object-handle <h> ^<a> <v>)}
-->
   (<ds> ^unachieved <d>)
}
