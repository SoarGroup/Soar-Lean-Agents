## Effect of move (look-ahead).
sp {frogs-and-toads*apply*move*internal
   (state <s> ^problem-space.name frogs-and-toads ^operator <op> ^internal-actions true ^world <w>)
   (<op> ^task-operator true ^name move ^pre-conditions-satisfied true ^argument1.object-handle $ <bh> ^argument2.object-handle $ <dh>)
   (<w> ^anchored-world true ^objects <objs>)
   (<objs> ^block <b> ^location <d>)
   (<b> ^object-handle $ <bh>)
   (<d> ^object-handle $ <dh>)
   (<w> ^on <r> ^below <bl> ^clear <cd>)
   (<r> ^argument1 <b> ^argument2 <old>)
   (<bl> ^argument1 <old> ^argument2 <b>)
   (<cd> ^argument1 <d>)
-->
   (<r> ^argument2 <old> - <d>)
   (<bl> ^argument1 <old> - <d>)
   (<w> ^clear <cd> - <nc>)
   (<nc> ^argument1 <old>)
}

## Effect of a completed move command on the real world (once per command).
sp {frogs-and-toads*apply*move*environment-effect
   :o-support
   (state <s> ^problem-space.name frogs-and-toads ^superstate nil ^world <w> ^io.output-link.perform-action <pa>)
   (<pa> ^name move ^status complete ^argument1 <bh> ^argument2 <dh> -^effect-applied true)
   (<w> ^anchored-world true ^objects <objs>)
   (<objs> ^block <b> ^location <d>)
   (<b> ^object-handle $ <bh>)
   (<d> ^object-handle $ <dh>)
   (<w> ^on <r> ^below <bl> ^clear <cd>)
   (<r> ^argument1 <b> ^argument2 <old>)
   (<bl> ^argument1 <old> ^argument2 <b>)
   (<cd> ^argument1 <d>)
-->
   (<r> ^argument2 <old> - <d>)
   (<bl> ^argument1 <old> - <d>)
   (<w> ^clear <cd> - <nc>)
   (<nc> ^argument1 <old>)
   (<pa> ^effect-applied true)
   (write |Move | <bh> | onto | <dh> (crlf))
}
## Goal: every block is on a location of its own color.
sp {frogs-and-toads*elaborate*goal*colors-matched
   (state <s> ^problem-space.name frogs-and-toads ^world <w>)
   (<w> ^objects <objs>)
   (<objs> ^task <t> ^block <b-block-6> ^location <l-block-6> ^block <b-block-7> ^location <l-block-7> ^block <b-block-8> ^location <l-block-8> ^block <b-block-9> ^location <l-block-9>)
   (<b-block-6> ^object-handle block-6)
   (<l-block-6> ^color blue)
   (<w> ^on <on-block-6>)
   (<on-block-6> ^argument1 <b-block-6> ^argument2 <l-block-6>)
   (<b-block-7> ^object-handle block-7)
   (<l-block-7> ^color blue)
   (<w> ^on <on-block-7>)
   (<on-block-7> ^argument1 <b-block-7> ^argument2 <l-block-7>)
   (<b-block-8> ^object-handle block-8)
   (<l-block-8> ^color red)
   (<w> ^on <on-block-8>)
   (<on-block-8> ^argument1 <b-block-8> ^argument2 <l-block-8>)
   (<b-block-9> ^object-handle block-9)
   (<l-block-9> ^color red)
   (<w> ^on <on-block-9>)
   (<on-block-9> ^argument1 <b-block-9> ^argument2 <l-block-9>)
-->
   (<t> ^goal-met true)
}
