   (<ds> ^achieved <d>)
}

sp {knight-side-swap*elaborate*state*unachieved*object-property
   (state <s> ^problem-space.name knight-side-swap ^desireds <ds> ^world <w>)
   (<ds> ^desired <d>)
   (<d> ^object <do>)
