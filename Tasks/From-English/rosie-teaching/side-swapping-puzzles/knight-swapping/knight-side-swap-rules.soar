## Elaborate problem space: adds ^copy-relation, ^dont-copy-object-attribute, ^problem-space.
sp {knight-side-swap*elaborate*problem-space
   (state <s> ^name knight-side-swap)
-->
   (<s> ^problem-space <p>)
   (<p> ^name knight-side-swap ^copy-relation below ^share-relation jumpable ^copy-relation clear ^dont-copy-object-attribute goal-met)
}

sp {knight-side-swap*elaborate*problem-space*mea-substate
   (state <s> ^impasse no-change ^attribute operator ^superstate <ss>)
   (<ss> ^problem-space.name knight-side-swap ^operator <so>)
   (<so> ^task-operator true -^pre-conditions-satisfied true)
-->
   (<s> ^problem-space <p>)
   (<p> ^name knight-side-swap ^dont-copy-object-attribute goal-met)
}

## Elaborate flags: adds ^flag-override, ^mea-operator-selection.
sp {knight-side-swap*elaborate*flags
   (state <s> ^superstate nil ^name knight-side-swap)
-->
   (<s> ^flag-override <f>)
   (<f> ^mea-operator-selection true)
}

## Achievement of object-property desireds (supplied by the task).
sp {knight-side-swap*elaborate*state*achieved*object-property
   (state <s> ^problem-space.name knight-side-swap ^desireds <ds> ^world <w>)
   (<ds> ^desired <d>)
