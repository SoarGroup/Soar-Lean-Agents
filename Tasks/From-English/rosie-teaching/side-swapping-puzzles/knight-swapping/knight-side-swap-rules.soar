   (<w> ^anchored-world true)
  -{(<w> ^objects.object <ob>)
    (<ob> ^object-handle <h> ^<a> <v>)}
-->
   (<ds> ^unachieved <d>)
}
## Propose move in problem space knight-side-swap when its conditions below hold (jump).
sp {knight-side-swap*propose*move*jump
   (state <s> ^problem-space.name knight-side-swap ^flags.mea-operator-selection true ^world <w> ^desireds <ds>)
   (<w> ^anchored-world true ^objects <objs>)
   (<objs> ^object <b> <d>)
   (<b> ^type block ^object-handle $ <bh>)
   (<d> ^type location ^object-handle $ <dh>)
   (<w> ^on <on-b>)
   (<on-b> ^argument1 <b> ^argument2 <l1>)
   (<w> ^jumpable <jumpable-d>)
   (<jumpable-d> ^argument1 <d> ^argument2 <l1>)
   (<w> ^clear <clear-d>)
   (<clear-d> ^argument1 <d>)
   (<ds> ^unachieved-desireds true)
-->
   (<s> ^operator <op> +)
   (<op> ^name move ^task-operator true ^action-handle move ^argument1 <b> ^argument2 <d> ^argument-count 2 ^pre-conditions-satisfied true)
}
## Effect of move (look-ahead).
sp {knight-side-swap*apply*move*internal
   (state <s> ^problem-space.name knight-side-swap ^operator <op> ^internal-actions true ^world <w>)
   (<op> ^task-operator true ^name move ^pre-conditions-satisfied true ^argument1.object-handle $ <bh> ^argument2.object-handle $ <dh>)
   (<w> ^anchored-world true ^objects <objs>)
   (<objs> ^object <b> <d>)
   (<b> ^object-handle $ <bh>)
   (<d> ^object-handle $ <dh>)
   (<w> ^on <r> ^below <bl> ^clear <cd>)
   (<r> ^argument1 <b> ^argument2 <old>)
   (<bl> ^argument1 <old> ^argument2 <b>)
   (<cd> ^argument1 <d>)
-->
   (<r> ^argument2 <old> - <d>)
   (<bl> ^argument1 <old> - <d>)
   (<w> ^clear <cd> - <nc>)
   (<nc> ^argument1 <old>)
}

## Effect of a completed move command on the real world (once per command).
sp {knight-side-swap*apply*move*environment-effect
   :o-support
   (state <s> ^problem-space.name knight-side-swap ^superstate nil ^world <w> ^io.output-link.perform-action <pa>)
   (<pa> ^name move ^status complete ^argument1 <bh> ^argument2 <dh> -^effect-applied true)
   (<w> ^anchored-world true ^objects <objs>)
   (<objs> ^object <b> <d>)
   (<b> ^object-handle $ <bh>)
   (<d> ^object-handle $ <dh>)
   (<w> ^on <r> ^below <bl> ^clear <cd>)
   (<r> ^argument1 <b> ^argument2 <old>)
   (<bl> ^argument1 <old> ^argument2 <b>)
   (<cd> ^argument1 <d>)
-->
   (<r> ^argument2 <old> - <d>)
   (<bl> ^argument1 <old> - <d>)
   (<w> ^clear <cd> - <nc>)
   (<nc> ^argument1 <old>)
   (<pa> ^effect-applied true)
   (write |Move | <bh> | onto | <dh> (crlf))
}
