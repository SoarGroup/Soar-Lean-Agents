   (<a1> ^argument1 <b1>)
   (<a2> ^argument1 <b2>)
   (<c1> ^argument1 <b1>)
   (<c2> ^argument1 <b2>)
   (<w> ^on <r1> ^below <bl1>)
   (<r1> ^argument1 <b1> ^argument2 <x1>)
   (<bl1> ^argument1 <x1> ^argument2 <b1>)
   (<w> ^on <r2> ^below <bl2>)
   (<r2> ^argument1 <b2> ^argument2 <x2>)
   (<bl2> ^argument1 <x2> ^argument2 <b2>)
