## Goal: all blocks are on a garbage.
sp {mahjong*elaborate*goal*all-on-garbage
   (state <s> ^problem-space.name mahjong ^world <w>)
   (<w> ^objects <objs>)
   (<objs> ^object <t> <g> <b-block-1> <b-block-2> <b-block-3> <b-block-5> <b-block-6> <b-block-7> <b-block-8> <b-block-9>)
   (<t> ^type task)
   (<g> ^type location ^name garbage)
   (<b-block-1> ^object-handle block-1)
   (<w> ^on <on-block-1>)
   (<on-block-1> ^argument1 <b-block-1> ^argument2 <g>)
   (<b-block-2> ^object-handle block-2)
   (<w> ^on <on-block-2>)
   (<on-block-2> ^argument1 <b-block-2> ^argument2 <g>)
   (<b-block-3> ^object-handle block-3)
   (<w> ^on <on-block-3>)
   (<on-block-3> ^argument1 <b-block-3> ^argument2 <g>)
   (<b-block-5> ^object-handle block-5)
   (<w> ^on <on-block-5>)
   (<on-block-5> ^argument1 <b-block-5> ^argument2 <g>)
   (<b-block-6> ^object-handle block-6)
   (<w> ^on <on-block-6>)
   (<on-block-6> ^argument1 <b-block-6> ^argument2 <g>)
   (<b-block-7> ^object-handle block-7)
   (<w> ^on <on-block-7>)
   (<on-block-7> ^argument1 <b-block-7> ^argument2 <g>)
   (<b-block-8> ^object-handle block-8)
   (<w> ^on <on-block-8>)
   (<on-block-8> ^argument1 <b-block-8> ^argument2 <g>)
   (<b-block-9> ^object-handle block-9)
   (<w> ^on <on-block-9>)
   (<on-block-9> ^argument1 <b-block-9> ^argument2 <g>)
-->
   (<t> ^goal-met true)
}

