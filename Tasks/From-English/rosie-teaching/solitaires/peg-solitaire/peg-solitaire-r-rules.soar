## Elaborate problem space: adds ^copy-relation, ^dont-copy-object-attribute, ^problem-space.
sp {peg-solitaire-r*elaborate*problem-space
   (state <s> ^name peg-solitaire-r)
-->
   (<s> ^problem-space <p>)
   (<p> ^name peg-solitaire-r ^copy-relation below ^copy-relation step-1 ^copy-relation step-2 ^copy-relation step-3 ^copy-relation step-4 ^copy-relation step-5 ^copy-relation step-6 ^copy-relation step-7 ^copy-relation step-8 ^copy-relation clear ^dont-copy-object-attribute goal-met)
}

sp {peg-solitaire-r*elaborate*problem-space*mea-substate
   (state <s> ^impasse no-change ^attribute operator ^superstate <ss>)
   (<ss> ^problem-space.name peg-solitaire-r ^operator <so>)
   (<so> ^task-operator true -^pre-conditions-satisfied true)
-->
   (<s> ^problem-space <p>)
   (<p> ^name peg-solitaire-r ^dont-copy-object-attribute goal-met)
}

## Elaborate flags: adds ^flag-override, ^mea-operator-selection.
sp {peg-solitaire-r*elaborate*flags
   (state <s> ^superstate nil ^name peg-solitaire-r)
-->
   (<s> ^flag-override <f>)
   (<f> ^mea-operator-selection true)
}

## Achievement of object-property desireds (supplied by the task).
sp {peg-solitaire-r*elaborate*state*achieved*object-property
   (state <s> ^problem-space.name peg-solitaire-r ^desireds <ds> ^world <w>)
   (<ds> ^desired <d>)
   (<d> ^object <do>)
   (<do> ^object-handle $ <h> ^{ <> object-handle <a> } <v>)
   (<w> ^anchored-world true ^objects.object <ob>)
   (<ob> ^object-handle $ <h> ^<a> <v>)
-->
   (<ds> ^achieved <d>)
}

sp {peg-solitaire-r*elaborate*state*unachieved*object-property
   (state <s> ^problem-space.name peg-solitaire-r ^desireds <ds> ^world <w>)
   (<ds> ^desired <d>)
   (<d> ^object <do>)
   (<do> ^object-handle $ <h> ^{ <> object-handle <a> } <v>)
   (<w> ^anchored-world true)
  -{(<w> ^objects.object <ob>)
    (<ob> ^object-handle <h> ^<a> <v>)}
-->
   (<ds> ^unachieved <d>)
}
## Propose jump in problem space peg-solitaire-r when its conditions below hold (dir 1).
sp {peg-solitaire-r*propose*jump*dir-1
   (state <s> ^problem-space.name peg-solitaire-r ^flags.mea-operator-selection true ^world <w> ^desireds <ds>)
   (<w> ^anchored-world true ^objects <objs>)
   (<objs> ^object <q> <l> <c> <o> <p>)
   (<q> ^type block ^object-handle $ <qh>)
   (<l> ^type location ^object-handle $ <lh>)
   (<p> ^type block)
   (<w> ^on <on-p>)
   (<on-p> ^argument1 <p> ^argument2 <c>)
   (<w> ^on <on-q>)
   (<on-q> ^argument1 <q> ^argument2 <o>)
   (<w> ^step-1 <step-1-lc>)
   (<step-1-lc> ^argument1 <l> ^argument2 <c>)
   (<w> ^step-1 <step-1-co>)
   (<step-1-co> ^argument1 <c> ^argument2 <o>)
   (<w> ^clear <clear-l>)
   (<clear-l> ^argument1 <l>)
   (<ds> ^unachieved-desireds true)
-->
   (<s> ^operator <op> +)
   (<op> ^name jump ^task-operator true ^action-handle jump ^argument1 <q> ^argument2 <l> ^argument-count 2 ^desireds <pre> ^direction 1)
   (<pre> ^desired-count 0)
}
## Effect of jump in direction 1 (look-ahead).
sp {peg-solitaire-r*apply*jump*internal*dir-1
   (state <s> ^problem-space.name peg-solitaire-r ^operator <op> ^internal-actions true ^world <w>)
   (<op> ^task-operator true ^name jump ^direction 1 ^pre-conditions-satisfied true ^argument1.object-handle $ <qh> ^argument2.object-handle $ <lh>)
   (<w> ^anchored-world true ^objects <objs>)
   (<objs> ^object <q> <l> <c> <o> <p>)
   (<q> ^object-handle $ <qh>)
   (<l> ^object-handle $ <lh>)
   (<p> ^type block)
   (<w> ^on <rp> <rq> ^below <bp> <bq> ^clear <cl>)
   (<rp> ^argument1 <p> ^argument2 <c>)
   (<bp> ^argument1 <c> ^argument2 <p>)
   (<rq> ^argument1 <q> ^argument2 <o>)
   (<bq> ^argument1 <o> ^argument2 <q>)
   (<cl> ^argument1 <l>)
   (<w> ^step-1 <step-1-lc>)
   (<step-1-lc> ^argument1 <l> ^argument2 <c>)
   (<w> ^step-1 <step-1-co>)
   (<step-1-co> ^argument1 <c> ^argument2 <o>)
-->
   (<w> ^on <rp> - ^below <bp> -)
   (<rq> ^argument2 <o> - <l>)
   (<bq> ^argument1 <o> - <l>)
   (<w> ^clear <cl> - <nc1> <nc2>)
   (<nc1> ^argument1 <c>)
   (<nc2> ^argument1 <o>)
}

## Effect of a completed jump command in direction 1 on the real world (once per command).
sp {peg-solitaire-r*apply*jump*environment-effect*dir-1
   :o-support
   (state <s> ^problem-space.name peg-solitaire-r ^superstate nil ^world <w> ^io.output-link.perform-action <pa>)
   (<pa> ^name jump ^status complete ^argument1 <qh> ^argument2 <lh> -^effect-applied true)
   (<w> ^anchored-world true ^objects <objs>)
   (<objs> ^object <q> <l> <c> <o> <p>)
   (<q> ^object-handle $ <qh>)
   (<l> ^object-handle $ <lh>)
   (<p> ^type block)
   (<w> ^on <rp> <rq> ^below <bp> <bq> ^clear <cl>)
   (<rp> ^argument1 <p> ^argument2 <c>)
   (<bp> ^argument1 <c> ^argument2 <p>)
   (<rq> ^argument1 <q> ^argument2 <o>)
   (<bq> ^argument1 <o> ^argument2 <q>)
   (<cl> ^argument1 <l>)
   (<w> ^step-1 <step-1-lc>)
   (<step-1-lc> ^argument1 <l> ^argument2 <c>)
   (<w> ^step-1 <step-1-co>)
   (<step-1-co> ^argument1 <c> ^argument2 <o>)
-->
   (<w> ^on <rp> - ^below <bp> -)
   (<rq> ^argument2 <o> - <l>)
   (<bq> ^argument1 <o> - <l>)
   (<w> ^clear <cl> - <nc1> <nc2>)
   (<nc1> ^argument1 <c>)
   (<nc2> ^argument1 <o>)
   (<pa> ^effect-applied true)
   (write |Jump | <qh> | onto | <lh> (crlf))
}
