}

## Effect of a completed jump command in direction 8 on the real world (once per command).
sp {peg-solitaire-r*apply*jump*environment-effect*dir-8
   :o-support
   (state <s> ^problem-space.name peg-solitaire-r ^superstate nil ^world <w> ^io.output-link.perform-action <pa>)
   (<pa> ^name jump ^status complete ^argument1 <qh> ^argument2 <lh> -^effect-applied true)
   (<w> ^anchored-world true ^objects <objs>)
   (<objs> ^object <q> <l> <c> <o> <p>)
   (<q> ^object-handle $ <qh>)
   (<l> ^object-handle $ <lh>)
   (<p> ^type block)
   (<w> ^on <rp> <rq> ^below <bp> <bq> ^clear <cl>)
   (<rp> ^argument1 <p> ^argument2 <c>)
   (<bp> ^argument1 <c> ^argument2 <p>)
   (<rq> ^argument1 <q> ^argument2 <o>)
   (<bq> ^argument1 <o> ^argument2 <q>)
   (<cl> ^argument1 <l>)
   (<w> ^step-8 <step-8-lc>)
   (<step-8-lc> ^argument1 <l> ^argument2 <c>)
   (<w> ^step-8 <step-8-co>)
   (<step-8-co> ^argument1 <c> ^argument2 <o>)
-->
   (<w> ^on <rp> - ^below <bp> -)
   (<rq> ^argument2 <o> - <l>)
   (<bq> ^argument1 <o> - <l>)
   (<w> ^clear <cl> - <nc1> <nc2>)
   (<nc1> ^argument1 <c>)
   (<nc2> ^argument1 <o>)
   (<pa> ^effect-applied true)
   (write |Jump | <qh> | onto | <lh> (crlf))
}
## Goal: the number of covered locations is one (a covered location and no other; A-P2).
sp {peg-solitaire-r*elaborate*goal*one-covered
   (state <s> ^problem-space.name peg-solitaire-r ^world <w>)
   (<w> ^objects <objs> ^below <b1>)
   (<objs> ^object <t> <l1>)
   (<t> ^type task)
   (<l1> ^type location)
   (<b1> ^argument1 <l1>)
  -{(<w> ^below <b2>)
    (<b2> ^argument1 { <> <l1> <l2> })
    (<objs> ^object <l2>)
    (<l2> ^type location)}
-->
   (<t> ^goal-met true)
}
