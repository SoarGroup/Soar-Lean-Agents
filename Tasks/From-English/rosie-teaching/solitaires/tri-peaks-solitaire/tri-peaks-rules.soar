## Goal: all blocks are trashed (position one).
sp {tri-peaks*elaborate*goal*all-trashed
   (state <s> ^problem-space.name tri-peaks ^world <w>)
   (<w> ^objects <objs>)
   (<objs> ^task <t> ^block <b-block-1> <b-block-2> <b-block-3> <b-block-4> <b-block-5> <b-block-6> <b-block-7> <b-block-8> <b-block-9>)
   (<b-block-1> ^object-handle block-1 ^position 1)
   (<b-block-2> ^object-handle block-2 ^position 1)
   (<b-block-3> ^object-handle block-3 ^position 1)
   (<b-block-4> ^object-handle block-4 ^position 1)
   (<b-block-5> ^object-handle block-5 ^position 1)
   (<b-block-6> ^object-handle block-6 ^position 1)
   (<b-block-7> ^object-handle block-7 ^position 1)
   (<b-block-8> ^object-handle block-8 ^position 1)
   (<b-block-9> ^object-handle block-9 ^position 1)
-->
   (<t> ^goal-met true)
}
