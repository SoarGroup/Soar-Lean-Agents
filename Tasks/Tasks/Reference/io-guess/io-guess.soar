## io-guess: the smallest environment-coupled agent under the standard conventions (reference agent).
## The environment holds a secret number from 1 to 100. Each turn the agent issues one command
## ^io.output-link.guess.value <n>; the environment answers on the input link with ^feedback higher|lower|correct,
## the next ^turn, marks the command ^status complete, and sets ^game-over true when the number is found.
## What this agent demonstrates (rule names say which convention):
##   input   copied to the state by elaborations, as constants (IO-003, IO-005, IO-006, IO-008)
##   output  created by an operator application, one command, parameters under its identifier (IO-010, IO-012, IO-013)
##   cleanup removed by an operator application once the environment marks it ^status complete (IO-014, IO-017)
##   turns   one command per environment turn; the next command waits for the environment's next ^turn
##   halt    on the environment's ^game-over signal, not on a goal of the agent

## ---- initialization ----
sp {io-guess*propose*initialize
   (state <s> ^superstate nil
             -^name)
-->
   (<s> ^operator <o> + =)
   (<o> ^name initialize-io-guess)}

sp {io-guess*apply*initialize
   (state <s> ^operator <o>)
   (<o> ^name initialize-io-guess)
-->
   (<s> ^name io-guess ^lo 1 ^hi 100)}

## ---- interpreting the input: the state gets the environment's structure as constants ----
sp {io-guess*elaborate*state*turn
   (state <s> ^name io-guess
              ^io.input-link.turn <t>)
-->
   (<s> ^turn <t>)}

sp {io-guess*elaborate*state*feedback
   (state <s> ^name io-guess
              ^io.input-link.feedback <f>)
-->
   (<s> ^feedback <f>)}

sp {io-guess*elaborate*state*game-over
   (state <s> ^name io-guess
              ^io.input-link.game-over true)
-->
   (<s> ^game-over true)}

## The feedback of the first turn is "start"; later, the bounds must have been updated for this turn.
sp {io-guess*elaborate*state*ready*start
   (state <s> ^name io-guess
              ^feedback start)
-->
   (<s> ^ready true)}

sp {io-guess*elaborate*state*ready*updated
   (state <s> ^name io-guess
              ^turn <t>
              ^bounds-turn <t>)
-->
   (<s> ^ready true)}

## ---- update the bounds from the feedback on the last guess (once per turn) ----
sp {io-guess*propose*update-bounds
   (state <s> ^name io-guess
              ^turn <t>
              ^last-guess-turn { <> <t> <lg> }
              ^feedback { << higher lower >> <f> }
             -^bounds-turn <t>
             -^game-over true)
-->
   (<s> ^operator <o> + =)
   (<o> ^name update-bounds ^feedback <f>)}

sp {io-guess*apply*update-bounds*higher
   (state <s> ^operator <o>
              ^turn <t>
              ^last-guess <g>
              ^lo <lo>)
   (<o> ^name update-bounds ^feedback higher)
-->
   (<s> ^lo <lo> - (+ <g> 1)
        ^bounds-turn <t>)}

sp {io-guess*apply*update-bounds*lower
   (state <s> ^operator <o>
              ^turn <t>
              ^last-guess <g>
              ^hi <hi>)
   (<o> ^name update-bounds ^feedback lower)
-->
   (<s> ^hi <hi> - (- <g> 1)
        ^bounds-turn <t>)}

## ---- guess: one command per turn; the value is the middle of what is still possible ----
sp {io-guess*propose*guess
   (state <s> ^name io-guess
              ^ready true
              ^turn <t>
              ^lo <lo>
              ^hi <hi>
             -^last-guess-turn <t>
             -^game-over true)
-->
   (<s> ^operator <o> + =)
   (<o> ^name guess ^value (div (+ <lo> <hi>) 2))}

sp {io-guess*apply*guess*command
   (state <s> ^operator <o>
              ^io.output-link <out>)
   (<o> ^name guess ^value <v>)
-->
   (<out> ^guess <c>)
   (<c> ^value <v>)}

sp {io-guess*apply*guess*remember
   (state <s> ^operator <o>
              ^turn <t>
              ^last-guess <old>)
   (<o> ^name guess ^value <v>)
-->
   (<s> ^last-guess <v> <old> -
        ^last-guess-turn <t>)}

sp {io-guess*apply*guess*remember*first
   (state <s> ^operator <o>
              ^turn <t>
             -^last-guess)
   (<o> ^name guess ^value <v>)
-->
   (<s> ^last-guess <v>
        ^last-guess-turn <t>)}

sp {io-guess*apply*guess*remember*turn
   (state <s> ^operator <o>
              ^turn <t>
              ^last-guess-turn { <> <t> <old> })
   (<o> ^name guess)
-->
   (<s> ^last-guess-turn <t> <old> -)}

## ---- remove the command once the environment has finished with it (IO-014) ----
sp {io-guess*propose*remove-command
   (state <s> ^name io-guess
              ^io.output-link <out>)
   (<out> ^guess <c>)
   (<c> ^status complete)
-->
   (<s> ^operator <o> + =)
   (<o> ^name remove-command ^command <c>)}

sp {io-guess*apply*remove-command
   (state <s> ^operator <o>
              ^io.output-link <out>)
   (<o> ^name remove-command ^command <c>)
   (<out> ^guess <c>)
-->
   (<out> ^guess <c> -)}

## ---- stop on the environment's signal ----
sp {io-guess*propose*stop
   (state <s> ^name io-guess
              ^game-over true)
-->
   (<s> ^operator <o> + >)
   (<o> ^name stop)}

sp {io-guess*apply*stop
   (state <s> ^operator <o>)
   (<o> ^name stop)
-->
   (write (crlf) |The environment ended the game.|)
   (halt)}
