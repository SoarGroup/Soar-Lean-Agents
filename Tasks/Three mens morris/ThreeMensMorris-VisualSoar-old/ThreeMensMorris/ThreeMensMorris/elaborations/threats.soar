# A player who can complete a line with one placement or one move.

sp {morris*elaborate*threat*place*east*1
(state <s> ^name three-mens-morris ^placing <p>)
    (<s> ^occ <o1>)
    (<o1> ^pos <c1> ^owner empty)
    (<c1> ^east <c2>)
    (<s> ^occ <o2>)
    (<o2> ^pos <c2> ^owner <p>)
    (<c2> ^east <c3>)
    (<s> ^occ <o3>)
    (<o3> ^pos <c3> ^owner <p>)
    -->
    (<s> ^threat <p> +)
}

sp {morris*elaborate*threat*move*east*1
(state <s> ^name three-mens-morris ^moving <p>)
    (<s> ^occ <o1>)
    (<o1> ^pos <c1> ^owner empty)
    (<c1> ^east <c2>)
    (<s> ^occ <o2>)
    (<o2> ^pos <c2> ^owner <p>)
    (<c2> ^east <c3>)
    (<s> ^occ <o3>)
    (<o3> ^pos <c3> ^owner <p>)
    (<c1> ^adj <cz>)
    (<s> ^occ <oz>)
    (<oz> ^pos { <> <c2> <> <c3> <cz> } ^owner <p>)
    -->
    (<s> ^threat <p> +)
}

