sp {morris*evaluate*win
(state <s> ^name three-mens-morris ^quiescence t ^turn <q> ^desired <d> ^look-ahead-operator <lo> ^player <pl>)
    (<lo> ^player <p>)
    (<pl> ^name <p> ^opponent <q>)
    (<s> ^winner <p>)
    -->
    (<s> ^numeric-value 100 +)
}

sp {morris*evaluate*lose
(state <s> ^name three-mens-morris ^quiescence t ^turn <q> ^desired <d> ^look-ahead-operator <lo> ^player <pl>)
    (<lo> ^player <p>)
    (<pl> ^name <p> ^opponent <q>)
    (<s> ^winner <q>)
    -->
    (<s> ^numeric-value -100 +)
}

sp {morris*evaluate*opponent-threat
(state <s> ^name three-mens-morris ^quiescence t ^turn <q> ^desired <d> ^look-ahead-operator <lo> ^player <pl>)
    (<lo> ^player <p>)
    (<pl> ^name <p> ^opponent <q>)
    (<s> ^threat <q> -^winner <w>)
    -->
    (<s> ^numeric-value -100 +)
}

sp {morris*evaluate*centre
(state <s> ^name three-mens-morris ^quiescence t ^turn <q> ^desired <d> ^look-ahead-operator <lo> ^player <pl>)
    (<lo> ^player <p>)
    (<pl> ^name <p> ^opponent <q>)
    (<s> ^stage2 yes -^winner <w> -^threat <q> ^occ <oc>)
    (<oc> ^pos <cc> ^owner <p>)
    (<cc> ^centre yes)
    -->
    (<s> ^numeric-value 2 +)
}

sp {morris*evaluate*other
(state <s> ^name three-mens-morris ^quiescence t ^turn <q> ^desired <d> ^look-ahead-operator <lo> ^player <pl>)
    (<lo> ^player <p>)
    (<pl> ^name <p> ^opponent <q>)
    (<s> ^stage2 yes -^winner <w> -^threat <q>)
   -{ (<s> ^occ <oc>)
      (<oc> ^pos <cc> ^owner <p>)
      (<cc> ^centre yes) }
    -->
    (<s> ^numeric-value 0 +)
}

sp {morris*monitor*place
    (state <s> ^superstate nil ^name three-mens-morris ^operator <op>)
    (<op> ^name place ^player <p> ^occ <o>)
    (<o> ^pos <c>)
    (<c> ^id <n>)
    -->
    (write (crlf) <p> | places | <n>)
}

sp {morris*monitor*move
    (state <s> ^superstate nil ^name three-mens-morris ^operator <op>)
    (<op> ^name move ^player <p> ^from <o1> ^to <o2>)
    (<o1> ^pos <c1>)
    (<c1> ^id <a>)
    (<o2> ^pos <c2>)
    (<c2> ^id <b>)
    -->
    (write (crlf) <p> | moves | <a> | -> | <b>)
}

sp {morris*propose*finish
    (state <s> ^superstate nil ^name three-mens-morris)
    (<s> ^{ << winner draw >> <k> } <w>)
    -->
    (<s> ^operator <o> +)
    (<o> ^name finish + ^kind <k> + ^what <w> +)
}

sp {morris*apply*finish*winner
    (state <s> ^superstate nil ^operator <o>)
    (<o> ^name finish ^kind winner ^what <w>)
    -->
    (write (crlf) |WINNER: | <w>)
    (halt)
}

sp {morris*apply*finish*draw
    (state <s> ^superstate nil ^operator <o>)
    (<o> ^name finish ^kind draw)
    -->
    (write (crlf) |DRAW|)
    (halt)
}
