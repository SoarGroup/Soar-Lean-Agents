## Propose initialize-pddl-blocksworld-3ops when its conditions below hold.
sp {pddl-blocksworld-3ops*propose*initialize-pddl-blocksworld-3ops
   (state <s> ^superstate nil ^world <w> -^name)
-->
   (<s> ^operator <o> + >)
   (<o> ^name initialize-pddl-blocksworld-3ops ^task-operator false)
}

sp {pddl-blocksworld-3ops*apply*initialize-pddl-blocksworld-3ops
   (state <s> ^operator.name initialize-pddl-blocksworld-3ops ^world <w>)
   (<w> ^objects <objs>)
-->
   (<s> ^name pddl-blocksworld-3ops ^desireds <ds>)
   (<objs> ^object <k-a> <k-b> <k-c> <k-d> <k-e> <k-task>)
   (<k-a> ^object-handle a ^anchored true ^type object ^name a)
   (<k-b> ^object-handle b ^anchored true ^type object ^name b)
   (<k-c> ^object-handle c ^anchored true ^type object ^name c)
   (<k-d> ^object-handle d ^anchored true ^type object ^name d)
   (<k-e> ^object-handle e ^anchored true ^type object ^name e)
   (<k-task> ^object-handle task ^anchored true ^type task)
   (<ds> ^desired-count 1 ^desired <d1>)
   (<d1> ^object <d1-o>)
   (<d1-o> ^object-handle task ^goal-met true)
   (<w> ^clear <rel-1>)
   (<rel-1> ^argument1 <k-b>)
   (<w> ^clear <rel-2>)
   (<rel-2> ^argument1 <k-e>)
   (<w> ^on <rel-3>)
   (<rel-3> ^argument1 <k-b> ^argument2 <k-a>)
   (<w> ^on <rel-4>)
   (<rel-4> ^argument1 <k-d> ^argument2 <k-c>)
   (<w> ^on <rel-5>)
   (<rel-5> ^argument1 <k-e> ^argument2 <k-d>)
   (<w> ^on-table <rel-6>)
   (<rel-6> ^argument1 <k-a>)
   (<w> ^on-table <rel-7>)
   (<rel-7> ^argument1 <k-c>)
   (log 1 (crlf) |Initialize pddl-blocksworld-3ops.|)
}

## Elaborate problem space: adds ^copy-relation, ^dont-copy-object-attribute, ^problem-space.
sp {pddl-blocksworld-3ops*elaborate*problem-space
   (state <s> ^name pddl-blocksworld-3ops)
-->
   (<s> ^problem-space <p>)
   (<p> ^name pddl-blocksworld-3ops ^copy-relation clear ^copy-relation on-table ^dont-copy-object-attribute goal-met)
}

sp {pddl-blocksworld-3ops*elaborate*problem-space*mea-substate
   (state <s> ^impasse no-change ^attribute operator ^superstate <ss>)
   (<ss> ^problem-space.name pddl-blocksworld-3ops ^operator <so>)
   (<so> ^task-operator true -^pre-conditions-satisfied true)
-->
   (<s> ^problem-space <p>)
   (<p> ^name pddl-blocksworld-3ops ^dont-copy-object-attribute goal-met)
}

## Elaborate flags: adds ^flag-override, ^mea-operator-selection.
sp {pddl-blocksworld-3ops*elaborate*flags
   (state <s> ^superstate nil ^name pddl-blocksworld-3ops)
-->
