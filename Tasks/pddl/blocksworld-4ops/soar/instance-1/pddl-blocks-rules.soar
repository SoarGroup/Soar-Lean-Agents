## Assumption ledger:


## Propose initialize-pddl-blocks when its conditions below hold.
sp {pddl-blocks*propose*initialize-pddl-blocks
   (state <s> ^superstate nil ^world <w> -^name)
-->
   (<s> ^operator <o> + >)
   (<o> ^name initialize-pddl-blocks ^task-operator false)
}

sp {pddl-blocks*apply*initialize-pddl-blocks
   (state <s> ^operator.name initialize-pddl-blocks ^world <w>)
   (<w> ^objects <objs>)
-->
   (<s> ^name pddl-blocks ^desireds <ds>)
   (<objs> ^object <k-d> <k-b> <k-a> <k-c> <k-hand> <k-task>)
   (<k-d> ^object-handle d ^anchored true ^type object ^name d)
   (<k-b> ^object-handle b ^anchored true ^type object ^name b)
   (<k-a> ^object-handle a ^anchored true ^type object ^name a)
   (<k-c> ^object-handle c ^anchored true ^type object ^name c)
   (<k-hand> ^object-handle hand ^anchored true ^type hand ^name hand ^empty true)
   (<k-task> ^object-handle task ^anchored true ^type task)
   (<ds> ^desired-count 1 ^desired <d1>)
   (<d1> ^object <d1-o>)
   (<d1-o> ^object-handle task ^goal-met true)
   (<w> ^clear <rel-1>)
   (<rel-1> ^argument1 <k-c>)
   (<w> ^clear <rel-2>)
   (<rel-2> ^argument1 <k-a>)
   (<w> ^clear <rel-3>)
   (<rel-3> ^argument1 <k-b>)
   (<w> ^clear <rel-4>)
   (<rel-4> ^argument1 <k-d>)
   (<w> ^ontable <rel-5>)
   (<rel-5> ^argument1 <k-c>)
   (<w> ^ontable <rel-6>)
   (<rel-6> ^argument1 <k-a>)
   (<w> ^ontable <rel-7>)
   (<rel-7> ^argument1 <k-b>)
   (<w> ^ontable <rel-8>)
   (<rel-8> ^argument1 <k-d>)
   (log 1 (crlf) |Initialize pddl-blocks.|)
}

## Elaborate problem space: adds ^copy-relation, ^dont-copy-object-attribute, ^problem-space.
sp {pddl-blocks*elaborate*problem-space
   (state <s> ^name pddl-blocks)
-->
   (<s> ^problem-space <p>)
   (<p> ^name pddl-blocks ^copy-relation clear ^copy-relation ontable ^copy-relation holding ^dont-copy-object-attribute goal-met)
}

sp {pddl-blocks*elaborate*problem-space*mea-substate
   (state <s> ^impasse no-change ^attribute operator ^superstate <ss>)
   (<ss> ^problem-space.name pddl-blocks ^operator <so>)
   (<so> ^task-operator true -^pre-conditions-satisfied true)
-->
   (<s> ^problem-space <p>)
   (<p> ^name pddl-blocks ^dont-copy-object-attribute goal-met)
}

## Elaborate flags: adds ^flag-override, ^mea-operator-selection.
sp {pddl-blocks*elaborate*flags
   (state <s> ^superstate nil ^name pddl-blocks)
-->
   (<s> ^flag-override <f>)
   (<f> ^mea-operator-selection true)
}

## Achievement of object-property desireds (supplied by the task).
sp {pddl-blocks*elaborate*state*achieved*object-property
   (state <s> ^problem-space.name pddl-blocks ^desireds <ds> ^world <w>)
   (<ds> ^desired <d>)
   (<d> ^object <do>)
   (<do> ^object-handle <h> ^{ <> object-handle <a> } <v>)
   (<w> ^anchored-world true ^objects.object <ob>)
   (<ob> ^object-handle <h> ^<a> <v>)
-->
   (<ds> ^achieved <d>)
}

sp {pddl-blocks*elaborate*state*unachieved*object-property
   (state <s> ^problem-space.name pddl-blocks ^desireds <ds> ^world <w>)
   (<ds> ^desired <d>)
   (<d> ^object <do>)
   (<do> ^object-handle <h> ^{ <> object-handle <a> } <v>)
   (<w> ^anchored-world true)
  -{(<w> ^objects.object <ob>)
    (<ob> ^object-handle <h> ^<a> <v>)}
-->
   (<ds> ^unachieved <d>)
}

## Operator pick-up (statement 1).
sp {pddl-blocks*propose*pick-up
   (state <s> ^problem-space.name pddl-blocks ^flags.mea-operator-selection true ^world <w> ^desireds <ds>)
   (<w> ^anchored-world true ^objects <objs>)
   (<objs> ^object <x>)
   (<x> ^type object)
   (<w> ^clear <r1>)
   (<r1> ^argument1 <x>)
   (<w> ^ontable <r2>)
   (<r2> ^argument1 <x>)
   (<objs> ^object <nhand>)
   (<nhand> ^type hand)
   (<nhand> ^empty true)
   (<ds> ^unachieved-desireds true)
-->
   (<s> ^operator <op> +)
   (<op> ^name pick-up ^task-operator true ^action-handle pick-up ^argument1 <x> ^argument-count 1 ^desireds <pre>)
   (<pre> ^desired-count 0)
}

## Effect of pick-up (look-ahead).
