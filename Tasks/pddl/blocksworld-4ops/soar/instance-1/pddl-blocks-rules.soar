   (state <s> ^problem-space.name pddl-blocks ^operator <op> ^internal-actions true ^world <w>)
   (<op> ^task-operator true ^name pick-up ^pre-conditions-satisfied true ^argument1.object-handle $ <x-h>)
   (<w> ^anchored-world true ^objects <objs>)
   (<objs> ^object <x>)
   (<x> ^object-handle $ <x-h>)
   (<objs> ^object <nhand>)
   (<nhand> ^type hand)
   (<w> ^ontable <e1>)
   (<e1> ^argument1 <x>)
   (<w> ^clear <e2>)
   (<e2> ^argument1 <x>)
   (<nhand> ^empty <nhand-empty>)
-->
   (<w> ^ontable <e1> -)
   (<w> ^clear <e2> -)
   (<w> ^holding <new-3>)
   (<new-3> ^argument1 <x>)
   (<nhand> ^empty <nhand-empty> - false)
}

