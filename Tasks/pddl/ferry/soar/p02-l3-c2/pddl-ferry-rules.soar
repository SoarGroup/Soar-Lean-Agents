## Propose initialize-pddl-ferry when its conditions below hold.
sp {pddl-ferry*propose*initialize-pddl-ferry
   (state <s> ^superstate nil ^world <w> -^name)
-->
   (<s> ^operator <o> + >)
   (<o> ^name initialize-pddl-ferry ^task-operator false)
}

sp {pddl-ferry*apply*initialize-pddl-ferry
   (state <s> ^operator.name initialize-pddl-ferry ^world <w>)
   (<w> ^objects <objs>)
-->
   (<s> ^name pddl-ferry ^desireds <ds>)
   (<objs> ^object <k-l-0> <k-l-1> <k-l-2> <k-c-0> <k-c-1> <k-ferry> <k-task>)
   (<k-l-0> ^object-handle l-0 ^anchored true ^type object ^name l-0)
   (<k-l-1> ^object-handle l-1 ^anchored true ^type object ^name l-1)
   (<k-l-2> ^object-handle l-2 ^anchored true ^type object ^name l-2)
   (<k-c-0> ^object-handle c-0 ^anchored true ^type object ^name c-0)
   (<k-c-1> ^object-handle c-1 ^anchored true ^type object ^name c-1)
   (<k-ferry> ^object-handle ferry ^anchored true ^type ferry ^name ferry ^empty true)
   (<k-task> ^object-handle task ^anchored true ^type task)
   (<ds> ^desired-count 1 ^desired <d1>)
   (<d1> ^object <d1-o>)
   (<d1-o> ^object-handle task ^goal-met true)
   (<w> ^at <rel-1>)
   (<rel-1> ^argument1 <k-c-0> ^argument2 <k-l-1>)
   (<w> ^at <rel-2>)
   (<rel-2> ^argument1 <k-c-1> ^argument2 <k-l-2>)
   (<w> ^at-ferry <rel-3>)
   (<rel-3> ^argument1 <k-l-0>)
   (<w> ^car <rel-4>)
   (<rel-4> ^argument1 <k-c-0>)
   (<w> ^car <rel-5>)
   (<rel-5> ^argument1 <k-c-1>)
   (<w> ^location <rel-6>)
   (<rel-6> ^argument1 <k-l-0>)
   (<w> ^location <rel-7>)
   (<rel-7> ^argument1 <k-l-1>)
   (<w> ^location <rel-8>)
   (<rel-8> ^argument1 <k-l-2>)
   (<w> ^not-eq <rel-9>)
   (<rel-9> ^argument1 <k-l-0> ^argument2 <k-l-1>)
   (<w> ^not-eq <rel-10>)
   (<rel-10> ^argument1 <k-l-0> ^argument2 <k-l-2>)
   (<w> ^not-eq <rel-11>)
   (<rel-11> ^argument1 <k-l-1> ^argument2 <k-l-0>)
   (<w> ^not-eq <rel-12>)
   (<rel-12> ^argument1 <k-l-1> ^argument2 <k-l-2>)
   (<w> ^not-eq <rel-13>)
   (<rel-13> ^argument1 <k-l-2> ^argument2 <k-l-0>)
   (<w> ^not-eq <rel-14>)
   (<rel-14> ^argument1 <k-l-2> ^argument2 <k-l-1>)
   (log 1 (crlf) |Initialize pddl-ferry.|)
}

## Elaborate problem space: adds ^copy-relation, ^dont-copy-object-attribute, ^problem-space.
sp {pddl-ferry*elaborate*problem-space
   (state <s> ^name pddl-ferry)
-->
   (<s> ^problem-space <p>)
   (<p> ^name pddl-ferry ^copy-relation at ^copy-relation at-ferry ^copy-relation car ^copy-relation location ^copy-relation not-eq ^dont-copy-object-attribute goal-met)
}

sp {pddl-ferry*elaborate*problem-space*mea-substate
   (state <s> ^impasse no-change ^attribute operator ^superstate <ss>)
   (<ss> ^problem-space.name pddl-ferry ^operator <so>)
   (<so> ^task-operator true -^pre-conditions-satisfied true)
-->
   (<s> ^problem-space <p>)
   (<p> ^name pddl-ferry ^dont-copy-object-attribute goal-met)
}

## Elaborate flags: adds ^flag-override, ^mea-operator-selection.
sp {pddl-ferry*elaborate*flags
   (state <s> ^superstate nil ^name pddl-ferry)
-->
   (<s> ^flag-override <f>)
   (<f> ^mea-operator-selection true)
}

