## Effect of sail (look-ahead).
sp {pddl-ferry*apply*sail*internal
   (state <s> ^problem-space.name pddl-ferry ^operator <op> ^internal-actions true ^world <w>)
   (<op> ^task-operator true ^name sail ^pre-conditions-satisfied true ^argument1.object-handle $ <from-h> ^argument2.object-handle $ <to-h>)
   (<w> ^anchored-world true ^objects <objs>)
   (<objs> ^object <from>)
   (<from> ^object-handle $ <from-h>)
   (<objs> ^object <to>)
   (<to> ^object-handle $ <to-h>)
   (<w> ^at-ferry <e1>)
   (<e1> ^argument1 <from>)
-->
   (<w> ^at-ferry <e1> -)
   (<w> ^at-ferry <new-2>)
   (<new-2> ^argument1 <to>)
}

