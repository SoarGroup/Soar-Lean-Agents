   :o-support
   (state <s> ^problem-space.name pddl-ferry ^superstate nil ^world <w> ^io.output-link.perform-action <pa>)
   (<pa> ^name sail ^status complete ^argument1 <from-h> ^argument2 <to-h> -^effect-applied true)
   (<w> ^anchored-world true ^objects <objs>)
   (<objs> ^object <from>)
   (<from> ^object-handle $ <from-h>)
   (<objs> ^object <to>)
   (<to> ^object-handle $ <to-h>)
   (<w> ^at-ferry <e1>)
   (<e1> ^argument1 <from>)
-->
   (<w> ^at-ferry <e1> -)
   (<w> ^at-ferry <new-2>)
   (<new-2> ^argument1 <to>)
   (<pa> ^effect-applied true)
   (write |sail | <from-h> | | <to-h> (crlf))
}

