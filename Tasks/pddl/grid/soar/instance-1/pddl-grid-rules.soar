   (state <s> ^problem-space.name pddl-grid ^operator <op> ^internal-actions true ^world <w>)
   (<op> ^task-operator true ^name unlock ^pre-conditions-satisfied true ^argument1.object-handle $ <curpos-h> ^argument2.object-handle $ <lockpos-h> ^argument3.object-handle $ <key-h> ^argument4.object-handle $ <shape-h>)
   (<w> ^anchored-world true ^objects <objs>)
