   (<rel-163> ^argument1 <k-node4-1>)
   (<w> ^place <rel-164>)
   (<rel-164> ^argument1 <k-node4-2>)
   (<w> ^place <rel-165>)
   (<rel-165> ^argument1 <k-node4-3>)
   (<w> ^place <rel-166>)
   (<rel-166> ^argument1 <k-node4-4>)
   (<w> ^shape <rel-167>)
   (<rel-167> ^argument1 <k-triangle>)
   (<w> ^shape <rel-168>)
   (<rel-168> ^argument1 <k-diamond>)
   (<w> ^shape <rel-169>)
   (<rel-169> ^argument1 <k-square>)
   (<w> ^shape <rel-170>)
   (<rel-170> ^argument1 <k-circle>)
   (log 1 (crlf) |Initialize pddl-grid.|)
}

## Elaborate problem space: adds ^copy-relation, ^dont-copy-object-attribute, ^problem-space.
sp {pddl-grid*elaborate*problem-space
   (state <s> ^name pddl-grid)
-->
   (<s> ^problem-space <p>)
   (<p> ^name pddl-grid ^copy-relation at ^copy-relation at-robot ^copy-relation conn ^copy-relation key ^copy-relation key-shape ^copy-relation lock-shape ^copy-relation locked ^copy-relation open ^copy-relation place ^copy-relation shape ^copy-relation holding ^dont-copy-object-attribute goal-met)
}

sp {pddl-grid*elaborate*problem-space*mea-substate
   (state <s> ^impasse no-change ^attribute operator ^superstate <ss>)
   (<ss> ^problem-space.name pddl-grid ^operator <so>)
   (<so> ^task-operator true -^pre-conditions-satisfied true)
-->
   (<s> ^problem-space <p>)
   (<p> ^name pddl-grid ^dont-copy-object-attribute goal-met)
}

## Elaborate flags: adds ^flag-override, ^mea-operator-selection.
sp {pddl-grid*elaborate*flags
   (state <s> ^superstate nil ^name pddl-grid)
-->
   (<s> ^flag-override <f>)
   (<f> ^mea-operator-selection true)
}

## Achievement of object-property desireds (supplied by the task).
sp {pddl-grid*elaborate*state*achieved*object-property
   (state <s> ^problem-space.name pddl-grid ^desireds <ds> ^world <w>)
   (<ds> ^desired <d>)
   (<d> ^object <do>)
   (<do> ^object-handle <h> ^{ <> object-handle <a> } <v>)
   (<w> ^anchored-world true ^objects.object <ob>)
   (<ob> ^object-handle <h> ^<a> <v>)
-->
   (<ds> ^achieved <d>)
}

sp {pddl-grid*elaborate*state*unachieved*object-property
   (state <s> ^problem-space.name pddl-grid ^desireds <ds> ^world <w>)
   (<ds> ^desired <d>)
   (<d> ^object <do>)
   (<do> ^object-handle <h> ^{ <> object-handle <a> } <v>)
   (<w> ^anchored-world true)
  -{(<w> ^objects.object <ob>)
    (<ob> ^object-handle <h> ^<a> <v>)}
-->
   (<ds> ^unachieved <d>)
}

## Operator unlock (statement 1).
sp {pddl-grid*propose*unlock
   (state <s> ^problem-space.name pddl-grid ^flags.mea-operator-selection true ^world <w> ^desireds <ds>)
   (<w> ^anchored-world true ^objects <objs>)
   (<objs> ^object <curpos>)
   (<curpos> ^type object)
   (<objs> ^object <lockpos>)
   (<lockpos> ^type object)
   (<objs> ^object <key>)
   (<key> ^type object)
   (<objs> ^object <shape>)
   (<shape> ^type object)
   (<w> ^place <r1>)
   (<r1> ^argument1 <curpos>)
   (<w> ^place <r2>)
   (<r2> ^argument1 <lockpos>)
   (<w> ^key <r3>)
   (<r3> ^argument1 <key>)
   (<w> ^shape <r4>)
   (<r4> ^argument1 <shape>)
   (<w> ^conn <r5>)
   (<r5> ^argument1 <curpos> ^argument2 <lockpos>)
   (<w> ^key-shape <r6>)
   (<r6> ^argument1 <key> ^argument2 <shape>)
   (<w> ^lock-shape <r7>)
   (<r7> ^argument1 <lockpos> ^argument2 <shape>)
   (<w> ^at-robot <r8>)
   (<r8> ^argument1 <curpos>)
   (<w> ^locked <r9>)
   (<r9> ^argument1 <lockpos>)
   (<w> ^holding <r10>)
   (<r10> ^argument1 <key>)
   (<ds> ^unachieved-desireds true)
-->
   (<s> ^operator <op> +)
   (<op> ^name unlock ^task-operator true ^action-handle unlock ^argument1 <curpos> ^argument2 <lockpos> ^argument3 <key> ^argument4 <shape> ^argument-count 4 ^desireds <pre>)
   (<pre> ^desired-count 0)
}

## Effect of unlock (look-ahead).
