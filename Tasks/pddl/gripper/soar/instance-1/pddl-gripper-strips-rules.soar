## Effect of move (look-ahead).
sp {pddl-gripper-strips*apply*move*internal
   (state <s> ^problem-space.name pddl-gripper-strips ^operator <op> ^internal-actions true ^world <w>)
   (<op> ^task-operator true ^name move ^pre-conditions-satisfied true ^argument1.object-handle $ <from-h> ^argument2.object-handle $ <to-h>)
   (<w> ^anchored-world true ^objects <objs>)
