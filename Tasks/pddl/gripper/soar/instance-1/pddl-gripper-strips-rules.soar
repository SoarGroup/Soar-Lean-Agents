## Propose initialize-pddl-gripper-strips when its conditions below hold.
sp {pddl-gripper-strips*propose*initialize-pddl-gripper-strips
   (state <s> ^superstate nil ^world <w> -^name)
-->
   (<s> ^operator <o> + >)
   (<o> ^name initialize-pddl-gripper-strips ^task-operator false)
}

sp {pddl-gripper-strips*apply*initialize-pddl-gripper-strips
   (state <s> ^operator.name initialize-pddl-gripper-strips ^world <w>)
   (<w> ^objects <objs>)
-->
   (<s> ^name pddl-gripper-strips ^desireds <ds>)
   (<objs> ^object <k-rooma> <k-roomb> <k-ball4> <k-ball3> <k-ball2> <k-ball1> <k-left> <k-right> <k-task>)
   (<k-rooma> ^object-handle rooma ^anchored true ^type object ^name rooma)
   (<k-roomb> ^object-handle roomb ^anchored true ^type object ^name roomb)
   (<k-ball4> ^object-handle ball4 ^anchored true ^type object ^name ball4)
   (<k-ball3> ^object-handle ball3 ^anchored true ^type object ^name ball3)
   (<k-ball2> ^object-handle ball2 ^anchored true ^type object ^name ball2)
   (<k-ball1> ^object-handle ball1 ^anchored true ^type object ^name ball1)
   (<k-left> ^object-handle left ^anchored true ^type object ^name left)
   (<k-right> ^object-handle right ^anchored true ^type object ^name right)
   (<k-task> ^object-handle task ^anchored true ^type task)
   (<ds> ^desired-count 1 ^desired <d1>)
   (<d1> ^object <d1-o>)
   (<d1-o> ^object-handle task ^goal-met true)
   (<w> ^at <rel-1>)
   (<rel-1> ^argument1 <k-ball4> ^argument2 <k-rooma>)
   (<w> ^at <rel-2>)
   (<rel-2> ^argument1 <k-ball3> ^argument2 <k-rooma>)
   (<w> ^at <rel-3>)
   (<rel-3> ^argument1 <k-ball2> ^argument2 <k-rooma>)
   (<w> ^at <rel-4>)
   (<rel-4> ^argument1 <k-ball1> ^argument2 <k-rooma>)
   (<w> ^at-robby <rel-5>)
   (<rel-5> ^argument1 <k-rooma>)
   (<w> ^ball <rel-6>)
   (<rel-6> ^argument1 <k-ball4>)
   (<w> ^ball <rel-7>)
   (<rel-7> ^argument1 <k-ball3>)
   (<w> ^ball <rel-8>)
   (<rel-8> ^argument1 <k-ball2>)
   (<w> ^ball <rel-9>)
   (<rel-9> ^argument1 <k-ball1>)
   (<w> ^free <rel-10>)
   (<rel-10> ^argument1 <k-left>)
   (<w> ^free <rel-11>)
   (<rel-11> ^argument1 <k-right>)
   (<w> ^gripper <rel-12>)
   (<rel-12> ^argument1 <k-left>)
   (<w> ^gripper <rel-13>)
   (<rel-13> ^argument1 <k-right>)
   (<w> ^room <rel-14>)
   (<rel-14> ^argument1 <k-rooma>)
   (<w> ^room <rel-15>)
   (<rel-15> ^argument1 <k-roomb>)
   (log 1 (crlf) |Initialize pddl-gripper-strips.|)
}

## Elaborate problem space: adds ^copy-relation, ^dont-copy-object-attribute, ^problem-space.
sp {pddl-gripper-strips*elaborate*problem-space
   (state <s> ^name pddl-gripper-strips)
-->
   (<s> ^problem-space <p>)
   (<p> ^name pddl-gripper-strips ^copy-relation at ^copy-relation at-robby ^copy-relation ball ^copy-relation free ^copy-relation gripper ^copy-relation room ^copy-relation carry ^dont-copy-object-attribute goal-met)
}

sp {pddl-gripper-strips*elaborate*problem-space*mea-substate
   (state <s> ^impasse no-change ^attribute operator ^superstate <ss>)
   (<ss> ^problem-space.name pddl-gripper-strips ^operator <so>)
   (<so> ^task-operator true -^pre-conditions-satisfied true)
-->
   (<s> ^problem-space <p>)
   (<p> ^name pddl-gripper-strips ^dont-copy-object-attribute goal-met)
}

## Elaborate flags: adds ^flag-override, ^mea-operator-selection.
sp {pddl-gripper-strips*elaborate*flags
   (state <s> ^superstate nil ^name pddl-gripper-strips)
-->
   (<s> ^flag-override <f>)
   (<f> ^mea-operator-selection true)
}

