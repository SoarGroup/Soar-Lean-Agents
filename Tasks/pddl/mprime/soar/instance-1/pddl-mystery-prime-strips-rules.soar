   :o-support
   (state <s> ^problem-space.name pddl-mystery-prime-strips ^superstate nil ^world <w> ^io.output-link.perform-action <pa>)
   (<pa> ^name overcome ^status complete ^argument1 <c-h> ^argument2 <v-h> ^argument3 <n-h> ^argument4 <s1-h> ^argument5 <s2-h> -^effect-applied true)
   (<w> ^anchored-world true ^objects <objs>)
   (<objs> ^object <c>)
   (<c> ^object-handle $ <c-h>)
   (<objs> ^object <v>)
   (<v> ^object-handle $ <v-h>)
   (<objs> ^object <n>)
   (<n> ^object-handle $ <n-h>)
   (<objs> ^object <s1>)
   (<s1> ^object-handle $ <s1-h>)
   (<objs> ^object <s2>)
   (<s2> ^object-handle $ <s2-h>)
   (<w> ^craves <e1>)
   (<e1> ^argument1 <c> ^argument2 <n>)
   (<w> ^harmony <e2>)
   (<e2> ^argument1 <v> ^argument2 <s2>)
-->
   (<w> ^craves <e1> -)
   (<w> ^harmony <e2> -)
   (<w> ^fears <new-3>)
   (<new-3> ^argument1 <c> ^argument2 <v>)
   (<w> ^harmony <new-4>)
   (<new-4> ^argument1 <v> ^argument2 <s1>)
   (<pa> ^effect-applied true)
   (write |overcome | <c-h> | | <v-h> | | <n-h> | | <s1-h> | | <s2-h> (crlf))
}

