## Effect of overcome (look-ahead).
sp {pddl-mystery-prime-strips*apply*overcome*internal
   (state <s> ^problem-space.name pddl-mystery-prime-strips ^operator <op> ^internal-actions true ^world <w>)
   (<op> ^task-operator true ^name overcome ^pre-conditions-satisfied true ^argument1.object-handle $ <c-h> ^argument2.object-handle $ <v-h> ^argument3.object-handle $ <n-h> ^argument4.object-handle $ <s1-h> ^argument5.object-handle $ <s2-h>)
   (<w> ^anchored-world true ^objects <objs>)
   (<objs> ^object <c>)
   (<c> ^object-handle $ <c-h>)
   (<objs> ^object <v>)
   (<v> ^object-handle $ <v-h>)
   (<objs> ^object <n>)
   (<n> ^object-handle $ <n-h>)
   (<objs> ^object <s1>)
   (<s1> ^object-handle $ <s1-h>)
   (<objs> ^object <s2>)
   (<s2> ^object-handle $ <s2-h>)
   (<w> ^craves <e1>)
   (<e1> ^argument1 <c> ^argument2 <n>)
   (<w> ^harmony <e2>)
   (<e2> ^argument1 <v> ^argument2 <s2>)
-->
   (<w> ^craves <e1> -)
   (<w> ^harmony <e2> -)
   (<w> ^fears <new-3>)
   (<new-3> ^argument1 <c> ^argument2 <v>)
   (<w> ^harmony <new-4>)
   (<new-4> ^argument1 <v> ^argument2 <s1>)
}

## Effect of a completed overcome command on the real world (once per command).
