## Goal (statement 5): ^goal-met true on the task object.
sp {pddl-mystery-prime-strips*elaborate*goal
   (state <s> ^problem-space.name pddl-mystery-prime-strips ^world <w>)
   (<w> ^anchored-world true ^objects <objs>)
   (<objs> ^object <task>)
   (<task> ^type task)
   (<objs> ^object <k-abrasion>)
   (<k-abrasion> ^object-handle abrasion)
   (<objs> ^object <k-rice>)
   (<k-rice> ^object-handle rice)
   (<w> ^craves <r1>)
   (<r1> ^argument1 <k-abrasion> ^argument2 <k-rice>)
-->
   (<task> ^goal-met true)
}
