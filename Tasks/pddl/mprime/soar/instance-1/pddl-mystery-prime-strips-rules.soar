## Elaborate problem space: adds ^copy-relation, ^dont-copy-object-attribute, ^problem-space.
sp {pddl-mystery-prime-strips*elaborate*problem-space
   (state <s> ^name pddl-mystery-prime-strips)
-->
   (<s> ^problem-space <p>)
   (<p> ^name pddl-mystery-prime-strips ^copy-relation attacks ^copy-relation craves ^copy-relation eats ^copy-relation food ^copy-relation harmony ^copy-relation locale ^copy-relation orbits ^copy-relation pain ^copy-relation planet ^copy-relation pleasure ^copy-relation province ^copy-relation fears ^dont-copy-object-attribute goal-met)
}

sp {pddl-mystery-prime-strips*elaborate*problem-space*mea-substate
   (state <s> ^impasse no-change ^attribute operator ^superstate <ss>)
   (<ss> ^problem-space.name pddl-mystery-prime-strips ^operator <so>)
   (<so> ^task-operator true -^pre-conditions-satisfied true)
-->
   (<s> ^problem-space <p>)
   (<p> ^name pddl-mystery-prime-strips ^dont-copy-object-attribute goal-met)
}

## Elaborate flags: adds ^flag-override, ^mea-operator-selection.
sp {pddl-mystery-prime-strips*elaborate*flags
   (state <s> ^superstate nil ^name pddl-mystery-prime-strips)
-->
   (<s> ^flag-override <f>)
   (<f> ^mea-operator-selection true)
}

## Achievement of object-property desireds (supplied by the task).
sp {pddl-mystery-prime-strips*elaborate*state*achieved*object-property
   (state <s> ^problem-space.name pddl-mystery-prime-strips ^desireds <ds> ^world <w>)
   (<ds> ^desired <d>)
   (<d> ^object <do>)
   (<do> ^object-handle <h> ^{ <> object-handle <a> } <v>)
   (<w> ^anchored-world true ^objects.object <ob>)
   (<ob> ^object-handle <h> ^<a> <v>)
-->
   (<ds> ^achieved <d>)
}

sp {pddl-mystery-prime-strips*elaborate*state*unachieved*object-property
   (state <s> ^problem-space.name pddl-mystery-prime-strips ^desireds <ds> ^world <w>)
   (<ds> ^desired <d>)
   (<d> ^object <do>)
   (<do> ^object-handle <h> ^{ <> object-handle <a> } <v>)
   (<w> ^anchored-world true)
  -{(<w> ^objects.object <ob>)
    (<ob> ^object-handle <h> ^<a> <v>)}
-->
   (<ds> ^unachieved <d>)
}

