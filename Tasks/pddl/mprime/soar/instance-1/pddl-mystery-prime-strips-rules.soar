   (<new-4> ^argument1 <v> ^argument2 <s2>)
}

## Effect of a completed succumb command on the real world (once per command).
sp {pddl-mystery-prime-strips*apply*succumb*environment-effect
   :o-support
   (state <s> ^problem-space.name pddl-mystery-prime-strips ^superstate nil ^world <w> ^io.output-link.perform-action <pa>)
   (<pa> ^name succumb ^status complete ^argument1 <c-h> ^argument2 <v-h> ^argument3 <n-h> ^argument4 <s1-h> ^argument5 <s2-h> -^effect-applied true)
   (<w> ^anchored-world true ^objects <objs>)
   (<objs> ^object <c>)
   (<c> ^object-handle $ <c-h>)
   (<objs> ^object <v>)
   (<v> ^object-handle $ <v-h>)
   (<objs> ^object <n>)
   (<n> ^object-handle $ <n-h>)
   (<objs> ^object <s1>)
   (<s1> ^object-handle $ <s1-h>)
   (<objs> ^object <s2>)
   (<s2> ^object-handle $ <s2-h>)
   (<w> ^fears <e1>)
   (<e1> ^argument1 <c> ^argument2 <v>)
   (<w> ^harmony <e2>)
   (<e2> ^argument1 <v> ^argument2 <s1>)
-->
   (<w> ^fears <e1> -)
   (<w> ^harmony <e2> -)
   (<w> ^craves <new-3>)
   (<new-3> ^argument1 <c> ^argument2 <n>)
   (<w> ^harmony <new-4>)
   (<new-4> ^argument1 <v> ^argument2 <s2>)
   (<pa> ^effect-applied true)
   (write |succumb | <c-h> | | <v-h> | | <n-h> | | <s1-h> | | <s2-h> (crlf))
}

