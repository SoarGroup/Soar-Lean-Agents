   (<r4> ^argument1 <v> ^argument2 <n>)
   (<w> ^food <r5>)
   (<r5> ^argument1 <n>)
   (<w> ^harmony <r6>)
   (<r6> ^argument1 <v> ^argument2 <s2>)
   (<w> ^planet <r7>)
   (<r7> ^argument1 <s2>)
