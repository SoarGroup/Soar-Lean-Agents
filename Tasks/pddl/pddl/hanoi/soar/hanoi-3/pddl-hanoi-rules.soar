## hanoi / hanoi3 (PDDL): generated by spec_backend.py (WorldSpec, path B: Lean description, Python rules) from the instructor statements.
##
## Instructor statements used (numbers as in english-input.txt):
##  1. PDDL action move
##  2. PDDL goal of problem hanoi3
##
## Assumption ledger:


## Propose initialize-pddl-hanoi when its conditions below hold.
sp {pddl-hanoi*propose*initialize-pddl-hanoi
   (state <s> ^superstate nil ^world <w> -^name)
-->
   (<s> ^operator <o> + >)
   (<o> ^name initialize-pddl-hanoi ^task-operator false)
}

sp {pddl-hanoi*apply*initialize-pddl-hanoi
   (state <s> ^operator.name initialize-pddl-hanoi ^world <w>)
   (<w> ^objects <objs>)
-->
   (<s> ^name pddl-hanoi ^desireds <ds>)
   (<objs> ^object <k-peg1> <k-peg2> <k-peg3> <k-d-1> <k-d-2> <k-d-3> <k-task>)
   (<k-peg1> ^object-handle peg1 ^anchored true ^type object ^name peg1)
   (<k-peg2> ^object-handle peg2 ^anchored true ^type object ^name peg2)
   (<k-peg3> ^object-handle peg3 ^anchored true ^type object ^name peg3)
   (<k-d-1> ^object-handle d-1 ^anchored true ^type object ^name d-1)
   (<k-d-2> ^object-handle d-2 ^anchored true ^type object ^name d-2)
   (<k-d-3> ^object-handle d-3 ^anchored true ^type object ^name d-3)
   (<k-task> ^object-handle task ^anchored true ^type task)
   (<ds> ^desired-count 1 ^desired <d1>)
   (<d1> ^object <d1-o>)
   (<d1-o> ^object-handle task ^goal-met true)
   (<w> ^clear <rel-1>)
   (<rel-1> ^argument1 <k-peg2>)
   (<w> ^clear <rel-2>)
   (<rel-2> ^argument1 <k-peg3>)
   (<w> ^clear <rel-3>)
   (<rel-3> ^argument1 <k-d-1>)
   (<w> ^on <rel-4>)
   (<rel-4> ^argument1 <k-d-3> ^argument2 <k-peg1>)
   (<w> ^on <rel-5>)
   (<rel-5> ^argument1 <k-d-2> ^argument2 <k-d-3>)
   (<w> ^on <rel-6>)
   (<rel-6> ^argument1 <k-d-1> ^argument2 <k-d-2>)
   (<w> ^smaller <rel-7>)
   (<rel-7> ^argument1 <k-peg1> ^argument2 <k-d-1>)
   (<w> ^smaller <rel-8>)
   (<rel-8> ^argument1 <k-peg1> ^argument2 <k-d-2>)
   (<w> ^smaller <rel-9>)
   (<rel-9> ^argument1 <k-peg1> ^argument2 <k-d-3>)
   (<w> ^smaller <rel-10>)
   (<rel-10> ^argument1 <k-peg2> ^argument2 <k-d-1>)
   (<w> ^smaller <rel-11>)
   (<rel-11> ^argument1 <k-peg2> ^argument2 <k-d-2>)
   (<w> ^smaller <rel-12>)
   (<rel-12> ^argument1 <k-peg2> ^argument2 <k-d-3>)
   (<w> ^smaller <rel-13>)
   (<rel-13> ^argument1 <k-peg3> ^argument2 <k-d-1>)
   (<w> ^smaller <rel-14>)
   (<rel-14> ^argument1 <k-peg3> ^argument2 <k-d-2>)
   (<w> ^smaller <rel-15>)
   (<rel-15> ^argument1 <k-peg3> ^argument2 <k-d-3>)
   (<w> ^smaller <rel-16>)
   (<rel-16> ^argument1 <k-d-2> ^argument2 <k-d-1>)
   (<w> ^smaller <rel-17>)
   (<rel-17> ^argument1 <k-d-3> ^argument2 <k-d-1>)
   (<w> ^smaller <rel-18>)
   (<rel-18> ^argument1 <k-d-3> ^argument2 <k-d-2>)
   (log 1 (crlf) |Initialize pddl-hanoi.|)
}

## Elaborate problem space: adds ^copy-relation, ^dont-copy-object-attribute, ^problem-space.
sp {pddl-hanoi*elaborate*problem-space
   (state <s> ^name pddl-hanoi)
-->
   (<s> ^problem-space <p>)
   (<p> ^name pddl-hanoi ^copy-relation clear ^copy-relation smaller ^dont-copy-object-attribute goal-met)
}

sp {pddl-hanoi*elaborate*problem-space*mea-substate
   (state <s> ^impasse no-change ^attribute operator ^superstate <ss>)
   (<ss> ^problem-space.name pddl-hanoi ^operator <so>)
   (<so> ^task-operator true -^pre-conditions-satisfied true)
-->
   (<s> ^problem-space <p>)
   (<p> ^name pddl-hanoi ^dont-copy-object-attribute goal-met)
}

## Elaborate flags: adds ^flag-override, ^mea-operator-selection.
sp {pddl-hanoi*elaborate*flags
   (state <s> ^superstate nil ^name pddl-hanoi)
-->
   (<s> ^flag-override <f>)
   (<f> ^mea-operator-selection true)
}

## Achievement of object-property desireds (supplied by the task).
sp {pddl-hanoi*elaborate*state*achieved*object-property
   (state <s> ^problem-space.name pddl-hanoi ^desireds <ds> ^world <w>)
   (<ds> ^desired <d>)
   (<d> ^object <do>)
   (<do> ^object-handle <h> ^{ <> object-handle <a> } <v>)
   (<w> ^anchored-world true ^objects.object <ob>)
   (<ob> ^object-handle <h> ^<a> <v>)
-->
   (<ds> ^achieved <d>)
}

sp {pddl-hanoi*elaborate*state*unachieved*object-property
   (state <s> ^problem-space.name pddl-hanoi ^desireds <ds> ^world <w>)
   (<ds> ^desired <d>)
   (<d> ^object <do>)
   (<do> ^object-handle <h> ^{ <> object-handle <a> } <v>)
   (<w> ^anchored-world true)
  -{(<w> ^objects.object <ob>)
    (<ob> ^object-handle <h> ^<a> <v>)}
-->
   (<ds> ^unachieved <d>)
}

## Operator move (statement 1).
sp {pddl-hanoi*propose*move
   (state <s> ^problem-space.name pddl-hanoi ^flags.mea-operator-selection true ^world <w> ^desireds <ds>)
   (<w> ^anchored-world true ^objects <objs>)
   (<objs> ^object <disc>)
   (<disc> ^type object)
   (<objs> ^object <from>)
   (<from> ^type object)
   (<objs> ^object <to>)
   (<to> ^type object)
   (<w> ^smaller <r1>)
   (<r1> ^argument1 <to> ^argument2 <disc>)
   (<w> ^on <r2>)
   (<r2> ^argument1 <disc> ^argument2 <from>)
   (<w> ^clear <r3>)
   (<r3> ^argument1 <disc>)
   (<w> ^clear <r4>)
   (<r4> ^argument1 <to>)
   (<ds> ^unachieved-desireds true)
-->
   (<s> ^operator <op> +)
   (<op> ^name move ^task-operator true ^action-handle move ^argument1 <disc> ^argument2 <from> ^argument3 <to> ^argument-count 3 ^desireds <pre>)
   (<pre> ^desired-count 0)
}

## Effect of move (look-ahead).
sp {pddl-hanoi*apply*move*internal
   (state <s> ^problem-space.name pddl-hanoi ^operator <op> ^internal-actions true ^world <w>)
   (<op> ^task-operator true ^name move ^pre-conditions-satisfied true ^argument1.object-handle $ <disc-h> ^argument2.object-handle $ <from-h> ^argument3.object-handle $ <to-h>)
   (<w> ^anchored-world true ^objects <objs>)
   (<objs> ^object <disc>)
   (<disc> ^object-handle $ <disc-h>)
   (<objs> ^object <from>)
   (<from> ^object-handle $ <from-h>)
   (<objs> ^object <to>)
   (<to> ^object-handle $ <to-h>)
   (<w> ^on <e1>)
   (<e1> ^argument1 <disc> ^argument2 <from>)
   (<w> ^clear <e2>)
   (<e2> ^argument1 <to>)
-->
   (<w> ^on <e1> -)
   (<w> ^clear <e2> -)
   (<w> ^clear <new-3>)
   (<new-3> ^argument1 <from>)
   (<w> ^on <new-4>)
   (<new-4> ^argument1 <disc> ^argument2 <to>)
}

## Effect of a completed move command on the real world (once per command).
sp {pddl-hanoi*apply*move*environment-effect
   :o-support
   (state <s> ^problem-space.name pddl-hanoi ^superstate nil ^world <w> ^io.output-link.perform-action <pa>)
   (<pa> ^name move ^status complete ^argument1 <disc-h> ^argument2 <from-h> ^argument3 <to-h> -^effect-applied true)
   (<w> ^anchored-world true ^objects <objs>)
   (<objs> ^object <disc>)
   (<disc> ^object-handle $ <disc-h>)
   (<objs> ^object <from>)
   (<from> ^object-handle $ <from-h>)
   (<objs> ^object <to>)
   (<to> ^object-handle $ <to-h>)
   (<w> ^on <e1>)
   (<e1> ^argument1 <disc> ^argument2 <from>)
   (<w> ^clear <e2>)
   (<e2> ^argument1 <to>)
-->
   (<w> ^on <e1> -)
   (<w> ^clear <e2> -)
   (<w> ^clear <new-3>)
   (<new-3> ^argument1 <from>)
   (<w> ^on <new-4>)
   (<new-4> ^argument1 <disc> ^argument2 <to>)
   (<pa> ^effect-applied true)
   (write |move | <disc-h> | | <from-h> | | <to-h> (crlf))
}

## Goal (statement 2): ^goal-met true on the task object.
sp {pddl-hanoi*elaborate*goal
   (state <s> ^problem-space.name pddl-hanoi ^world <w>)
   (<w> ^anchored-world true ^objects <objs>)
   (<objs> ^object <task>)
   (<task> ^type task)
   (<objs> ^object <k-d-3>)
   (<k-d-3> ^object-handle d-3)
   (<objs> ^object <k-peg3>)
   (<k-peg3> ^object-handle peg3)
   (<w> ^on <r1>)
   (<r1> ^argument1 <k-d-3> ^argument2 <k-peg3>)
   (<objs> ^object <k-d-2>)
   (<k-d-2> ^object-handle d-2)
   (<w> ^on <r2>)
   (<r2> ^argument1 <k-d-2> ^argument2 <k-d-3>)
   (<objs> ^object <k-d-1>)
   (<k-d-1> ^object-handle d-1)
   (<w> ^on <r3>)
   (<r3> ^argument1 <k-d-1> ^argument2 <k-d-2>)
-->
   (<task> ^goal-met true)
}
