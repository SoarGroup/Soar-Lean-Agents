## Goal (statement 7): ^goal-met true on the task object.
sp {pddl-logistics-strips*elaborate*goal
   (state <s> ^problem-space.name pddl-logistics-strips ^world <w>)
   (<w> ^anchored-world true ^objects <objs>)
   (<objs> ^object <task>)
   (<task> ^type task)
   (<objs> ^object <k-package6>)
   (<k-package6> ^object-handle package6)
   (<objs> ^object <k-city1-2>)
   (<k-city1-2> ^object-handle city1-2)
   (<w> ^at <r1>)
   (<r1> ^argument1 <k-package6> ^argument2 <k-city1-2>)
   (<objs> ^object <k-package5>)
   (<k-package5> ^object-handle package5)
   (<objs> ^object <k-city6-2>)
   (<k-city6-2> ^object-handle city6-2)
   (<w> ^at <r2>)
   (<r2> ^argument1 <k-package5> ^argument2 <k-city6-2>)
   (<objs> ^object <k-package4>)
   (<k-package4> ^object-handle package4)
   (<objs> ^object <k-city3-2>)
   (<k-city3-2> ^object-handle city3-2)
   (<w> ^at <r3>)
   (<r3> ^argument1 <k-package4> ^argument2 <k-city3-2>)
   (<objs> ^object <k-package3>)
   (<k-package3> ^object-handle package3)
   (<objs> ^object <k-city6-1>)
   (<k-city6-1> ^object-handle city6-1)
   (<w> ^at <r4>)
   (<r4> ^argument1 <k-package3> ^argument2 <k-city6-1>)
   (<objs> ^object <k-package2>)
   (<k-package2> ^object-handle package2)
   (<w> ^at <r5>)
   (<r5> ^argument1 <k-package2> ^argument2 <k-city6-2>)
   (<objs> ^object <k-package1>)
   (<k-package1> ^object-handle package1)
   (<objs> ^object <k-city2-1>)
   (<k-city2-1> ^object-handle city2-1)
   (<w> ^at <r6>)
   (<r6> ^argument1 <k-package1> ^argument2 <k-city2-1>)
-->
   (<task> ^goal-met true)
}
