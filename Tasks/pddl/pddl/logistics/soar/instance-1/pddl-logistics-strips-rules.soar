sp {pddl-logistics-strips*propose*initialize-pddl-logistics-strips
   (state <s> ^superstate nil ^world <w> -^name)
-->
   (<s> ^operator <o> + >)
   (<o> ^name initialize-pddl-logistics-strips ^task-operator false)
}

