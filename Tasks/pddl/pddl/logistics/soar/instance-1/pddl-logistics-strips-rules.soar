## Elaborate problem space: adds ^copy-relation, ^dont-copy-object-attribute, ^problem-space.
sp {pddl-logistics-strips*elaborate*problem-space
   (state <s> ^name pddl-logistics-strips)
-->
   (<s> ^problem-space <p>)
   (<p> ^name pddl-logistics-strips ^copy-relation airplane ^copy-relation airport ^copy-relation at ^copy-relation city ^copy-relation in-city ^copy-relation location ^copy-relation obj ^copy-relation truck ^dont-copy-object-attribute goal-met)
}

sp {pddl-logistics-strips*elaborate*problem-space*mea-substate
   (state <s> ^impasse no-change ^attribute operator ^superstate <ss>)
   (<ss> ^problem-space.name pddl-logistics-strips ^operator <so>)
   (<so> ^task-operator true -^pre-conditions-satisfied true)
-->
   (<s> ^problem-space <p>)
   (<p> ^name pddl-logistics-strips ^dont-copy-object-attribute goal-met)
}

## Elaborate flags: adds ^flag-override, ^mea-operator-selection.
sp {pddl-logistics-strips*elaborate*flags
   (state <s> ^superstate nil ^name pddl-logistics-strips)
-->
   (<s> ^flag-override <f>)
   (<f> ^mea-operator-selection true)
}

