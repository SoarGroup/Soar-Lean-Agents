   (state <s> ^problem-space.name pddl-logistics-strips ^operator <op> ^internal-actions true ^world <w>)
   (<op> ^task-operator true ^name load-truck ^pre-conditions-satisfied true ^argument1.object-handle $ <obj-h> ^argument2.object-handle $ <truck-h> ^argument3.object-handle $ <loc-h>)
   (<w> ^anchored-world true ^objects <objs>)
