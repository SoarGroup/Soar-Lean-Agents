   :o-support
   (state <s> ^problem-space.name pddl-logistics-strips ^superstate nil ^world <w> ^io.output-link.perform-action <pa>)
   (<pa> ^name load-truck ^status complete ^argument1 <obj-h> ^argument2 <truck-h> ^argument3 <loc-h> -^effect-applied true)
   (<w> ^anchored-world true ^objects <objs>)
   (<objs> ^object <obj>)
   (<obj> ^object-handle $ <obj-h>)
   (<objs> ^object <truck>)
   (<truck> ^object-handle $ <truck-h>)
   (<objs> ^object <loc>)
   (<loc> ^object-handle $ <loc-h>)
   (<w> ^at <e1>)
   (<e1> ^argument1 <obj> ^argument2 <loc>)
-->
