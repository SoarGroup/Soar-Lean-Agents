   (<w> ^anchored-world true ^objects <objs>)
   (<objs> ^object <obj>)
   (<obj> ^type object)
   (<objs> ^object <airplane>)
   (<airplane> ^type object)
   (<objs> ^object <loc>)
   (<loc> ^type object)
   (<w> ^obj <r1>)
   (<r1> ^argument1 <obj>)
   (<w> ^airplane <r2>)
   (<r2> ^argument1 <airplane>)
   (<w> ^location <r3>)
   (<r3> ^argument1 <loc>)
   (<w> ^in <r4>)
   (<r4> ^argument1 <obj> ^argument2 <airplane>)
   (<w> ^at <r5>)
   (<r5> ^argument1 <airplane> ^argument2 <loc>)
   (<ds> ^unachieved-desireds true)
-->
   (<s> ^operator <op> +)
   (<op> ^name unload-airplane ^task-operator true ^action-handle unload-airplane ^argument1 <obj> ^argument2 <airplane> ^argument3 <loc> ^argument-count 3 ^desireds <pre>)
   (<pre> ^desired-count 0)
}

## Effect of unload-airplane (look-ahead).
sp {pddl-logistics-strips*apply*unload-airplane*internal
   (state <s> ^problem-space.name pddl-logistics-strips ^operator <op> ^internal-actions true ^world <w>)
   (<op> ^task-operator true ^name unload-airplane ^pre-conditions-satisfied true ^argument1.object-handle $ <obj-h> ^argument2.object-handle $ <airplane-h> ^argument3.object-handle $ <loc-h>)
   (<w> ^anchored-world true ^objects <objs>)
   (<objs> ^object <obj>)
   (<obj> ^object-handle $ <obj-h>)
   (<objs> ^object <airplane>)
   (<airplane> ^object-handle $ <airplane-h>)
   (<objs> ^object <loc>)
   (<loc> ^object-handle $ <loc-h>)
   (<w> ^in <e1>)
   (<e1> ^argument1 <obj> ^argument2 <airplane>)
-->
   (<w> ^in <e1> -)
   (<w> ^at <new-2>)
   (<new-2> ^argument1 <obj> ^argument2 <loc>)
}

