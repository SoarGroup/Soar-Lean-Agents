   (state <s> ^problem-space.name pddl-movie-strips ^flags.mea-operator-selection true ^world <w> ^desireds <ds>)
   (<w> ^anchored-world true ^objects <objs>)
   (<objs> ^object <x>)
   (<x> ^type object)
   (<w> ^crackers <r1>)
   (<r1> ^argument1 <x>)
   (<ds> ^unachieved-desireds true)
-->
   (<s> ^operator <op> +)
   (<op> ^name get-crackers ^task-operator true ^action-handle get-crackers ^argument1 <x> ^argument-count 1 ^desireds <pre>)
   (<pre> ^desired-count 0)
}

## Effect of get-crackers (look-ahead).
sp {pddl-movie-strips*apply*get-crackers*internal
   (state <s> ^problem-space.name pddl-movie-strips ^operator <op> ^internal-actions true ^world <w>)
   (<op> ^task-operator true ^name get-crackers ^pre-conditions-satisfied true ^argument1.object-handle $ <x-h>)
   (<w> ^anchored-world true ^objects <objs>)
   (<objs> ^object <x>)
   (<x> ^object-handle $ <x-h>)
   (<objs> ^object <nviewer>)
   (<nviewer> ^type viewer)
   (<nviewer> ^have-crackers <nviewer-have-crackers>)
-->
   (<nviewer> ^have-crackers <nviewer-have-crackers> - true)
}

## Effect of a completed get-crackers command on the real world (once per command).
sp {pddl-movie-strips*apply*get-crackers*environment-effect
   :o-support
   (state <s> ^problem-space.name pddl-movie-strips ^superstate nil ^world <w> ^io.output-link.perform-action <pa>)
   (<pa> ^name get-crackers ^status complete ^argument1 <x-h> -^effect-applied true)
   (<w> ^anchored-world true ^objects <objs>)
   (<objs> ^object <x>)
   (<x> ^object-handle $ <x-h>)
   (<objs> ^object <nviewer>)
   (<nviewer> ^type viewer)
   (<nviewer> ^have-crackers <nviewer-have-crackers>)
-->
   (<nviewer> ^have-crackers <nviewer-have-crackers> - true)
   (<pa> ^effect-applied true)
   (write |get-crackers | <x-h> (crlf))
}

## Goal (statement 9): ^goal-met true on the task object.
sp {pddl-movie-strips*elaborate*goal
   (state <s> ^problem-space.name pddl-movie-strips ^world <w>)
   (<w> ^anchored-world true ^objects <objs>)
   (<objs> ^object <task>)
   (<task> ^type task)
   (<objs> ^object <nmovie>)
   (<nmovie> ^type movie)
   (<nmovie> ^rewound true)
   (<objs> ^object <ncounter>)
   (<ncounter> ^type counter)
   (<ncounter> ^at-zero true)
   (<objs> ^object <nviewer>)
   (<nviewer> ^type viewer)
   (<nviewer> ^have-chips true)
   (<nviewer> ^have-dip true)
   (<nviewer> ^have-pop true)
   (<nviewer> ^have-cheese true)
   (<nviewer> ^have-crackers true)
-->
   (<task> ^goal-met true)
}
