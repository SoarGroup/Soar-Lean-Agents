## Effect of cross-one (look-ahead).
sp {bridge-and-torch*apply*cross-one*internal
   (state <s> ^operator <op> ^internal-actions true ^world <w>)
   (<op> ^task-operator true ^name cross-one ^pre-conditions-satisfied true ^argument1.object-handle $ <a-h> ^argument2.object-handle $ <to-h>)
   (<w> ^anchored-world true ^objects <objs>)
   (<objs> ^object <a>)
   (<a> ^object-handle $ <a-h>)
   (<objs> ^object <to>)
   (<to> ^object-handle $ <to-h>)
   (<objs> ^object <tc>)
   (<tc> ^type torch)
   (<objs> ^object <ck>)
   (<ck> ^type clock)
   (<w> ^at <r1>)
   (<r1> ^argument1 <a> ^argument2 <old>)
   (<w> ^at <r2>)
   (<r2> ^argument1 <tc> ^argument2 <old>)
   (<ck> ^elapsed <ck-elapsed>)
   (<a> ^minutes <a-minutes>)
-->
