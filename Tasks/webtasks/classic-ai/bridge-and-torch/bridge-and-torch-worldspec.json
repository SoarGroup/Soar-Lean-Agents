{"title": "Bridge and torch (bridge-and-torch)",
 "sums": [],
 "statements":
 [[1, "Four people must cross a bridge at night. They start on the near side."],
  [2,
   "They have one torch. Anyone on the bridge must have the torch with them."],
  [3, "At most two people can be on the bridge at once."],
  [4,
   "Crossing takes Ann 1 minute, Bob 2 minutes, Cy 5 minutes and Di 10 minutes."],
  [5, "Two people crossing together go at the speed of the slower one."],
  [6,
   "One or two people on the side with the torch can cross with the torch to the other side."],
  [7,
   "The goal is that all four people are on the far side within 17 minutes."]],
 "repeatControl": {"types": ["person", "torch"], "rel": "at"},
 "relations":
 [["at", ["ann", "near-side"]],
  ["at", ["bob", "near-side"]],
  ["at", ["cy", "near-side"]],
  ["at", ["di", "near-side"]],
  ["at", ["torch", "near-side"]],
  ["other", ["near-side", "far-side"]],
  ["other", ["far-side", "near-side"]]],
 "ops":
 [{"stmts": [2, 4, 6],
   "stepCost": {"prop": ["a", "minutes"]},
   "report":
   [{"handle": "a"}, {"text": " crosses with the torch to "}, {"handle": "to"}],
   "pre":
   [{"type": "torch", "obj": "tc"},
    {"rel": "at", "args": [{"var": "a"}, {"var": "from"}]},
    {"rel": "at", "args": [{"var": "tc"}, {"var": "from"}]},
    {"rel": "other", "args": [{"var": "from"}, {"var": "to"}]}],
   "params": [["a", "person"], ["to", "bank"]],
