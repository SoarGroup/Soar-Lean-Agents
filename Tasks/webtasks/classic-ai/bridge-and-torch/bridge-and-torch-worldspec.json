    {"update": "ck",
     "rhs": {"plus": [{"prop": ["ck", "elapsed"]}, {"prop": ["a", "minutes"]}]},
     "prop": "elapsed"}],
   "bind":
   [{"type": "torch", "obj": "tc"},
    {"type": "clock", "obj": "ck"},
    {"rel": "at", "args": [{"var": "a"}, {"var": "old"}]},
    {"rel": "at", "args": [{"var": "tc"}, {"var": "old"}]}]},
  {"stmts": [2, 3, 4, 5, 6],
