{
  "format": "worldspec-1",
  "name": "cheryls-birthday",
  "title": "Cheryl's birthday (cheryls-birthday)",
  "statements": [
    [
      1,
      "Albert and Bernard want to know Cheryl's birthday. Cheryl gives them ten possible dates: May 15, May 16, May 19, June 17, June 18, July 14, July 16, August 14, August 15, August 17."
    ],
    [
      2,
      "Cheryl tells Albert only the month and tells Bernard only the day."
    ],
    [
      3,
      "Albert says: \"I don't know when Cheryl's birthday is, but I know that Bernard doesn't know either.\""
    ],
    [
      4,
      "Bernard says: \"At first I didn't know when Cheryl's birthday is, but I know now.\""
    ],
    [
      5,
      "Albert says: \"Then I also know when Cheryl's birthday is.\""
    ],
    [
      6,
      "Each statement is true, and each speaker reasons perfectly."
    ],
    [
      7,
      "The goal is to find Cheryl's birthday."
    ]
  ],
  "assumptions": [
    {
      "id": "A-CB1",
      "kind": "intent",
      "text": "The ten dates are date objects with a month and a day. Who was told what is not stored: \"Albert would know\" is read over every date, as if Albert had been told that date's month.",
      "stmts": [
        1,
        2
      ]
    },
    {
      "id": "A-CB2",
      "kind": "intent",
      "text": "Knowledge is explicit (JL, 16 Nov 2026): derived relations, recomputed in every world, say for which dates a speaker would or would not know; operators test them positively. Their definitions use negation (\"no other date has that day\"), which is allowed only there.",
      "stmts": [
        3,
        4,
        5,
        6
      ]
    },
    {
      "id": "A-CB3",
      "kind": "intent",
      "text": "Each statement is an operator that marks, on every date at once (an each effect), the dates where the statement would be false (out3, out4, out5). Marks are added, never removed, so each statement is judged on the dates left before it. A stage number keeps the statements in order.",
      "stmts": [
        3,
        4,
        5
      ]
    },
    {
      "id": "A-CB4",
      "kind": "intent",
      "text": "\"I know that Bernard doesn't know\": rules out every date in a month that has a date whose day is unique among all ten (Bernard might know). \"I don't know\": rules out dates in a month with one date (none here).",
      "stmts": [
        3
      ]
    },
    {
      "id": "A-CB5",
      "kind": "intent",
      "text": "\"At first I didn't know\": rules out dates with a unique day among all ten (already gone after statement 3). \"I know now\": rules out dates whose day is shared by another date left after statement 3.",
      "stmts": [
        4
      ]
    },
    {
      "id": "A-CB6",
      "kind": "intent",
      "text": "\"Then I also know\": rules out dates whose month is shared by another date left after statement 4. The answer is the one date left; with more than one left, no answer is proposed.",
      "stmts": [
        5,
        7
      ]
    }
  ],
