## Guard patrol (guard-patrol): generated by spec_backend.py (WorldSpec, path B: Lean description, Python rules) from the instructor statements.
##
## Instructor statements used (numbers as in english-input.txt):
##  1. The world has three squares, A, B and C, in a row.
##  2. A guard robot is in square A.
##  3. The robot can move to a neighbouring square.
##  4. The robot goes to square C, then back to square A, and repeats this three times.
##
## Assumption ledger:
##   A-G1: "neighbouring": a static next relation between A and B and between B and C, both ways.
##   A-G2: Going to C and back to A are two phases; repeats closes the loop back to the first (L8-027); three times is ^repeat-count 3 (L8-029).

## Propose initialize-guard-patrol when its conditions below hold.
sp {guard-patrol*propose*initialize-guard-patrol
   (state <s> ^superstate nil ^world <w> -^name)
-->
   (<s> ^operator <o> + >)
   (<o> ^name initialize-guard-patrol ^task-operator false)
}

sp {guard-patrol*apply*initialize-guard-patrol
   (state <s> ^operator.name initialize-guard-patrol ^world <w>)
   (<w> ^objects <objs>)
-->
   (<s> ^name guard-patrol ^desireds <ds>)
   (<objs> ^object <k-a> <k-b> <k-c> <k-guard> <k-task>)
   (<k-a> ^object-handle a ^anchored true ^type square ^name a)
   (<k-b> ^object-handle b ^anchored true ^type square ^name b)
   (<k-c> ^object-handle c ^anchored true ^type square ^name c)
   (<k-guard> ^object-handle guard ^anchored true ^type agent ^name guard)
   (<k-task> ^object-handle task ^anchored true ^type task)
   (<ds> ^desired-count 1 ^desired <p1d1>)
   (<p1d1> ^object <p1d1-o>)
   (<p1d1-o> ^object-handle task ^at-c-met true)
   (<ds> ^next-desireds <ph2>)
   (<ph2> ^desired-count 1 ^desired <p2d1>)
   (<p2d1> ^object <p2d1-o>)
   (<p2d1-o> ^object-handle task ^at-a-met true)
   (<ph2> ^next-desireds <ds>)
   (<ds> ^loop-start true)
   (<s> ^repeat-count 3)
   (<w> ^at <rel-1>)
   (<rel-1> ^argument1 <k-guard> ^argument2 <k-a>)
   (<w> ^next <rel-2>)
   (<rel-2> ^argument1 <k-a> ^argument2 <k-b>)
   (<w> ^next <rel-3>)
   (<rel-3> ^argument1 <k-b> ^argument2 <k-a>)
   (<w> ^next <rel-4>)
   (<rel-4> ^argument1 <k-b> ^argument2 <k-c>)
   (<w> ^next <rel-5>)
   (<rel-5> ^argument1 <k-c> ^argument2 <k-b>)
   (log 1 (crlf) |Initialize guard-patrol.|)
}

## Elaborate problem space: adds ^copy-relation, ^dont-copy-object-attribute, ^problem-space.
sp {guard-patrol*elaborate*problem-space
   (state <s> ^name guard-patrol)
-->
   (<s> ^problem-space <p>)
   (<p> ^name guard-patrol ^copy-relation at ^copy-relation next ^dont-copy-object-attribute goal-met ^dont-copy-object-attribute at-c-met ^dont-copy-object-attribute at-a-met)
}

sp {guard-patrol*elaborate*problem-space*mea-substate
   (state <s> ^impasse no-change ^attribute operator ^superstate <ss>)
   (<ss> ^problem-space.name guard-patrol ^operator <so>)
   (<so> ^task-operator true -^pre-conditions-satisfied true)
-->
   (<s> ^problem-space <p>)
   (<p> ^name guard-patrol ^dont-copy-object-attribute goal-met ^dont-copy-object-attribute at-c-met ^dont-copy-object-attribute at-a-met)
}

## Elaborate flags: adds ^flag-override, ^mea-operator-selection.
sp {guard-patrol*elaborate*flags
   (state <s> ^superstate nil ^name guard-patrol)
-->
   (<s> ^flag-override <f>)
   (<f> ^mea-operator-selection true)
}

## Achievement of object-property desireds (supplied by the task).
sp {guard-patrol*elaborate*state*achieved*object-property
   (state <s> ^problem-space.name guard-patrol ^desireds <ds> ^world <w>)
   (<ds> ^desired <d>)
   (<d> ^object <do>)
   (<do> ^object-handle <h> ^{ <> object-handle <a> } <v>)
   (<w> ^anchored-world true ^objects.object <ob>)
   (<ob> ^object-handle <h> ^<a> <v>)
-->
   (<ds> ^achieved <d>)
}

sp {guard-patrol*elaborate*state*unachieved*object-property
   (state <s> ^problem-space.name guard-patrol ^desireds <ds> ^world <w>)
   (<ds> ^desired <d>)
   (<d> ^object <do>)
   (<do> ^object-handle <h> ^{ <> object-handle <a> } <v>)
   (<w> ^anchored-world true)
  -{(<w> ^objects.object <ob>)
    (<ob> ^object-handle <h> ^<a> <v>)}
-->
   (<ds> ^unachieved <d>)
}

## Operator move (statement 3).
sp {guard-patrol*propose*move
   (state <s> ^problem-space.name guard-patrol ^flags.mea-operator-selection true ^world <w> ^desireds <ds>)
   (<w> ^anchored-world true ^objects <objs>)
   (<objs> ^object <to>)
   (<to> ^type square)
   (<objs> ^object <g>)
   (<g> ^type agent)
   (<w> ^at <r1>)
   (<r1> ^argument1 <g> ^argument2 <cur>)
   (<w> ^next <r2>)
   (<r2> ^argument1 <cur> ^argument2 <to>)
   (<ds> ^unachieved-desireds true)
-->
   (<s> ^operator <op> +)
   (<op> ^name move ^task-operator true ^action-handle move ^argument1 <to> ^argument-count 1 ^desireds <pre>)
   (<pre> ^desired-count 0)
}

## Effect of move (look-ahead).
sp {guard-patrol*apply*move*internal
   (state <s> ^problem-space.name guard-patrol ^operator <op> ^internal-actions true ^world <w>)
   (<op> ^task-operator true ^name move ^pre-conditions-satisfied true ^argument1.object-handle $ <to-h>)
   (<w> ^anchored-world true ^objects <objs>)
   (<objs> ^object <to>)
   (<to> ^object-handle $ <to-h>)
   (<objs> ^object <g>)
   (<g> ^type agent)
   (<w> ^at <r1>)
   (<r1> ^argument1 <g> ^argument2 <old>)
-->
   (<r1> ^argument2 <old> - <to>)
}

## Effect of a completed move command on the real world (once per command).
sp {guard-patrol*apply*move*environment-effect
   :o-support
   (state <s> ^problem-space.name guard-patrol ^superstate nil ^world <w> ^io.output-link.perform-action <pa>)
   (<pa> ^name move ^status complete ^argument1 <to-h> -^effect-applied true)
   (<w> ^anchored-world true ^objects <objs>)
   (<objs> ^object <to>)
   (<to> ^object-handle $ <to-h>)
   (<objs> ^object <g>)
   (<g> ^type agent)
   (<w> ^at <r1>)
   (<r1> ^argument1 <g> ^argument2 <old>)
-->
   (<r1> ^argument2 <old> - <to>)
   (<pa> ^effect-applied true)
   (write |Move to | <to-h> (crlf))
}

## Phase at-c (statement 4): ^at-c-met true on the task object.
sp {guard-patrol*elaborate*phase*at-c
   (state <s> ^problem-space.name guard-patrol ^world <w>)
   (<w> ^anchored-world true ^objects <objs>)
   (<objs> ^object <task>)
   (<task> ^type task)
   (<objs> ^object <g>)
   (<g> ^type agent)
   (<objs> ^object <k-c>)
   (<k-c> ^object-handle c)
   (<w> ^at <r1>)
   (<r1> ^argument1 <g> ^argument2 <k-c>)
-->
   (<task> ^at-c-met true)
}

## Phase at-a (statement 4): ^at-a-met true on the task object.
sp {guard-patrol*elaborate*phase*at-a
   (state <s> ^problem-space.name guard-patrol ^world <w>)
   (<w> ^anchored-world true ^objects <objs>)
   (<objs> ^object <task>)
   (<task> ^type task)
   (<objs> ^object <g>)
   (<g> ^type agent)
   (<objs> ^object <k-a>)
   (<k-a> ^object-handle a)
   (<w> ^at <r1>)
   (<r1> ^argument1 <g> ^argument2 <k-a>)
-->
   (<task> ^at-a-met true)
}
