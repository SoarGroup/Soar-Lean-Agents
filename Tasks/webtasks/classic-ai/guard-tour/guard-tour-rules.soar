## Guard tour (guard-tour): generated by spec_backend.py (WorldSpec, path B: Lean description, Python rules) from the instructor statements.
##
## Instructor statements used (numbers as in english-input.txt):
##  1. The world has three squares, A, B and C, in a row.
##  2. A guard robot is in square A.
##  3. The robot can move to a neighbouring square.
##  4. First the robot goes to square C, then back to square A, and finally to square B.
##
## Assumption ledger:
##   A-G1: "neighbouring": a static next relation between A and B and between B and C, both ways.
##   A-G2: The three stages are phases in order (L8-026); the goal field holds the last phase (used by the semantics checks).
## Matching hints for learned rules (World-Conventions L3-095, L11-009): many-valued attributes, sized from the initial world.
production optimize-attribute square 5
production optimize-attribute agent 5
production optimize-attribute task 5
production optimize-attribute object 5
production optimize-attribute at 2
production optimize-attribute next 4


## Propose initialize-guard-tour when its conditions below hold.
sp {guard-tour*propose*initialize-guard-tour
   (state <s> ^superstate nil ^world <w> -^name)
-->
   (<s> ^operator <o> + >)
   (<o> ^name initialize-guard-tour ^task-operator false)
}

sp {guard-tour*apply*initialize-guard-tour
   (state <s> ^operator.name initialize-guard-tour ^world <w>)
   (<w> ^objects <objs>)
-->
   (<s> ^name guard-tour ^desireds <ds>)
   (<objs> ^square <k-a> <k-b> <k-c> ^agent <k-guard> ^task <k-task>)
   (<k-a> ^object-handle a ^anchored true ^type square ^name a ^static true)
   (<k-b> ^object-handle b ^anchored true ^type square ^name b ^static true)
   (<k-c> ^object-handle c ^anchored true ^type square ^name c ^static true)
   (<k-guard> ^object-handle guard ^anchored true ^type agent ^name guard ^static true)
   (<k-task> ^object-handle task ^anchored true ^type task)
   (<ds> ^desired-count 1 ^desired <p1d1>)
   (<p1d1> ^object <p1d1-o>)
   (<p1d1-o> ^object-handle task ^at-c-met true)
   (<ds> ^next-desireds <ph2>)
   (<ph2> ^desired-count 1 ^desired <p2d1>)
   (<p2d1> ^object <p2d1-o>)
   (<p2d1-o> ^object-handle task ^at-a-met true)
   (<ph2> ^next-desireds <ph3>)
   (<ph3> ^desired-count 1 ^desired <p3d1>)
   (<p3d1> ^object <p3d1-o>)
   (<p3d1-o> ^object-handle task ^at-b-met true)
   (<w> ^at <rel-1>)
   (<rel-1> ^argument1 <k-guard> ^argument2 <k-a>)
   (<w> ^next <rel-2>)
   (<rel-2> ^argument1 <k-a> ^argument2 <k-b>)
   (<w> ^next <rel-3>)
   (<rel-3> ^argument1 <k-b> ^argument2 <k-a>)
   (<w> ^next <rel-4>)
   (<rel-4> ^argument1 <k-b> ^argument2 <k-c>)
   (<w> ^next <rel-5>)
   (<rel-5> ^argument1 <k-c> ^argument2 <k-b>)
   (log 1 (crlf) |Initialize guard-tour.|)
}

## Elaborate problem space: adds ^copy-relation, ^dont-copy-object-attribute, ^problem-space, ^share-relation.
sp {guard-tour*elaborate*problem-space
   (state <s> ^name guard-tour)
-->
   (<s> ^problem-space <p>)
   (<p> ^name guard-tour ^copy-relation at ^share-relation next ^dont-copy-object-attribute goal-met ^dont-copy-object-attribute at-c-met ^dont-copy-object-attribute at-a-met ^dont-copy-object-attribute at-b-met)
}

sp {guard-tour*elaborate*problem-space*mea-substate
   (state <s> ^impasse no-change ^attribute operator ^superstate <ss>)
   (<ss> ^problem-space.name guard-tour ^operator <so>)
   (<so> ^task-operator true -^pre-conditions-satisfied true)
-->
   (<s> ^problem-space <p>)
   (<p> ^name guard-tour ^dont-copy-object-attribute goal-met ^dont-copy-object-attribute at-c-met ^dont-copy-object-attribute at-a-met ^dont-copy-object-attribute at-b-met)
}

## Elaborate flags: adds ^flag-override, ^mea-operator-selection.
sp {guard-tour*elaborate*flags
   (state <s> ^superstate nil ^name guard-tour)
-->
   (<s> ^flag-override <f>)
   (<f> ^mea-operator-selection true)
}

## Achievement of object-property desireds (supplied by the task).
sp {guard-tour*elaborate*state*achieved*object-property
   (state <s> ^problem-space.name guard-tour ^desireds <ds> ^world <w>)
   (<ds> ^desired <d>)
   (<d> ^object <do>)
   (<do> ^object-handle <h> ^{ <> object-handle <a> } <v>)
   (<w> ^anchored-world true ^objects.object <ob>)
   (<ob> ^object-handle <h> ^<a> <v>)
-->
   (<ds> ^achieved <d>)
}

sp {guard-tour*elaborate*state*unachieved*object-property
   (state <s> ^problem-space.name guard-tour ^desireds <ds> ^world <w>)
   (<ds> ^desired <d>)
   (<d> ^object <do>)
   (<do> ^object-handle <h> ^{ <> object-handle <a> } <v>)
   (<w> ^anchored-world true)
  -{(<w> ^objects.object <ob>)
    (<ob> ^object-handle <h> ^<a> <v>)}
-->
   (<ds> ^unachieved <d>)
}

## Operator move (statement 3).
sp {guard-tour*propose*move
   (state <s> ^problem-space.name guard-tour ^flags.mea-operator-selection true ^world <w> ^desireds <ds>)
   (<w> ^anchored-world true ^objects <objs>)
   (<objs> ^square <to>)
   (<objs> ^agent <g>)
   (<w> ^at <r1>)
   (<r1> ^argument1 <g> ^argument2 <cur>)
   (<w> ^next <r2>)
   (<r2> ^argument1 <cur> ^argument2 <to>)
   (<ds> ^unachieved-desireds true)
-->
   (<s> ^operator <op> +)
   (<op> ^name move ^task-operator true ^action-handle move ^argument1 <to> ^argument-count 1 ^pre-conditions-satisfied true)
}

## Effect of move (look-ahead).
sp {guard-tour*apply*move*internal
   (state <s> ^problem-space.name guard-tour ^operator <op> ^internal-actions true ^world <w>)
   (<op> ^task-operator true ^name move ^pre-conditions-satisfied true ^argument1.object-handle $ <to-h>)
   (<w> ^anchored-world true ^objects <objs>)
   (<objs> ^square <to>)
   (<to> ^object-handle $ <to-h>)
   (<objs> ^agent <g>)
   (<w> ^at <r1>)
   (<r1> ^argument1 <g> ^argument2 <old>)
-->
   (<r1> ^argument2 <old> - <to>)
}

## Effect of a completed move command on the real world (once per command).
sp {guard-tour*apply*move*environment-effect
   :o-support
   (state <s> ^problem-space.name guard-tour ^superstate nil ^world <w> ^io.output-link.perform-action <pa>)
   (<pa> ^name move ^status complete ^argument1 <to-h> -^effect-applied true)
   (<w> ^anchored-world true ^objects <objs>)
   (<objs> ^square <to>)
   (<to> ^object-handle $ <to-h>)
   (<objs> ^agent <g>)
   (<w> ^at <r1>)
   (<r1> ^argument1 <g> ^argument2 <old>)
-->
   (<r1> ^argument2 <old> - <to>)
   (<pa> ^effect-applied true)
   (write |Move to | <to-h> (crlf))
}

## Phase at-c (statement 4): ^at-c-met true on the task object.
sp {guard-tour*elaborate*phase*at-c
   (state <s> ^problem-space.name guard-tour ^world <w>)
   (<w> ^anchored-world true ^objects <objs>)
   (<objs> ^task <task>)
   (<objs> ^agent <g>)
   (<objs> ^square <k-c>)
   (<k-c> ^object-handle c)
   (<w> ^at <r1>)
   (<r1> ^argument1 <g> ^argument2 <k-c>)
-->
   (<task> ^at-c-met true)
}

## Phase at-a (statement 4): ^at-a-met true on the task object.
sp {guard-tour*elaborate*phase*at-a
   (state <s> ^problem-space.name guard-tour ^world <w>)
   (<w> ^anchored-world true ^objects <objs>)
   (<objs> ^task <task>)
   (<objs> ^agent <g>)
   (<objs> ^square <k-a>)
   (<k-a> ^object-handle a)
   (<w> ^at <r1>)
   (<r1> ^argument1 <g> ^argument2 <k-a>)
-->
   (<task> ^at-a-met true)
}

## Phase at-b (statement 4): ^at-b-met true on the task object.
sp {guard-tour*elaborate*phase*at-b
   (state <s> ^problem-space.name guard-tour ^world <w>)
   (<w> ^anchored-world true ^objects <objs>)
   (<objs> ^task <task>)
   (<objs> ^agent <g>)
   (<objs> ^square <k-b>)
   (<k-b> ^object-handle b)
   (<w> ^at <r1>)
   (<r1> ^argument1 <g> ^argument2 <k-b>)
-->
   (<task> ^at-b-met true)
}
