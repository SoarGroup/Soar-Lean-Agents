   (<rel-73> ^argument1 <k-cube-a> ^argument2 <k-ground>)
   (<w> ^prev <rel-74>)
   (<rel-74> ^argument1 <k-cube-b> ^argument2 <k-cube-a>)
   (<w> ^prev <rel-75>)
   (<rel-75> ^argument1 <k-cube-c> ^argument2 <k-cube-b>)
   (<w> ^prev <rel-76>)
   (<rel-76> ^argument1 <k-cube-d> ^argument2 <k-cube-c>)
   (<w> ^placed <rel-77>)
   (<rel-77> ^argument1 <k-ground> ^argument2 <k-ground-pose>)
   (<w> ^unplaced <rel-78>)
   (<rel-78> ^argument1 <k-cube-a>)
   (<w> ^unplaced <rel-79>)
   (<rel-79> ^argument1 <k-cube-b>)
   (<w> ^unplaced <rel-80>)
   (<rel-80> ^argument1 <k-cube-c>)
   (<w> ^unplaced <rel-81>)
   (<rel-81> ^argument1 <k-cube-d>)
   (log 1 (crlf) |Initialize instant-insanity.|)
}

## Elaborate problem space: adds ^copy-relation, ^dont-copy-object-attribute, ^problem-space.
sp {instant-insanity*elaborate*problem-space
   (state <s> ^name instant-insanity)
-->
   (<s> ^problem-space <p>)
   (<p> ^name instant-insanity ^copy-relation orient ^copy-relation prev ^copy-relation placed ^copy-relation unplaced ^dont-copy-object-attribute goal-met)
}

sp {instant-insanity*elaborate*problem-space*mea-substate
   (state <s> ^impasse no-change ^attribute operator ^superstate <ss>)
   (<ss> ^problem-space.name instant-insanity ^operator <so>)
   (<so> ^task-operator true -^pre-conditions-satisfied true)
-->
   (<s> ^problem-space <p>)
   (<p> ^name instant-insanity ^dont-copy-object-attribute goal-met)
}

## Elaborate flags: adds ^flag-override, ^mea-operator-selection.
sp {instant-insanity*elaborate*flags
   (state <s> ^superstate nil ^name instant-insanity)
-->
   (<s> ^flag-override <f>)
   (<f> ^mea-operator-selection true)
}

## Achievement of object-property desireds (supplied by the task).
sp {instant-insanity*elaborate*state*achieved*object-property
   (state <s> ^problem-space.name instant-insanity ^desireds <ds> ^world <w>)
   (<ds> ^desired <d>)
   (<d> ^object <do>)
   (<do> ^object-handle <h> ^{ <> object-handle <a> } <v>)
   (<w> ^anchored-world true ^objects.object <ob>)
   (<ob> ^object-handle <h> ^<a> <v>)
-->
   (<ds> ^achieved <d>)
}

sp {instant-insanity*elaborate*state*unachieved*object-property
   (state <s> ^problem-space.name instant-insanity ^desireds <ds> ^world <w>)
   (<ds> ^desired <d>)
   (<d> ^object <do>)
   (<do> ^object-handle <h> ^{ <> object-handle <a> } <v>)
   (<w> ^anchored-world true)
  -{(<w> ^objects.object <ob>)
    (<ob> ^object-handle <h> ^<a> <v>)}
-->
   (<ds> ^unachieved <d>)
}

## Operator place (statements 3, 4).
sp {instant-insanity*propose*place
   (state <s> ^problem-space.name instant-insanity ^flags.mea-operator-selection true ^world <w> ^desireds <ds>)
   (<w> ^anchored-world true ^objects <objs>)
   (<objs> ^object <c>)
   (<c> ^type cube)
   (<objs> ^object <o>)
   (<o> ^type orientation)
   (<w> ^unplaced <r1>)
   (<r1> ^argument1 <c>)
   (<w> ^orient <r2>)
   (<r2> ^argument1 <o> ^argument2 <c>)
   (<w> ^prev <r3>)
   (<r3> ^argument1 <c> ^argument2 <q>)
   (<w> ^placed <r4>)
   (<r4> ^argument1 <q> ^argument2 <r>)
   (<ds> ^unachieved-desireds true)
-->
   (<s> ^operator <op> +)
   (<op> ^name place ^task-operator true ^action-handle place ^argument1 <c> ^argument2 <o> ^argument-count 2 ^desireds <pre>)
   (<pre> ^desired-count 0)
}

## Effect of place (look-ahead).
sp {instant-insanity*apply*place*internal
   (state <s> ^problem-space.name instant-insanity ^operator <op> ^internal-actions true ^world <w>)
   (<op> ^task-operator true ^name place ^pre-conditions-satisfied true ^argument1.object-handle $ <c-h> ^argument2.object-handle $ <o-h>)
   (<w> ^anchored-world true ^objects <objs>)
   (<objs> ^object <c>)
   (<c> ^object-handle $ <c-h>)
   (<objs> ^object <o>)
   (<o> ^object-handle $ <o-h>)
   (<w> ^unplaced <e2>)
   (<e2> ^argument1 <c>)
-->
   (<w> ^placed <new-1>)
   (<new-1> ^argument1 <c> ^argument2 <o>)
   (<w> ^unplaced <e2> -)
}

## Effect of a completed place command on the real world (once per command).
sp {instant-insanity*apply*place*environment-effect
   :o-support
   (state <s> ^problem-space.name instant-insanity ^superstate nil ^world <w> ^io.output-link.perform-action <pa>)
   (<pa> ^name place ^status complete ^argument1 <c-h> ^argument2 <o-h> -^effect-applied true)
   (<w> ^anchored-world true ^objects <objs>)
   (<objs> ^object <c>)
   (<c> ^object-handle $ <c-h>)
   (<objs> ^object <o>)
   (<o> ^object-handle $ <o-h>)
   (<w> ^unplaced <e2>)
   (<e2> ^argument1 <c>)
-->
   (<w> ^placed <new-1>)
   (<new-1> ^argument1 <c> ^argument2 <o>)
   (<w> ^unplaced <e2> -)
   (<pa> ^effect-applied true)
   (write |Place | <c-h> | turned as | <o-h> (crlf))
}

## Losing condition same-colour-front (statement 5).
sp {instant-insanity*elaborate*failure*same-colour-front
   (state <s> ^problem-space.name instant-insanity ^desireds <ds> ^world <w>)
   (<w> ^anchored-world true ^objects <objs>)
   (<objs> ^object <c1>)
   (<c1> ^type cube)
   (<objs> ^object <c2>)
   (<c2> ^type cube)
   (<objs> ^object { <> <c1> <c2> })
   (<w> ^placed <r1>)
   (<r1> ^argument1 <c1> ^argument2 <o1>)
   (<w> ^placed <r2>)
   (<r2> ^argument1 <c2> ^argument2 <o2>)
   (<o2> ^front <o2-front>)
   (<o1> ^front <o2-front>)
-->
   (<s> ^failure <ds>)
}

