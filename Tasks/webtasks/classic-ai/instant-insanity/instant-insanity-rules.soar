## Goal (statements 3, 5): ^goal-met true on the task object.
sp {instant-insanity*elaborate*goal
   (state <s> ^problem-space.name instant-insanity ^world <w>)
   (<w> ^anchored-world true ^objects <objs>)
   (<objs> ^object <task>)
   (<task> ^type task)
   (<objs> ^object <x-cube-a>)
   (<x-cube-a> ^object-handle cube-a)
   (<w> ^placed <r1>)
   (<r1> ^argument1 <x-cube-a> ^argument2 <o-cube-a>)
   (<objs> ^object <x-cube-b>)
   (<x-cube-b> ^object-handle cube-b)
   (<w> ^placed <r2>)
   (<r2> ^argument1 <x-cube-b> ^argument2 <o-cube-b>)
   (<objs> ^object <x-cube-c>)
   (<x-cube-c> ^object-handle cube-c)
   (<w> ^placed <r3>)
   (<r3> ^argument1 <x-cube-c> ^argument2 <o-cube-c>)
   (<objs> ^object <x-cube-d>)
   (<x-cube-d> ^object-handle cube-d)
   (<w> ^placed <r4>)
   (<r4> ^argument1 <x-cube-d> ^argument2 <o-cube-d>)
-->
   (<task> ^goal-met true)
}
