   (<k-place-a> ^object-handle place-a ^anchored true ^type location ^name place-a ^static true)
   (<k-place-b> ^object-handle place-b ^anchored true ^type location ^name place-b ^static true)
   (<k-place-c> ^object-handle place-c ^anchored true ^type location ^name place-c ^static true)
   (<k-monkey> ^object-handle monkey ^anchored true ^type animal ^name monkey ^static true)
   (<k-box> ^object-handle box ^anchored true ^type box ^name box ^static true)
   (<k-bananas> ^object-handle bananas ^anchored true ^type food ^name bananas ^static true)
   (<k-floor> ^object-handle floor ^anchored true ^type floor ^name floor ^static true)
   (<k-task> ^object-handle task ^anchored true ^type task)
   (<ds> ^desired-count 1 ^desired <d1>)
   (<d1> ^object <d1-o>)
   (<d1-o> ^object-handle task ^goal-met true)
   (<w> ^at <rel-1>)
   (<rel-1> ^argument1 <k-monkey> ^argument2 <k-place-a>)
   (<w> ^at <rel-2>)
   (<rel-2> ^argument1 <k-box> ^argument2 <k-place-c>)
   (<w> ^at <rel-3>)
   (<rel-3> ^argument1 <k-bananas> ^argument2 <k-place-b>)
   (<w> ^on <rel-4>)
   (<rel-4> ^argument1 <k-monkey> ^argument2 <k-floor>)
   (log 1 (crlf) |Initialize monkey-and-bananas.|)
}

