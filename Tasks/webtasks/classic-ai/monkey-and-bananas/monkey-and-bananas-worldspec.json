{
  "format": "worldspec-1",
  "name": "monkey-and-bananas",
  "title": "Monkey and bananas (monkey-and-bananas)",
  "statements": [
    [
      1,
      "There are three places in a room: A, B and C."
    ],
    [
      2,
      "A monkey is at A. A box is at C. Bananas hang from the ceiling above B."
    ],
    [
      3,
      "The monkey is on the floor."
    ],
    [
      4,
      "The monkey can go from its place to another place if it is on the floor."
    ],
    [
      5,
      "The monkey can push the box from its place to another place if the box is at the monkey's place and the monkey is on the floor. The monkey and the box both end at the new place."
    ],
    [
      6,
      "The monkey can climb onto the box if the box is at the monkey's place and the monkey is on the floor."
    ],
    [
      7,
      "The monkey can climb down from the box onto the floor."
    ],
    [
      8,
      "The monkey can grasp the bananas if it is on the box and the box is at the place under the bananas."
    ],
    [
      9,
      "The goal is that the monkey has the bananas."
    ]
  ],
  "assumptions": [
    {
      "id": "A-MB1",
      "kind": "intent",
      "text": "\"Bananas hang from the ceiling above B\": the bananas are at B, so \"the place under the bananas\" is the place the bananas are at.",
      "stmts": [
        2,
        8
      ]
    },
    {
      "id": "A-MB2",
      "kind": "intent",
      "text": "The floor is an object; being on the floor or on the box is an on relation from the monkey.",
      "stmts": [
        3,
        6,
        7
      ]
    },
    {
      "id": "A-MB3",
      "kind": "intent",
      "text": "\"has the bananas\" is a holds relation from the monkey to the bananas, added by grasp.",
      "stmts": [
        8,
        9
      ]
    },
    {
      "id": "A-MB4",
      "kind": "intent",
      "text": "The actions are named go, push, climb-up, climb-down and grasp.",
      "stmts": [
        4,
        5,
        6,
        7,
        8
      ]
    }
  ],
