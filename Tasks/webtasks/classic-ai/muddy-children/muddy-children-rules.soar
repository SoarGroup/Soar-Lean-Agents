## Elaborate problem space: adds ^copy-relation, ^dont-copy-object-attribute, ^problem-space, ^share-relation.
sp {muddy-children*elaborate*problem-space
   (state <s> ^name muddy-children)
-->
   (<s> ^problem-space <p>)
   (<p> ^name muddy-children ^copy-relation out-at ^copy-relation said-yes ^share-relation muddy ^share-relation clean ^share-relation view-mate ^share-relation actual ^dont-copy-object-attribute goal-met)
}

sp {muddy-children*elaborate*problem-space*mea-substate
   (state <s> ^impasse no-change ^attribute operator ^superstate <ss>)
   (<ss> ^problem-space.name muddy-children ^operator <so>)
   (<so> ^task-operator true -^pre-conditions-satisfied true)
-->
   (<s> ^problem-space <p>)
   (<p> ^name muddy-children ^dont-copy-object-attribute goal-met)
}

## Elaborate flags: adds ^flag-override, ^mea-operator-selection.
sp {muddy-children*elaborate*flags
   (state <s> ^superstate nil ^name muddy-children)
-->
   (<s> ^flag-override <f>)
   (<f> ^mea-operator-selection true)
}

