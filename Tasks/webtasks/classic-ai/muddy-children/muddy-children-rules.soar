   (state <s> ^problem-space.name muddy-children ^operator <op> ^internal-actions true ^world <w>)
   (<op> ^task-operator true ^name father-speaks ^pre-conditions-satisfied true ^argument1.object-handle $ <t-h>)
   (<w> ^anchored-world true ^objects <objs>)
