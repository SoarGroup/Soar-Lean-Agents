## Tower of London (tower-of-london): generated by spec_backend.py (WorldSpec, path B: Lean description, Python rules) from the instructor statements.
##
## Instructor statements used (numbers as in english-input.txt):
##  1. There are three pegs. The first peg holds up to three balls, the second up to two, the third one.
##  2. There are three balls: red, green and blue.
##  3. At the start the first peg holds red at the bottom and green on top of it, the second peg holds blue, and the third peg is empty.
##  4. You can move the top ball of a peg onto another peg that is not full.
##  5. The goal is that the first peg holds blue at the bottom and red on top of it, and the second peg holds green.
##  6. Reach the goal in as few moves as possible.
##
## Assumption ledger:
##   A-TL1: "holds up to n balls": a peg has n slots, stacked by an over relation from a floor; a ball is at a slot.
##   A-TL2: "the top ball": a ball whose slot has an empty space over it. Each peg has a cap space over its top slot that is always empty and never a target, so the top slot needs no special case.
##   A-TL3: "onto a peg that is not full": into the peg's lowest empty slot, i.e. an empty slot over a slot or floor that something is at. Each floor holds a fixed base object, which no action moves.
##   A-TL4: "another peg": the target slot is of a different peg than the ball's slot.
##   A-TL5: "as few moves as possible": unit cost per move, read through the library's search settings, not through the rules.

## Propose initialize-tower-of-london when its conditions below hold.
sp {tower-of-london*propose*initialize-tower-of-london
   (state <s> ^superstate nil ^world <w> -^name)
-->
   (<s> ^operator <o> + >)
   (<o> ^name initialize-tower-of-london ^task-operator false)
}

sp {tower-of-london*apply*initialize-tower-of-london
   (state <s> ^operator.name initialize-tower-of-london ^world <w>)
   (<w> ^objects <objs>)
-->
   (<s> ^name tower-of-london ^desireds <ds>)
   (<objs> ^object <k-red-ball> <k-green-ball> <k-blue-ball> <k-peg-a> <k-a-floor> <k-a-base> <k-a-low> <k-a-mid> <k-a-top> <k-a-cap> <k-peg-b> <k-b-floor> <k-b-base> <k-b-low> <k-b-top> <k-b-cap> <k-peg-c> <k-c-floor> <k-c-base> <k-c-low> <k-c-cap> <k-task>)
   (<k-red-ball> ^object-handle red-ball ^anchored true ^type ball ^name red-ball ^color red)
   (<k-green-ball> ^object-handle green-ball ^anchored true ^type ball ^name green-ball ^color green)
   (<k-blue-ball> ^object-handle blue-ball ^anchored true ^type ball ^name blue-ball ^color blue)
   (<k-peg-a> ^object-handle peg-a ^anchored true ^type peg ^name peg-a ^capacity 3)
   (<k-a-floor> ^object-handle a-floor ^anchored true ^type floor ^name a-floor)
   (<k-a-base> ^object-handle a-base ^anchored true ^type base ^name a-base)
   (<k-a-low> ^object-handle a-low ^anchored true ^type slot ^name a-low ^kind space)
   (<k-a-mid> ^object-handle a-mid ^anchored true ^type slot ^name a-mid ^kind space)
   (<k-a-top> ^object-handle a-top ^anchored true ^type slot ^name a-top ^kind space)
   (<k-a-cap> ^object-handle a-cap ^anchored true ^type cap ^name a-cap ^kind space)
   (<k-peg-b> ^object-handle peg-b ^anchored true ^type peg ^name peg-b ^capacity 2)
   (<k-b-floor> ^object-handle b-floor ^anchored true ^type floor ^name b-floor)
   (<k-b-base> ^object-handle b-base ^anchored true ^type base ^name b-base)
   (<k-b-low> ^object-handle b-low ^anchored true ^type slot ^name b-low ^kind space)
   (<k-b-top> ^object-handle b-top ^anchored true ^type slot ^name b-top ^kind space)
   (<k-b-cap> ^object-handle b-cap ^anchored true ^type cap ^name b-cap ^kind space)
   (<k-peg-c> ^object-handle peg-c ^anchored true ^type peg ^name peg-c ^capacity 1)
   (<k-c-floor> ^object-handle c-floor ^anchored true ^type floor ^name c-floor)
   (<k-c-base> ^object-handle c-base ^anchored true ^type base ^name c-base)
   (<k-c-low> ^object-handle c-low ^anchored true ^type slot ^name c-low ^kind space)
   (<k-c-cap> ^object-handle c-cap ^anchored true ^type cap ^name c-cap ^kind space)
   (<k-task> ^object-handle task ^anchored true ^type task)
   (<ds> ^desired-count 1 ^desired <d1>)
   (<d1> ^object <d1-o>)
   (<d1-o> ^object-handle task ^goal-met true)
   (<w> ^over <rel-1>)
   (<rel-1> ^argument1 <k-a-low> ^argument2 <k-a-floor>)
   (<w> ^over <rel-2>)
   (<rel-2> ^argument1 <k-a-mid> ^argument2 <k-a-low>)
   (<w> ^over <rel-3>)
   (<rel-3> ^argument1 <k-a-top> ^argument2 <k-a-mid>)
   (<w> ^over <rel-4>)
   (<rel-4> ^argument1 <k-a-cap> ^argument2 <k-a-top>)
   (<w> ^over <rel-5>)
   (<rel-5> ^argument1 <k-b-low> ^argument2 <k-b-floor>)
   (<w> ^over <rel-6>)
   (<rel-6> ^argument1 <k-b-top> ^argument2 <k-b-low>)
   (<w> ^over <rel-7>)
   (<rel-7> ^argument1 <k-b-cap> ^argument2 <k-b-top>)
   (<w> ^over <rel-8>)
   (<rel-8> ^argument1 <k-c-low> ^argument2 <k-c-floor>)
   (<w> ^over <rel-9>)
   (<rel-9> ^argument1 <k-c-cap> ^argument2 <k-c-low>)
   (<w> ^of <rel-10>)
   (<rel-10> ^argument1 <k-a-low> ^argument2 <k-peg-a>)
   (<w> ^of <rel-11>)
   (<rel-11> ^argument1 <k-a-mid> ^argument2 <k-peg-a>)
   (<w> ^of <rel-12>)
   (<rel-12> ^argument1 <k-a-top> ^argument2 <k-peg-a>)
   (<w> ^of <rel-13>)
   (<rel-13> ^argument1 <k-b-low> ^argument2 <k-peg-b>)
   (<w> ^of <rel-14>)
   (<rel-14> ^argument1 <k-b-top> ^argument2 <k-peg-b>)
   (<w> ^of <rel-15>)
   (<rel-15> ^argument1 <k-c-low> ^argument2 <k-peg-c>)
   (<w> ^at <rel-16>)
   (<rel-16> ^argument1 <k-a-base> ^argument2 <k-a-floor>)
   (<w> ^at <rel-17>)
   (<rel-17> ^argument1 <k-b-base> ^argument2 <k-b-floor>)
   (<w> ^at <rel-18>)
   (<rel-18> ^argument1 <k-c-base> ^argument2 <k-c-floor>)
   (<w> ^at <rel-19>)
   (<rel-19> ^argument1 <k-red-ball> ^argument2 <k-a-low>)
   (<w> ^at <rel-20>)
   (<rel-20> ^argument1 <k-green-ball> ^argument2 <k-a-mid>)
   (<w> ^at <rel-21>)
   (<rel-21> ^argument1 <k-blue-ball> ^argument2 <k-b-low>)
   (<w> ^empty <rel-22>)
   (<rel-22> ^argument1 <k-a-top>)
   (<w> ^empty <rel-23>)
   (<rel-23> ^argument1 <k-a-cap>)
   (<w> ^empty <rel-24>)
   (<rel-24> ^argument1 <k-b-top>)
   (<w> ^empty <rel-25>)
   (<rel-25> ^argument1 <k-b-cap>)
   (<w> ^empty <rel-26>)
   (<rel-26> ^argument1 <k-c-low>)
   (<w> ^empty <rel-27>)
   (<rel-27> ^argument1 <k-c-cap>)
   (log 1 (crlf) |Initialize tower-of-london.|)
}

## Elaborate problem space: adds ^copy-relation, ^dont-copy-object-attribute, ^problem-space.
sp {tower-of-london*elaborate*problem-space
   (state <s> ^name tower-of-london)
-->
   (<s> ^problem-space <p>)
   (<p> ^name tower-of-london ^copy-relation over ^copy-relation of ^copy-relation at ^copy-relation empty ^dont-copy-object-attribute goal-met)
}

sp {tower-of-london*elaborate*problem-space*mea-substate
   (state <s> ^impasse no-change ^attribute operator ^superstate <ss>)
   (<ss> ^problem-space.name tower-of-london ^operator <so>)
   (<so> ^task-operator true -^pre-conditions-satisfied true)
-->
   (<s> ^problem-space <p>)
   (<p> ^name tower-of-london ^dont-copy-object-attribute goal-met)
}

## Elaborate flags: adds ^flag-override, ^mea-operator-selection.
sp {tower-of-london*elaborate*flags
   (state <s> ^superstate nil ^name tower-of-london)
-->
   (<s> ^flag-override <f>)
   (<f> ^mea-operator-selection true)
}

## Achievement of object-property desireds (supplied by the task).
sp {tower-of-london*elaborate*state*achieved*object-property
   (state <s> ^problem-space.name tower-of-london ^desireds <ds> ^world <w>)
   (<ds> ^desired <d>)
   (<d> ^object <do>)
   (<do> ^object-handle <h> ^{ <> object-handle <a> } <v>)
   (<w> ^anchored-world true ^objects.object <ob>)
   (<ob> ^object-handle <h> ^<a> <v>)
-->
   (<ds> ^achieved <d>)
}

sp {tower-of-london*elaborate*state*unachieved*object-property
   (state <s> ^problem-space.name tower-of-london ^desireds <ds> ^world <w>)
   (<ds> ^desired <d>)
   (<d> ^object <do>)
   (<do> ^object-handle <h> ^{ <> object-handle <a> } <v>)
   (<w> ^anchored-world true)
  -{(<w> ^objects.object <ob>)
    (<ob> ^object-handle <h> ^<a> <v>)}
-->
   (<ds> ^unachieved <d>)
}

## Operator move (statement 4).
sp {tower-of-london*propose*move
   (state <s> ^problem-space.name tower-of-london ^flags.mea-operator-selection true ^world <w> ^desireds <ds>)
   (<w> ^anchored-world true ^objects <objs>)
   (<objs> ^object <b>)
   (<b> ^type ball)
   (<objs> ^object <t>)
   (<t> ^type slot)
   (<w> ^at <r1>)
   (<r1> ^argument1 <b> ^argument2 <src>)
   (<w> ^over <r2>)
   (<r2> ^argument1 <c> ^argument2 <src>)
   (<w> ^empty <r3>)
   (<r3> ^argument1 <c>)
   (<w> ^empty <r4>)
   (<r4> ^argument1 <t>)
   (<w> ^over <r5>)
   (<r5> ^argument1 <t> ^argument2 <u>)
   (<w> ^at <r6>)
   (<r6> ^argument1 <o> ^argument2 <u>)
   (<w> ^of <r7>)
   (<r7> ^argument1 <src> ^argument2 <p1>)
   (<w> ^of <r8>)
   (<r8> ^argument1 <t> ^argument2 <p2>)
   (<objs> ^object { <> <p1> <p2> })
   (<ds> ^unachieved-desireds true)
-->
   (<s> ^operator <op> +)
   (<op> ^name move ^task-operator true ^action-handle move ^argument1 <b> ^argument2 <t> ^argument-count 2 ^desireds <pre>)
   (<pre> ^desired-count 0)
}

## Effect of move (look-ahead).
sp {tower-of-london*apply*move*internal
   (state <s> ^problem-space.name tower-of-london ^operator <op> ^internal-actions true ^world <w>)
   (<op> ^task-operator true ^name move ^pre-conditions-satisfied true ^argument1.object-handle $ <b-h> ^argument2.object-handle $ <t-h>)
   (<w> ^anchored-world true ^objects <objs>)
   (<objs> ^object <b>)
   (<b> ^object-handle $ <b-h>)
   (<objs> ^object <t>)
   (<t> ^object-handle $ <t-h>)
   (<w> ^at <r1>)
   (<r1> ^argument1 <b> ^argument2 <old>)
   (<w> ^empty <e2>)
   (<e2> ^argument1 <t>)
-->
   (<r1> ^argument2 <old> - <t>)
   (<w> ^empty <e2> -)
   (<w> ^empty <new-3>)
   (<new-3> ^argument1 <old>)
}

## Effect of a completed move command on the real world (once per command).
sp {tower-of-london*apply*move*environment-effect
   :o-support
   (state <s> ^problem-space.name tower-of-london ^superstate nil ^world <w> ^io.output-link.perform-action <pa>)
   (<pa> ^name move ^status complete ^argument1 <b-h> ^argument2 <t-h> -^effect-applied true)
   (<w> ^anchored-world true ^objects <objs>)
   (<objs> ^object <b>)
   (<b> ^object-handle $ <b-h>)
   (<objs> ^object <t>)
   (<t> ^object-handle $ <t-h>)
   (<w> ^at <r1>)
   (<r1> ^argument1 <b> ^argument2 <old>)
   (<w> ^empty <e2>)
   (<e2> ^argument1 <t>)
-->
   (<r1> ^argument2 <old> - <t>)
   (<w> ^empty <e2> -)
   (<w> ^empty <new-3>)
   (<new-3> ^argument1 <old>)
   (<pa> ^effect-applied true)
   (write |Move | <b-h> | to | <t-h> (crlf))
}

## Goal (statement 5): ^goal-met true on the task object.
sp {tower-of-london*elaborate*goal
   (state <s> ^problem-space.name tower-of-london ^world <w>)
   (<w> ^anchored-world true ^objects <objs>)
   (<objs> ^object <task>)
   (<task> ^type task)
   (<objs> ^object <k-blue-ball>)
   (<k-blue-ball> ^object-handle blue-ball)
   (<objs> ^object <k-a-low>)
   (<k-a-low> ^object-handle a-low)
   (<w> ^at <r1>)
   (<r1> ^argument1 <k-blue-ball> ^argument2 <k-a-low>)
   (<objs> ^object <k-red-ball>)
   (<k-red-ball> ^object-handle red-ball)
   (<objs> ^object <k-a-mid>)
   (<k-a-mid> ^object-handle a-mid)
   (<w> ^at <r2>)
   (<r2> ^argument1 <k-red-ball> ^argument2 <k-a-mid>)
   (<objs> ^object <k-green-ball>)
   (<k-green-ball> ^object-handle green-ball)
   (<objs> ^object <k-b-low>)
   (<k-b-low> ^object-handle b-low)
   (<w> ^at <r3>)
   (<r3> ^argument1 <k-green-ball> ^argument2 <k-b-low>)
-->
   (<task> ^goal-met true)
}
