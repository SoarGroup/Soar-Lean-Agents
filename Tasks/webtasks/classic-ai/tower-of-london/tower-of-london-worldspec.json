{
  "format": "worldspec-1",
  "name": "tower-of-london",
  "title": "Tower of London (tower-of-london)",
  "statements": [
    [
      1,
      "There are three pegs. The first peg holds up to three balls, the second up to two, the third one."
    ],
    [
      2,
      "There are three balls: red, green and blue."
    ],
    [
      3,
      "At the start the first peg holds red at the bottom and green on top of it, the second peg holds blue, and the third peg is empty."
    ],
    [
      4,
      "You can move the top ball of a peg onto another peg that is not full."
    ],
    [
      5,
      "The goal is that the first peg holds blue at the bottom and red on top of it, and the second peg holds green."
    ],
    [
      6,
      "Reach the goal in as few moves as possible."
    ]
  ],
  "assumptions": [
    {
      "id": "A-TL1",
      "kind": "intent",
      "text": "\"holds up to n balls\": a peg has n slots, stacked by an over relation from a floor; a ball is at a slot.",
      "stmts": [
        1
      ]
    },
    {
      "id": "A-TL2",
      "kind": "intent",
      "text": "\"the top ball\": a ball whose slot has an empty space over it. Each peg has a cap space over its top slot that is always empty and never a target, so the top slot needs no special case.",
      "stmts": [
        4
      ]
    },
    {
      "id": "A-TL3",
      "kind": "intent",
      "text": "\"onto a peg that is not full\": into the peg's lowest empty slot, i.e. an empty slot over a slot or floor that something is at. Each floor holds a fixed base object, which no action moves.",
      "stmts": [
        4
      ]
    },
    {
      "id": "A-TL4",
      "kind": "intent",
      "text": "\"another peg\": the target slot is of a different peg than the ball's slot.",
      "stmts": [
        4
      ]
    },
    {
      "id": "A-TL5",
      "kind": "intent",
      "text": "\"as few moves as possible\": unit cost per move, read through the library's search settings, not through the rules.",
      "stmts": [
        6
      ]
    }
  ],
