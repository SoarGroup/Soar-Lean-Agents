## Vacuum world (vacuum-world): generated by spec_backend.py (WorldSpec, path B: Lean description, Python rules) from the instructor statements.
##
## Instructor statements used (numbers as in english-input.txt):
##  1. The world has two squares, Left and Right, side by side.
##  2. A vacuum cleaner is in the Left square. Both squares are dirty.
##  3. The vacuum can move to the other square.
##  4. The vacuum can suck, which makes the square it is in clean.
##  5. Each action costs one step.
##  6. The goal is that both squares are clean, in as few steps as possible.
##
## Assumption ledger:
##   A-V1: "the other square": a static next relation holds between Left and Right in both directions.
##   A-V2: "clean" is "not dirty", kept as a maintained relation (it tests absence and decides the goal).
##   A-V3: Suck is proposed only in a dirty square: sucking a clean square changes nothing, so it is never part of a shortest plan.
##   A-V4: "as few steps as possible": unit cost per action, read through the library's search settings, not through the rules.

## Propose initialize-vacuum-world when its conditions below hold.
sp {vacuum-world*propose*initialize-vacuum-world
   (state <s> ^superstate nil ^world <w> -^name)
-->
   (<s> ^operator <o> + >)
   (<o> ^name initialize-vacuum-world ^task-operator false)
}

sp {vacuum-world*apply*initialize-vacuum-world
   (state <s> ^operator.name initialize-vacuum-world ^world <w>)
   (<w> ^objects <objs>)
-->
   (<s> ^name vacuum-world ^desireds <ds>)
   (<objs> ^object <k-left> <k-right> <k-vacuum> <k-task>)
   (<k-left> ^object-handle left ^anchored true ^type square ^name left)
   (<k-right> ^object-handle right ^anchored true ^type square ^name right)
   (<k-vacuum> ^object-handle vacuum ^anchored true ^type agent ^name vacuum)
   (<k-task> ^object-handle task ^anchored true ^type task)
   (<ds> ^desired-count 1 ^desired <d1>)
   (<d1> ^object <d1-o>)
   (<d1-o> ^object-handle task ^goal-met true)
   (<w> ^at <rel-1>)
   (<rel-1> ^argument1 <k-vacuum> ^argument2 <k-left>)
   (<w> ^dirty <rel-2>)
   (<rel-2> ^argument1 <k-left>)
   (<w> ^dirty <rel-3>)
   (<rel-3> ^argument1 <k-right>)
   (<w> ^next <rel-4>)
   (<rel-4> ^argument1 <k-left> ^argument2 <k-right>)
   (<w> ^next <rel-5>)
   (<rel-5> ^argument1 <k-right> ^argument2 <k-left>)
   (log 1 (crlf) |Initialize vacuum-world.|)
}

## Elaborate problem space: adds ^copy-relation, ^dont-copy-object-attribute, ^problem-space.
sp {vacuum-world*elaborate*problem-space
   (state <s> ^name vacuum-world)
-->
   (<s> ^problem-space <p>)
   (<p> ^name vacuum-world ^copy-relation at ^copy-relation dirty ^copy-relation next ^copy-relation clean ^dont-copy-object-attribute goal-met)
}

sp {vacuum-world*elaborate*problem-space*mea-substate
   (state <s> ^impasse no-change ^attribute operator ^superstate <ss>)
   (<ss> ^problem-space.name vacuum-world ^operator <so>)
   (<so> ^task-operator true -^pre-conditions-satisfied true)
-->
   (<s> ^problem-space <p>)
   (<p> ^name vacuum-world ^dont-copy-object-attribute goal-met)
}

## Elaborate flags: adds ^flag-override, ^mea-operator-selection.
sp {vacuum-world*elaborate*flags
   (state <s> ^superstate nil ^name vacuum-world)
-->
   (<s> ^flag-override <f>)
   (<f> ^mea-operator-selection true)
}

## Achievement of object-property desireds (supplied by the task).
sp {vacuum-world*elaborate*state*achieved*object-property
   (state <s> ^problem-space.name vacuum-world ^desireds <ds> ^world <w>)
   (<ds> ^desired <d>)
   (<d> ^object <do>)
   (<do> ^object-handle <h> ^{ <> object-handle <a> } <v>)
   (<w> ^anchored-world true ^objects.object <ob>)
   (<ob> ^object-handle <h> ^<a> <v>)
-->
   (<ds> ^achieved <d>)
}

sp {vacuum-world*elaborate*state*unachieved*object-property
   (state <s> ^problem-space.name vacuum-world ^desireds <ds> ^world <w>)
   (<ds> ^desired <d>)
   (<d> ^object <do>)
   (<do> ^object-handle <h> ^{ <> object-handle <a> } <v>)
   (<w> ^anchored-world true)
  -{(<w> ^objects.object <ob>)
    (<ob> ^object-handle <h> ^<a> <v>)}
-->
   (<ds> ^unachieved <d>)
}

## Operator move (statement 3).
sp {vacuum-world*propose*move
   (state <s> ^problem-space.name vacuum-world ^flags.mea-operator-selection true ^world <w> ^desireds <ds>)
   (<w> ^anchored-world true ^objects <objs>)
   (<objs> ^object <to>)
   (<to> ^type square)
   (<objs> ^object <v>)
   (<v> ^type agent)
   (<w> ^at <r1>)
   (<r1> ^argument1 <v> ^argument2 <cur>)
   (<w> ^next <r2>)
   (<r2> ^argument1 <cur> ^argument2 <to>)
   (<ds> ^unachieved-desireds true)
-->
   (<s> ^operator <op> +)
   (<op> ^name move ^task-operator true ^action-handle move ^argument1 <to> ^argument-count 1 ^desireds <pre>)
   (<pre> ^desired-count 0)
}

## Effect of move (look-ahead).
sp {vacuum-world*apply*move*internal
   (state <s> ^problem-space.name vacuum-world ^operator <op> ^internal-actions true ^world <w>)
   (<op> ^task-operator true ^name move ^pre-conditions-satisfied true ^argument1.object-handle $ <to-h>)
   (<w> ^anchored-world true ^objects <objs>)
   (<objs> ^object <to>)
   (<to> ^object-handle $ <to-h>)
   (<objs> ^object <v>)
   (<v> ^type agent)
   (<w> ^at <r1>)
   (<r1> ^argument1 <v> ^argument2 <old>)
-->
   (<r1> ^argument2 <old> - <to>)
}

## Effect of a completed move command on the real world (once per command).
sp {vacuum-world*apply*move*environment-effect
   :o-support
   (state <s> ^problem-space.name vacuum-world ^superstate nil ^world <w> ^io.output-link.perform-action <pa>)
   (<pa> ^name move ^status complete ^argument1 <to-h> -^effect-applied true)
   (<w> ^anchored-world true ^objects <objs>)
   (<objs> ^object <to>)
   (<to> ^object-handle $ <to-h>)
   (<objs> ^object <v>)
   (<v> ^type agent)
   (<w> ^at <r1>)
   (<r1> ^argument1 <v> ^argument2 <old>)
-->
   (<r1> ^argument2 <old> - <to>)
   (<pa> ^effect-applied true)
   (write |Move to | <to-h> (crlf))
}

## Operator suck (statement 4).
sp {vacuum-world*propose*suck
   (state <s> ^problem-space.name vacuum-world ^flags.mea-operator-selection true ^world <w> ^desireds <ds>)
   (<w> ^anchored-world true ^objects <objs>)
   (<objs> ^object <sq>)
   (<sq> ^type square)
   (<objs> ^object <v>)
   (<v> ^type agent)
   (<w> ^at <r1>)
   (<r1> ^argument1 <v> ^argument2 <sq>)
   (<w> ^dirty <r2>)
   (<r2> ^argument1 <sq>)
   (<ds> ^unachieved-desireds true)
-->
   (<s> ^operator <op> +)
   (<op> ^name suck ^task-operator true ^action-handle suck ^argument1 <sq> ^argument-count 1 ^desireds <pre>)
   (<pre> ^desired-count 0)
}

## Effect of suck (look-ahead).
sp {vacuum-world*apply*suck*internal
   (state <s> ^problem-space.name vacuum-world ^operator <op> ^internal-actions true ^world <w>)
   (<op> ^task-operator true ^name suck ^pre-conditions-satisfied true ^argument1.object-handle $ <sq-h>)
   (<w> ^anchored-world true ^objects <objs>)
   (<objs> ^object <sq>)
   (<sq> ^object-handle $ <sq-h>)
   (<w> ^dirty <e1>)
   (<e1> ^argument1 <sq>)
-->
   (<w> ^dirty <e1> -)
   (<w> ^clean <new-2>)
   (<new-2> ^argument1 <sq>)
}

## Effect of a completed suck command on the real world (once per command).
sp {vacuum-world*apply*suck*environment-effect
   :o-support
   (state <s> ^problem-space.name vacuum-world ^superstate nil ^world <w> ^io.output-link.perform-action <pa>)
   (<pa> ^name suck ^status complete ^argument1 <sq-h> -^effect-applied true)
   (<w> ^anchored-world true ^objects <objs>)
   (<objs> ^object <sq>)
   (<sq> ^object-handle $ <sq-h>)
   (<w> ^dirty <e1>)
   (<e1> ^argument1 <sq>)
-->
   (<w> ^dirty <e1> -)
   (<w> ^clean <new-2>)
   (<new-2> ^argument1 <sq>)
   (<pa> ^effect-applied true)
   (write |Suck in | <sq-h> (crlf))
}

## Goal (statement 6): ^goal-met true on the task object.
sp {vacuum-world*elaborate*goal
   (state <s> ^problem-space.name vacuum-world ^world <w>)
   (<w> ^anchored-world true ^objects <objs>)
   (<objs> ^object <task>)
   (<task> ^type task)
   (<objs> ^object <x-left>)
   (<x-left> ^object-handle left)
   (<w> ^clean <r1>)
   (<r1> ^argument1 <x-left>)
   (<objs> ^object <x-right>)
   (<x-right> ^object-handle right)
   (<w> ^clean <r2>)
   (<r2> ^argument1 <x-right>)
-->
   (<task> ^goal-met true)
}
