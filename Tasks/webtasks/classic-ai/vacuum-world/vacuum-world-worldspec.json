{
  "format": "worldspec-1",
  "name": "vacuum-world",
  "title": "Vacuum world (vacuum-world)",
  "statements": [
    [
      1,
      "The world has two squares, Left and Right, side by side."
    ],
    [
      2,
      "A vacuum cleaner is in the Left square. Both squares are dirty."
    ],
    [
      3,
      "The vacuum can move to the other square."
    ],
    [
      4,
      "The vacuum can suck, which makes the square it is in clean."
    ],
    [
      5,
      "Each action costs one step."
    ],
    [
      6,
      "The goal is that both squares are clean, in as few steps as possible."
    ]
  ],
  "assumptions": [
    {
      "id": "A-V1",
      "kind": "intent",
      "text": "\"the other square\": a static next relation holds between Left and Right in both directions.",
      "stmts": [
        1,
        3
      ]
    },
    {
      "id": "A-V2",
      "kind": "intent",
      "text": "\"clean\" is \"not dirty\", kept as a maintained relation (it tests absence and decides the goal).",
      "stmts": [
        4,
        6
      ]
    },
    {
      "id": "A-V3",
      "kind": "intent",
      "text": "Suck is proposed only in a dirty square: sucking a clean square changes nothing, so it is never part of a shortest plan.",
      "stmts": [
        4
      ]
    },
    {
      "id": "A-V4",
      "kind": "intent",
      "text": "\"as few steps as possible\": unit cost per action, read through the library's search settings, not through the rules.",
      "stmts": [
        5,
        6
      ]
    }
  ],
