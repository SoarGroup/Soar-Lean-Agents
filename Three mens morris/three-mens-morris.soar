    (state <s> ^name three-mens-morris ^quiescence t ^turn O ^desired <d> ^look-ahead-operator <lo>)
    (<lo> ^player X)
    (<s> ^stage2 yes ^board <b> -^winner <w> -^threat O)
    (<b> -^c4 X)
