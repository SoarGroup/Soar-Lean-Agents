# Three Men's Morris, played by Soar against itself with the default selection space
# (generated by gen.py)
chunk never
source selection.soar

sp {morris*propose*initialize
    (state <s> ^superstate nil -^name <n>)
    -->
    (<s> ^operator <o> +)
    (<o> ^name initialize-morris +)
}

sp {morris*apply*initialize
    (state <s> ^operator <o>)
    (<o> ^name initialize-morris)
    -->
    (<s> ^name three-mens-morris + ^board <b> + ^turn X + ^remaining-X 3 + ^remaining-O 3 + ^plies 0 + ^desired <d> +)
    (<d> ^name win + ^better higher +)
    (<b> ^c0 empty + ^c1 empty + ^c2 empty + ^c3 empty + ^c4 empty + ^c5 empty + ^c6 empty + ^c7 empty + ^c8 empty + )
}

sp {morris*elaborate*problem-space
    (state <s> ^name three-mens-morris)
    -->
    (<s> ^problem-space <p> +)
    (<p> ^name three-mens-morris + ^default-state-copy yes + ^all-attributes-at-level one + ^two-level-attributes board +
         ^dont-copy winner + ^dont-copy threat + ^dont-copy draw + ^dont-copy stage1 + ^dont-copy stage2 +)
}

sp {morris*elaborate*winner*X*012
    (state <s> ^name three-mens-morris ^board <b>)
    (<b> ^c0 X ^c1 X ^c2 X)
    -->
    (<s> ^winner X +)
}

