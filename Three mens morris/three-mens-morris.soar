}

sp {morris*elaborate*stage1*X
    (state <s> ^name three-mens-morris ^turn O ^look-ahead-operator <lo>)
    (<lo> ^player X)
    -->
    (<s> ^stage1 yes +)
}

sp {morris*elaborate*stage2*X
    (state <s> ^name three-mens-morris ^stage1 yes)
    -->
    (<s> ^stage2 yes +)
}

sp {morris*evaluate*win*X
    (state <s> ^name three-mens-morris ^quiescence t ^turn O ^desired <d> ^look-ahead-operator <lo>)
    (<lo> ^player X)
    (<s> ^winner X)
    -->
    (<s> ^numeric-value 100 +)
}

sp {morris*evaluate*lose*X
