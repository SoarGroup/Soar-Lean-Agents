sp {morris*apply*place*book*X
    (state <s> ^name three-mens-morris ^operator <o> ^turn X ^remaining-X <r> ^plies <n>)
    (<o> ^name place ^player X)
    -->
    (<s> ^turn O + ^turn X - ^remaining-X (- <r> 1) + ^remaining-X <r> - ^plies (+ <n> 1) + ^plies <n> -)
}

sp {morris*apply*move*book*X
    (state <s> ^name three-mens-morris ^operator <o> ^turn X ^plies <n>)
