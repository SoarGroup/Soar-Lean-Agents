# If an blcok does not have another block ontop of it, it is clear.
## Modified so always apply through top-state

sp {P1*elaborate*block*clear
   (state <s> ^top-state <ts>)
   (<ts> ^object <block>
        -^ontop.bottom-block <block>)
-->
   (<ts> ^clear <block>)
}

# Table is always clear

sp {P2*elaborate*table*clear
   (state <s> ^top-state <ts>)
   (<ts> ^object <object>)
   (<object> ^type table)
-->
   (<ts> ^clear <object>)
}

sp {P1*elaborate*block*clear*toop
   (state <s> ^top-state <ts>)
   (<ts> ^object <block>
        -^ontop.bottom-block <block>)
-->
   (<ts> ^clear <block>)
}

# Table is always clear

sp {P2*elaborate*table*clear*top
   (state <s>  ^top-state <ts>
               ^superstate nil)
   (<ts> ^object <object>)
   (<object> ^type table)
-->
   (<ts> ^clear <object>)
}
