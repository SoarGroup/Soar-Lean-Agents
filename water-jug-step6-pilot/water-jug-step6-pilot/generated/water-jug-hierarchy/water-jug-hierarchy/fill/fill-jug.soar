# Generated by agentgen from the Lean description (water-jug-hierarchy). Do not edit: change the
# description and regenerate. Hand-written rules go in raw files listed as escape hatches.

sp {fill*propose*fill-jug
   (state <s> ^name fill)
   -(<s> ^done fill-jug)
   (<s> ^done pick-up)
-->
   (<s> ^operator <o> +)
   (<s> ^operator <o> =)
   (<o> ^name fill-jug)
}

sp {fill*apply*fill-jug
   (state <s> ^name fill)
   (<s> ^operator <o>)
   (<o> ^name fill-jug)
-->
   (<s> ^done fill-jug)
}
