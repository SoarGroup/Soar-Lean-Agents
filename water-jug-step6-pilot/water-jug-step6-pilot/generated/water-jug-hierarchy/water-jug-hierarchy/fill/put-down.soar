# Generated by agentgen from the Lean description (water-jug-hierarchy). Do not edit: change the
# description and regenerate. Hand-written rules go in raw files listed as escape hatches.

sp {fill*propose*put-down
   (state <s> ^name fill)
   -(<s> ^done put-down)
   (<s> ^done fill-jug)
-->
   (<s> ^operator <o> +)
   (<s> ^operator <o> =)
   (<o> ^name put-down)
}

sp {fill*apply*put-down
   (state <s> ^name fill)
   (<s> ^operator <o>)
   (<o> ^name put-down)
   (<s> ^jug <jug>)
   (<jug> ^contents <jug-contents>)
   (<jug> ^volume <jug-volume>)
-->
   (<jug> ^contents <jug-volume>)
   (<jug> ^contents <jug-contents> -)
   (<s> ^done put-down)
}
